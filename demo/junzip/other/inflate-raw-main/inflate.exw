with trace
function hexify(string s)
    string res = ""
    for ch in s do
        res &= sprintf(`%02x`,ch)
    end for
    return res
end function

function stitch(string a, b, integer aBitsLeft, bBitsLeft)
    integer a2 = a[2]
--  a[2] = a2-iff(a2>'9'?odd(a2):even(a2)) -- kill bfinal
    a[2] = a2-iff(a2>'9'?even(a2):odd(a2)) -- kill bfinal
    -- note ^that means you have to do stitch(a,stitch(b,c)),
    --     & cos it wdn't clear b, not stitch(stitch(a,b),c).
    if aBitsLeft=0 then
        a &= b
    else
        integer n = to_integer(a[-2..-1],0,16)
        sequence bits = int_to_bits(n,8-aBitsLeft)
--?{"last bits",bits}
        assert(bits_to_int(bits)==n)
        bool bNC = b[2]='1'
        if bNC then
            bits &= int_to_bits(1,aBitsLeft)
        else
            for i=1 to length(b) by 2 do
                n = to_integer(b[i..i+1],0,16)
                bits &= int_to_bits(n,8)
--?{n,b[i..i+1],bits}
            end for
            integer lb = length(bits),
                    wb = floor(lb/8)*8,
--                  pb = (wb+1)*8-lb
                    pb = wb+8-lb
            if bBitsLeft+aBitsLeft>=8 then
                bits = bits[1..wb]
--          elsif pb then
            else -- (since we now /know/ it's not 0)
                assert(pb==aBitsLeft) -- sanity check
                bits &= repeat(0,pb)
            end if
--?{"final",bits,length(bits)}
        end if
        a = a[1..-3]
        for i=1 to length(bits) by 8 do
            n = bits_to_int(bits[i..i+7])
            a &= sprintf("%02x",n)
        end for
        if bNC then
            if aBitsLeft<3 then
                a&="00"
            end if
            a &= b[3..$]
        end if
    end if
    return a
end function
procedure test(string a, b, ab, integer aBitsLeft, bBitsLeft)
    string res = stitch(a,b,aBitsLeft,bBitsLeft)
    assert(lower(res)==lower(ab))
end procedure
test("25cbc10dc0300843d195a84253fbe8a6f1fe235581d3135fc6411308078d451fa9be99da473d5ae54456bfdeead818d593b3ff7b8f4fa3e5fd03",
