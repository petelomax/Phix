--sequence ml = {36,36,36,36,36,36,38,38}
sequence ml = apply(vslice(spbl,1),length),
         ul = apply(vslice(spbl,2),length)
?ml
integer cml = max(ul)
integer iter=0
do
iter += 1
    integer l = rand(cml)
--  integer l = cml-5+rand(5)
--  integer l = cml
    string s = repeat(' ',l)
    for i=1 to l do
--      integer ch = rand(125-' ')+' '
--      integer ch = rand(62)+'0'-1
--      integer ch = rand(10)+'0'-1
--      integer ch = rand(10)+'A'-1
--      integer ch = rand(2)+'0'-1
--      integer ch = rand(2)+'0'
        integer ch = rand(3)+'a'-1
        if i<=9 then ch='a' end if
        if i=8 then ch='c' end if
        if i=5 or i=10 or i=11 then ch='b' end if
-- aaaabaacabbabcacbc
-- aaaabaacabbabcacbb
-- aaaabaacabbabcacba
-- aaaabaacabbabcacb
-- aaaabaacabbabccaa
-- aaaabaacabcacccaa
-- aaaabaacabbabcccbc
-- aaaabaacabbabccbbc

-- aaaabaacabbabcacbc
-- aaaabaacabbabcacbb
-- aaaabaacabbabcacba
-- aaaabaacabbabcacb
-- aaaabaacabbabccaa
-- aaaabaacabbbabcaa
-- aaaabaacabbabcbccc
-- aaaabaacabbabcbbcc
-- 12345678901
--      integer ch = rand(5)+':'-1
--      integer ch = rand(4)+':'-1
--      integer ch = rand(3)+':'-1
--      integer ch = rand(2)+':'-1
--      integer ch = rand(6)+':'-1
--      integer ch = i+'0'-1
--      if ch>'9' then ch += 'A'-'9'-1 end if
--      if ch>'Z' then ch += 'a'-'Z'-1 end if
--      if ch>'a' then ch = ':' end if
        s[i] = ch
    end for
--s = "jtttt" -- 1
--s = "25cbc10dc0300843d195a84253fbe8a6f1fe235581d3135fc6411308078d451fa9be99da473d5ae54456bfdeead818d593b3ff7b8f4fa3e5fd03"
    string c = ZipBufferRaw(s),
           d = deflate(s),
          hc = hexify(c),
--         u = repeat(' ',l),
           t = inflate(c)
if d!=c then ?9/0 end if
    --DEV: chalk this one down as unfixable.... (and maybe abandon LiteUnZip...[.dll])
--  object res = UnzipBufferRaw(c,u)
--  if not integer(res) then
--      progress("")
--      printf(1,"%s\n",res)
--      integer res2 = UnzipBufferRaw(c,u)
--  end if
        
--  integer res = 0
--  integer res = UnzipBufferRaw(c,u,dlen:=l+100)
--/*
Ah, you're looking at code which never went in because it would not compile (Z_STREAM is defined/used in LiteUnzip.c,
but not LiteZip.c). My ZipBufferRaw wraps ZipCreateBuffer, ZipAddBufferRaw, ZipGetMemory, and ZipClose, and I've seen
it fail in ZipAddBufferRaw but more often in ZipClose. Ask if you need anything more than this:

<<<

    iter = 1108
    l = 36'$'
    s = `5jyXgzhcgj3FgSieCzBLrXbmgSi68oCLx8tm`
--  i = 37'%'
--  ch = 109'm'
    c[1..25] = {51'3',205,170,140,72'H',175,202,72'H',78'N',207,50'2',118'v',75'K',15,206,76'L',117'u',174,114'r',242,41')',138,72'H',202,5}
    c[26..36] = {178,205,44',',242,157,125'}',42'*',44',',74'J',114'r',1}
    hc = `33CDAA8C48AFCA484ECF32764B0FCE4C75AE72F2298A48CA05B2CD2CF29D7D2A2C4A7201`
--        33cdaa8c48afca484ecf32764b0fce4c75ae72f2298a48ca4d0fce34b3c877f6a9b028c90500
    u = `5jyXgzhcgj3FgSieCzBLrXbmgSi68oCLx8tm`
    t = `5jyXgzhcgj3FgSieCzBLrXbmgSi68oCLx8tm`
--       5jyXgzhcgj3FgSieCzBLrXbmgSi68oCLx8tm
    res = `ZR_NOALLOC      = 2   -- Failed to allocate memory`
    lc = 38'&'
--*/
--  assert(u==s)
    assert(t==s)
--      integer bits = readBits(3),
--            bfinal = bits && 1,
    integer btype = and_bits(c[1],6) >> 1
 if btype=0b10 then -- dynamic

    integer lc = length(hc)
progress("%d: %d: %d: %s\r",{fbl,l,iter,s})
--progress("%d: %d: %d: %s\r",{fbl,lc,iter,hc})
    fbl += 1
--  if lc<ml[fbl] then
--  if lc<ml[fbl] or (lc=ml[fbl] and s<lower(spbl[fbl][2])) then
    if lc<ml[fbl] or (lc=ml[fbl] and s<spbl[fbl][2]) then
        ml[fbl] = lc
        ul[fbl] = l
        cml = max(ul)       
        spbl[fbl] = {hc,s}
        progress("")
        pp(ml)
        pp(spbl,{pp_Nest,1})
    end if
 end if
until get_key()!=-1
progress("")
?ml
--*!/

-- 35,500 iterations, 3.25MB/s on that tiny 96 byte jobbie - plenty fast enough for me!
--/*
That 0x2d0200000000 goes into an infinite loop, adding nulls to output until it runs out of memory.
That bug should of course be fixed in it's own right, but perhaps more importantly JavaScript's 
DecompressionStream rejects that completely. (I've added some length limits of 1000 for now.)
I think these are all the relevant bits, lmk if there's anything else you'd like to see.

Alas, 0x258c4101000000203003 is not accepted by DecompressionStream either, but at least it is
now also rejected by my code.

The D is fine but the D + S and D + F don't pass muster, with any of the three.
For boundary straddling checks, the earlier shortest version I had fits the screen better, which is
0x25cbc10dc0300843d195a84253fbe8a6f1fe235581d3135fc6411308078d451fa9be99da473d5ae54456bfdeead818d593b3ff7b8f4fa3e5fd03
(58 bytes) which decompresses to 
"F09F9880F09F8C9FF09F9A80F09F94AEF09FA7ACF09FA684F09F91BEF09F8E83F09FA496F09F8CAEF09F8DA3F09F8D95" (48 bytes)


atom t1 = time()+1
string {h,e} = he[1]
integer iter = 0
do 
    iter += 1
    string r = inflate_raw(h)
until time()>t1
printf(1,"%,d iterations: %s/s\n",{iter,file_size_k(iter*length(e))})
--*/
?"done"
wait_key()


