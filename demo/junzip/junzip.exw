--with javascript_semantics
sequence table
bool have_table = false
 
function crc32(string s)
    if not have_table then
        have_table = true
        table = repeat(0,256)
        for i=0 to 255 do
            atom rem = i
            for j=1 to 8 do
                if odd(rem) then
                    rem = xor_bits(floor(rem/2),#EDB88320)
                else
                    rem = floor(rem/2)
                end if
                if rem<0 then
                    rem += #100000000
                end if
            end for
            table[i+1] = rem
--printf(1,`%08x, `,rem)
        end for
--printf(1,"\n\n")
    end if
    atom crc = #FFFFFFFF
    for c in s do
        crc = xor_bits(floor(crc/#100),table[xor_bits(and_bits(crc,0xff),c)+1])
        if crc<0 then
            crc += #100000000
        end if
    end for
    return and_bits(not_bits(crc),#FFFFFFFF)
end function

sequence crc_table

function crc32a(string s)
    if not object(crc_table) then // (ie not yet initialised)
        crc_table = repeat(0,256)
        for i=0 to 255 do
            atom rem = i
            for j=1 to 8 do
                bool bOdd = odd(rem)
                rem = floor(rem/2)
                if bOdd then
                    rem = xor_bitsu(rem,#EDB88320)
                end if
            end for
            crc_table[i+1] = rem
--printf(1,`%08x, `,rem)
        end for
--printf(1,"\n\n")

    end if
    atom crc = #FFFFFFFF
    for c in s do
        integer cdx = xor_bits(and_bits(crc,0xff),c)+1
--      crc = xor_bitsu(floor(crc/#100),crc_table[cdx])
        crc = xor_bits(floor(crc/#100),crc_table[cdx])
        if crc<0 then
            crc += #100000000
        end if
    end for
--  return not_bitsu(crc)
    return and_bits(not_bits(crc),#FFFFFFFF)
end function

integer pMemCRC4 = 0

--/*
