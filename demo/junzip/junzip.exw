    if pMemCRC4=0 then
        atom pMem = allocate(4*256)
        pMemCRC4 = pMem/4
        /* Calculate CRC table. */
        for i=0 to 255 do
            atom rem = i  /* remainder from polynomial division */
            for j=1 to 8 do
                if and_bits(rem,1) then
                    rem = xor_bits(floor(rem/2),#EDB88320)
                else
                    rem = floor(rem/2)
                end if
                if rem<0 then
                    rem += #100000000
                end if
            end for
            poke4(pMem,rem)
--printf(1,`%08x, `,rem)
            pMem += 4
        end for
--printf(1,"\n\n")
    end if
    leave_cs()
end procedure
--make_crc2()       -- (optional, may as well omit if crc32() is not always used)
--*/

--/*
function crc32b(string s)
--integer byte, c4
atom crc
--atom ti
 
    if pMemCRC4=0 then make_crc2() end if   -- (above omitted, or a forward call)

    crc = #FFFFFFFF
    for i=1 to length(s) do
--      byte = s[i]
--      c4 = and_bits(crc,0xff)
--      c4 = xor_bits(c4,byte)
--      ti = peek4u((pMemCRC4+c4)*4)
--      c4 = floor(crc/#100)
--      crc = xor_bits(c4,ti)
        crc = xor_bits(floor(crc/#100),peek4u(pMemCRC4*4+xor_bits(and_bits(crc,0xff),s[i])*4))
        if crc<0 then
            crc += #100000000
        end if
    end for
--  return not_bits(crc)
    return and_bits(not_bits(crc),#FFFFFFFF)
end function
--*/

function crc32c(string s)
    atom res
    integer len = length(s)
    if pMemCRC4=0 then
        enter_cs()
        if pMemCRC4=0 then
            atom pMem = allocate(4*256)
            pMemCRC4 = pMem/4
            /* Calculate CRC table. */
            for i=0 to 255 do
                atom rem = i  /* remainder from polynomial division */
                for j=1 to 8 do
                    if and_bits(rem,1) then
                        rem = xor_bits(floor(rem/2),#EDB88320)
                    else
                        rem = floor(rem/2)
                    end if
                    if rem<0 then
                        rem += #100000000
                    end if
                end for
                poke4(pMem,rem)
--printf(1,`%08x, `,rem)
                pMem += 4
            end for
--printf(1,"\n\n")
        end if
        leave_cs()

    end if

    #ilASM{
            mov esi, [s]
            xor edx, edx
            shl esi, 2
            or eax, -1
            mov edi,[pMemCRC4]
            mov ecx,[len]
            shl edi,2

        ::CRC32_loop
            mov dl, [esi]
            xor dl, al
            shr eax, 8
            xor eax, [edi+edx*4]
            add esi,1
            sub ecx,1
            jnz CRC32_loop

            not eax
            lea edi,[res]
            call :%pStoreMint   
    }
--   pop     edx
-- pop   ecx
-- pop   esi
-- ret
    return res
end function

