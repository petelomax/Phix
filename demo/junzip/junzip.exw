                    printf(1,"    ex_fa_lnx (external file attributes [lnx]): 0x%04X%s\n",{ex_fa_lnx,decode_lnx_ex_fa(ex_fa_lnx)});
                    printf(1,"    lh_offset (relative offset of local header): [%08X]\n", lh_offset);
                    printf(1,"    filename: %s\n", {filename});
end if
if and_bits(gpbf,#8800)=#8800 then ?{`unicode`,zt,filename} end if
                    integer dd_bit = and_bits(gpbf,#8), 
                            gpbf0 = gpbf-and_bits(gpbf,0b1000_1000_1110) -- minus utf8|dd|deflate used
--                  if vmb!=20 then printf(1,"Warning: vmb is %d\n",vmb) end if
                    if vnte!=20 and vnte!=10 and vnte!=11 and vnte!=0 then crash(`vnte=%d not supported`,vnte) end if
--                  if (gpbf-dd_bit)=2 then printf(1,"Warning: gpbf=#%04X\n",{gpbf}) 
--                  elsif (gpbf-dd_bit)!=0 then crash(`gpbf=#%04X not supported`,{gpbf}) end if
                    if gpbf0!=0 then crash(`gpbf=#%04X not supported`,{gpbf}) end if
                    if cm!=0 and cm!=8 then ?9/0 end if
if (not bDirectory) or (cs!=0) then
                    if cm=0 and cs!=ucs then ?9/0 end if
end if
                    if cdfcl!=0 then ?9/0 end if
                    if dns!=0 then ?9/0 end if
--                  if in_fa!=0 then ?9/0 end if
--                  if ex_fa!=0 then ?9/0 end if

if in_fa != #0001 then -- apparently ASCII or text (else binary)
                    if in_fa!=0 then printf(1,"Warning: in_fa is %04x\n",in_fa) end if
end if
-- hi word is linux, lobyte windows...
--                  if  ex_fa_win != #0000
--                  and ex_fa_win != #0001
--                  and ex_fa_win != #0002
--                  and ex_fa_win != #0010
--                  and ex_fa_win != #0011
--                  and ex_fa_win != #0012
--                  and ex_fa_win != #0020
--                  and ex_fa_win != #0021
--                  and ex_fa_win != #0022
--                  and ex_fa_win != #0026
--                  and ex_fa_win != #0027
--                  and ex_fa_win != #0030
--                  and ex_fa_win != #0031
--                  and ex_fa_win != #0080
--                  and ex_fa_win != #0220
--                  and ex_fa_win != #0221
--                  and ex_fa_win != #2000
--                  and ex_fa_win != #2002
--                  and ex_fa_win != #2010
--                  and ex_fa_win != #2011
--                  and ex_fa_win != #2020
--                  and ex_fa_win != #2021
--                  and ex_fa_win != #2022
--                  and ex_fa_win != #2026
--                  and ex_fa_win != #2027
--                  and ex_fa_win != #2030
--                  and ex_fa_win != #2221
--                  and ex_fa_win != #2820
--                  and ex_fa_win != #4000
--                  and ex_fa_win != #8020 then
--                      printf(1,"Warning: ex_fa_win is %04x\n",ex_fa_win)
--                  end if
--                  if  ex_fa_lnx != #0000
--                  and ex_fa_lnx != #0002
--                  and ex_fa_lnx != #0008
--                  and ex_fa_lnx != #0010
--                  and ex_fa_lnx != #0018
--                  and ex_fa_lnx != #0180
--                  and ex_fa_lnx != #01A4
--                  and ex_fa_lnx != #081A
--                  and ex_fa_lnx != #41B6
--                  and ex_fa_lnx != #41C0
--                  and ex_fa_lnx != #41E8
--                  and ex_fa_lnx != #41ED
--                  and ex_fa_lnx != #41EF
--                  and ex_fa_lnx != #41F8
--                  and ex_fa_lnx != #41FD
--                  and ex_fa_lnx != #41FF
--                  and ex_fa_lnx != #8124
--                  and ex_fa_lnx != #8180
--                  and ex_fa_lnx != #81A0
--                  and ex_fa_lnx != #81A4
--                  and ex_fa_lnx != #81A6
--                  and ex_fa_lnx != #81AD
--                  and ex_fa_lnx != #81B0
--                  and ex_fa_lnx != #81B4
--                  and ex_fa_lnx != #81B6
--                  and ex_fa_lnx != #81BC
--                  and ex_fa_lnx != #81C0
--                  and ex_fa_lnx != #81D9
--                  and ex_fa_lnx != #81E4
--                  and ex_fa_lnx != #81ED
--                  and ex_fa_lnx != #81ED
--                  and ex_fa_lnx != #81FD
--                  and ex_fa_lnx != #81FF
--                  and ex_fa_lnx != #A1FF then
--                      printf(1,"Warning: ex_fa_lnx is %04x\n",ex_fa_lnx)
--                  end if

                    --
                    -- Local file header (lfh/lh):
                    --
                    --  typedef struct { /*packed*/                                                     offset  size 
                    --      x4 signature;               // x"504B0304"                                       0  4
                    --      uint16 lhvnte;              // (version needed to extract)      unsupported      4  2
                    --      uint16 lhgpbf;              // (general purpose bit flag)       unsupported      6  2
                    --      uint16 lhcm;                // (compression method)                              8  2 
                    --      uint16 lhlmft;              // (last modified file time)                        10  2 
                    --      uint16 lhlmfd;              // (last modified file date)                        12  2 
                    --      uint32 lhcrc32;                                                                 14  4 
                    --      uint32 lhcs;                // (compressed size)                                18  4 
                    --      uint32 lhucs;               // (uncompressed size)                              22  4 
                    --      uint16 lhfnl;               // (file name length)                               26  2 
                    --      uint16 lhxfl;               // (extra field length)             unsupported     28  2 
                    --  } lfh;
                    --
                    --    file name (variable size)                                                         30
                    --    extra field (variable size)                                                       30+n
                    --
                    --      <data>
                    --
                    -- General purpose bit flag:
                    --  Bit 00: encrypted file              -- #0001    x
                    --  Bit 01: compression option          -- #0002    x
                    --  Bit 02: compression option          -- #0004    x
                    --  Bit 03: data descriptor             -- #0008    ok
                    --  Bit 04: enhanced deflation          -- #0010    x
                    --  Bit 05: compressed patched data     -- #0020    x
                    --  Bit 06: strong encryption           -- #0040    x
                    --  Bit 07-10: unused
                    --  Bit 11: language encoding           -- #0800    ok 
                    --  Bit 12: reserved
                    --  Bit 13: mask header values          -- #2000    x
                    --  Bit 14-15: reserved
                    --
                    -- Aside: I have assumed that bits 1 and 2 are info-only and can safely be ignored.
                    --        For cm==8: 00=Normal, 01=Maximum, 10=Fast, 11=Super Fast (was used).
                    --        Likewise #0800 just indicates that filenames and comments are UTF-8.
                    --        Also, gpbf bit #8 is only useful in the central directory for corruption 
                    --        checks and only actually used here, on the local file header, as follows:

                    -- Data descriptor (dd): -- if gpbf && #8 bit set
                    --
                    --  typedef struct { /*packed*/                                                     offset  size 
                    --     [x4 signature;               // x"504B0708"                                       0  4] (optional)
                    --      uint32 ddcrc32;                                                                0/4  4 
                    --      uint32 ddlhcs;              // (compressed size)                               4/8  4 
                    --      uint32 lhucs;               // (uncompressed size)                            8/12  4 
                    --  } dd;
                    --
                    -- Aside: my understanding of the data descriptor is this:
                    --  zip files are read/written "backwards", the central directory already has all the
                    --  fields (including filename) so their presence on the local file header is only useful
                    --  for file corruption checking. When they're not known at lfh write-time, those checks
                    --  are replaced with something from a little later on in the file (and lfh are zero).
                    --
                    lh_offset += 1
                    sig = binary[lh_offset..lh_offset+3]
                    assert(sig==x"504B0304")
--                  integer lhvnte = get_num(binary,lh_offset+4,2),  -- version needed to extract
                    integer lhvnte = get_num(binary,lh_offset+4,1),  -- version needed to extract
                            lhgpbf = get_num(binary,lh_offset+6,2),  -- general purpose bit flag
                              lhcm = get_num(binary,lh_offset+8,2),  -- compression method
                            lhlmft = get_num(binary,lh_offset+10,2), -- last modified file time
                            lhlmfd = get_num(binary,lh_offset+12,2), -- last modified file date
                              lhcs = get_num(binary,lh_offset+18,4), -- compressed size
                             lhucs = get_num(binary,lh_offset+22,4), -- uncompressed size
                             lhfnl = get_num(binary,lh_offset+26,2), -- file name length
                             lhxfl = get_num(binary,lh_offset+28,2)  -- extra field length
                    atom lhcrc32 = get_num(binary,lh_offset+14,4)
                    string lhfilename = binary[lh_offset+30..lh_offset+30+fnl-1]
                    if dd_bit then
--                      if lhcs!=0 then ?9/0 end if
--                      if lhucs!=0 then ?9/0 end if
                        if lhcs!=0 and lhcs!=cs then ?9/0 end if
                        if lhucs!=0 and lhucs!=ucs then ?9/0 end if
--                      if lhcrc32!=0 then ?9/0 end if
                        if lhcrc32!=0 and lhcrc32!=crc_32 then ?9/0 end if
--                      integer dd_offset = lh_offset+30+lhfnl+cs
                        integer dd_offset = lh_offset+30+lhfnl+lhxfl+cs
                        string ddsig = binary[dd_offset..dd_offset+3]
                        if ddsig=x"504B0708" then dd_offset += 4 end if
                        lhcrc32 = get_num(binary,dd_offset,4)
                        lhcs = get_num(binary,dd_offset+4,4)
                        lhucs = get_num(binary,dd_offset+8,4)
                    end if
                    if lhvnte!=vnte then ?9/0 end if
                    if lhgpbf!=gpbf then ?9/0 end if
                    if lhcm!=cm then ?9/0 end if
                    if lhlmft!=lmft then ?9/0 end if
                    if lhcs!=cs then ?9/0 end if
                    if lhucs!=ucs then ?9/0 end if
                    if lhfnl!=fnl then ?9/0 end if
                    if lhcrc32!=crc_32 then ?9/0 end if
                    if lhfilename!=filename then ?9/0 end if
if bDump then
                    printf(1,"Local file header for \"%s\" (%d compressed bytes, flag %d)\n", {filename, lhcs, lhgpbf});
--                  printf(1,"    signature: 0x%08X\n", lh.signature);
                    printf(1,"    lhvnte (version needed to extract): %d\n", lhvnte);
                    printf(1,"    lhgpbf (general purpose bit flag): 0x%08x%s\n",{lhgpbf,decode_gpbf(lhgpbf,lhcm)});
                    printf(1,"    lhcm (compression method): %d%s\n",{lhcm,decode_compression_method(lhcm)});
                    printf(1,"    lhlmft (last modified file time): %s\n", int16_to_time(lhlmft))
                    printf(1,"    lhlmfd (last modified file date): %s\n", int16_to_date(lhlmfd))
                    printf(1,"    lhcrc32: 0x%08X\n", lhcrc32);
                    printf(1,"    lhcs (compressed size): %d\n", lhcs);
                    printf(1,"    lhucs (uncompressed size): %d\n", lhucs);
                    printf(1,"    lhfnl (file name length): %d\n", lhfnl);
                    printf(1,"    lhxfl (extra field length): %d\n", lhxfl);
end if
--                  cd_offset += 46+fnl
                    cd_offset += 46+fnl+xfl
                    if bPause then
                        printf(1,"%s (%d/%d)...",{zt,i,l})
                        wait_key()
                        puts(1,"\n")
                        bPause = false
                    end if
                end for
            end if
        end if
        binary = ""
    end for
    printf(1,"         \r")
end procedure
process_zips()
