--?zt
        --
        -- End of central directory record (EOCDR):
        --
        --  typedef struct { /*packed*/                                              size offset
        --      x4 signature;       // x"504B0506"                                      4   0
        --      uint16 dn;          // (disk number)                    unsupported     2   4
        --      uint16 cdn;         // (central directory disk number)  unsupported     2   6
        --      uint16 netd;        // (num entries this disk)          unsupported     2   8
        --      uint16 tne;         // (total num entries)                              2  10
        --      uint32 cd_size;     // (central directory size)                         4  12
        --      uint32 cd_offset;   // (central directory offset)                       4  16
        --      uint16 zfcl;        // (zip file comment length)                        2  20
        --      // Followed by zip file comment (variable size)                         "  22
        --  } eocdr;
        --
        integer eocdr = rmatch(x"504B0506",binary) -- signature
        if eocdr=0 then
            ?{zt,`NOT A ZIP`}
        else
--          string cdr = binary[eocdr..$]   -- (debug aid)
            integer dn = get_num(binary,eocdr+4,2),     -- disk number
                   cdn = get_num(binary,eocdr+6,2),     -- central directory disk number
                  netd = get_num(binary,eocdr+8,2),     -- num entries this disk
                   tne = get_num(binary,eocdr+10,2),    -- total num entries
                  zfcl = get_num(binary,eocdr+20,2),    -- ZIP file comment length
              filesize = length(binary),
              disksize = sizes[t]
            atom cd_size = get_num(binary,eocdr+12,4),      -- size of the central directory
               cd_offset = get_num(binary,eocdr+16,4)       -- offset of start of central directory
            assert(filesize==disksize)
--          assert((tne=0 and eocdr=1) or eocdr+22+zfcl=filesize)
            if eocdr+22+zfcl-1!=filesize then
--              printf(1,"%s: Warning - netd(%d)!=tne(%d)\n",{zt,netd,tne})
                ?{zt,`headers error`,filesize-(eocdr+22+zfcl-1),tne,eocdr}
            elsif dn!=0 or cdn!=0 or tne!=netd then
                ?{zt,`Multipart zip`}
            elsif tne=#FFFF or cd_offset=#FFFFFFFF or cd_size=#FFFFFFFF then
                ?{zt,`ZIP64`}
    // Every entry occupies at least sizeof(cdfh) bytes.
--          else tne * sizeof(cdfh) > cd_size then

            else
                string comment = binary[eocdr+22..$]
                integer lc = length(comment)
                if lc=40 and filter(comment,`out`,`0123456789abcdef`,"")="" then
                    -- ignore any meaningless (to us) 40-char guuids
                    comment = ""
                    lc = 0
                end if
                if bDump then
                    if lc then comment = `[`&comment&`] ` end if
                    printf(1,"%s %s(%d/%d)\n",{zt,comment,i,l})
                    printf(1,"    dn (disk number): %d\n", dn);
                    printf(1,"    cdn (central directory disk number): %d\n", cdn);
                    printf(1,"    netd (num entries this disk): %d\n", netd);
                    printf(1,"    tne (total num entries): %d\n", tne);
                    printf(1,"    cd_size (central directory size): %d\n", cd_size);
                    printf(1,"    cd_offset (central directory offset): [%08X]\n", cd_offset);
                    printf(1,"    zfcl (zip file comment length): %d\n", zfcl);
                elsif time()>=t0 then
                    printf(1,"%d/%d\r",{i,l})
                    t0 = time()+0.25
                end if
                --
                -- Central directory file header (cdfh/cfh):
                --
                --  typedef struct { /*packed*/                                                     offset  size 
                --      x4 signature;               // x"504B0102"                                       0  4
                --      uint8  vmb;                 // (version made by)                unsupported      4  1
                --      uint8  osmo;                // (os made on 0/3/11=Dos/Lnx/Win)  unsupported      5  1
                --      uint16 vnte;                // (version needed to extract)      unsupported      6  2
                --      uint16 gpbf;                // (general purpose bit flag)       unsupported      8  2
                --      uint16 compression_method;                                                      10  2 
                --      uint16 lmft;                // (last modified file time)                        12  2 
                --      uint16 lmfd;                // (last modified file date)                        14  2 
                --      uint32 crc32;                                                                   16  4 
                --      uint32 compressed_size;                                                         20  4 
                --      uint32 uncompressed_size;                                                       24  4 
                --      uint16 fnl;                 // (file name length)                               28  2 
                --      uint16 xfl;                 // (extra field length)             unsupported     30  2 
                --      uint16 cdfcl;               // (file comment length)            unsupported     32  2 
                --      uint16 dns;                 // (disk number start)              unsupported     34  2 
                --      uint16 in_fa;               // (internal file attributes)       unsupported     36  2 
