--*/
bool bDump = true,
     bPause = false

--/*
Flags   General purpose bit flag:
Bit 00: encrypted file
Bit 01: compression option
Bit 02: compression option
Bit 03: data descriptor
Bit 04: enhanced deflation
Bit 05: compressed patched data
Bit 06: strong encryption
Bit 07-10: unused
Bit 11: language encoding
Bit 12: reserved
Bit 13: mask header values
Bit 14-15: reserved
--*/
function decode_gpbf(integer gbpf, cm)
    sequence res = {}
    if gbpf&&0b01 then
        res &= {`enc`}
        gbpf -= 0b01
    end if
    integer co = gbpf&&0b0110
    if cm=8 then
        res &= {{`normal`,`maximum`,`fast`,`super fast`}[co/2+1]}
    end if
    gbpf -= co
    if gbpf&&0b1000 then
        res &= {`dd`}
        gbpf -= 0b1000
    end if
    integer utf8 = gbpf&&0x8800
    if utf8=0x8800 then
        res &= {`utf8`}
        gbpf -= utf8
    elsif utf8=0x0800 then
        -- see 0x4690 in the extra field, I think
        res &= {`lang`}
        gbpf -= utf8
    elsif utf8=0x8000 then
        -- wrong and meaningless, but fairly common
        res &= {`#8000, utf8-wrongly`}
        gbpf -= utf8
    end if
    if gbpf then
        res &= {sprintf(`0x%04x`,gbpf)}
        bPause = true
    end if
    if length(res) then
        return sprintf(` (%s)`,{join(res,'+')})
    end if
    return ""
end function

function decode_compression_method(integer cm)
    if cm=0 then return ` (stored)` end if
    if cm=8 then return ` (deflate)` end if
    return ` (**UNSUPPORTED**)`
end function

--/*
Internal file attributes:
Bit 0: apparent ASCII/text file
Bit 1: reserved
Bit 2: control field records precede logical records
Bits 3-16: unused
--*/
function decode_in_fa(integer fa)
    sequence res = {}
    if fa&&0x01 then
        res &= {`text`}
        fa -= 0x01
    end if
    if fa then
        res &= {sprintf(`0x%04x`,fa)}
        bPause = true
    end if
    if length(res) then
        return sprintf(` (%s)`,{join(res,'+')})
    end if
    return ""
end function

--/*
Bit     Hex Mask        Attribute       Meaning Phix Check Example
0       0x01    Read-only       File cannot be modified and(ext_attr, 1) != 0
1       0x02    Hidden  File is hidden from default directory listings  and(ext_attr, 2) != 0
2       0x04    System  File is a system file (e.g., IO.SYS, MSDOS.SYS) and(ext_attr, 4) != 0
3       0x08    Volume Label    Only valid for directory entries (marks the volume label directory)     Rarely set; ignore for file/dir checks
4       0x10    Directory       Entry is a directory (critical for your use case)       and(ext_attr, 16) != 0 → TRUE = directory
5       0x20    Archive File has changed since last backup (used by BACKUP/XCOPY)       and(ext_attr, 32) != 0
6–7     0xC0    Reserved        Should be 0 (ignore; may be set by non-standard tools)  and(ext_attr, 192) == 0 (valid if zero)
--DEV see also deflate.c
--*/
function decode_win_ex_fa(integer fa)--, osmo)
    sequence res = ""
    -- discard NTFS-specific bits 16..31:
--  if osmo=11 then fa = and_bits(fa,#FFFF) end if
--  -- bits 8..15 are **not safely portable**
    fa = and_bits(fa,#FF)
    if fa&&0x01 then res &= `R` fa -= 0x01 end if
    if fa&&0x02 then res &= `H` fa -= 0x02 end if
    if fa&&0x04 then res &= `S` fa -= 0x04 end if
    if fa&&0x10 then res &= `D` fa -= 0x10 end if
    if fa&&0x20 then res &= `A` fa -= 0x20 end if
    if fa then
        string plus = iff(length(res)?"+":"")
        res &= sprintf(`%s0x%02x`,{plus,fa})
        bPause = true
    end if
    if length(res) then
        return sprintf(` (%s)`,{res})
    end if
    return ""
end function

--/*
#define S_IFMT  #F000
#define S_IFSOCK #C000
#define S_IFLNK  #A000
--#define S_IFREG  #8000
#define S_IFBLK  #6000
#define S_IFDIR  #4000
#define S_IFCHR  #2000  -- symlink?
#define S_IFIFO  #1000
#define S_ISUID  #0800
#define S_ISGID  #0400
#define S_ISVTX  #0200

#define S_ISLNK(m)      (((m) & S_IFMT) == S_IFLNK)
#define S_ISREG(m)      (((m) & S_IFMT) == S_IFREG)
#define S_ISDIR(m)      (((m) & S_IFMT) == S_IFDIR)
#define S_ISCHR(m)      (((m) & S_IFMT) == S_IFCHR)
#define S_ISBLK(m)      (((m) & S_IFMT) == S_IFBLK)
#define S_ISFIFO(m)     (((m) & S_IFMT) == S_IFIFO)
#define S_ISSOCK(m)     (((m) & S_IFMT) == S_IFSOCK)

#define S_IRWXU #01C0
#define S_IRUSR #0100
#define S_IWUSR #0080
#define S_IXUSR #0040

#define S_IRWXG #0038
#define S_IRGRP #0020
#define S_IWGRP #0010
#define S_IXGRP #0008

#define S_IRWXO #0007
#define S_IROTH #0004
#define S_IWOTH #0002
#define S_IXOTH #0001
#81A4
--*/
constant S_IFMT  = 0xF000, // Lnx file type mask)
         S_IFCHR = 0x2000, // Character special (symlink)
         S_IFDIR = 0x4000, // "" directory
         S_IDRWX = 0x61FF, // ""+permissions
         S_IFREG = 0x8000  // regular

function decode_lnx_ex_fa(integer fa)
    sequence res = {}
    integer drwx = fa&&S_IDRWX
    if fa&&S_IDRWX then
        string d = `-`
        if fa&&S_IFDIR then
            d = `d`
            fa -= S_IFDIR
            drwx -= S_IFDIR
        elsif fa&&S_IFCHR then
            d = `l`
            fa -= S_IFCHR
            drwx -= S_IFCHR
            bPause = true -- (not supported!)
        end if
        if drwx then
            integer ddx = 2, rwdx = 1, m = 0x0100
            d &= repeat('-',9)
            for ogo=1 to 3 do -- owner,group,others
                for rwx=1 to 3 do -- read,write,execute
                    if drwx&&m then d[ddx] = `rwx`[rwdx] end if
                    rwdx = rmdr(rwdx,3)+1
                    ddx += 1
                end for
            end for
        end if
        fa -= drwx
        res &= {d}
    end if
    if fa&&S_IFREG then
        fa -= S_IFREG
    end if
    if fa then
        res &= {sprintf(`0x%04x`,fa)}
        bPause = true
    end if
    if length(res) then
        return sprintf(` (%s)`,{join(res,'+')})
    end if
    return ""
end function

procedure process_zips()
    atom t0 = time()+0.25
    for i,t in tags to 8 do
--  for i,t in tags to 1898 do
--  for i,t in tags do
--  for i,t in tags from 3540 do
