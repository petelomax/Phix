                --      uint16 ex_fa_lnx;           // (external file attributes [lnx]) unsupported     40  2 
                --      uint32 lh_offset;           // (relative offset of local header)                42  4 
                --  } cdfh;
                --
                --      file name (variable size)                                                       46
                --      extra field (variable size)                                                     46+n
                --      file comment (variable size)                                                    46+n+m
                --
                --  Aside: quite why vnte [re-?]specifes the os made on rather defeats me.
                --
                cd_offset += 1 
                for f=1 to tne do
                    string sig = binary[cd_offset..cd_offset+3]
                    assert(sig==x"504B0102")
                    integer vmb = get_num(binary,cd_offset+4,1),     -- version made by
                           osmo = get_num(binary,cd_offset+5,1),     -- operating system made on
--                         vnte = get_num(binary,cd_offset+6,2),     -- version needed to extract
                           vnte = get_num(binary,cd_offset+6,1),     -- version needed to extract
                           gpbf = get_num(binary,cd_offset+8,2),     -- general purpose bit flag
                             cm = get_num(binary,cd_offset+10,2),    -- compression method
                           lmft = get_num(binary,cd_offset+12,2),    -- last modified file time
                           lmfd = get_num(binary,cd_offset+14,2),    -- last modified file date
                             cs = get_num(binary,cd_offset+20,4),    -- compressed size
                            ucs = get_num(binary,cd_offset+24,4),    -- uncompressed size
                            fnl = get_num(binary,cd_offset+28,2),    -- file name length
                            xfl = get_num(binary,cd_offset+30,2),    -- extra field length
                          cdfcl = get_num(binary,cd_offset+32,2),    -- file comment length
                            dns = get_num(binary,cd_offset+34,2),    -- disk number start
                          in_fa = get_num(binary,cd_offset+36,2),    -- internal file attributes
                      lh_offset = get_num(binary,cd_offset+42,4)     -- relative offset of local header
                    atom crc_32 = get_num(binary,cd_offset+16,4),
--                        ex_fa = get_num(binary,cd_offset+38,4)     -- external file attributes
                      ex_fa_win = get_num(binary,cd_offset+38,2),    -- external file attributes [win]
                      ex_fa_lnx = get_num(binary,cd_offset+40,2)     -- external file attributes [lnx]
