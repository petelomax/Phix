--
-- Split the aircraft into sets of nested convex hulls.
-- Why convex hulls, you may well ask: well, consider a side cabin window and the wing, and 
-- using the centres of both to determine depth order. From above, it is easy to imagine
-- tilting the wing until its centre is below that of the window, and end up drawing the
-- window on top of the wing. Now imagine the wing stops where it meets the window, and
-- suddenly (at that and similar angles) it no longer matters whether the window is drawn
-- before or after the wing(/roof), and that is an unbreakable property of convex hulls.
-- Perhaps you might compare the centre of the window against where it meets the wing, but
-- then you'd want to compare that against where it meets the rear and front windows: soon
-- you'd quickly end up needing different sub-orderings for every possible subset of parts.
-- (And in fact need many more such made-up points than the convex hull approach does, not
--  to mention each would be panel-specific vs. a re-usable point on our logical cuboid.)
--
-- Another common pitfall occurs when using the average z-depth of each panel's vertices:
-- a   Where abe is on the z=0 line and cd is parallel to that but a little further away.
-- bc  Triangle abc has a z-depth of (c-b)/3, bcde (c-b)/2, and bcd (c-b)*2/3, which is
-- ed  almost guaranteed to cause parallax and similar issues, which all quietly go away
-- when each face is mapped to a single point on a control cubiod, even if all such are
-- relative to each other for each ch-set rather than actually properly aircraft-whole.
--
-- The outermost split is (nose), ((cabin)+wings+struts), ((fuselage)+tail_fins), which
-- will always be drawn in either 1-2-3 or 3-2-1 order, ie furthest away first.
-- The nose is already a convex hull so that can simply be drawn depth-first as well.
-- For the mid-section, we consider the cabin as a whole as a single point in the centre
-- of its base against the wings and struts, and draw those five pieces depth-first.
-- Like the nose, the main cabin body is a convex hull and again depth-first suffices
-- (with the tiny tweak of making the window glass 1 pixel outside the door frames).
-- Lastly for the tail section we consider the fuselage a single point compared to the
-- three fins, and the four sides of the fuselage against each other at a deeper level.
-- Update: fuselage now split upper/lower to eliminate last(-1) glitch in painters algo.
-- Update2: the new OT/OM/OB points might have made that split completely unnecessary.
-- Using convex hulls makes the painter's algorithm almost completely foolproof (flw).
-- As a bonus, a single depth ordering (including a small handful of made-up points)
-- suffices all the way down (obviously ignoring irrelevant parts for each piece).
--
constant DRAW_ORDER = {
    -- Each node of this tree is either {{depth},{node}}, or a
    -- flat set of panel-ids or an integer (equivalent to {i}).
    -- Note a panel-id may refer to several, eg frame & glass.
    -- See the procedure draw_in_depth_first_order() for use.
    {F,C,R},
    {{FNOSE,SNOSE,PNOSE,TNOSE,BNOSE},
     {{PW,SW,PS,SS,B},{PWING,SWING,PSTRUT,SSTRUT,
                       {SBCAB,BLOOR,REARWINDOW,SCAB,SGLASS,ROOF,
                        PBCAB,FLOOR,WINDSCREEN,PCAB,PGLASS}}},
     {{OT,P,OM,S,OB},{FIN,PORT_FIN,{TPTAIL,TTAIL,TSTAIL},
                          STAR_FIN,{BPTAIL,BTAIL,BSTAIL}}}}}

sequence vertices, -- rotated VERTICES (unsorted) as set by draw()
         vcorder, -- sorted idx of ""[1..SR] (our virtual cuboid)
         ptags -- depth-first ordered tagset(length(POLYGONS)),"".

bool bCull = false -- (toggled by 'C')

function anti_clockwise(sequence poly, integer id)
if find(id,{FIN,STAR_FIN,PORT_FIN,PWING,SWING,PSTRUT,SSTRUT}) then ?9/0 end if
--?{"ac",length(poly)}
--{"ac",3}
--{"ac",4}
--{"ac",5}
--{"ac",6}
    return length(poly)=0 -- (always false)
end function

procedure draw_in_depth_first_order(gdx canvas, object order)

    if sequence(order) and sequence(order[1]) then
        -- {{depth},{node}} case
        assert(length(order)=2)
        sequence depth = order[1]
        order = order[2]
        integer l = length(order)
        assert(length(depth)==l)
        integer done = 0
        for v in vcorder do
            integer k = find(v,depth)
            if k then
                draw_in_depth_first_order(canvas,order[k])
                done += 1
            end if
        end for
        assert(done==l)
    else
        if integer(order) then order = {order} end if
        integer mask = 0, bit
        for o in order do
            bit = power(2,o-1)
            if and_bits(mask,bit) then ?9/0 end if
            mask += bit 
        end for
        sequence did = {}
        for pdx in ptags do
            integer id = POLYGONS[pdx][ID]
            bit = power(2,id-1)
            if and_bits(bit,mask) then
                sequence poly = {}
                for vdx in POLYGONS[pdx][POINTS] do
                    poly = append(poly,vertices[vdx][X..Y])
                end for
if (not bCull) or length(order)=1 or (not anti_clockwise(poly,id)) then
                gDrawPolygon(canvas,poly,bFill,POLYGONS[pdx][COLOUR])
end if
                did &= id
            end if
        end for
        assert(length(unique(did))==length(order))
    end if
end procedure

function transpose(sequence points, atom dx, dy, dz)
    -- shift all points left/right/up/down/fwd/back or all three
    -- no rotation of any kind occurs
    sequence res = {} 
    for p in points do
        atom {x,y,z} = p
        res = append(res,{x+dx,y+dy,z+dz})
    end for
    return res
end function

atom scale = 1
sequence currentOrientation = {1,0,0,0} -- identity quaternion (no rotation)

procedure redraw(gdx canvas, integer width, height)

    integer lv = length(VERTICES),
            lp = length(POLYGONS),
            cx = floor(width/2),
            cy = floor(height/2)

    atom {w, x, y, z} = currentOrientation,
         m11 = 1 - 2*y*y - 2*z*z,
         m12 =     2*x*y - 2*w*z,
         m13 =     2*x*z + 2*w*y,
         m21 =     2*x*y + 2*w*z,
         m22 = 1 - 2*x*x - 2*z*z,
         m23 =     2*y*z - 2*w*x,
         m31 =     2*x*z - 2*w*y,
         m32 =     2*y*z + 2*w*x,
         m33 = 1 - 2*x*x - 2*y*y,
         yaw = arcsin(max(min(2*(w*y-z*x),1),-1))*TG_RAD2DEG,
         pitch = -atan2(2*(w*z+x*y),1-2*(y*y+z*z))*TG_RAD2DEG,
         roll = -atan2(2*(w*x+y*z),1-2*(x*x+y*y))*TG_RAD2DEG

    gDrawText(canvas,10,10,"↔ yaw:%f, ↕ pitch:%f, ± roll:%f (quaternion-derived)",{yaw,pitch,roll})
    -- ^ yaw/pitch/roll (global-space aka spectator-eye view) are derived from the quaternion that
    -- the keyboard actually affects (in local-space aka pilot-eye view), hence at some angles a
    -- single key may alter all three and not the one you might have been expecting, sometimes it
    -- jumps sharply at certain boundaries, but the effect said keys have on the aircraft itself 
    -- should always look and feel quite natural and smooth. Also, Euler angles have ambiguity.

    vertices = transpose(VERTICES[1..lv],-400,-280,0)
    for i,v in vertices do
        {x,y,z} = v
        vertices[i] = {(m11*x + m12*y + m13*z)*scale,
                       (m21*x + m22*y + m23*z)*scale,
                       (m31*x + m32*y + m33*z)*scale}
    end for
    vertices = transpose(vertices,cx,cy,0)

    -- Painter's algorithm – on steroids!
    vcorder = custom_sort(vslice(vertices[1..SR],Z),tagset(SR))
    ptags = vslice(extract(vertices,vslice(POLYGONS,DEPTH)),Z)
    ptags = custom_sort(ptags,tagset(lp))
    draw_in_depth_first_order(canvas,DRAW_ORDER)
end procedure

procedure key_handler(gdx dlg, integer c, bool ctrl)
    c = upper(c)
    integer k = find(c,{'+','-',VK_RIGHT,VK_LEFT,VK_UP,VK_DOWN,'S','T','B','P'})
    if k>6 then
        atom c45 = cos(45*TG_DEG2RAD) // == sin(45) == sqrt(2)/2
        currentOrientation = {{1,0,0,0}, -- starboard view
                              {c45,-c45,0,0}, --  top view
                              {c45,c45,0,0},  -- base view
                              {0,0,1,0}}[k-6] -- port view
    elsif k then
        if ctrl then
            if c='-' then scale /= 1.1 end if
            if c='+' then scale *= 1.1 end if
        else
            integer axis = (k+odd(k))/2
            atom rotation_speed = 0.025, // Radians per frame
                 halfAngle = (1-2*odd(k))*rotation_speed,
                 {cw,cx,cy,cz} = currentOrientation,
                 dw = cos(halfAngle), 
                 {dx,dy,dz} = reinstate({0,0,0},axis,sin(halfAngle)),
                 nw = cw*dw - cx*dx - cy*dy - cz*dz,
                 nx = cw*dx + cx*dw + cy*dz - cz*dy,
                 ny = cw*dy - cx*dz + cy*dw + cz*dx,
                 nz = cw*dz + cx*dy - cy*dx + cz*dw,
                 l = sqrt(nw*nw + nx*nx + ny*ny + nz*nz);
            currentOrientation = {nw/l,nx/l,ny/l,nz/l}
        end if
    elsif c='C' then
        bCull = not bCull
    elsif c='W' then
        bFill = not bFill -- normal <==> wireframe
    elsif c='Q' then
--      currentOrientation = {0.7361856106,0.0049998696,0.6723252599,0.0773595045}
        currentOrientation = {0.6650709708,-0.3157132492,0.5717446139,0.3620964574} // key '-'
--      currentOrientation = {0.1609284521,-0.9751443658,-0.1085524179,0.1068263629}
--      currentOrientation = {0.9728893,-0.2188286392,0.0729497548,0.0166964021} // key '+' [FIXED]

    elsif c='!' then
        ?9/0 -- to debug, uncomment and hit ! when wrong, paste into Q for repeatability
    end if
    gRedraw(dlg)
end procedure

gdx canvas = gCanvas(redraw,`BGCLR=PARCHMENT`),
    dialog = gDialog(canvas,TITLE,`SIZE=800x560`)
gSetHandler(dialog,`KEY`,key_handler)
gMainLoop(dialog)

