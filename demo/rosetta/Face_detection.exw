--
-- demo\rosetta\Face_detection.exw
-- ===============================
--
--  Uses the same strategy as Wren, ie run python facedetect2.py <img>, which is
--  facedetect.py lightly modified so it runs on Windows, then draw the results.
--
--  Simply drag and drop an image file onto the main window.
--
requires(`1.0.6`) -- (not yet shipped)
requires(WINDOWS) -- (others may follow)
include theGUI.e
gdn img = NULL
sequence faces = {}

procedure redraw(gdx canvas, integer cw, ch)
    if img then
        gDrawImage(img,canvas,10,10)
        for f in faces do
            integer {x,y,w,h} = f; x += 10; y += 10;
            gDrawRect(canvas,x,y,x+w,y+h,colour:=TG_YELLOW)
        end for
    else
        gDrawText(canvas,cw/2,ch/2,"drop image here",{},TG_C)
    end if
end procedure

include builtins\pipeio.e

procedure drop(gdx dlg, string filename)
    gSetGlobal(`CLIPIMG`,NULL)
    gSetGlobal(`CLIPIMGFILE`,filename)
    img = gGetGlobal(`CLIPIMG`)
    if img then
        string cmd = sprintf(`python facedetect2.py "%s"`,{filename})
        faces = {}
        for face in apply(split(read_stdin_pipe(cmd),'\n'),trim) do
            faces = append(faces,apply(split(face,' '),to_integer))
        end for
        integer {w,h} = gGetAttribute(img,`SIZE`)
        gSetAttribute(dlg,`SIZE`,{w+20+2,h+20+32})
    end if
end procedure

gdx canvas = gCanvas(redraw,"BGCLR=LIGHT_PARCHMENT"),
    dialog = gDialog(canvas,`Face detection`,`SIZE=240x80`)
gSetHandler(dialog,`DROP`,drop)
gShow(dialog,50,50)
gMainLoop()
--/*

Because opencv-contrib-python version 5 is currently bugged, you have two ways to fix this.
Option 1: Downgrade OpenCV (Recommended)The absolute easiest and cleanest solution is to step 
back to the stable OpenCV 4.x branch, which fully includes all the missing .xml classifiers natively.
Open your Command Prompt and run this command:
pip uninstall -y opencv-python opencv-contrib-python opencv-python-headless
pip install opencv-contrib-python==4.13.0.92

python facedetect.py --cascade="%USERPROFILE%\AppData\Local\Programs\Python\Python311\Lib\site-packages\cv2\data\haarcascade_frontalface_alt2.xml" path\to\image.jpg
python facedetect.py --cascade="%USERPROFILE%\AppData\Local\Programs\Python\Python311\Lib\site-packages\cv2\data\haarcascade_frontalface_alt2.xml" AOBABA176.jpg
python facedetect.py --cascade "%USERPROFILE%\AppData\Local\Programs\Python\Python311\Lib\site-packages\cv2\data\haarcascade_frontalface_alt2.xml" AOBABA176.jpg
                               C:\Users\petel\AppData\Local\Programs\Python\Python312\Lib\site-packages\cv2\data


usage: facedetect.py [-h] [--biggest] [--best] [-c] [--data-dir DIRECTORY] [-q] [-s FILE] [--search-threshold PERCENT]
                     [-o OUTPUT] [-d]
                     file
