--
-- demo\rosetta\OpenGL_Sierpinski_sponge.exw
-- =========================================
--
--  Translation of https://rosettacode.org/wiki/Sierpinski_sponge#FreeBASIC
--  Converted to theGUI by Pete Lomax
--
--{{trans|FreeBASIC}}
--This can be run online <here>, and also works on desktop/Phix
requires(`1.0.6`) -- (not yet shipped)
without javascript -- (shd be when "")
include theGUI.e

constant fragment_shader = `
#version 300 es
precision mediump float;
in vec3 vColor;
out vec4 fragColor;
void main() {
    fragColor = vec4(vColor, 1.0);
}`,      vertex_shader = `
#version 300 es
layout(location = 0) in vec3 aPos;
layout(location = 1) in vec3 aNormal;
uniform mat4 uModel;
uniform mat4 uView;
uniform mat4 uProjection;
uniform vec3 uLightPosWorld;   // (10,10,10) in world space
out vec3 vColor;
void main() {
    // ---- world space ----
    vec4 worldPos = uModel * vec4(aPos, 1.0);
    vec3 normalWorld = normalize(mat3(uModel) * aNormal);

    // ---- lighting (no specular) ----
    const vec3 ambientLight = vec3(0.2,0.2,0.2);
    const vec3 diffuseLight = vec3(0.8,0.8,0.8);
    const vec3 ambientMaterial = vec3(0.2,0.2,0.2);
    const vec3 diffuseMaterial = vec3(0.8,0.8,0.8);

    vec3 lightDir = normalize(uLightPosWorld - worldPos.xyz);
    float diff = max(dot(normalWorld, lightDir), 0.0);
    vec3 ambient = ambientLight * ambientMaterial;
    vec3 diffuse = diffuseLight * diffuseMaterial * diff;
    vColor = ambient + diffuse;

    // ---- clip space ----
    vec4 eyePos = uView * worldPos;
    gl_Position = uProjection * eyePos;
}`

function compile_shader(string shader_source, integer stype)
    if not begins(`#version`,shader_source," \t\r\n") then
        shader_source = "#version 100\n" & shader_source
    end if
    integer shader = glCreateShader(stype)
    glShaderSource(shader, shader_source)
    glCompileShader(shader)
    return shader
end function

/* ==================================================================
    Cube geometry (unit cube, half-size = 0.5) with per-face normals
   ================================================================== */
constant cubePositions = {
  // Front (+z)  normal (0,0,1)
  -0.5, -0.5,  0.5,   0, 0, 1,
   0.5, -0.5,  0.5,   0, 0, 1,
   0.5,  0.5,  0.5,   0, 0, 1,
  -0.5,  0.5,  0.5,   0, 0, 1,

  // Back (-z)   normal (0,0,-1)
   0.5, -0.5, -0.5,   0, 0,-1,
  -0.5, -0.5, -0.5,   0, 0,-1,
  -0.5,  0.5, -0.5,   0, 0,-1,
   0.5,  0.5, -0.5,   0, 0,-1,

  // Left (-x)   normal (-1,0,0)
  -0.5, -0.5, -0.5,  -1, 0, 0,
  -0.5, -0.5,  0.5,  -1, 0, 0,
  -0.5,  0.5,  0.5,  -1, 0, 0,
  -0.5,  0.5, -0.5,  -1, 0, 0,

  // Right (+x)  normal (1,0,0)
   0.5, -0.5,  0.5,   1, 0, 0,
   0.5, -0.5, -0.5,   1, 0, 0,
   0.5,  0.5, -0.5,   1, 0, 0,
   0.5,  0.5,  0.5,   1, 0, 0,

  // Down (-y)   normal (0,-1,0)
  -0.5, -0.5, -0.5,   0,-1, 0,
   0.5, -0.5, -0.5,   0,-1, 0,
   0.5, -0.5,  0.5,   0,-1, 0,
  -0.5, -0.5,  0.5,   0,-1, 0,

  // Up (+y)     normal (0,1,0)
  -0.5,  0.5,  0.5,   0, 1, 0,
   0.5,  0.5,  0.5,   0, 1, 0,
   0.5,  0.5, -0.5,   0, 1, 0,
  -0.5,  0.5, -0.5,   0, 1, 0}

// indices: each face = 2 triangles (6 indices)
constant cubeIndices = {
  0,1,2, 0,2,3,         // front
  4,5,6, 4,6,7,         // back
  8,9,10,8,10,11,       // left
  12,13,14,12,14,15,    // right
  16,17,18,16,18,19,    // down
  20,21,22,20,22,23}    // up

integer program, lightLoc, modelLoc, projLoc, viewLoc, vao
bool drawn = false

procedure set_shader(gdx canvas)
    drawn = true
    glMakeCurrent(canvas)
    program = glCreateProgram()
    glAttachShader(program, compile_shader(vertex_shader,GL_VERTEX_SHADER))
    glAttachShader(program, compile_shader(fragment_shader,GL_FRAGMENT_SHADER))
    glLinkProgram(program)
    glUseProgram(program)
    lightLoc = glGetUniformLocation(program,`uLightPosWorld`)
    modelLoc = glGetUniformLocation(program,`uModel`)
    projLoc = glGetUniformLocation(program,`uProjection`)
    viewLoc = glGetUniformLocation(program,`uView`)
    integer posLoc = glGetAttribLocation(program,`aPos`),
           normLoc = glGetAttribLocation(program,`aNormal`),
        posNormBuf = glCreateBuffer(),
            idxBuf = glCreateBuffer()
    glBindBuffer(GL_ARRAY_BUFFER,posNormBuf)
    glBufferData(GL_ARRAY_BUFFER,glFloat32Array(cubePositions,true),GL_STATIC_DRAW)
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER, idxBuf)
    glBufferData(GL_ELEMENT_ARRAY_BUFFER,glUint16Array(cubeIndices,true),GL_STATIC_DRAW)

    /* -- VAO that captures attribute state -- */
    vao = glCreateVertexArray()
    glBindVertexArray(vao)
    glBindBuffer(GL_ARRAY_BUFFER, posNormBuf)
    // position
    glEnableVertexAttribArray(posLoc)
    glVertexAttribPointer(posLoc,3,GL_FLOAT,false,6*Float32Array_BYTES_PER_ELEMENT,0)
    // normal
    glEnableVertexAttribArray(normLoc)
    glVertexAttribPointer(normLoc,3,GL_FLOAT,false,6*Float32Array_BYTES_PER_ELEMENT,
                                                   3*Float32Array_BYTES_PER_ELEMENT)
    // IBO
    glBindBuffer(GL_ELEMENT_ARRAY_BUFFER,idxBuf)
    glBindVertexArray(null)
end procedure

procedure drawHoleySponge(atom x, y, z, size, integer level, sequence modelMatrix)
    if level==0 then
        sequence mat = m4_identity()
        mat = m4_translate(mat,{x,y,z})
        mat = m4_scale(mat,{size,size,size})
        // combine with the incoming model (which already holds global rotation)
        sequence combined = m4_multiply(modelMatrix,mat)
        glUniformMatrix4fv(modelLoc,false,combined)
        glDrawElements(GL_TRIANGLES,length(cubeIndices),GL_UNSIGNED_SHORT,0)
    else
        atom newSize = size/3
        for dx=-1 to 1 do
            for dy=-1 to 1 do
                for dz=-1 to 1 do
                    integer hollow = (dx=0) + (dy=0) + (dz=0)
                    if hollow<2 then
                        atom nx = x+dx*newSize,
                             ny = y+dy*newSize,
                             nz = z+dz*newSize
                        drawHoleySponge(nx,ny,nz,newSize,level-1,modelMatrix)
                    end if
                end for
            end for
        end for
    end if
end procedure

atom angleDeg = 0

procedure redraw(gdx canvas, integer w, h)
    if not drawn then set_shader(canvas) end if
    glViewport(0,0,w,h)

    atom angleRad = angleDeg*PI/180

    glClearColor(245/255,247/255,250/255,1.0)
    glClear(GL_COLOR_BUFFER_BIT || GL_DEPTH_BUFFER_BIT)
    glEnable(GL_DEPTH_TEST)
    glEnable(GL_CULL_FACE)
    glCullFace(GL_BACK)

    atom aspect = w/h
    sequence model = m4_yRotate(m4_identity(),angleRad),      // global rotation
              view = m4_inverse(m4_lookAt({10,10,10},{0,0,0},{0,1,0})),
        projection = m4_perspective(45*PI/180,aspect,0.1,100)

    glUseProgram(program)
    glUniformMatrix4fv(viewLoc,false,view)
    glUniformMatrix4fv(projLoc,false,projection)
    glUniform3f(lightLoc,10,10,10) // light position in world space

    glBindVertexArray(vao) // bind VAO (contains vertex+normal buffers and IBO)

    drawHoleySponge(0,0,0,5,2,model) // draw the sponge (level 2, base size 5.0)

    glBindVertexArray(null)
    glSwapBuffers(canvas)
end procedure

procedure action(gdx timer)
    angleDeg += 0.5
    gdx dlg = gGetAttribute(timer,`USER_DATA`)
    gRedraw(dlg)
end procedure

gdx canvas = gCanvas(redraw),
    dlg = gDialog(canvas,`Sierpinski sponge`,`SIZE=615x615`),
    timer = gTimer(action,20,true,dlg)
gMainLoop(dlg)

