constant stadium = """
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Football Stadium</title></head>
<body><script src="https://aframe.io/releases/1.0.4/aframe.min.js"></script><a-scene><a-assets></a-assets>
<a-sky src="https://i.imgur.com/HJt7RhF.jpg"></a-sky>
<a-camera zoom="1" camera="active: true" look-controls wasd-controls position="2 1 0"></a-camera></a-scene>
</body></html>""", html = "stadium.html"
assert(write_lines(html,{stadium})==1)
system_open(html)

