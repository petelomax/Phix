with javascript_semantics
requires("1.0.6")
include theGUI.e
--gUseGTK()

constant rainbow = {{"R",TG_RED},
                    {"A",TG_ORANGE},
                    {"I",TG_YELLOW},
                    {"N",TG_GREEN},
                    {"B",TG_BLUE},
                    {"O",TG_INDIGO},
                    {"W",TG_PURPLE}}

function get_data(integer idx)
    return iff(idx<=0?1:rainbow)
end function

gdx list = gList(get_data,"MARGIN=10,SIZE=x17")
gMainLoop(gDialog(list,"Rainbow"))


