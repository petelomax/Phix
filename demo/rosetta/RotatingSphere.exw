--
-- demo\rosetta\RotatingSphere.exw
-- ===============================
--
requires("1.0.6") -- (not yet shipped)
without javascript -- (shd be when "")
include theGUI.e

constant title = "Rotating sphere",
         TG_NEON_GREEN = #00FFC8

atom angleX = 0,
     angleY = 0

procedure redraw(gdx canvas, integer w, h)
    atom r = min(w,h)/3, // radius of 3D sphere
         pointsCount = 0,
         pX, pY, -- previous point
         cosX = cos(angleX),
         sinX = sin(angleX),
         cosY = cos(angleY),
         sinY = sin(angleY)

    // Calculate 3D points and connect them with lines.
    for u=0 to 20 do
        atom lat = (u*PI) / 20
        for v=0 to 20 do
            atom lon = (v*2*PI) / 20

            // Calculate base 3D coordinates using spherical geometry.
            atom x0 = r * sin(lat) * cos(lon),
                 y0 = r * sin(lat) * sin(lon),
                 z0 = r * cos(lat),
                 // Apply rotation around the x-axis.
                 y1 = y0 * cosX - z0 * sinX,
                 z1 = y0 * sinX + z0 * cosX,
                 // Apply rotation around the y-axis.
                 x2 =  x0 * cosY + z1 * sinY,
                 z2 = -x0 * sinY + z1 * cosY,
                 // 3D to 2D perspective projection based on depth (z-axis).
                 distance = 400,
                 perspective = distance / (distance - z2),
                 // Center the projected coordinates on the canvas screen
                 sX = w/2 + x2 * perspective,
                 sY = h/2 + y1 * perspective

            // Connect consecutive points with lines.
            if v>0 and pointsCount>0 then
                gDrawLine(canvas,pX,pY,sX,sY,TG_NEON_GREEN)
            end if
            {pX,pY} = {sX,sY}
            pointsCount += 1
        end for
    end for
end procedure

procedure action(gdx timer)
    gdx canvas = gGetAttribute(timer,`USER_DATA`)
    // Increment rotation angles.
    angleX += 0.02
    angleY += 0.03
    gRedraw(canvas)
end procedure

gdx canvas = gCanvas(redraw,"BGCLR=#1A1A24"),
    dialog = gDialog(canvas,title,"SIZE=800x600"),
    timer = gTimer(action,user_data:=canvas)
gMainLoop(dialog)


