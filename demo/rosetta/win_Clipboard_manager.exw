--
-- demo/rosetta/win_Clipboard_manager.exw
-- ======================================
--
-- for https://rosettacode.org/wiki/Clipboard_manager/display
--
--{{trans|FreeBASIC}} - but replaced hotkeys with proper clipboard monitoring. You can of course just use Win-V instead.
--requires(64,true)
requires(WINDOWS) -- You /might/ get somewhere on Linux/GTK by hooking the 'owner-change' signal.
                -- The Javascript addEventListener("copy") event is not system-level-enough, afaik...
              -- (besides, you really wouldn't want someone to be able to monitor your clipboard contents
            -- just because you have opened their webpage, for hopefully rather obvious security reasons, but
         -- you could (probably) do something like this for purely-in-the-same-application clipboard monitoring.)
requires("1.0.6") -- or blag next from the repo
include ../theGUI/theGUI.WINAPI.e

sequence copyList = {}
bool isPinned = False
HWND hMain, hList

procedure UpdateDisplay()
    string txt = ""
    for i,c in copyList do
        c = substitute_all(c,"\r\n\t","   ")
        txt &= sprintf("[%d] %s\r\n\r\n",{i,shorten(c,"chars")})
    end for
    SetWindowText(hList,txt)
end procedure

procedure AddToClipboard(string text)
    integer k = find(text,copyList),
            l = length(copyList)
    if text!="" and (k=0 or k!=l) then
        if k then
            copyList[k..k] = {}         -- remove old entry/move to top
        elsif l>=10 then            
            copyList = copyList[2..$]   -- keep only the 10 most recent
        end if
        copyList &= {text}
        UpdateDisplay()
    end if
end procedure

procedure TogglePin()
    isPinned = not isPinned
    atom hWndInsertAfter = iff(isPinned?HWND_TOPMOST:HWND_NOTOPMOST)
    SetWindowPos(hMain,hWndInsertAfter,0,0,0,0,SWP_NOMOVE||SWP_NOSIZE)
end procedure

procedure ReadClipboardAndStore()
    -- (called from WM_CLIPBOARDUPDATE or the Copy button)
    if OpenClipboard(0) then
        -- Prefer Unicode when available
        bool bUnicode = IsClipboardFormatAvailable(CF_UNICODETEXT)
        if bUnicode or IsClipboardFormatAvailable(CF_TEXT) then
            atom hData = GetClipboardData(iff(bUnicode?CF_UNICODETEXT:CF_TEXT))
            if hData!=0 then
                atom pData = GlobalLock(hData)
                if pData!=0 then
                    string s
                    if bUnicode then
                        sequence u = peek_wstring(pData)    -- Unicode
                        s = utf16_to_utf8(u)                -- → UTF-8
                    else
                        s = peek_string(pData)              -- ANSI
                    end if
                    AddToClipboard(s)
                    GlobalUnlock(hData)
                end if
            end if
        end if
        CloseClipboard()
    end if
end procedure

function WndProc(atom hWnd, msg, wParam, lParam)

    switch msg do

        case WM_COMMAND:

            if LOWORD(wParam)=1001 then -- Copy btn
                Sleep(100)
                ReadClipboardAndStore()

            elsif LOWORD(wParam)=1002 then -- Pin/Unpin btn
                TogglePin()
    
            elsif LOWORD(wParam)=1003 then -- Clear btn
                copyList = {}
                UpdateDisplay()
            end if
            
        case WM_CLIPBOARDUPDATE:
            ReadClipboardAndStore()
   
        case WM_CHAR:
            -- (Aside: You may prefer to remove this)
            if wParam=VK_ESCAPE then
                {} = SendMessage(hWnd,WM_CLOSE,0,0)
            end if

        case WM_DESTROY:
            PostQuitMessage(0)
    end switch
    
    return DefWindowProc(hWnd,msg,wParam,lParam)
end function

constant wClss = "ClipMgr", title = "Clipboard Manager"
RegisterClassEx(wClss,call_back(WndProc),CS_HREDRAW||CS_VREDRAW)

atom hInst = instance(),
    lStyle = WS_CHILD || WS_VISIBLE || ES_MULTILINE || ES_READONLY || WS_VSCROLL,
   dwStyle = WS_CHILD || WS_VISIBLE
hMain = CreateWindowEx(0,wClss,title,WS_OVERLAPPEDWINDOW,100,100,700,500,NULL,NULL,hInst,NULL)
hList = CreateWindowEx(WS_EX_CLIENTEDGE,"EDIT","",lStyle, 10,10,660,400,hMain,NULL,hInst,NULL)
{} = CreateWindowEx(0,"BUTTON","Copy (Ctrl+C)",  dwStyle, 10,420,200,30,hMain,1001,hInst,NULL)
{} = CreateWindowEx(0,"BUTTON","Pin/Unpin",     dwStyle, 220,420,200,30,hMain,1002,hInst,NULL)
{} = CreateWindowEx(0,"BUTTON","Clear All",    dwStyle,  430,420,120,30,hMain,1003,hInst,NULL)

ShowWindow(hMain,SW_SHOW)
UpdateWindow(hMain)

-- Register as a clipboard-format listener (must be done after the window exists)
AddClipboardFormatListener(hMain)

atom pMsg = allocate_struct(idMSG)
while GetMessage(pMsg,NULL,0,0) do
    TranslateMessage(pMsg)
    DispatchMessage(pMsg)
end while

