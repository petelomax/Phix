--
-- demo/rosetta/win_Clipboard_manager.exw
-- ======================================
--
-- for https://rosettacode.org/wiki/Clipboard_manager/display
--
--{{trans|FreeBASIC}}
--requires(64,true)
requires(WINDOWS) -- neither Lnx nor JS have clipboard hooks, afaik...
--I've translated the FreeBASIC entry for Clipboard manager/display on rosettacode to Phix, 
--but I think an AddClipboardFormatListener()-based approach would be much better.

include ../theGUI/theGUI.WINAPI.e

sequence copyList = {}
bool isPinned = False
HWND hMain, hList

procedure UpdateDisplay()
    string txt = ""
    for i,c in copyList do
        c = substitute_all(c,"\r\n\t","   ")
        txt &= sprintf("[%d] %s\r\n\r\n",{i,shorten(c,"chars")})
    end for
    SetWindowText(hList, txt)
end procedure

procedure AddToClipboard(string text)
    integer k = find(text,copyList),
            l = length(copyList)
    if text!="" and (k=0 or k!=l) then
        if k then
            copyList[k..k] = {}         -- remove old entry so it moves to top
        elsif l>=10 then            
            copyList = copyList[2..$]   -- keep only the 10 most recent
        end if
        copyList &= {text}
        UpdateDisplay()
    end if
end procedure

procedure TogglePin()
    isPinned = not isPinned
    atom hWndInsertAfter = iff(isPinned?HWND_TOPMOST:HWND_NOTOPMOST)
    SetWindowPos(hMain, hWndInsertAfter, 0, 0, 0, 0, SWP_NOMOVE || SWP_NOSIZE)
--  if isPinned then
--      SetWindowPos(hMain, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE || SWP_NOSIZE)
--  else
--      SetWindowPos(hMain, HWND_NOTOPMOST, 0, 0, 0, 0, SWP_NOMOVE || SWP_NOSIZE)
--  end if
end procedure

