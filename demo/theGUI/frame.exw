--?gVersion()

--function quit(gdx /*id*/)
function quit(gdx btn)
?{`quit, closing, dlg size is:`,gGetAttribute(gGetDialog(btn),`SIZE`)}
?{`quit, closing, frame size is:`,gGetAttribute(gGetParent(gGetParent(btn)),`SIZE`)}
-- 152,119 wanted, got 136,78
--sleep(2)
    return TG_CLOSE
end function

