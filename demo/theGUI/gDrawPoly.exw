--/*
local function lRotatePolygon(sequence poly, object angle)
--
--  DEV this is a fair bit slower than I thought it would be...
--  In demo\theGUI\gDrawPolygon.exw the Phix logo with 33 {x,y}
--  rotates worse than twice as slowly as the house with 5 {x,y}
--  whereas I expected it would be keyboard-repeat-rate bound...
--
    integer cx, cy
    if sequence(angle) then
        {angle,cx,cy} = angle
    else
        {cx,cy} = poly[1]
    end if
    if angle!=0 then
        integer lp = length(poly)
        sequence res = repeat(0,lp)
        atom rr = angle*TG_DEG2RAD,
             sr = sin(rr),
             cr = cos(rr)
-- Simplifies the #ilASM loading of xmm2/3, without causing any noticeable harm...
if integer(sr) then sr += 1e-12 end if
if integer(cr) then cr += 1e-12 end if
        for i,pi in poly do
            integer lpi = length(pi)
            if lpi=0 then
                res[i] = {}
            elsif lpi>=8 then
                crash(`arc segments not supported`,nFrames:=2)
            elsif odd(lpi) then
                crash(`odd segment length found`,nFrames:=2)
            else
                sequence ri = repeat(0,lpi)
if 1 then
-- this is 10* faster than the hll version, 335,000 rps vs 35,000 rps.
-- unfortunately, it's not the root cause of the slowness.... (swamped by gDrawPolygon, I guess)
                #ilASM{
                        [32]
                            mov esi,[pi]
                            mov edi,[ri]
                            shl esi,2           -- esi := raw[pi]
                            shl edi,2           -- edi := raw[ri]
                            mov edx,[sr]
                            sub esp,8
                            fld qword[ebx+edx*4]
                            fstp qword[esp]
                            movsd xmm2,qword[esp]   -- xmm2 := sr
                            mov edx,[cr]
                            fld qword[ebx+edx*4]
                            fstp qword[esp]
                            movsd xmm3,qword[esp]   -- xmm3 := cr
                            add esp,8

                         ::forj
                            mov ecx,[cx]
                            mov eax,[esi]
                            add esi,4
                            call :%pLoadMint    -- eax:=(int32)eax
                            mov edx,eax
                            cvtsi2sd xmm4,ecx   -- cx
                            mov eax,[esi]
                            sub edx,ecx         -- pi[j] - cx
                            mov ecx,[cy]
                            call :%pLoadMint    -- eax:=(int32)eax
                            add esi,4
                            sub eax,ecx         -- pi[k] - cy
                            cvtsi2sd xmm5,ecx   -- cy

                            cvtsi2sd xmm0,edx   -- x
                            cvtsi2sd xmm1,eax   -- y
                            mulsd xmm0,xmm3     -- x*cr
                            mulsd xmm1,xmm2     -- y*sr
                            subsd xmm0,xmm1
                            addsd xmm0,xmm4     -- + cx
                            cvtsd2si ecx,xmm0   -- x*cr-y*sr+cx
                            mov [edi],ecx
                            add edi,4

                            cvtsi2sd xmm0,edx   -- x
                            cvtsi2sd xmm1,eax   -- y
                            mulsd xmm0,xmm2     -- x*sr
                            mulsd xmm1,xmm3     -- y*cr
                            addsd xmm0,xmm1
                            addsd xmm0,xmm5     -- + cy
                            cvtsd2si ecx,xmm0   -- x*sr+y*cr+cy
                            mov [edi],ecx
                            add edi,4

                            sub [lpi],2
                            jne :forj

                        [64]
                            mov rsi,[pi]
                            mov rdi,[ri]
                            shl rsi,2           -- rsi := raw[pi]
                            shl rdi,2           -- rdi := raw[ri]
                            mov r12,[cx]
                            mov r13,[cy]
                            cvtsi2sd xmm4,r12   -- cx
                            cvtsi2sd xmm5,r13   -- cy

                            mov rdx,[sr]
                            sub rsp,8
                            fld tbyte[rbx+rdx*4]
                            fstp qword[rsp]
                            movsd xmm2,qword[rsp]   -- xmm2 := sr
                            mov rdx,[cr]
                            fld tbyte[rbx+rdx*4]
                            fstp qword[rsp]
                            movsd xmm3,qword[rsp]   -- xmm3 := cr
                            add rsp,8

                         ::forj
                            mov rax,[rsi]
                            add rsi,8
                            call :%pLoadMint    -- rax:=(int64)rax
                            mov rdx,rax
                            mov rax,[rsi]
                            call :%pLoadMint    -- rax:=(int64)rax
                            add rsi,8
                            sub rdx,r12         -- pi[j] - cx
                            sub rax,r13         -- pi[k] - cy

                            cvtsi2sd xmm0,rdx   -- x
                            cvtsi2sd xmm1,rax   -- y
                            mulsd xmm0,xmm3     -- x*cr
                            mulsd xmm1,xmm2     -- y*sr
                            subsd xmm0,xmm1
                            addsd xmm0,xmm4     -- + cx
                            cvtsd2si rcx,xmm0   -- x*cr-y*sr+cx
                            mov [rdi],rcx
                            add rdi,8

                            cvtsi2sd xmm0,rdx   -- x
                            cvtsi2sd xmm1,rax   -- y
                            mulsd xmm0,xmm2     -- x*sr
                            mulsd xmm1,xmm3     -- y*cr
                            addsd xmm0,xmm1
                            addsd xmm0,xmm5     -- + cy
                            cvtsd2si rcx,xmm0
                            mov [rdi],rcx
                            add rdi,8

                            sub [lpi],2
                            jne :forj
                        []
                      }
else
                for j=1 to lpi-1 by 2 do
                    integer k = j+1,
                            x = round(pi[j] - cx),
                            y = round(pi[k] - cy)
                    ri[j] = round(x*cr - y*sr + cx)
                    ri[k] = round(x*sr + y*cr + cy)
                end for
end if
                res[i] = ri
            end if
        end for
        return res
    end if
    return poly
end function
--*/

bool bDrawCtrls = true -- toggle using 'c'
bool bFilled = true -- toggle using 'f'
bool bMargin1 = true -- (non-togglable) [DEV yet, that is...]

-- the nearest end/ctrl point to the mouse position
-- ie if ndi!=0 then {x,y} = poly[ndi][ndx..+1]...
integer ndi = 0, ndx = 0, angle = 0

function set_nearest(sequence poly, atom x, y)
    integer ni=0, nx=0, nd
    for i,p in poly do
        for dx=1 to length(p) by 2 do
            integer xd = p[dx]-x,
                    yd = p[dx+1]-y,
                    d = xd*xd + yd*yd
            if d<100 and (ni=0 or nd>d) then
                {ni,nx,nd} = {i,dx,d}
            end if
        end for
    end for
    if ndi!=ni or ndx!=nx then
        {ndi,ndx} = {ni,nx} 
        return true -- redraw
    end if
    return false
end function

function ncolour(integer i, dx)
    -- helper: nearest in green, else endpoints red and ctrlpoints blue
    bool near = (ndi==i and ndx==dx)
    return iff(near?TG_GREEN:iff(dx=1?TG_RED:TG_BLUE))
end function

