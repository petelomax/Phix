--
-- demo\theGUI\gVbox.exw
-- =====================
--
--with javascript_semantics
{} = sprint(0,9) -- (set the default asCh to -1)
puts(1,"")
--requires(64,true)
include theGUI.e
--include backup\theGUI.2320.e -- very different!
--include backup\theGUI.0002.e -- same!
--gUseGTK() --DEV very weird tab order... FIXED, except GTK3 initial focus is not shown...

procedure action(gdx btn)
    gSetAttribute(gGetDialog(btn),`TITLE`,gGetAttribute(btn,`TITLE`))
end procedure

sequence rows = {}
for row=1 to 7 do
    gdx b1 = gButton("",action,`TITLE="button%d1"`,{row}),
        b2 = gButton("",action,`TITLE="button%d2"`,{row}),
        b3 = gButton("",action,`TITLE="button%d3"`,{row}), hb
    switch row do
        case 1: hb = gVbox({gVbox({b1,b2,b3},`SPACE=BOTTOM,MARGIN=5,GAP=5`)},`bottom`)
        case 2: hb = gVbox({gVbox({b1,b2,b3},`SPACE=BETWEEN,MARGIN=5,GAP=5`)},`between`)
        case 3: hb = gVbox({gVbox({b1,b2,b3},`SPACE=AROUND,MARGIN=5,GAP=5`)},`around`)
        case 4: hb = gVbox({gVbox({b1,b2,b3},`SPACE=CENTRE,MARGIN=5,GAP=5`)},`centre`)
        case 5: hb = gVbox({gVbox({b1,gVbox({b2,b3},`SPACE=LEFT,GAP=5`)},`MARGIN=5,GAP=5`)},`one-two`)
        case 6: hb = gVbox({gVbox({gVbox({b1,b2},`GAP=5`),b3},`SPACE=BETWEEN,MARGIN=5,GAP=5`)},`two-one`)
        case 7: hb = gVbox({gVbox({b1,b2,b3},`SPACE=TOP,MARGIN=5,GAP=5`)},`top`)
    end switch
-- aside: H/B trash the SPACE=BETWEEN, as they should:
--  gSetAttribute(hb,`EXPAND`,'H') -- ok
    gSetAttribute(hb,`EXPAND`,'V') -- ok
--  gSetAttribute(hb,`EXPAND`,'B') -- ok
    rows &= hb
end for
--gdx dlg = gDialog(gHbox(rows,`SPACE=BETWEEN`),`gVbox`,`MINSIZE=520x137`)
gdx dlg = gDialog(gHbox(rows,`SPACE=BETWEEN`),`gVbox`,`SIZE=600x200,MINSIZE=520x137`)
--gdx dlg = gDialog(gHbox(rows,`SPACE=BETWEEN`),`gVbox`,`SIZE=600x200`)
--gdx dlg = gDialog(gVbox(rows,`SPACE=BETWEEN,MARGIN=x2`),`gHbox`,`MINSIZE=225x326`)

--gShow(dlg)
--printf(1,"dialog size: %v\n",{gGetAttribute(dlg,`SIZE`)})
gMainLoop(dlg)
