-- sug: if X/YTICK=0 then ... range is max-min, floor(range/tick)*20 <= w/h where 20 is deduced from tags...
-- sug: if XMIN=XMAX (and likewise when YMIN=YMAX) then
--      XMIN is smallest multiple of XTICK <= min(x)
--      XMAX is smallest multiple of XTICK >= max(x)
--      YMIN is smallest multiple of YTICK <= min(y)
--      YMAX is smallest multiple of YTICK >= max(y)
--gdx graph = hGraph(get_data,`XTICK=1,XMIN=0,XMAX=9,YMIN=0,YMAX=180`),
gdx graph = hGraph(get_data),
--  dlg = gDialog(graph,`gGraph`,`SIZE=240x140,MINSIZE=210x112`)
    dlg = gDialog(graph,`gGraph`,`SIZE=240x80`)
ctrl_xtra[graph][GX_XMAX] = 9
ctrl_xtra[graph][GX_YMAX] = 180
--ctrl_xtra[graph][GX_XTICK] = {1,4}
--ctrl_xtra[graph][GX_YTICK] = {{{180,2},{90,4},{60,10,10,2},{20,16,10,5}},{89,109,159}}

