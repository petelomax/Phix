local object ximg = NULL, ltab, rtab
--{ximg,ltab,rtab} = apply({x_txt,l_txt,r_txt},gImage_from_XPM)

local constant TAB_BORDER = #E6E6E6,
               TAB_BGCLR = #F0F0F0,     -- overall
               TAB_BG_SEL = #F9F9F9,    -- selected/active tab background
               TAB_BG_NS = #F3F3F3,     -- other tabs
               TAB_BG_HOV = #EDEDED,    -- hover on other tabs
               TAB_OVER_HOV = #E0EEFC   -- hover on overflow buttons

local function tg_tabs_get_tabset(gdx tabs)
    object tabset = ctrl_xtra[tabs][CXTAB_ITEMS]
    if integer(tabset) then
        string sig = tg_get_sig(tabset)
        if sig="FO" then
            tabset = tabset(tabs)
        elsif sig="F" then
            tabset = tabset()
        else
            ?9/0
        end if
    end if
    return tabset
end function

local procedure tg_tabs_redraw(gdx tabs, integer w,h)
    if ximg=NULL then
        {ximg,ltab,rtab} = gGetGlobal(`xlr_xpm`) -- (not documented)
    end if
    -- first pass: calculate all the tab widths
    sequence tabset = tg_tabs_get_tabset(tabs),
          tabwidths = {}
    bool rover_needed = false,
         bHasFocus = gGetFocus()=tabs,
         bActive = gGetAttribute(tabs,`ACTIVE`),
         bClose = ctrl_xtra[tabs][CXTAB_CLOSE],
         bBump = ctrl_xtra[tabs][CXTAB_BUMP]
    integer {mx,my} = gGetAttribute(tabs,`MOUSEPOS`),
           selected = ctrl_xtra[tabs][CXTAB_SEL],
           firsttab = ctrl_xtra[tabs][CXTAB_1ST],
              tw, x = iff(firsttab>1?10:0)
    gdm img
    for i,t in tabset from firsttab do
        tw = 0
        if not string(t) then
            {t,img} = t
            tw += gGetAttribute(img,`SIZE`)[1]+4
        end if
        tw += gGetTextExtent(t,tabs)[1]+12
        if bClose then tw += 10 end if
        x += tw
        rover_needed = x>(w-(i<length(tabset))*11)
        if rover_needed then
            if i>selected or not bBump then exit end if
            if firsttab=1 then x += 10 end if
            x -= tabwidths[1]
            tabwidths = tabwidths[2..$]
            firsttab += 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
            rover_needed = false -- (i/c i==$)
        end if
        tabwidths &= tw
        if i=length(tabset) then
            while firsttab>1 do
                -- when resizing, drag in any that now fit, aka
                --  when it would have left rover_needed false.
                t = tabset[firsttab-1]
                tw = 0
                if not string(t) then
                    {t,img} = t
                    tw += gGetAttribute(img,`SIZE`)[1]+4
                end if
                tw += gGetTextExtent(t,tabs)[1]+12
                if bClose then tw += 10 end if
                if x+tw-(firsttab=2)*10>w then exit end if
                x += tw
                tabwidths = tw & tabwidths
                firsttab -= 1
                ctrl_xtra[tabs][CXTAB_1ST] = firsttab
            end while
        end if
    end for
    x = 0
    if firsttab>1 then
        -- show leftarrow:
        if mx>=0 and mx<10 
        and my>2 and my<22 and bActive then
            -- show hover highlight on leftarrow:
            gDrawRect(tabs, 0, 3, 9, 21, true, colour:=TAB_OVER_HOV)
        end if
        gDrawImage(ltab,tabs,2,8)
        x = 10
    end if
    -- save for mouse handling:
    ctrl_xtra[tabs][CXTAB_TWSAVE] = tabwidths
    atom txtclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
    for i,t in tabset from firsttab do
        integer wdx = i-firsttab+1, ty, bg
        if wdx>length(tabwidths) then
            assert(rover_needed)
            gDrawText(tabs,x+5,1,"...",{},TG_SE,colour:=txtclr)
            exit
        end if
        tw = tabwidths[wdx]
        if i=selected and bActive then
            ty = 0
            bg = TAB_BG_SEL
        else
            ty = 2
            if mx>x and mx<x+tw
            and my>2 and my<22 and bActive then
                bg = TAB_BG_HOV
            else
                bg = TAB_BG_NS
            end if
        end if
        gDrawRect(tabs,x,ty,x+tw,h-1,true,colour:=bg)
        if bHasFocus and i=selected and bActive then
            -- draw focus rect  
            integer fb = iff(backend=TG_GTK?h-8:
                         iff(backend=TG_WINAPI?h-5:9/0))
--          gDrawRect(tabs,x+2,ty+2,x+tw-1,fb,rc:=2,colour:=TG_BLACK,style:=TG_DOTTED)
            gDrawRect(tabs,x+2,ty+2,x+tw-1,fb,rc:=0,colour:=TG_BLACK,style:=TG_DOTTED)
        end if
        -- left edge
        gDrawLine(tabs,x,ty,x,h-1,colour:=TAB_BORDER)
        integer iw = 0, ih
        if not string(t) then
            {t,img} = t
            {iw,ih} = gGetAttribute(img,`SIZE`)
            iw += 4
            if not bActive then img = gGreyscale_XPM(img) end if
            gDrawImage(img,tabs,x+6,ty+10-floor(ih/2))
        end if
        gDrawText(tabs,x+iw+5,ty+3,t,{},TG_SE,colour:=txtclr)
        if bClose then
            gDrawImage(ximg,tabs,x+tw-12,ty+6)
        end if
        -- top edge
        gDrawLine(tabs,x,ty,x+tw,ty,colour:=TAB_BORDER)
        if i!=selected then
            -- bottom edge
            gDrawLine(tabs,x,h-2,x+tw,h-2,colour:=TAB_BORDER)
        end if
        x += tw     
        -- right edge
        gDrawLine(tabs,x,ty,x,h-2,colour:=TAB_BORDER)
    end for
    -- save for tg_tabs_click:
    ctrl_xtra[tabs][CXTAB_ROVER] = rover_needed
    if rover_needed then
        bool bHovr = mx>=w-10 and mx<w and my>2 and my<22 and bActive
        atom bgclr = iff(bHovr?TAB_OVER_HOV:TAB_BGCLR)
        gDrawRect(tabs, w-10, 3, w-1, 21, true, colour:=bgclr)
        gDrawImage(rtab,tabs,w-9,8)
    end if
end procedure

local procedure tg_tabs_mousemoveleave(gdx tabs)
    gRedraw(tabs)
end procedure

local procedure tg_tabs_click(gdx tabs, sequence status, integer x, y) 
    if gGetAttribute(tabs,`ACTIVE`) then
        integer {w,h} = gGetAttribute(tabs,`SIZE`), tdx = -2,
             old_posn = ctrl_xtra[tabs][CXTAB_SEL],
             firsttab = ctrl_xtra[tabs][CXTAB_1ST]
        bool doleft = false,
             doright = false,
             doclose = false,
             dochange = false,
             doredraw = true,
             bClose = ctrl_xtra[tabs][CXTAB_CLOSE],
             rover_needed = ctrl_xtra[tabs][CXTAB_ROVER]
        if status[1..2]=`LS` 
        and y>2 and y<22 then
            if firsttab>1 
            and x>=0 and x<10 then
                doleft = true
                tdx = -1
            elsif rover_needed
              and x>=w-10 and x<w then
                doright = true
                tdx = 0
            else
                integer tx = iff(firsttab>1?10:0)
                sequence twsave = ctrl_xtra[tabs][CXTAB_TWSAVE]
                for i,rhs in twsave do
                    tx += rhs
                    if x<=tx then
                        tdx = firsttab+i-1
                        doclose = bClose and tx-x<=10
                        dochange = not doclose
                        exit
                    end if
                end for
                if tdx=-2 and rover_needed then
                    doright = true
                    tdx = 0
                end if
            end if
        end if
        if doleft then
            firsttab -= 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
        elsif doright then
            firsttab += 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
        elsif doclose then
            {old_posn,tdx,dochange} = {tdx,0,true}
        elsif dochange then
            ctrl_xtra[tabs][CXTAB_SEL] = tdx
        else
            doredraw = false
        end if
        if doredraw then
            -- allow bump: show as many tabs as you can while ensuring sel is visible,
            --       however that can disable l/r arrow buttons, so they set it false, 
            --       & it can be annoying for close to jump back, so that does so too.
            ctrl_xtra[tabs][CXTAB_BUMP] = dochange and tdx!=0
            gRedraw(tabs)
        end if
        if dochange and old_posn!=tdx then
--          rtn tabchanged = gGetHandler(tabs,`TABCHANGED`)
            rtn tabchanged = hGetHandler()
            if tabchanged then
                string sig = get_routine_info(tabchanged,false)[3]
                if sig=`POII` then
                    tabchanged(tabs,old_posn,tdx)
                elsif sig=`PII` then
                    tabchanged(old_posn,tdx)
                else
                    ?9/0
                end if
            elsif doclose then
                crash(`TABCHANGED not defined`)
            end if
        end if
    end if
end procedure

local function tg_tabs_key_handler(gdx tabs, integer c) 
    if gGetAttribute(tabs,`ACTIVE`) then
        integer selected = ctrl_xtra[tabs][CXTAB_SEL],
                firsttab = ctrl_xtra[tabs][CXTAB_1ST]
        bool bRedraw = false
        if c=VK_LEFT then
            if selected>1 then
                selected -= 1
                if firsttab>selected then
                    firsttab = selected
                    ctrl_xtra[tabs][CXTAB_1ST] = firsttab
                end if
                bRedraw = true
            end if
        elsif c=VK_RIGHT then
            sequence tabset = tg_tabs_get_tabset(tabs)
            if selected<length(tabset) then
                selected += 1
                bRedraw = true
            end if
        end if
        if bRedraw then
            ctrl_xtra[tabs][CXTAB_SEL] = selected
            ctrl_xtra[tabs][CXTAB_BUMP] = true
            gRedraw(tabs)
            return TG_IGNORE
        end if
    end if
    return TG_CONTINUE
end function

--local function hTabs(object tabitems, [rtn tabchanged=NULL,] string attributes="", dword_seq args={}) 
local function hTabs(object tabitems, rtn tabchanged=NULL, string attributes="", dword_seq args={})
--  {tabchanged, attributes, args} = paranormalise_raa(tabchanged, attributes, args)
    gdx tabs = gCanvas(tg_tabs_redraw,`SIZE=0x24,EXPAND=HORIZONTAL`)
--  ctrl_types[tabs] = TABS
    if platform()!=JS then
        ctrl_xtra &= repeat(0,tabs-length(ctrl_xtra))
    end if
    object tabs_attr = repeat(0,CXTAB_LEN)
    tabs_attr[CXTAB_ITEMS] = tabitems
    tabs_attr[CXTAB_SEL] = 1
    tabs_attr[CXTAB_1ST] = 1
    tabs_attr[CXTAB_BUMP] = true
    ctrl_xtra[tabs] = tabs_attr
    tabs_attr = 0
--  tg_register_handler(TABS,`TABITEMS`,{`FO`,`F`})
--  tg_register_handler(TABS,`TABCHANGED`,{`POII`,`PII`})
    gSetAttribute(tabs,`BGCLR`,TAB_BGCLR)
    gSetHandler(tabs,{`MOUSEMOVE`,`MOUSELEAVE`},tg_tabs_mousemoveleave)
    gSetHandler(tabs,`CLICK`,tg_tabs_click)
    gSetHandler(tabs,`KEY`,tg_tabs_key_handler)
--  if integer(tabitems) then
--      gSetHandler(tabs,`TABITEMS`,tabitems) -- (for the sig check only)
--  end if
    if tabchanged then
--      gSetHandler(tabs,`TABCHANGED`,tabchanged)
        hSetHandler(tabchanged)
    end if
    if length(attributes) then
--?{attributes,args}
        gSetAttributes(tabs,attributes,args)
    end if
    return tabs
end function

