--/*
local constant tab_attrs = {{   CXTAB_ITEMS:=$,'O',`TABITEMS`   }, -- static sequence or a TABITEMS function
                            {   CXTAB_CLOSE:=$,'B',`SHOWCLOSE`  }, -- t/f
                            {     CXTAB_SEL:=$,'I',`POSN`       }, -- 1..length(tabitems)
                            {     CXTAB_1ST:=$,'i',`[1ST]`      }, -- (internal, firsttab)
                            {    CXTAB_BUMP:=$,'i',`[BUMP]`     }, -- (internal, allow bump, see below)
                            {   CXTAB_ROVER:=$,'b',`[ROVER]`    }, -- (internal, rover_needed)
                            {  CXTAB_TWSAVE:=$,'s',`[TWSAVE]`   }}, -- (internal, tab widths)
                    CXTAB_LEN = length(tab_attrs)
--*/
sequence ctrl_xtra = {} -- hButton-specific
enum CXTAB_ITEMS,
     CXTAB_CLOSE,
     CXTAB_SEL,
     CXTAB_1ST,
     CXTAB_BUMP,
     CXTAB_ROVER,
     CXTAB_TWSAVE,
     CXTAB_LEN = $

local function tg_get_sig(rtnn rid) -- copied verbatim from theGUI.e
--DEV/temp:
--local function tg_get_sig(rtn rid) -- copied verbatim from theGUI.e
    return get_routine_info(rid,false)[3] -- eg `FI`
end function

local type dword_seq(object s)  -- (technically qword_seq on 64-bit)
    return sequence(s) and not string(s) -- copied verbatim from theGUI.e
end type

rtn tabchanged = NULL
