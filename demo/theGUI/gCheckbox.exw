puts(1,"")
--requires(64,true)
with javascript_semantics
include theGUI.e
--gUseGTK()

procedure value_changed(gdx chk, bool bState)
    gSetAttribute(gGetDialog(chk),`TITLE`,`ticked:%t`,{bState})
--procedure value_changed()
--  ?"value_changed"
end procedure

--gdx chk = gCheckbox(`Is this c&hecked?`,value_changed),
