gdx chk = gCheckbox({`Is this c&hecked?`,TG_W,TG_E},value_changed),
    hbx = gHbox({chk},`SPACE=AROUND`),
--  dlg = gDialog(hbx,`gCheckbox`,`MINSIZE=240x80,MAXSIZE=400x300`) -- pretty good...
    dlg = gDialog(hbx,`gCheckbox`,`SIZE=240x80`)
--gSetAttributes(chk,`ACTIVE=7`)
--gSetAttributes(chk,`VALUE=7`)
gSetAttributes(chk,`EXPAND=H`)
