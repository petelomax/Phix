// 2. Tear down audio pipeline
mpv_command_string(mpv_ctx, "set aid no");
mpv_command_string(mpv_ctx, "set ao null");

// 3. Rebuild audio pipeline (blank string resets 'ao' to default driver)
mpv_command_string(mpv_ctx, "set ao \"\"");
std::string restore_aid_cmd = "set aid " + std::string(aid);
mpv_command_string(mpv_ctx, restore_aid_cmd.c_str());

// 4. Free memory
mpv_free(aid);

