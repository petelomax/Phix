        gMenuSetAttribute(menus,id,`ACTIVE`,bLoaded)
    end for
end procedure

string video_file ="" -- (as opened)

function get_duration()
    bool bGet = mpv_ctx!=NULL and video_file!=""
    atom duration = iff(bGet?mpv_get_property(mpv_ctx,`duration`,MPV_FORMAT_DOUBLE,0):0)
    return duration
end function

procedure set_aspect_ratio(integer c)
    gMenuSetAttribute(menus,c,`CHECKED`,true)
    -- Disable 'Fix' for 'd3fault', else enable, iff ffmpeg installed:
    gMenuSetAttribute(menus,'F',`ACTIVE`,c!='3' and bFFmpeg)
    string ar = ASPECT_RATIOS[c-'0'], cmd
    if mm={2,0} then
        cmd = `set video-aspect `&ASPECT_RATIOS[c-'0']
        mpv_command_string(mpv_ctx,cmd)
    elsif mm={2,5} then
        if get_duration()>0 then
            mpv_set_property(mpv_ctx,`video-aspect-override`,MPV_FORMAT_STRING,ar)
        end if
    else
        ?9/0
    end if
end procedure

procedure toggle_fullscreen()
    if get_duration()>0 then
        bFullscreen = not bFullscreen
        gSetAttribute({mainmenu,seekbar,hbox},`VISIBLE`,not bFullscreen)
        gSetAttribute({sources,fragments},`VISIBLE`,bEditingEnabled and not bFullscreen)
        gSetAttribute(dlg,`FULLSCREEN`,bFullscreen)
    end if
end procedure

integer sub_id = -2     -- -2 is check, -1 is none, 0+ is subtitle track_id

procedure set_subtitle_visibility(integer visible)
    -- visible can be true or false, or -1 to toggle.
    if sub_id>=0 then
        mpv_set_property(mpv_ctx,`sub`,MPV_FORMAT_INT,sub_id)
        bool v = mpv_get_property(mpv_ctx,`sub-visibility`,MPV_FORMAT_FLAG)
        v = iff(visible==-1?not v:visible)
        mpv_set_property(mpv_ctx,`sub-visibility`,MPV_FORMAT_FLAG,v)
        gMenuSetAttribute(menus,'V',`CHECKED`,v)
        -- when the video is letterboxed, ie top/bottom borders exist because of user-resizing,
        -- then when subtitles are being displayed make the top border height 0 to maximise the
        -- chances of the subtitles fitting entirely within the bottom border, off-video (but
        -- if they're half-on/half-off, that's just user error, aka not resizing it sensibly).
        mpv_set_property(mpv_ctx,`video-align-y`,MPV_FORMAT_INT,-v)
    end if
end procedure

