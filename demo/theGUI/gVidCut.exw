--/*
--procedure download_subtitle_mpchc_style()--string video_file)
    -- 1. ---- HASH CALCULATION (MPHC's method) -----------------------
    atom fsize = get_file_size(video_file)
    if fsize >= 131072 then

--  atom fh = open(video_file, `rb`)
--  if fh = 0 then return "" end if
--  string first64k = read(fh, 65536)
--  seek(fh, fsize - 65536, 0)                -- start of last 64KB
--  string last64k  = read(fh, 65536)
--  close(fh)

--  string hash = lower( to_hex(fsize) & to_hex(first64k) & to_hex(last64k) )
    -- Example: `176cd81302aab28e...` (hex string)
        string fhash = computeFileHash(video_file)


    -- 2. ---- BUILD XML-RPC REQUEST ---------------------------------
    string xml_request = sprintf(
        "<?xml version=\"1.0\"?>" &
        "<methodCall>" &
        "  <methodName>SearchSubtitles</methodName>" &
        "  <params>" &
        "    <param>" &
        "      <value>" &
        "        <struct>" &
        "          <member><name>moviehash</name><value><string>%s</string></value></member>" &
        "          <member><name>sublanguageid</name><value><string>eng</string></value></member>" &
        "        </struct>" &
        "      </value>" &
        "    </param>" &
        "  </params>" &
        "</methodCall>",
        {fhash}
    )

    -- Write the XML to a temp file (curl can read it directly)
    string req_file = get_temp_file(`os_xmlrpc_req.xml`)
    atom req_fh = open(req_file, `wb`)
    puts(req_fh, xml_request)
    close(req_fh)

    -- 3. ---- SEND XML-RPC POST (curl) ------------------------------
    string resp_file = get_temp_file(`os_xmlrpc_resp.xml`)
    string curl_cmd = sprintf(
        `curl -s -H "Content-Type: text/xml" -d @"%s" "http://api.opensubtitles.org/xml-rpc" -o "%s"`,
        {req_file, resp_file}
    )

    integer res = system_exec(curl_cmd)
    if res != 0 then
?{curl_cmd,res}
        {} = delete_file(req_file)
        return
    end if
    {} = delete_file(req_file)   -- cleanup request file

    -- 4. ---- PARSE XML RESPONSE ------------------------------------
--  string xmlresp = read_all(resp_file)
    string xmlresp = get_text(resp_file)
    {} = delete_file(resp_file)
?{`xmlresp`,xmlresp}
 -- 401 Unauthorised - time to throw in the towel methinks...
--/*
    if xmlresp = "" then return "" end if

    -- Look for the first <data><value><string>…</string></value></data> that contains a download link
    -- The XML-RPC response is a struct with a "data" array; each element is a struct with "SubDownloadLink".
    atom data_start = match_regex(xmlresp, `<data>`)
    if data_start = NULL then return "" end if
    string data_section = xmlresp[data_start..$]

    -- Find the first <value><string>…</string></string> inside a <member><name>SubDownloadLink</name>…</member>
    atom link_match = match_regex(data_section,
                                 """<member><name>SubDownloadLink</name><value><string>([^<]+)</string></value></member>""")
    if link_match = NULL then return "" end if
    string zip_url = link_match[2]

    if zip_url = "" then return "" end if

    -- 5. ---- DOWNLOAD ZIP & EXTRACT .SRT ---------------------------
    string zip_path = get_temp_file(`subtemp.zip`)
    string srt_path = get_temp_file(`temp_sub.srt`)

    if system(sprintf(`curl -s -L -o "%s" "%s"`, {zip_path, zip_url})) != 0 then
        return ""
    end if

    -- unzip -p extracts the first matching file to stdout
    if system(sprintf(`unzip -p "%s" *.srt > "%s" 2>/dev/null`, {zip_path, srt_path})) != 0 then
        {} = delete_file(zip_path)
        return ""
    end if
    {} = delete_file(zip_path)   -- cleanup zip

    if not file_exists(srt_path) then return "" end if
    return srt_path   -- <-- this is the .srt file you can feed to MPV
--*/
    end if   -- /too small for a real hash

--end procedure
--*/

--/*
Formats:
 D.. = Demuxing supported
 .E. = Muxing supported
 ..d = Is a device
 ---
 D   bmp_pipe        piped bmp sequence
 DE  ico             Microsoft Windows ICO
 DE  image2          image2 sequence
 D   jpeg_pipe       piped jpeg sequence
 DE  m4v             raw MPEG-4 video
  E  mp4             MP4 (MPEG-4 Part 14)
 DE  mpjpeg          MIME multipart JPEG
 D   png_pipe        piped png sequence
 D   ppm_pipe        piped ppm sequence
 DE  srt             SubRip subtitle
 DE  wav             WAV / WAVE (Waveform Audio)
 D   xbm_pipe        piped xbm sequence

C:\Program Files (x86)\Phix>
-display_hflip
-display_vflip

       
--*/

