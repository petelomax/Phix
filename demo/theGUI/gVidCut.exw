integer ctrl_hover = 0

enum ICON, POSITION, WIDTH, MARGIN, H_OFFSET, VISIBLE, KEY, TIP
constant REC=2, PLAY=4, CUT=6, XTRACT=7, MUTE=8
sequence ctrl_info = {{stop,5,14,0,2,true,'.',`stop`},
                      {rec,40,5,0,4,true,'I',`start segment`},
                      {bck,50,4,2,6,true,M_CTRL+VK_LEFT,`back frame`},
                      {play,58,14,0,2,true,' ',`play/pause`},
                      {fwd,76,4,2,6,true,M_CTRL+VK_RIGHT,`step frame`},
                      {cut,85,5,0,4,true,'O',`end segment`},
                      {xtract,115,10,5,4,true,'X',`extract`},
                      {mute,622/*w-25*/,20,5,0,true,'M',`mute`}}

procedure draw_ctrls(gdx ctrls, integer w,h)
    --
    -- You could, o/c, implement ctrls as a bunch of buttons, but it is
    -- just as easy to draw the icons (which are the hard part anyway),
    -- and hover effects & clicking has turned out quite a bit easier.
    --
    ctrl_info[REC][VISIBLE] = bEditingEnabled
    ctrl_info[CUT][VISIBLE] = bEditingEnabled
    ctrl_info[XTRACT][VISIBLE] = bEditingEnabled
--  ctrl_info[XTRACT][ICON] = iff(bEditingEnabled... xtractG,xtractB,xtract)
    ctrl_info[MUTE][POSITION] = w-25
    if ctrl_hover and ctrl_info[ctrl_hover][VISIBLE] then
        integer p = ctrl_info[ctrl_hover][POSITION],
                q = ctrl_info[ctrl_hover][WIDTH],
                m = ctrl_info[ctrl_hover][MARGIN]
        gDrawRect(ctrls,p-m,0,p+q+m,h-4,true,colour:=#caf0f8) -- (faint blue)
    end if
    atom d = get_duration()
    bool bPaused = iff(d>0?mpv_get_property(mpv_ctx,`pause`,MPV_FORMAT_FLAG):true)
    ctrl_info[PLAY][ICON] = iff(bPaused?play:pause)
    ctrl_info[MUTE][ICON] = iff(bMuted?muted:mute)
    for i,ci in ctrl_info do
        if ci[VISIBLE] then
            gDrawImage(ci[ICON],ctrls,ci[POSITION],ci[H_OFFSET])
        end if  
    end for
    if d>0 then 
        if not bLoaded then
            durations[1] = d
            apply_loaded(true)
            set_aspect_ratio('3') -- D3fault/no
        end if
        if string(restore_subtitles) and length(restore_subtitles)>1 then
            load_subtitles(restore_subtitles)
            restore_subtitles = 0
        end if
        if sub_id=-2 then
            sub_id = -1
            integer tlc = mpv_get_property(mpv_ctx,`track-list/count`,MPV_FORMAT_INT)
--?{`track-list/count`,tlc}
            for i=0 to tlc-1 do
                string prop = sprintf(`track-list/%d/type`,i),
                         id = sprintf(`track-list/%d/id`,i),
                        tlt = mpv_get_property(mpv_ctx,prop)
--?{prop,tlt}
                if tlt=`sub` then
--DEV maybe:
--              if tlt=`sub` and sub_id=-1 then
--                  sub_id = i
--X                 string id = sprintf(`track-list/%d/id`,i)
--,                      lang = sprintf(`track-list/%d/lang`,i)
--?{i,mpv_get_property(mpv_ctx,lang)}
--track-list/N/lang
                    sub_id = mpv_get_property(mpv_ctx,id,MPV_FORMAT_INT)
--track-list/N/id
--if i>2 then
                    exit -- assme en[g] will be first...
--                  if aud_id!=-1 then exit end if
--end if
--              elsif tlt=`audio` and aud_id=-1 then
--X                 string id = sprintf(`track-list/%d/id`,i)
--                  aud_id = mpv_get_property(mpv_ctx,id,MPV_FORMAT_INT)
--                  if sub_id!=-1 then exit end if
                end if
            end for
--/*
{"track-list/count",4}
{"track-list/0/type","video"}
{"track-list/1/type","audio"}
{"track-list/2/type","sub"}
{"track-list/3/type","video"}
-- and after loading and getting a count of 5:
{"track-list/4/type","sub"}
--*/
            gMenuSetAttribute(menus,'V',`ACTIVE`,sub_id!=-1)
            set_subtitle_visibility(sub_id>=0)
--          gMenuSetAttribute(menus,'V',`CHECKED`,sub_id>=0)
        end if
        if seek_to then
            mpv_command_string(mpv_ctx,sprintf(`seek %f absolute`,seek_to))
            seek_to = 0
        end if
        atom pos = mpv_get_property(mpv_ctx,`playback-time`,MPV_FORMAT_DOUBLE)
        string p = elapsed_short(pos,fmt:=`:`), e = elapsed_short(d,fmt:=`:`)
        gDrawText(ctrls,w-30,h/2-2,`%s / %s`,{p,e},TG_W)
    end if
end procedure

function get_ctrl_index(integer x)
    -- convert an x co-ordinate into a control index, or 0
    for i,ci in ctrl_info do
        if ci[VISIBLE] then
            integer p = ci[POSITION],
                    w = ci[WIDTH],
                    m = ci[MARGIN]
            if x>=p-m and x<=p+w+m then return i end if
        end if
    end for
    return 0
end function

procedure ctrl_click_handler(gdx ctrls, sequence status, integer x, y)
    set_seekbar_timer()
    if status[1..2]=`LS` then -- left single click
        integer cdx = get_ctrl_index(x)
        if cdx then
            {} = menu_handler(NULL,ctrl_info[cdx][KEY])
        end if
    end if
end procedure

procedure ctrl_mousemove(gdx ctrls, integer x,/*y*/)
    set_seekbar_timer()
    ctrl_hover = get_ctrl_index(x)
    gSetAttribute(ctrls,`TIP`,iff(ctrl_hover?ctrl_info[ctrl_hover][TIP]:NULL))
    gRedraw(ctrls)
end procedure

procedure ctrl_mouseleave(gdx ctrls)
    set_seekbar_timer()
    ctrl_hover = 0
    gRedraw(ctrls)
end procedure

integer seekbar_hover = -1
string seekbar_tip

--TODO: hover effects (similar to ctrls)
procedure draw_seekbar(gdx seekbar, integer tw,h)
    gDrawRect(seekbar,0,0,tw-1,h-1,colour:=TG_BLACK)
    
    integer w = round(tw*timeval)-2
    if w>=1 then -- Draw playback position:
        gDrawRect(seekbar,1,1,min(w,tw-3),h-2,true,colour:=TG_GREEN)
    end if
    if seekbar_hover!=-1 then
        gDrawText(seekbar,seekbar_hover,h/2,seekbar_tip,{},TG_C)
    end if
    atom duration = get_duration()
    if duration>0 then
        -- Draw marked segments (teal overlay)
        if length(cut_segments) > 0 then
            integer seg_start_x, seg_end_x
--          , seg_width
            for i, segment in cut_segments do
                seg_start_x = round(tw * segment[1] / duration) + 1 -- +1 for 1-based offset
                seg_end_x   = round(tw * segment[2] / duration) + 1
--              seg_width   = max(1,seg_end_x - seg_start_x)
                if seg_start_x>=1 and seg_end_x<=tw then
--                  gDrawRect(seekbar,seg_start_x,1,seg_width,h-2,true,colour:=TG_TEAL)
                    gDrawRect(seekbar,seg_start_x,1,seg_end_x,h-2,true,colour:=TG_TEAL)
                end if
            end for
        end if
    
        -- Draw current in/out points (yellow lines)
        if current_in_point > 0 then
            integer in_x = round(tw * current_in_point / duration) + 1
            if in_x >= 1 and in_x <= tw then
                gDrawLine(seekbar,in_x,1,in_x,h-2,colour:=TG_YELLOW)
            end if
        end if
        if current_out_point > 0 then
            integer out_x = round(tw * current_out_point / duration) + 1
            if out_x>=1 and out_x<=tw then
                gDrawLine(seekbar,out_x,1,out_x,h-2,colour:=TG_YELLOW)
            end if
        end if
    end if

end procedure

procedure update_seekbar(gdx seekbar_timer)
    atom duration = get_duration()
    if duration>0 then
        atom pt = mpv_get_property(mpv_ctx,`playback-time`,MPV_FORMAT_DOUBLE)
        timeval = pt/duration
        positions[1] = iff(timeval>0.999?0:pt)
        gRedraw(seekbar)
        if timeval>0.999 then
            bool pause = mpv_get_property(mpv_ctx,`pause`,MPV_FORMAT_FLAG)
            -- (also pops bFullScreen when it should:)
            if pause then set_pause(true) end if
--          set_pause(FETCH) 
        end if
    elsif time()>toliept then
--?"seekbar_timer stop"
        gSetAttribute(seekbar_timer,`RUN`,false)
    end if
end procedure

procedure jump_to(integer x)
    atom d = get_duration()
    if d>0 then
        integer w = gGetAttribute(seekbar,`SIZE`)[1]
        timeval = max(min(x/w,1),0)
--      gSetAttribute(seekbar,`VALUE`,>)
--      seekbar_hover = x
        gRedraw(seekbar)
        mpv_command_string(mpv_ctx,sprintf(`seek %f absolute`,timeval*d))
    end if
end procedure

bool bDragg = false,
     bOnThumb = false

function seekbar_click(gdx /*seekbar*/, sequence status, integer x, /*y*/) 
    set_seekbar_timer()
    if status[1]='L' then
        integer s2 = status[2]
        if s2='S' then
            if bOnThumb then bDragg = true; return `CAPTURE` end if
        elsif s2='R' then
            if bDragg then  bDragg = false; return `RELEASE` end if
            jump_to(x)
        end if
    end if
    return TG_IGNORE
end function

--/*
from https://www.mux.com/articles/extract-thumbnails-from-a-video-with-ffmpeg#extract-a-single-thumbnail-at-a-specific-timestamp

Extract a single thumbnail at a specific timestamp:
ffmpeg -i input_video.mp4 -vf "select='gte(t,9)',scale=320:-1" -frames:v 1 thumbnail.png

Extract 1 thumbnail for every 10th I-frame or keyframe:
ffmpeg -i input_video.mp4 -vf "select='eq(pict_type,I)',select='not(mod(n,10))',scale=320:-1" -vsync vfr -q:v 2 thumb%04d.png

for i in 20 to 80 step 20
    ffmpeg -noaccurate_seek -ss {i} -i 'https://www.sample-videos.com/video/mp4/720/big_buck_bunny_720p_30mb.mp4' -vframes 1 out-{i}.png
    
    
ffmpeg -i ./Big_Buck_Bunny_360_10s_30MB.mp4 -i ./watermark-ex.png -filter_complex "drawtext=fontfile=/Users/<username>/Library/Fonts/OpenSans-Bold.ttf:text='$UPPERCASE_TITLE':fontcolor=white:fontsize=28:x=(w-tw)/2:y=(h-th)/2,drawtext=fontfile=/Users/<username>/Library/Fonts/OpenSans-SemiBold.ttf:text=\'$DURATION\':x=(w-tw-8):y=(h-th-8):boxborderw=8:fontsize=20:fontcolor=white:box=1:boxcolor=black@0.625,overlay=x=8/2:y=(main_h-overlay_h-8)" -ss 00:00:09.000 -vframes 1 thumbnail.jpg 
--*/

--integer overlay_id = -1

function getint(integer fn, size, skip=0)
    atom res = 0, m = 1
    for i=1 to skip do {} = getc(fn) end for
    for i=1 to size do
        res += getc(fn)*m
        m*=#100
    end for
    return res
end function

constant integer tg_popup = gGetGlobal(`tg_popup`) -- (not documented, see theGUI.e instead of phix.chm)

--/*
ao-volume / audio-device: If the OS drops the audio endpoint, these properties will change unexpectedly or return null string values.
ao-reload mpv_command_string(ctx, "ao-reload");Tears down and completely rebuilds the audio output thread. This is the cleanest programmatic fix.
The easiest workaround is the select the audio track again manually (by default the # key). 
audio-reload

lua:
-- Function to completely rebuild the audio system
function rebuild_audio()
    print("Rebuilding audio pipeline...")
    
    -- Save the current volume and audio track ID
    local current_vol = mp.get_property("volume")
    local current_aid = mp.get_property("aid")
    
    -- Force audio pipeline teardown by disabling the audio track
    mp.set_property("aid", "no")
    
    -- Cycle the Audio Output driver to force libmpv to free the device context
    -- Setting it to null then back to default forces a complete rebuild
    mp.set_property("ao", "null")
    mp.set_property("ao", "") 
    
    -- Restore the audio track and volume to re-initialise WASAPI
    mp.set_property("aid", current_aid)
    mp.set_property("volume", current_vol)
    
    print("Audio pipeline rebuilt successfully!")
end

-- Function to check audio status on unpause
function check_audio_on_unpause(prop, paused)
    -- We only care when paused becomes false (meaning it unpaused)
    if paused == false then
        -- Check if mpv thinks an audio stream should be playing
        local aid = mp.get_property("aid")
        
        if aid ~= "no" and aid ~= nil then
            -- Query the actual codec name currently active in the audio hardware
            local codec = mp.get_property("audio-codec-name")
            local ao_active = mp.get_property("current-ao")
            
            print("Unpaused. Active AO: " .. tostring(ao_active) .. " | Codec: " .. tostring(codec))
            
            -- If an audio track is selected but the hardware output or codec has crashed (returns empty)
            if not codec or codec == "" or not ao_active or ao_active == "" then
                print("Audio crash detected!")
                rebuild_audio()
            end
        end
    end
end

-- Watch the "pause" property for changes
mp.observe_property("pause", "bool", check_audio_on_unpause)

C/C++:
// 1. Get current track so you can restore it
