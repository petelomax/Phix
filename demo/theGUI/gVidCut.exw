--
-- demo\theGUI\gVidCut.exw
-- =======================
-- 
--  An attempt at something half-way between MPC-HC and LosslessCut
--
--  Note this expects ffmpeg and libmpv to be manually installed, and remains
--  a strictly desktop-only program (aka JavaScript/browser-incompatible).
--
--  For docs, press F1 when on the word gVidCut in theEditor, or open
--     phix.chm and navigate to Other Libraries/theGUI/libmpv/gVidCut.
--
-- TODO: add a resume playing feature (given VK_HOME is available, no need to make it optional...)
--       never/once/partial/playing...
--       black/blue/green extract icon...
--       preview on seekbar hover...
--       single instance
--       thumbnail sheet print...
--
--puts(1,"")
--requires(64,true)
without javascript_semantics -- (**not** browser compatible)
--with trace
--without debug

include theGUI.e
include builtins\pdates.e
include builtins\ini.e
include builtins\syswait.ew
include builtins\pipeio.e
include builtins\VM\pcmdlnN.e
include builtins\pdate.e
include builtins\penv.e

