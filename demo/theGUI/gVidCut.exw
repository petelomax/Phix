procedure apply_loaded(bool flag)
--?{`apply_loaded`,flag}
    bLoaded = flag
    -- enable/disable those menu entries that need a file already loaded
--  for id in {M_CTRL+'L',M_CTRL+'D',M_SHIFT+VK_F10,M_NOT_KEY+'A',M_ALT+VK_CR,'P'} do
