procedure seekbar_mousemove(gdx seekbar, integer x,y, bool left, middle, right)
    set_seekbar_timer()
    atom d = get_duration()
    if d then
        integer {w,h} = gGetAttribute(seekbar,`SIZE`)
        atom tv = max(min(x/w,1),0)
        if not left then
            bDragg = false
            atom thumbx = w*timeval
            bOnThumb = x>=thumbx-5 and x<=thumbx+5
            gSetAttribute(seekbar,`CURSOR`,iff(bOnThumb?`WE_RESIZE`:NULL))
        elsif bDragg then
            jump_to(x)
        end if
-- Nah, I'm gonna do it!!
        -- Aside: MPC-HC has a natty (optional) litte feature whereby hovering on 
        -- the seekbar (aka seekbar) displays a thumbnail tooltip-like thing, but
        -- you may as well just drag it directly and get full-screen image, imnsho.
        -- (Admittedly that idea is critical for YouTube/online playing, whereby
        --  dragging would buffer like crazy, but on a desktop it's near-instant.)
        atom s = tv*d
        seekbar_hover = x
        seekbar_tip = elapsed_short(s,0,`:`)
        gRedraw(seekbar)        
--/!*
--      -- aside: when bEditingEnabled it makes much more sense to seek(video) aka jump_to(x).
        bool bAbsoluteThumbHeight = ends("px",seek_thumb_height)
        integer sth
        if bAbsoluteThumbHeight then
            sth = to_number(seek_thumb_height[1..-3]) -- eg 25px
        else
            assert(seek_thumb_height[$]='%')
            sth = to_number(seek_thumb_height[1..-2]) -- eg 25%
        end if
        if sth and not bEditingEnabled then
            -- logically move the otherwise invisible spacer so its bl is where we
            -- want the tl of sbview, the [paused and shrunk] preview video popup.
            integer {vw,vh} = gGetAttribute(video,`SIZE`)
            if bAbsoluteThumbHeight then
                {w,h} = {round(sth*vw/vh),sth}
            else
                {w,h} = {round((sth/100)*vw),round((sth/100)*vh)}
            end if
            {x,y} = {round(tv*vw-w/2),vh-h}
--          gSetAttribute(spacer,`CBXY`,{x,y-10})
--          gSetAttribute(spacer,`CBXY`,{x,y})
            gSetAttribute(spacer,`CBXY`,{x,y+13})
            gSetAttribute(sbview,`SIZE`,{w,h})
--DEV I think this needs to do a SetWindowPos, and with HWND_TOP[MOST] perhaps...
--AH: is it only working because/when it's going through "the only video on a dialog"??
            tg_popup(spacer,sbview)
--this probably wants to be in yet another timer...
--?{"sb_ctx",sb_ctx}
            if bLoadSeekbar and sb_ctx!=NULL then
--          if bLoadSeekbar then
                bLoadSeekbar = false
                mpv_command_string(sb_ctx,sprintf(`loadfile "%s"`,{video_file}))
                mpv_command_string(sb_ctx,`set pause no`) -- Start decoding to prime VO
--              mpv_command_string(sb_ctx,`set pause yes`)
            end if

