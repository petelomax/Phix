constant VIDCUTINI = `gVidCut`,
ini_defaults = `
-- gVidCut.ini
mute = 0
volume = "0.5"
max_recent = 20
seek_thumb_height = 25%
source_list_width = 80
fragment_list_width = 80
`
ini_load(VIDCUTINI,ini_defaults)
bMuted = ini_setting(`mute`)
integer max_recent = ini_setting(`max_recent`),
        source_list_width = ini_setting(`source_list_width`),
        fragment_list_width = ini_setting(`fragment_list_width`)
string seek_thumb_height = ini_setting(`seek_thumb_height`)

constant RECENTINI = VIDCUTINI&`_Recent`,
recent_defaults = `
-- gVidCut_Recent.ini: recent/favourites held as fullpath = {bFav,last_play,duration,subtitles,position}
` -- eg C:\Program Files (x86)\Phix\demo\theGUI\hermit.mpg = {false,19/09/26 06:01:11,21.473180,0,1.534867}

sequence recent = {}, recent_dirs = {}, recent_files = {}, favs = {}, timestrs = {}, times = {}, durations = {},
         filedates = {}, filesizes = {}, subtitles = {}, positions = {}
procedure load_recent_files()
    ini_load(RECENTINI,recent_defaults)
    bool bFav; atom dur,p; sequence lps; object subt
    for fullpath in ini_keynames(RECENTINI) do
        if get_file_type(fullpath)==FILETYPE_FILE then
            string sfp = ini_setting(fullpath)
            sequence r = scanf(sfp,`{%t,%s,%f,%s,%f}`)
            if length(r)!=1 then ?9/0 end if
            {bFav,lps,dur,subt,p} = r[1]
            recent &= {fullpath}
            recent_dirs &= {get_file_path(fullpath)}
            recent_files &= {get_file_name(fullpath)}
            favs &= bFav
            timestrs &= {lps}
            times &= {parse_date_string(lps,{`DD/MM/YY hh:mm:ss`})}
            durations &= dur
            filedates &= {get_file_date(fullpath)}
            filesizes &= get_file_size(fullpath)
            if subt=`0` then subt = NULL end if
            subtitles &= {subt}
            positions &= p
        end if
    end for
end procedure
load_recent_files()

--DEV somewhere better than this... ini file? get_file_path(ini_filename(VIDCUTINI))&VIDCUTINI??
function get_temp_file(string filename)
--  return join_path({current_dir(),filename})
--  return join_path({get_file_path(ini_filename(VIDCUTINI)),VIDCUTINI,filename})
    string path = get_file_path(ini_filename(VIDCUTINI))
    path = join_path({path,VIDCUTINI})
    if get_file_type(path)!=FILETYPE_DIRECTORY then
        assert(create_directory(path))
    end if
    path = join_path({path,filename})
    path = mpv_normalize_path(path)
    return path
end function
--constant seekbar_img = get_temp_file(`seekbar_img.bmp`)

include builtins\pipeio.e

function read_pipe(string cmd)
    sequence pipes = {0,create_pipe(INHERIT_READ),0}
    atom hProc = system_exec(cmd,12,pipes),
         hPipe = pipes[PIPOUT][READ_PIPE]
    object res = read_from_pipe(hPipe,hProc)
    if string(res) then 
        while true do
            object buff = read_from_pipe(hPipe,hProc)
            if buff=-1 then exit end if
            res &= buff
        end while
    else
        res = ""
    end if
--sleep(1)
    if platform()=WINDOWS then
        hProc = close_handles(hProc)
    end if
    pipes = close_handles(pipes)
--?{`read_pipe`,cmd,res}
    return res
end function

--SUG: slap these in the ini file, so we don't have to flash up consoles on startup, or rather do so just once...
function get_ff_versions()
    sequence result = {0,0}
    for i,ff in {`ffprobe`,`ffmpeg`} do
        string res = read_pipe(ff&` -version`)
        result[i] = trim(res[1..match(` Copyright`,res)])
    end for
    return result   
end function
constant {ffprobe_version,ffmpeg_version} = get_ff_versions(),
         bFFprobe = ffprobe_version!="",
         bFFmpeg = ffmpeg_version!=""

constant string PROBE_WH_AR = join({`-v error`, -- aka `-loglevel error`,
                                    `-select_streams v:0`,
                                    `-show_entries stream=width,height,sample_aspect_ratio`,
                                    `-of csv` -- aka `-output_format csv`
                                    },' ')

integer video_width = 640, video_height = 480, sar_num = 1, sar_den = 1

function probe_options(string video_file)
    assert(bFFprobe) -- shd'a gMessage()'d b4/instead'a calling me!
    -- get true display dimensions and aspect ratio via ffprobe
    string ffprobe_cmd = sprintf(`ffprobe %s "%s"`,{PROBE_WH_AR,video_file}),
           csv = read_pipe(ffprobe_cmd) -- eg "stream,1440,1080,1:1\r\n"
--?ffprobe_cmd
--`ffprobe -v error -select_streams v:0 -show_entries stream=width,height,sample_aspect_ratio -of csv "C:/Users/petel/Downloads/Dexter.S08E09.540p.x265.AAC.[9jaRocks.Com].mkv"`
    if csv="" then return false end if
    -- aside: a trailing ',' seems random...
    csv = trim_tail(csv,",\r\n")
    -- aside: that's not exactly very helpful, now is it:
    if ends(`,N/A`,csv) then csv[-3..-1] = `1:1` end if
--?{`csv`,csv}
    sequence r = scanf(csv,`stream,%d,%d,%d:%d`)
    if length(r)!=1 then 
        gMessage(dlg,`Failed to parse ffprobe output: `&csv,`Error`)
        return false
    end if
    {video_width,video_height,sar_num,sar_den} = r[1]
--?{`video_width`,video_width,`video_height`,video_height,`sar_num`,sar_num,`sar_den`,sar_den}
    return true
end function

