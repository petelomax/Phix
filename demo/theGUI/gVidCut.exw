procedure set_seekbar_timer()
    toliept = time()+10
    if mpv_ctx and not gGetAttribute(seekbar_timer,`RUN`) then
--?`run seekbar_timer`
        gSetAttribute(seekbar_timer,`RUN`,true)
    end if
end procedure

bool bLoadSeekbar = false
object folder = NULL -- for gOpenFile/gSaveFile <== last opened file's directory

procedure update_recent_and_open_file(string txt)
--?{`update_recent_and_open_file`,txt}
    if length(txt)>0 then
        set_seekbar_timer()
        string timestr = format_timedate(date(),`DD/MM/YY hh:mm:ss`)
        integer k = find(txt,recent)
        if k then
            bool bFav = favs[k]
            object sk = subtitles[k]
            atom pk = positions[k]
            recent[2..k] = recent[1..k-1];                  recent[1] = txt
            recent_dirs[2..k] = recent_dirs[1..k-1];        recent_dirs[1] = get_file_path(txt)
            recent_files[2..k] = recent_files[1..k-1];      recent_files[1] = get_file_name(txt)
            favs[2..k] = favs[1..k-1];                      favs[1] = bFav
            times[2..k] = times[1..k-1];                    times[1] = date()
            timestrs[2..k] = timestrs[1..k-1];              timestrs[1] = timestr
            subtitles[2..k] = subtitles[1..k-1];            subtitles[1] = sk
            positions[2..k] = positions[1..k-1];            positions[1] = pk
            durations[2..k] = durations[1..k-1]; 
            filedates[2..k] = filedates[1..k-1];
            filesizes[2..k] = filesizes[1..k-1];
        else
            recent = prepend(recent,txt)
            recent_dirs = prepend(recent_dirs,get_file_path(txt))
            recent_files = prepend(recent_files,get_file_name(txt))
            favs = prepend(favs,false)
            timestrs = prepend(timestrs,timestr)
            times = prepend(times,timestr)
            subtitles = prepend(subtitles,0)
            positions = prepend(positions,0)
            durations = prepend(durations,0)
            filedates = prepend(filedates,0)
            filesizes = prepend(filesizes,0)
        end if
        durations[1] = `???`
        filedates[1] = get_file_date(txt)
        filesizes[1] = get_file_size(txt)
--?{`recent_files`,source_line(),recent_files}
        if mpv_ctx!=0 then
            video_file = mpv_normalize_path(recent[1])
            if file_exists(video_file)
--          and probe_options(video_file) then
            and (bFFprobe=false or probe_options(video_file)) then
--          if true then
                subtitle_file = ""
                folder = get_file_path(recent[1])
                --
                -- Note: you cannot do anything until you know it has successfully loaded, 
                --       which is detected by get_duration()>0, and the traditional place
                --       to do that is draw_ctrls()/(not bLoaded)/(sub_id=-2), albeit the
                --       first place where it actually triggers is usually draw_seekbar().
                --
                mpv_command_string(mpv_ctx,sprintf(`loadfile "%s"`,{video_file}))
                mpv_command_string(mpv_ctx,`set pause no`) -- Start decoding to prime VO
                bLoadSeekbar = true
                apply_loaded(false)
--?{`video_file`,source_line(),video_file}
                if bFFprobe then
                    -- resize to fit:
                    integer {cw,ch} = gGetAttribute(video,`SIZE`),
                            {dw,dh} = gGetAttribute(dlg,`SIZE`),
                            {sw,sh} = gGetGlobal(`SCREENSIZE`),
                            vw = round(video_width*sar_num/sar_den),
                            vh = video_height
--?{`cw`,cw,`ch`,ch,`dw`,dw,`dh`,dh,`sw`,sw,`sh`,sh,`vw`,vw,`vh`,vh}
                    dw -= cw
                    dh -= ch
                    if vh+dh>sh then
                        -- scale down, heeping aspect ratio the same
                        integer nh = sh-dh
                        {vw,vh} = {round(vw*nh/vh),nh}
--?{`nh`,nh,`vw`,vw,`vh`,vh}
                    end if
                    if vw+dw>sw then
                        ?9/0 -- placeholder... (which may never ever trigger)
--should it, compare with/out this:
--                      integer nw = sw-dw
--                      {vw,vh} = {nw,round(vh*nw/vw)}
                    end if
                    sequence nwh = {vw+dw,vh+dh}
--?{`nwh`,nwh}
                    gSetAttribute(dlg,`SIZE`,nwh)
                    gSetAttribute(dlg,`TITLE`,get_file_name(video_file))
                    gShow(dlg,TG_CENTER,TG_CENTER)

                    timeval = 0
                    gRedraw(dlg)
                elsif first_time_ffprobe_less then
                    first_time_ffprobe_less = false
                    gMessage(dlg,`ffprobe not installed`,`Warning`)
                end if
                seek_to = positions[1]
                restore_subtitles = subtitles[1]
--else gMessage()?
            end if
        end if
    end if
end procedure

gdx recent_window = NULL,
    recent_table

procedure close_recent_and_play(integer row)
    -- (row is post-filter_dx here)
    gHide(recent_window)
    update_recent_and_open_file(recent[row])
end procedure

procedure toggle_fav(gdx table, integer row)
    -- (row is post-filter_dx here)
    favs[row] = not favs[row]
    sequence data = gGetAttribute(table,`DATA`)
    gSetAttribute(table,`DATA`,NULL)
    data[1][row][1] = favs[row]
    gSetAttribute(table,`DATA`,data)
    gRedraw(table)
end procedure

sequence data, filter_dx

procedure recent_click(gdx table, sequence status, integer row, col)
    if status[1]='L' then
        row = filter_dx[row]
        if status[2]='D' then
            close_recent_and_play(row)
        elsif status[2]='S' and col=1 then
            toggle_fav(table,row)
        end if  
    end if  
end procedure

gdm favicon, notfavicon

function fav_fmt(integer /*get_data*/, row, col)
    bool fav = data[filter_dx[row]][col]
    return {`image`,iff(fav?favicon:notfavicon)}
end function

include builtins\unidecode.e

function rf_mixed_case(integer /*get_data*/, row, /*col*/)  
    -- for case-insensitve sorting, and presence of subtitles/resume point
    row = filter_dx[row]
    string filename = recent_files[row]
--  filename = unidecode(filename) -- (temp/for visual confirmation only)
    sequence fs = {}
    if string(subtitles[row]) 
    and file_exists(subtitles[row]) then
        fs = {`srt`}
    end if
    if positions[row]!=0 then
        fs &= {elapsed_short(positions[row],0,`:`)}
    end if
    if length(fs) then filename &= sprintf("  [%s]",{join(fs,',')}) end if
    return filename
end function

constant string date_fmt = `%[3]02d/%[2]02d/%[1]02d %[4]02d:%[5]02d`

function size_fmt(integer get_data, row, col)
    return file_size_k(data[filter_dx[row]][col])
end function

function dur_fmt(integer /*get_data*/, row, col)
    object res = data[filter_dx[row]][col]
    if not string(res) then -- `???`...
        res = elapsed_short(res,0,`:`)
    end if
    return res
end function

function td_fmt(integer /*get_data*/, row, col)
    object td = data[filter_dx[row]][col]
    if not string(td) then
        td = format_timedate(td,`DD/MM/YY hh:mm:ss`) 
    end if
    return td
end function

function get_data(integer row)
    if row=0 then return length(filter_dx) end if
    return data[filter_dx[row]]
end function

constant RF_TITLE = `Recent Files`
string ac_filter = "" -- auto cyclic filter, see gVidCut docs

procedure apply_filter()
    integer ld = length(data)
    filter_dx = tagset(ld)
    sequence terms = split(ac_filter)
    string title = RF_TITLE
    if length(terms) then
        sequence sdata = repeat(0,ld)
        for i=1 to ld do sdata[i] = lower(get_data(i)) end for
        integer terms_ok = 0
        for t in reverse(terms) do
            sequence f2 = {}
            for f in filter_dx do
                for column in sdata[f] do
                    if string(column) and match(t,column) then
                        f2 &= f
                        exit
                    end if
                end for
            end for
            if length(f2)=0 then exit end if
            filter_dx = f2
            terms_ok += 1
        end for
        string term
        if terms_ok=0 then
            term = terms[$]
            integer chars_ok = 1
            for l=1 to length(term) do
                sequence f2 = {}
                string t = term[-l..-1]
                for f in filter_dx do
                    for column in sdata[f] do
                        if string(column) and match(t,column) then
                            f2 &= f
                            exit
                        end if
                    end for
                end for
                if length(f2)=0 then exit end if
                filter_dx = f2
                chars_ok = l
            end for
            term = term[-chars_ok..-1]
        else
            term = join(terms[-terms_ok..$])
        end if
        integer n = length(filter_dx)
        if n!=ld then
            title = sprintf(`%s [%s, %d/%d]`,{RF_TITLE,term,n,ld})
        else
            title = sprintf(`%s [%s, (none)]`,{RF_TITLE,term})
        end if
    end if
    gSetAttribute(recent_window,`TITLE`,title)
end procedure

procedure recent_key_handler(gdx table, integer c)
    if c=VK_CR or (c=' ' and ac_filter="")  then
        integer row = gGetAttribute(table,`SELECTED`)
        if row then
            row = filter_dx[row]
            if c=VK_CR then
                close_recent_and_play(row)
            else
                toggle_fav(table,row)
            end if
        end if  
    end if  
    if c=VK_DEL or c=VK_BS then
        if length(ac_filter) then
            ac_filter = ac_filter[1..$-1]
        end if
    elsif c>=' ' and c<#7F then
        ac_filter &= lower(c)
    end if
    apply_filter()
end procedure

procedure open_recent()
    if recent_window=NULL then
        sequence columns = {{`Fav`,25,`C`},
                            {`Directory`,160,`L`},
                            {`File`,260,`CL`},
                            {`Date`,60,`CR`},
                            {`Size`,40,`CR`},
                            {`Duration`,40,`CR`},
                            {`Last played`,60,`CR`}}
        recent_table = gTable(columns,{{}},0)
        gSetHandler(recent_table,`TABCLICK`,recent_click)
        gSetHandler(recent_table,`TABKEY`,recent_key_handler)
        recent_window = gDialog(recent_table,dlg,RF_TITLE,`SIZE=1200x600`)
        favicon = gGetGlobal(`CHECKED_ICON`)
        notfavicon = gGetGlobal(`UNCHECKED_ICON`)
    end if
    sequence rf_lower_case = apply(apply(recent_files,unidecode),lower)
--  -- (leetcode handling, if we ever need it:)
--  for i,txt in rf_lower_case do
--      rf_lower_case[i[ = substitute_all(txt,"30@$","eoas")
--  end for
    data = columnize({favs,recent_dirs,rf_lower_case,filedates,filesizes,durations,times})
    sequence ctrl = {fav_fmt,        0,rf_mixed_case, date_fmt, size_fmt,  dur_fmt,td_fmt}
    filter_dx = tagset(length(data))
    apply_filter()
    gSetAttribute(recent_table,`DATA`,{get_data,ctrl})
    gShow(recent_window)
end procedure

procedure export_video(gdx dlg)
?`export_video`
    assert(bFFmpeg) -- shd'a gMessage()'d b4/instead'a calling me!
    if length(cut_segments)=0 then
        gMessage(dlg,`No segments marked for export`,`Error`)
        return
    end if
    
    string default_name = get_temp_file(`output.mp4`),
--         fltr = `MP4 Video (*.mp4)|*.mp4|All Files (*.*)|*.*`
--         output_file = gFileSaveDialog(dlg,`Export Video`,default_name,fltr)
           output_file = default_name
    
    if output_file != "" then
        ?{`Exporting to`,output_file}
        -- BUILD CONCATENATION LIST
        string concat_list = ""
        for segment in cut_segments do
            concat_list &= sprintf("file '%s'\n",{segment[3]})
        end for
        
        -- WRITE CONCATENATION LIST TO TEMP FILE
        string list_file = get_temp_file(`vidcut_concat.txt`)
--      gFileWrite(list_file,concat_list)
--      write_file(list_file,concat_list)
        integer fn = open(list_file,`w`)
        puts(fn,concat_list)
        close(fn)
        
        -- BUILD FFMPEG COMMAND (lossless concat)
        string ffmpeg_cmd = sprintf(
            `ffmpeg -y -f concat -safe 0 -i "%s" -c copy "%s"`,
            {list_file,output_file}
        )
        
        ?{`FFMPEG CMD:`,ffmpeg_cmd}
        atom exit_code = system_exec(ffmpeg_cmd)
        if exit_code = 0 then
            gMessage(dlg,`Export successful!`,`Success`)
            -- CLEANUP
--          gFileDelete(list_file)
            {} = delete_file(list_file)
            cut_segments = {}  -- Clear segments after export
            bHasUnsavedChanges = false
            if get_file_type(output_file)=FILETYPE_FILE then
                gMenuSetAttribute(menus,M_CTRL+'S',`ACTIVE`,true)
            end if
        else
            gMessage(dlg,`Export failed (see console)`,`Error`)
        end if
    end if
end procedure

procedure set_volume(gdx id, atom c)
    set_seekbar_timer()
    -- if id!=volume, c is 0 or VK_UP/VK_DOWN or +/-1,
    -- else in fact c===v, but no-one cares about that.
    atom v = gGetAttribute(volume,`VALUE`)
    if id!=volume and c!=0 then
        v = max(min(v+iff(c=VK_UP or c=+1?0.01:-0.01),1),0)
        gSetAttribute(volume,`VALUE`,v)
        gRedraw(volume)
    end if
    if mpv_ctx!=0 then
        mpv_set_property(mpv_ctx,`volume`,MPV_FORMAT_DOUBLE,v*100)
    end if
    ini_restore(VIDCUTINI)
    ini_set(`volume`,sprintf(`"%f"`,v))
end procedure

procedure toggle_mute()
    mpv_command_string(mpv_ctx,`cycle mute`)
    bMuted = not bMuted
    gMenuSetAttribute(menus,'M',`CHECKED`,bMuted)
    ini_restore(VIDCUTINI)
    ini_set(`mute`,bMuted)
--hm, -ao=pulse seems to make mpv work again.
--ao=alsa
--audio-device=auto
end procedure

procedure move_back(string filename)
    bool res = move_file(`output.mp4`,filename,true)
    if res then 
        gMenuSetAttribute(menus,M_CTRL+'S',`ACTIVE`,false)
--else gMessage?
    end if
end procedure

procedure save_as()
    if get_file_type(`output.mp4`)=FILETYPE_FILE then
        object name = NULL
--DEV   if length(?in_files)=1 then name = infiles[1] end if
        gSaveFile(dlg,move_back,name:=name)
    end if
end procedure

procedure load_subtitles(string subtitle_path)
    if get_duration()>0 then
        if length(subtitle_path) then
            mpv_command_string(mpv_ctx,sprintf(`sub-add "%s"`,{mpv_normalize_path(subtitle_path)}))
            sub_id = -2
            subtitle_file = subtitle_path  -- Track for cleanup
            subtitles[1] = subtitle_path
            ?{`Subtitle loaded:`, subtitle_path}
        else
            sequence filters = {{`SubRip Subtitle (*.srt)`,`*.srt`}, {`All Files (*.*)`,`*.*`}}
            gOpenFile(dlg,load_subtitles,NULL,filters)
            subtitles[1] = NULL
        end if
    end if
end procedure

procedure mpv_drop(string filename)
    if ends(`.srt`,filename) then
        load_subtitles(filename)
    else
        update_recent_and_open_file(filename)
    end if
end procedure

procedure mark_in()
    assert(bFFmpeg) -- shd'a gMessage()'d b4/instead'a calling me!
    -- Mark In point
    current_in_point = mpv_get_property(mpv_ctx,`playback-time`,MPV_FORMAT_DOUBLE)
    bHasUnsavedChanges = true
    ?{`Marked IN at`,current_in_point,`s`}
end procedure

procedure mark_out()
    assert(bFFmpeg) -- shd'a gMessage()'d b4/instead'a calling me!
    -- Mark Out point
    current_out_point = mpv_get_property(mpv_ctx,`playback-time`,MPV_FORMAT_DOUBLE)
    bHasUnsavedChanges = true
    ?{`Marked OUT at`,current_out_point,`s`}
    -- AUTOMATICALLY EXTRACT SEGMENT WHEN OUT IS MARKED (if IN is set)
    if current_in_point>=0 and current_out_point>current_in_point then
        string tempfile = get_temp_file(sprintf(`segment_%03d.mp4`,{length(cut_segments)+1}))
        string ffmpeg_cmd = sprintf(`ffmpeg -y -ss %f -to %f -i "%s" -c copy "%s"`,
                {current_in_point,current_out_point,video_file,tempfile})
        ?{`Extracting segment:`,ffmpeg_cmd}
        integer exit_code = system_exec(ffmpeg_cmd)
        if exit_code = 0 then
            cut_segments &= {{current_in_point,current_out_point,temp_file}}
            ?{`Segment added (total:`,length(cut_segments),`)`}
            -- Reset points for next segment
            current_in_point = 0
            current_out_point = 0
        else
            ?{`Segment extraction failed`}
        end if
    end if
end procedure

gdx properties_dlg = NULL, info
constant pfmt = `
File Name: %s
Directory: %s
File date: %s
Disk size: %s
`
-- lots more stuff to go in there...
--sequence durations = {},
--storage size, display size, aspect ratio, subtitles[/embedded]

procedure show_properties(integer shift)
    if shift then 
        string msg = sprintf(pfmt,{recent_files[1],
                                   recent_dirs[1],
                                   sprintf(date_fmt,filedates[1]),
                                   file_size_k(filesizes[1])})
        if properties_dlg=NULL then
            info = gLabel(msg,`EXPAND=BOTH`)
            gdx ok = gButton(`OK`,gQuit),
              hbox = gHbox({ok},`SPACE=LEFT`),
              vbox = gVbox({info,hbox},`MARGIN=10`)
            properties_dlg = gDialog(vbox,dlg,`Properties`)
            gSetAttribute(properties_dlg,`DEFAULTENTER`,TG_CLOSE)
        else
            gSetAttribute(info,`TITLE`,msg)
--          sequence nwh = sq_add(gGetTextExtent(msg),{30,75})
--          gSetAttribute(properties_dlg,`SIZE`,nwh)
        end if
        gShow(properties_dlg,TG_CENTER,TG_CENTER)
    end if
end procedure

function yes_action()
--?`yes_action`
    export_video(dlg)
    if length(cut_segments) = 0 then  -- Only close if export succeeded or cancelled
        gHide(dlg)
    end if
    return TG_CLOSE -- (close the message box)
end function

function no_action()
--?`no_action`
--May be needed:
    bHasUnsavedChanges = false
    gHide(dlg)
    return TG_CLOSE -- (close the message box)
end function

function cancel_action()
--?`cancel_action`
    return TG_CLOSE -- (close the message box)
end function

function close_handler()
--?`close`
    if bHasUnsavedChanges then
        gMessage(dlg,`Save changes before closing?`,`Confirm`,
                     {NULL,yes_action,no_action,cancel_action})
        return TG_IGNORE  -- Don't close yet
    end if
    mpv_ctx = mpv_terminate_destroy(mpv_ctx)
    ini_save(VIDCUTINI)
    ini_delete_all(RECENTINI)
    integer saved = 0
    for i,d in durations do
        if (favs[i] or saved<max_recent)
        and atom(d) then -- (omit unloadables)
            object subi = subtitles[i]
            if find(subi,{0,"\0"}) then subi="0" end if
            string setting = sprintf(`{%t,%s,%f,%s,%f}`,{favs[i],timestrs[i],d,subi,positions[i]})
            ini_set(recent[i],setting,false)
            saved += 1
        end if
    end for
    ini_save(RECENTINI)
    return TG_CONTINUE
end function

procedure quick_restart()
    if close_handler()=TG_CONTINUE then
        requires({-machine_bits(),"-restart"},0b1001)
    end if
end procedure

function key_handler(gdx dlg, integer c, bool ctrl, shift, alt)
--?{`key_handler`,dlg, c, gGetKeyName(c), {ctrl, shift, alt}}
    set_seekbar_timer()
    if c=VK_F1 then
        gMessage(dlg,help_text,title)
        return TG_IGNORE -- (don't open browser help!)
    end if
    c = upper(c)
    atom d = get_duration()
    if alt then
        switch c do
            case VK_CR: toggle_fullscreen()
            case 'A': gMessage(dlg,about_txt,`About`)
        end switch
    elsif ctrl then
        switch c do
            case 'O': gOpenFile(dlg,update_recent_and_open_file,NULL,folder)
            case 'Q': quick_restart()
            case 'R': open_recent()
            case 'S': save_as()
--          case 'T': test()
            case 'L': load_subtitles("")
--          case 'D': download_subtitle_mpchc_style()
            case VK_RIGHT: if d>0 then mpv_command_string(mpv_ctx,`frame-step`) end if
            case VK_LEFT: if d>0 then mpv_command_string(mpv_ctx,`frame-back-step`) end if
        end switch
    elsif d>0 then
        if mpv_ctx=0 then ?9/0 end if -- sanity check
        if c>='1' and c<='6' then
            set_aspect_ratio(c)
        else
            switch c do
                case VK_SP: set_pause(TOGGLE)
                case VK_UP, VK_DOWN: set_volume(0,c)
                case VK_RIGHT: mpv_command_string(mpv_ctx,`seek +5 relative`)
                case VK_LEFT: mpv_command_string(mpv_ctx,`seek -5 relative`)
                case VK_HOME: mpv_command_string(mpv_ctx,`seek 0 absolute`)
                case VK_END: mpv_command_string(mpv_ctx,sprintf(`seek %f absolute`,{d}))
                case '.': set_pause(true)
                case 'F': toggle_fullscreen()
                case 'I': mark_in()
                case 'O': mark_out()
                case 'V': set_subtitle_visibility(-1) // toggle
                case VK_F10: show_properties(shift)
--DEV replace with Ctrl Z/Y:
                case VK_DEL:  -- Clear all segments
                    if length(cut_segments) > 0 then
                        cut_segments = {}
                        current_in_point = 0
                        current_out_point = 0
                        bHasUnsavedChanges = false
                        ?{`All segments cleared`}
                    end if
                case VK_BS:  -- Undo last segment
                    if length(cut_segments) > 0 then
                        cut_segments = cut_segments[1..length(cut_segments)-1]
                        bHasUnsavedChanges = true
                        ?{`Last segment removed (remaining:`,length(cut_segments),`)`}
                        -- Reset points if we had a partial segment
                        if current_in_point > 0 then
                            current_in_point = 0
                            current_out_point = 0
                        end if
                    end if
            end switch
        end if
    end if
    switch c do
        case 'E':
            if not bFFmpeg then
                gMessage(dlg,`ffmpeg not installed`,`Error`)
            elsif not bFullscreen then
                bEditingEnabled = not bEditingEnabled
                gSetAttribute({sources,fragments},`VISIBLE`,bEditingEnabled)
                gRedraw(dlg)
            end if
        case 'M': toggle_mute()
        case VK_ESC: 
            if bFullscreen then
                toggle_fullscreen()
                set_pause(true)
            elsif not bHasUnsavedChanges then 
                return TG_CLOSE
            else
                gHide(dlg) -- it works!!
            end if
    end switch
    gRedraw(dlg)
    return TG_DEFAULT
end function

function menu_handler(gdx menu, integer id)
    if id='F' then
        --
        -- fix aspect ratio
        -- (All I know is that I once fixed a badly squidged 960x720 video back to a watchable 1280x720 like this):
        -- ffmpeg -i 720p.h264.mp4 -map 0 -c copy -bsf:v h264_metadata=sample_aspect_ratio=4/3 -aspect 16/9 720pffs.mp4
        -- (by which I mean I no longer had to manually override the aspect ratio, it just immediately played properly)

--      integer exit_code = system_exec(cmd) ..
--      obvs. check file was created, offer to play it, and later offer to overwrite original..

        gMenuSetAttribute(menus,'3',`CHECKED`,true) -- re-select d3fault
        gMenuSetAttribute(menus,'F',`ACTIVE`,false) -- disable self

    else
        integer {c,ctrl,shift,alt} = gMenuCcsa(id)
        {} = key_handler(dlg,c,ctrl,shift,alt) 
    end if
    if id==M_ALT+VK_F4 then
        gHide(dlg) -- (not just the right-click popup menu)
        return TG_CLOSE
    end if
    return TG_DEFAULT
end function

atom ldt = -1 -- left down time, for verifying a mouse button release is "ours".

procedure dlg_click_handler(gdx /*id*/, sequence status)
    set_seekbar_timer()
    if status[1..2]=`RS` then -- right single click
        gPopupMenu(dlg,popupmenu)
    elsif status[1..2]=`LS` then -- left down
        ldt = time()
    elsif status[1..2]=`LR`  -- left release, but first let's be certain it really is
      and ldt>time()-0.5     -- ours, not residual from (eg) the recent_files pop-up
      and get_duration()>0 then -- and only when there's a successfully loaded video
        set_pause(TOGGLE)
    end if
end procedure

procedure mpv_init(atom handle)
--?"mpv_init"
    mpv_ctx = mpv_create()
    mpv_set_option_string(mpv_ctx,`wid`,sprintf(`%d`,handle))
    mpv_set_option_string(mpv_ctx,`vo`,`gpu`)  -- or `direct3d` on Windows
    mpv_set_option_string(mpv_ctx,`keep-open`,`yes`)
    mpv_set_option_string(mpv_ctx,`pause`,`yes`)    -- Start paused
    mpv_set_option_string(mpv_ctx,`mute`,iff(bMuted?`yes`:`no`))
    mpv_set_option_string(mpv_ctx,`osd-bar`,`no`)
    mpv_initialize(mpv_ctx)

    sequence cl = command_line()
    if length(cl)>2 then
        cl = cl[3]
        if cl="-restart" then cl = recent[1] end if
        if get_file_type(cl)=FILETYPE_FILE then
            update_recent_and_open_file(cl)
            set_volume(0,0)
--DEVgood place for -restart? requires({-machine_bits(),"-restart"},true)
--DEV dies without this... unless we kill the MPV_INIT below... [FIXED]
--else
--filename = recent[1]

        end if
--      cl = {} -- (don't re-attempt for sbview)
    end if
end procedure

atom sbview_handle = NULL -- DEV temp, for debugging

procedure mpv_initp(atom handle)
?{"mpv_initp",handle}
sbview_handle = handle
    sb_ctx = mpv_create()
    mpv_set_option_string(sb_ctx,`wid`,sprintf(`%d`,handle))
    mpv_set_option_string(sb_ctx,`vo`,`gpu`)  -- or `direct3d` on Windows
    mpv_set_option_string(sb_ctx,`keep-open`,`yes`)
--  mpv_set_option_string(sb_ctx,`pause`,`yes`) -- Start paused
    mpv_set_option_string(sb_ctx,`pause`,`no`) -- Start paused .. loadfile
    mpv_set_option_string(sb_ctx,`mute`,`yes`)
    mpv_set_option_string(sb_ctx,`osd-bar`,`no`)
    mpv_initialize(sb_ctx)
end procedure

function reverse_xpm(string xpm)
    sequence res = split(xpm,'\n')
    res[4..$] = apply(res[4..$],reverse)
    res = join(res,'\n')
    return res
end function

