procedure seekbar_mouseleave(gdx seekbar)
    set_seekbar_timer()
    seekbar_hover = -1
    gRedraw(seekbar)
end procedure

procedure draw_volume(gdx volume, integer w,h)
    atom v = gGetAttribute(volume,`VALUE`) -- (0.0..1.0)
    gDrawRect(volume,0,0,w-1,h-1,colour:=TG_BLACK)
    if not bMuted then
        if v>0 then
            gDrawRect(volume,1,1,max(w*v-3,0),h-2,true,colour:=TG_GREEN)
        end if
        gDrawText(volume,w/2,h/2,`%d%%`,{v*100},TG_C)
    end if
end procedure

--TODO: Open (multiple when bEditingEnabled) plonks them in here (when bEditingEnabled) 
--      and selects the first. Also, obvs, initially empty in the final version.
sequence sourcelist = recent_files -- (temp)

function fetch_sources(integer item)
    if item=0 then return length(sourcelist) end if
    if item=-1 then
        item = largest(apply(sourcelist,length),true)
        -- Find the largest point size (max 16) that will fit.
        string txt = sourcelist[item]
        integer width = gGetAttribute(sources,`SIZE`)[1]
        for point_size=6 to 16 do -- (binary chop probably not worth it)
            gSetAttribute(sources,`FONT`,`Helvetica, %d`,{point_size+1})
            if gGetTextExtent(txt,sources)[1]>width then -- (nope)
                gSetAttribute(sources,`FONT`,`Helvetica, %d`,{point_size})
                exit
            end if
        end for -- (if 17pt was ok, leave it at that)
        return item
    end if
    return sourcelist[item]
end function

procedure source_selected(integer item)
    update_recent_and_open_file(sourcelist[item])
end procedure   

function fetch_cuts(integer item)
    if item=0 then return length(cutlist) end if
    if item=-1 then return 0 end if -- don't care here (no long paths)
    -- TODO better fmt, once we've decided what the entries actually are
    return sprintf(`%v`,{cutlist[item]})
end function

