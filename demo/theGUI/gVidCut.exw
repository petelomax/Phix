integer mpv_ctx = NULL, sb_ctx = NULL

gdx mainmenu, -- main dialog menu
    popupmenu, -- right-click popup menu
    menus, -- (both the above)
    sources, -- list of input files 
    spacer, -- for positioning seekbar preview popup
    cspace, -- (so we can CBXY "")
    sbview, -- seekbar preview popup
    video,  -- area for mpv to draw in
    fragments, -- list of cut segments
    triplet, -- above three side-by-side
    seekbar, -- video position/slider
    seekbar_timer, -- redraw "", and next
    ctrls, -- hand painted, see draw_ctrls()
    volume, -- a smaller slider
    hbox, vbox, dlg,
    mbx = NULL, lbl, btns -- (see gMessage)

forward function get_source_code_length()
constant mm = mpv_client_api_version(`mm`),
      title = `VidCut`, help_text = `
Something between MPC_HC and LosslessCut: a simple video player that can also perform frame-accurate 
slicing without doubling or trebling file sizes, and permanently fix incorrect video aspect ratios.

E toggles Edit mode, F toggles fullscreen, Space play/pause, Up/Down control volume, M toggles mute,
Ctrl Left/Right single steps, I/O marks in/out points, Ctrl Z/Y undo/redo, Ctrl T tests, Ctrl S saves.

For slightly more details see the manual, or inspect the source code itself (which is just ~1.5K lines).
`, about_txt = sprintf(`
gVidCut version 1.0

A hybrid video player/editor, based on MPC-HC and inspired by LosslessCut.

Using %s
    and libmpv version %s, and all amazingly in just %,d lines of source code!
`, {gVersion(), mpv_client_api_version(), get_source_code_length()})

procedure gMessage(gdx dlg, string msg, title, sequence actions={})
--  static [mbx, lbl, btns]
--  static gdx mbx = NULL, lbl, btns
    if mbx=NULL then
        lbl = gLabel(msg,`EXPAND=BOTH`)
        gdx OkBtn = gButton(`OK`,gQuit),
            YesBtn = gButton(`Yes`,`VISIBLE=FALSE`),
            NoBtn = gButton(`No`,`VISIBLE=FALSE`),
            CancelBtn = gButton(`Cancel`,`VISIBLE=FALSE`)
        btns = {OkBtn,YesBtn,NoBtn,CancelBtn}
        gdx hbox = gHbox(btns,`SPACE=LEFT,EXPAND=H`),
            vbox = gVbox({lbl,hbox},`MARGIN=10`)
        mbx = gDialog(vbox,dlg,title)
        gSetAttribute(mbx,`DEFAULTENTER`,TG_CLOSE)
    else
        gSetAttribute(lbl,`TITLE`,msg)
        gSetAttribute(mbx,`TITLE`,title)
    end if
    if actions={} then actions={gQuit,NULL,NULL,NULL} end if
    integer la = length(actions)
    for i,btn in btns do
        integer action = iff(i>la?NULL:actions[i])
        gSetAttribute(btn,`VISIBLE`,action!=NULL)
        if action then gSetHandler(btn,`ACTION`,action) end if
    end for
    gShow(mbx)
end procedure

--  seekbar_timer: absolutely must be running whenever a video is actually playing, in order
--  to keep that in step. Ideally timers should be switched off when not needed to allow the
--  program to go properly idle, just like the lights when leaving a room, which is where the
--  whole toliept idea comes from. The asynchronous nature of these things means just because
--  it isn't playing right now does not mean it won't be in 0.25s, however if it is still not
--  playing ten seconds later it is safe(r) to assume it never will, without a further nudge.
--
atom toliept = time()+10 -- time of last interesting event +10 (for seekbar_timer shutdown)

atom timeval = 0 -- (0.0..1.0)

