gdx mnu = gMenu(MAIN_MENU,menu_handler), 
--  pmn = gMenu(FILE_MENU,menu_handler), 
    pmn = gMenu(MAIN_MENU,menu_handler), 
    cnv = gCanvas(`BGCLR=PARCHMENT`), 
    box = gVbox({mnu,cnv}),
    dlg = gDialog(box,`hMenu`,`SIZE = 502x332`)
gSetHandler(cnv,`CLICK`,dlg_click_handler)
--gSetAttribute({cnv,dlg},`USER_DATA`,mnu) -- NO (as per docs, gPopupMenu objects)
-- A real app would probably just use local vars instead*2:
gSetAttribute({cnv,dlg},`USER_DATA`,pmn)
gSetAttribute({mnu,pmn},`USER_DATA`,dlg)
