-- DIBtest.exw
--  (a quick diagnostic generated by and for ChatGPT - passed w/o issue)
include theGUI.WINAPI.e

constant W = 100,
         H = 100

atom hBmp = NULL
atom pBits = NULL

function make_dib()
    -- create memory DC (safer than GetDC(NULL))
    atom hdc = CreateCompatibleDC(NULL)

    -- BITMAPINFO (header + 1 RGBQUAD)
    integer lbmi = get_struct_size(idBITMAPINFOHEADER)+4
    atom pBMI = allocate(lbmi)
    mem_set(pBMI, 0, lbmi)

    set_struct_field(idBITMAPINFOHEADER, pBMI, "biSize", lbmi)
    set_struct_field(idBITMAPINFOHEADER, pBMI, "biWidth", W)
    set_struct_field(idBITMAPINFOHEADER, pBMI, "biHeight", -H) -- top-down
    set_struct_field(idBITMAPINFOHEADER, pBMI, "biPlanes", 1)
    set_struct_field(idBITMAPINFOHEADER, pBMI, "biBitCount", 32)
    set_struct_field(idBITMAPINFOHEADER, pBMI, "biCompression", BI_RGB)

    -- pointer-to-pointer for bits
    atom ppBits = allocate(machine_word())
    pokeN(ppBits, 0, machine_word())

    atom h = CreateDIBSection(hdc, pBMI, DIB_RGB_COLORS, ppBits, NULL, 0)

    pBits = peeknu(ppBits)

    ?{"OK",h,pBits}

    -- fill pixels (simple gradient)
    for y=0 to H-1 do
        for x=0 to W-1 do
            integer r = round(x*255/W)
            integer g = round(y*255/H)
            integer b = 128
            integer col = r + g*#100 + b*#10000
            poke4(pBits + (y*W + x)*4, col)
        end for
    end for

    DeleteDC(hdc)
    return h
end function

function WndProc(atom hWnd, msg, wParam, lParam)
    switch msg do

        case WM_CREATE:
            hBmp = make_dib()
            return 0

        case WM_PAINT:
            atom hdc = BeginPaint(hWnd, pPAINTSTRUCT)

            if hBmp!=0 then
                atom mem = CreateCompatibleDC(hdc)
                {} = SelectObject(mem, hBmp)

                BitBlt(hdc, 10,10, W,H, mem, 0,0, SRCCOPY)

                DeleteDC(mem)
            end if

            EndPaint(hWnd, pPAINTSTRUCT)
            return 0

        case WM_CHAR:
            if wParam=VK_ESCAPE then
                {} = SendMessage(hWnd,WM_CLOSE,0,0)
            end if

        case WM_DESTROY:
            PostQuitMessage(0)
            return 0
    end switch

    return DefWindowProc(hWnd, msg, wParam, lParam)
end function

constant WndProc_cb = call_back(WndProc)

procedure main()
    RegisterClassEx("dibtest", WndProc_cb)

    atom hWnd = CreateWindowEx(0,"dibtest","DIB Test",
        WS_OVERLAPPEDWINDOW,
        100,100,200,200,
        NULL,NULL,NULL,NULL)

    ShowWindow(hWnd)

    atom pMsg = allocate_struct(idMSG)
    while GetMessage(pMsg,NULL,0,0) do
        TranslateMessage(pMsg)
        DispatchMessage(pMsg)
    end while
end procedure

main()
