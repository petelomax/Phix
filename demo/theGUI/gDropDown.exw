--gdx drop1 = gDropDown({"one","two","threefourfivesix"},changed),
-- bug: on WinAPI, many hoops to avoid [0], then it kills tab/shift tab/esc...
--gdx drop1 = gDropDown({"one","two","three"},changed),
--gdx list1 = gList({"one","two","three"},changed),
--  drop1 = gDropDown(list1,changed),
--  list2 = gList(apply(true,ordinal,{tagset(21),true}),changed),
--  drop2 = gDropDown(list2,changed,"VALUE=3"),
gdx list1 = gList({"one","two","three"}),
    drop1 = gDropDown(list1),
    list2 = gList(apply(true,ordinal,{tagset(21),true})),
    drop2 = gDropDown(list2,"VALUE=3"),
--  drop2 = gDropDown(changed,`VALUE=3,OPTIONS={"Brazil","USA","Japan","France"}`), -- (nope, .. update docs?)
--  drop2 = gDropDown(changed,"=VALUE,OPTIONS",{3,{"Brazil","USA","Japan","France"}}),
--  drop2 = gDropDown(changed,"=OPTIONS,VALUE",{{"Brazil","USA","Japan","France"},3}), -- fine
--  drop2 = gDropDown({"Brazil","USA","Japan","France"},changed,"VALUE=3"), -- fine
--  vhbox = gVbox({gHbox({drop1,drop2})}),
--  vhbox = gVbox({gFrame(gHbox({drop1,drop2}),"gFrame")}),
--  vhbox = gVbox({gHbox({drop1})}),
    hbox = gHbox({drop1,drop2},"MARGIN=13x13,GAP=15"),
    dlg = gDialog(hbox,"gDropDown",`SIZE=240x80`)
--gSetAttribute(drop2,"VALUE",3) -- (else it's blank)
--puts(1,"")
gShow(dlg)
--?gGetAttribute(drop1,"VALINT")
--?gGetAttribute(drop2,"OPTIONS")
gMainLoop()
