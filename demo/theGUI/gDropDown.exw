--/*
procedure changed(gdx id, object v)
--DEV...
--  ?{"changed",id,gGetAttribute(id,"VALINT"),
--trace(1)
    ?{"changed",id,v}
--  gGetInt(id,"VALUE"),
--  ?{"changed",gGetAttribute(id,"VALUE"),
