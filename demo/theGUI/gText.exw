--puts(1,"") -- [while/since value_changed() prints to console]
--requires(64,true)
with javascript_semantics
include theGUI.e
--gUseGTK()

constant backend = gVersion(-1),
         backver = gVersion(-2),
--       bGTK2 = backend=TG_GTK and backver=2,
         bGTK3 = backend=TG_GTK and backver=3 

procedure value_changed(gdx txt, string v)
    if v="" then v = "gText" end if
    gSetAttribute(gGetDialog(txt),`TITLE`,v)
end procedure

gdx txt = gText(value_changed),
--gdx txt = hSpin(value_changed),
--gdx cal = gCanvas(`SIZE=221x142`)
--    txt = hDatePick(cal,value_changed,"05/11/2025"),
--gdx list = gCanvas(`SIZE=100x200`),
--  txt = hDropdown(list,value_changed,"thing"),

    hbx = gVbox({txt},`==`,{{`MARGIN`,iff(bGTK3?7:13)}}),
    dlg = gDialog(hbx,`gText`,`SIZE=240x80`)
--gSetAttribute(txt,`FONT`,`Ariel, italic 9`)
--gSetAttribute(hbx,`FONT`,`Ariel, italic 9`)
--gSetAttribute(dlg,`FONT`,`Ariel, italic 9`) -- it seems we /do/ need tg_set_font for inheritance anyway...
gMainLoop(dlg)

