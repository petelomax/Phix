with javascript_semantics
--requires(64,true)
include theGUI.e
--gSetGlobal(`DIAGNOSTICS`,true)
--gUseGTK()

gdx btn1 = gButton("one",        "SIZE= 35x25, CBXY= 10x10"),
    btn2 = gButton("two",        "SIZE= 35x25, CBXY=100x50"),
    frame = gCbox({btn2},"frame","SIZE=130x100,CBXY= 60x20"),
    cbox = gCbox({btn1,frame},   "SIZE=198x128"),
    dlg = gDialog(cbox,"gCbox",  "SIZE=200x160")
gMainLoop(dlg)

