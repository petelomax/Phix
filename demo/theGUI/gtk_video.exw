    gtk_box_pack_start(controls_box, play_btn, FALSE, FALSE, 5)
--  gtk_box_pack_start(GTK_BOX(controls_box), timeline, TRUE, TRUE, 5)
--  gtk_box_pack_start(controls_box, timeline, TRUE, TRUE, 5)
    gtk_widget_show_all(controls_box)
    
    -- BOTTOM SPACER (for VIDEO_TOP_PCT equivalent at bottom)
    atom bottom_spacer = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0)
--/*
    gtk_widget_set_hexpand(bottom_spacer, TRUE)
    gtk_widget_set_vexpand(bottom_spacer, FALSE)
--*/
--  gtk_box_pack_start(GTK_BOX(vbox), bottom_spacer, FALSE, FALSE, 0)
    gtk_box_pack_start(vbox, bottom_spacer, FALSE, FALSE, 0)
