    atom vbox = gtk_box_new(GTK_ORIENTATION_VERTICAL, false,70)
--  gtk_container_add(GTK_CONTAINER(main_window), vbox)
    gtk_container_add(main_window, vbox)
    gtk_widget_show(vbox)
    
    -- TOP SPACER (for VIDEO_TOP_PCT margin)
    atom top_spacer = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0)
--  atom top_spacer = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0,70)
--/*
    gtk_widget_set_hexpand(top_spacer, TRUE)
    gtk_widget_set_vexpand(top_spacer, FALSE)
--*/
--  gtk_box_pack_start(GTK_BOX(vbox), top_spacer, FALSE, FALSE, 0)
    gtk_box_pack_start(vbox, top_spacer, FALSE, FALSE, 0)
    gtk_widget_show(top_spacer)
    
    -- VIDEO AREA (GtkDrawingArea as mpv sink)
    video_area = gtk_drawing_area_new()
--?{"video_area",video_area}
--/*
    gtk_widget_set_hexpand(video_area, TRUE)
    gtk_widget_set_vexpand(video_area, TRUE)
--*/
--  gtk_box_pack_start(GTK_BOX(vbox), video_area, TRUE, TRUE, 0)
    gtk_box_pack_start(vbox, video_area, TRUE, TRUE, 0)
    gtk_widget_show(video_area)
    
    -- CONNECT VIDEO AREA SIGNALS (REALIZE + SIZE-ALLOCATE)
    g_signal_connect_data(video_area, "realize", video_realize_cb, 0)
    g_signal_connect_data(video_area, "size-allocate", video_size_allocate_cb, 0)
    
    -- BOTTOM SPACER + CONTROLS AREA (for your UI controls)
    atom controls_box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0)
