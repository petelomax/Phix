    gtk_widget_set_hexpand(controls_box, TRUE)
    gtk_widget_set_vexpand(controls_box, FALSE)
--  gtk_box_set_homogeneous(GTK_BOX(controls_box), FALSE)
    gtk_box_set_homogeneous(controls_box, FALSE)
--*/
    
    -- Example controls (replace with your actual UI)
    atom play_btn = gtk_button_new_with_label("¶ Play/Pause")
--(GTK3 only)
--  atom timeline = gtk_scale_new[_with_range](GTK_ORIENTATION_HORIZONTAL, 0, 100, 1)
