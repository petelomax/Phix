puts(1,"")
--requires(64,true)
--without debug
include theGUI.GTK.e
include libmpv.e
--include std/console.e  -- For get_key() in main loop (optional)
include pcfunc.e
include pFloatN.e
include pprntfN.e
--include ptagset.e
with debug
--with trace
--trace(3)
--constant STDERR = 2
--/*
OK, I finally got it working (hoorah) by trimming things down to the bare bones. Right now I just need a few cosmetic changes.
The window is not initially positioned correctly, but instead centred on the outer dimensions (not client area) of the main window,
nor is it moved when the main window is dragged. Neither is it resized to match the main window being resized.
A simple 10 pixel border on all four sides was what I was expecting.
Also, Esc shuts down properly, but top right X clearly makes it struggle with something before eventually terminating.
--*/

constant VIDEO_FILE = `test_colorbars.mp4`

atom mpv_ctx = 0
atom main_window = 0

atom video_child = 0
atom draw_area = 0

function key_handler(atom widget, event, /*user_data*/)
    integer keyval = get_struct_field(idGdkEventKey, event, "keyval")
?{"key_handler",keyval}
    if keyval=GTK_ESC then
        c_proc(x_gtk_main_quit)
    end if
    if mpv_ctx!=0 then
        switch keyval do
--{"key_handler",65453} - = #FFAD
--{"key_handler",65451} + = #FFAB

            case GDK_KEY_space: mpv_command_string(mpv_ctx, "cycle pause")
            case GDK_KEY_Left: mpv_command_string(mpv_ctx, "seek -5 relative")
--Nope. I changed my key handler to:
--          case GDK_KEY_Left: gtk_widget_hide(video_child)
--          case GDK_KEY_Right: gtk_widget_show(video_child)
--and right arrow does not restore the video.
            case GDK_KEY_Right: mpv_command_string(mpv_ctx, "seek +5 relative")
            case GDK_KEY_Home: mpv_command_string(mpv_ctx, "seek 0 absolute")
            case GDK_KEY_End: 
                    atom duration = mpv_get_property(mpv_ctx, "duration", MPV_FORMAT_DOUBLE)
                    mpv_command_string(mpv_ctx, sprintf("seek %f absolute", {duration}))
        end switch
    end if
    return true
end function
global constant key_handler_cb = call_back({'+',key_handler})

--/*
procedure main()
    gtk_init()
    
    -- CREATE MAIN WINDOW
    main_window = gtk_window_new(GTK_WINDOW_TOPLEVEL)
    gtk_window_set_title(main_window, "Phix + GTK + libmpv Player")
    gtk_window_set_default_size(main_window, 900, 600)
    g_signal_connect_data(main_window, "destroy", gtk_main_quit, 0)

    -- SHOW MAIN WINDOW
    gtk_widget_show_all(main_window)
--gtk_window_move(main_window,10,20)

    video_child = gtk_window_new(GTK_WINDOW_TOPLEVEL)
    gtk_window_set_transient_for(video_child, main_window)
    gtk_window_set_decorated(video_child, FALSE)
    gtk_window_set_resizable(video_child, FALSE)

    -- drawing area
    draw_area = gtk_drawing_area_new()
    integer w = 880, h = 580
--  integer w = 780, h = 480
--  integer w = 890, h = 590
    gtk_widget_set_size_request(draw_area, w, h)
--/!*
    set_struct_field(idGdkRectangle,gtkRECT,"x",0)
    set_struct_field(idGdkRectangle,gtkRECT,"y",50) -- no effect
    set_struct_field(idGdkRectangle,gtkRECT,"width",w)
    set_struct_field(idGdkRectangle,gtkRECT,"height",h)
    gtk_widget_size_allocate(draw_area,gtkRECT)
    gtk_widget_size_allocate(video_child,gtkRECT)
--*!/
    gtk_container_add(video_child, draw_area)
    gtk_widget_show_all(video_child)

    atom gdk_video_win = gtk_widget_get_window(draw_area);
    if gdk_video_win = 0 then ?9/0 end if
--guint32 xid = GDK_WINDOW_XID(gdk_video_win); // GTK2: returns guint32 (XID on X11, HWND on Win32)
--gdk_x11_window_get_xid(window)??
    if platform()!=WINDOWS then ?9/0 end if -- placeholder...
    atom handle = gdk_win32_window_get_handle(gdk_video_win)

    mpv_ctx = mpv_create()

    -- EMBEDDING OPTIONS (SET BEFORE INITIALIZE)
    mpv_set_option_string(mpv_ctx, "wid", sprintf("%d", handle))
