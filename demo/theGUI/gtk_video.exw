--/*
local function video_realize(atom video_area, user_data)
    -- CRITICAL: Only safe to get handle AFTER video_area is realized
    atom vid_handle = get_video_window_handle(video_area)
--?{"win_handle",win_handle,"video_area",video_area}
    if vid_handle = 0 then
--      puts(STDERR, "Failed to get video window handle\n")
        crash("Failed to get video window handle")
--      return 0
    end if

    -- Initialize mpv WITH THIS WINDOW HANDLE
    mpv_ctx = mpv_create()
--  if mpv_ctx = 0 then
--      puts(STDERR, "mpv_create() failed\n")
--      return
--  end if

    -- EMBEDDING OPTIONS (SET BEFORE INITIALIZE)
--  mpv_set_option_string(mpv_ctx, "wid", sprintf("%p", vid_handle))
    mpv_set_option_string(mpv_ctx, "wid", sprintf("%d", vid_handle))
--  mpv_set_option_string(mpv_ctx, "wid", sprintf("%d", video_area)) -- nope!
    mpv_set_option_string(mpv_ctx, "vo", "gpu")  -- or "direct3d" on Windows
    mpv_set_option_string(mpv_ctx, "keep-open", "yes")
    mpv_set_option_string(mpv_ctx, "pause", "yes")  -- Start paused

    mpv_initialize(mpv_ctx)
    
    -- Load file (with duration retry logic from earlier)
    mpv_command_string(mpv_ctx, sprintf("loadfile \"%s\"", {VIDEO_FILE}))
--  if mpv_command_string(mpv_ctx, sprintf("loadfile \"%s\"", {VIDEO_FILE})) < 0 then
--      puts(STDERR, sprintf("Failed to load: %s\n", {VIDEO_FILE}))
--      mpv_ctx = mpv_terminate_destroy(mpv_ctx)
--      mpv_ctx = 0
--      return
--  end if

    -- Wait for valid duration (same logic as WinAPI version)
    atom duration = -1
    integer retries = 0
    while retries < 50 do
        duration = mpv_get_property(mpv_ctx, "duration", MPV_FORMAT_DOUBLE, -1)
--?duration
        if duration >= 0 then exit end if
--      sleep(100)
        sleep(0.100)
        retries += 1
    end while
    if retries >= 50 then
        printf(1, "Warning: Duration unavailable (using 0)\n")
    else
        printf(1, "Duration: %.2fs\n", {duration})
    end if
--  return false --??
    return true
end function
global constant video_realize_cb = call_back({'+',video_realize})
--*/

--/*
    -- CREATE VERTICAL BOX LAYOUT (matches your WinAPI margin logic)
    -- **NB** sizes are off vs. win_video.exw, but I don't care. (see gVidCut.exw)
