    mpv_initialize(mpv_ctx)
    
    -- Load file (with duration retry logic from earlier)
    mpv_command_string(mpv_ctx, sprintf("loadfile \"%s\"", {VIDEO_FILE}))

    
    -- OPTIONAL: Add keyboard controls (like your WinAPI version)
    g_signal_connect_data(main_window, "key-press-event", key_handler_cb, 0)
    g_signal_connect_data(video_child, "key-press-event", key_handler_cb, 0)
    
    -- START GTK MAIN LOOP
    gtk_main()
    
    -- CLEANUP
    mpv_ctx = mpv_terminate_destroy(mpv_ctx)
end procedure
main()
--*/
--/*
local function main_realize(atom video_area, user_data)
    -- GET MAIN WINDOW'S POSITION AND SIZE (AFTER REALIZATION)
    integer {x,y} = gtk_window_get_position(main_window),
            {w,h} = gtk_window_get_size(main_window)
            
    -- CALCULATE VIDEO WINDOW POSITION (MAIN WINDOW'S CLIENT AREA OFFSET)
    --    Assuming 10px border: video starts at (x+10, y+10)
    -- SET VIDEO WINDOW POSITION AND SIZE
--  gtk_window_move(video_child, x+10, y+10)
--  gtk_window_resize(video_child, w-20, h-20)
    return true
end function
global constant main_realize_cb = call_back({'+',main_realize})
--*/

local function main_configure(atom widget, event, user_data)
--atom vcw = gtk_widget_get_window(video_child)
--printf(1,"video_child_state(mc):%0b\n",gdk_window_get_state(vcw))

    integer {x,y} = gtk_window_get_position(main_window),
            {w,h} = gtk_window_get_size(main_window)
    -- client area:
    x += 7
    y += 32 
    -- MAINTAIN 10px BORDER RELATIVE TO MAIN WINDOW
    w -= 20
    h -= 20
    gtk_window_move(video_child,x+10,y+10)
    gtk_window_resize(video_child,w,h)
    gtk_widget_set_size_request(draw_area,w,h)
--  gtk_window_present(video_child)
--gtk_widget_show_all(video_child)
--  return false -- Propagate event
    return true
end function
global constant main_configure_cb = call_back({'+',main_configure})

local function draw_area_focus(atom /*widget*/, /*event*/, main_window)
    gtk_window_present(main_window)
    return false -- Allow event to propagate (so clicks still register, but focus moves)
end function
global constant draw_area_focus_cb = call_back({'+',draw_area_focus})

procedure main()
    gtk_init()
    
    -- CREATE MAIN WINDOW (UNCHANGED)
    main_window = gtk_window_new(GTK_WINDOW_TOPLEVEL)
    gtk_window_set_title(main_window, "Phix + GTK + libmpv Player")
    gtk_window_set_default_size(main_window, 900, 600)
    g_signal_connect_data(main_window, "destroy", gtk_main_quit_cb, 0)

    video_child = gtk_window_new(GTK_WINDOW_TOPLEVEL)
    gtk_window_set_transient_for(video_child, main_window)
    gtk_window_set_decorated(video_child, FALSE)
    gtk_window_set_resizable(video_child, FALSE)
    draw_area = gtk_drawing_area_new()
    integer initial_w = 880, initial_h = 580  -- Your desired video size
    gtk_widget_set_size_request(draw_area, initial_w, initial_h)
    gtk_container_add(video_child, draw_area)
    gtk_widget_show_all(video_child)
--When video_child or draw_area get focus, can we put it back to the main_window?
--  g_signal_connect_data(draw_area, "focus-in-event",draw_area_focus_cb,0)
    g_signal_connect_data(video_child,"focus-in-event",draw_area_focus_cb,main_window)
    
    -- 🔑 INITIAL POSITIONING: SET VIDEO WINDOW TO MAIN WINDOW'S CLIENT AREA OFFSET
    --    (This replaces the missing child window positioning)
--  g_signal_connect_data(main_window, "realize",main_realize_cb, 0)
    
    -- 🔑 SYNCHRONIZE VIDEO WINDOW WHEN MAIN WINDOW MOVES/RESIZES
    g_signal_connect_data(main_window, "configure-event", main_configure_cb, 0)

    -- 🔑 GET WINDOW HANDLE FOR MPV (FROM VIDEO WINDOW'S DRAWING AREA)
    atom gdk_video_win = gtk_widget_get_window(draw_area)
--  if gdk_video_win = 0 then abort(1) end if
    if gdk_video_win = 0 then ?9/0 end if
    atom handle = gdk_win32_window_get_handle(gdk_video_win)  -- Windows-specific
--?handle
    
    -- MPV SETUP (IDENTICAL TO YOUR WINAPI CODE)
    mpv_ctx = mpv_create()
    mpv_set_option_string(mpv_ctx, "wid", sprintf("%d", handle))
    mpv_set_option_string(mpv_ctx, "vo", "gpu")
--  mpv_set_option_string(mpv_ctx, "vo", "angle")
--  mpv_set_option_string(mpv_ctx, "vo", "libmpv")
--  mpv_set_option_string(mpv_ctx, "vo", "opengl")
--  mpv_set_option_string(mpv_ctx, "vo", "opengl-hq")
--  mpv_set_option_string(mpv_ctx, "vo", "direct3d")
    mpv_set_option_string(mpv_ctx, "keep-open", "yes")
    mpv_set_option_string(mpv_ctx, "pause", "yes")  -- Start paused
    mpv_initialize(mpv_ctx)
    mpv_command_string(mpv_ctx, sprintf("loadfile \"%s\"", {VIDEO_FILE}))
    
    -- 🔑 KEYBOARD CONTROLS (ON MAIN WINDOW - IDENTICAL TO WINAPI)
    g_signal_connect_data(main_window, "key-press-event", key_handler_cb, 0)
    g_signal_connect_data(video_child, "key-press-event", key_handler_cb, 0)
    
--/*
    -- 🔑 DRAW CALLBACK: DRAW GUI CONTROLS OVER MAIN WINDOW (INCLUDING OVER VIDEO AREA)
    --    (IDENTICAL LOGIC TO YOUR WINAPI WM_PAINT - YOUR EXISTING CODE GOES HERE)
    g_signal_connect_data(main_window, "draw",
        lambda(widget, cr, user_data) do
            -- YOUR EXISTING GUI DRAWING LOGIC (UNTouched!)
            cairo_set_source_rgb(cr, 1.0, 1.0, 0.875); // TG_PARCHMENT
            cairo_rectangle(cr, 0, 0, width, height);
            cairo_fill(cr);
            
            cairo_set_source_rgb(cr, 0, 0, 0); // black
            cairo_set_line_width(cr, 0.5);
            cairo_move_to(cr, 0, 0);
            cairo_line_to(cr, width, height);
            cairo_stroke(cr);
            cairo_move_to(cr, width, 0);
            cairo_line_to(cr, 0, height);
            cairo_stroke(cr);
            
            return FALSE
        end, 0)
--*/    

    -- SHOW WINDOWS (MAIN FIRST, THEN VIDEO)
    gtk_widget_show_all(main_window)
    gtk_window_present(video_child)  -- Ensures video window appears
    
    gtk_main()
--?"main_back"
    
    -- 🔑 CLEANUP: MPV CONTEXT DESTROYED WITH MAIN WINDOW
    mpv_ctx = mpv_terminate_destroy(mpv_ctx)
end procedure
main()
--?"done"
