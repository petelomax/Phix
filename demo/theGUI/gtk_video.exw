local function video_size_allocate(atom video_area, atom allocation, user_data)
--?"video_size_allocate"
    -- Update mpv's video output when video_area resizes/moves
--  if mpv_ctx!=0 then
    if false then
    
--      integer x = get_struct_field(idGdkRectangle, allocation, "x")
--      integer y = get_struct_field(idGdkRectangle, allocation, "y")
--      integer w = get_struct_field(idGdkRectangle, allocation, "width")
--      integer h = get_struct_field(idGdkRectangle, allocation, "height")
    
        -- NOTIFY MPV OF NEW SIZE/position (critical for embedded mode)
