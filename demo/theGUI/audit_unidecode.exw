sequence pgmap = vslice(data,1),
         chmap = reinstate(repeat(0,472),pgmap,tagset(length(data)))
data = vslice(data,2)
for i,d in data do
    data[i] = substitute(d,'_',' ')
end for

--global 
function local_unidecode(string utf8)
    if utf8!="" then
        sequence utf32 = utf8_to_utf32(utf8)
--      if max(utf32)>#7F
--      and not object(chmap) then -- (ie still <novalue>)
--          chmap = reinstate(repeat(0,472),vslice(data,1),tagset(length(data)))
--          data = vslice(data,2)
--          for i,d in data do
--              data[i] = substitute(d,'_',' ')
--          end for
--      end if
        utf8 = ""
        integer pch = ' '
        for c in utf32 do
            if c=223 then -- special case: ß (#DF aka double s, eszett or sharp s) -> ss
                utf8 &= 's'
                c = 's'
            elsif c>=#80 then
                integer hi = c >> 8,
                        lo = c && 0xff
                c = ' '
                if hi<length(chmap) then
                    integer ddx = chmap[hi+1];
                    if ddx then
                        c = data[ddx][lo+1]
                    end if
                end if
            end if
            if c!=' ' or pch!=' ' then
                utf8 &= c
            end if
            pch = c
        end for
    end if
    return utf8
end function

integer udx = 1, -- 1..51, index to above table
     slices = 4 -- or 8 or 16 (aka chunks)
-- with 8 slices, GetTextExtent fails on page 15 because there isn't "a valid Tibetan base consonant":
-- in day-to-day operations that would o/c mean something deeply amiss, but here I simply don't care.
gSetGlobal(`DIAGNOSTICS`,`ignore_TextExtent_errors`)

procedure redraw(gdx canvas, integer w, h)
    h = floor(h/(slices+2))
    integer dn = pgmap[udx], ubase = (dn-1)*256, 
            s = 1, sl = 256/slices, g = 8-log2(slices)*2
    for i=1 to slices do
        if i>1 or dn>1 then
            string u64 = utf32_to_utf8(tagstart(ubase+s-1,sl)),
                   d64 = local_unidecode(u64)
            gDrawText(canvas,w/2,h*i-g,u64,{},TG_N)
            gDrawText(canvas,w/2,h*i+g,d64,{},TG_S)
        end if
        s += sl
    end for
    gDrawText(canvas,w/2,h*(slices+1),`< %d/%d (aka %d) >`,{udx,length(data),dn},TG_C)
end procedure

procedure key_handler(gdx dlg, integer c)
    if c = VK_UP then
        slices = min(16,slices*2)
    elsif c=VK_DOWN then
        slices = max(slices/2,4)
    else
        udx = iff(c=VK_LEFT?max(1,udx-1):min(udx+1,length(data)))
    end if
    gRedraw(dlg)
end procedure

gdx cnv = gCanvas(redraw),
    dlg = gDialog(cnv,`audit_unidecode`,`SIZE=800x600`)
gSetHandler(dlg,`KEY`,key_handler)
gMainLoop(dlg)

