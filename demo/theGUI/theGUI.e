local procedure tg_menubar_showtop(gdx menu, integer hov)
    object cxm = ctrl_xtra[menu],
          item = cxm[CX_MENUS][1][MX_ITEMS][hov],
        widths = cxm[CX_MEXTRA][1][MX_WIDTHS]
    integer mdx = item[MX_SUBMENU],
             id = item[MX_ID]
    cxm = NULL -- (kill refcount)
    item = NULL -- ("", why not)
    if mdx then
        gdx dlg = gGetDialog(menu)
        ctrl_xtra[menu][CX_MEXTRA][1][MX_OWNER] = dlg
        integer w = sum(widths[1..hov-1]),
                x = ctrl_size[menu][SZ_X]+w,
                y = ctrl_size[menu][SZ_Y]+32+11
--DEV also FULLSCREEN??
        if not gGetAttribute(dlg,`MAXIMISED`) then
            x += ctrl_size[dlg][SZ_X]+8
            y += ctrl_size[dlg][SZ_Y]+8
        end if
        tg_show_menu(dlg,menu,mdx,x,y)
--printf(1,"ctrl_xtra[%d][DX_ACTIVEPOP] = %d (%d)\n",{dlg,menu,source_line()})
        ctrl_xtra[dlg][DX_ACTIVEPOP] = menu
    end if
end procedure

