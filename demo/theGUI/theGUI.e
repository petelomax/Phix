global function gImage_from_Pixbuf(gdp pixbuf, atom transparent=TG_WHITE)
    if not bInit then tg_Init() end if
    if integer(pixbuf) then
        pixbuf = gPixbuf_take_Pixels(pixbuf)
    end if
    integer h = length(pixbuf),
            w = length(pixbuf[1])
    gdm image = gImage(w,h,transparent,transparent,false)
    integer id = (-image+1)/2
    sequence gim = gimages[id]
    atom pMem = gim[TG_IMG_PIXEL_MEM]
    if backend=TG_GTK then
        sequence bgrl = repeat(0,w)
        for line in pixbuf do
            for i=1 to w do
                bgrl[i] = tg_GTK_rgba_to_bgra(line[i])
            end for
            poke4(pMem,bgrl)
            pMem += w*4
        end for
    elsif backend=TG_WINAPI then
        for line in pixbuf do
            poke4(pMem,line)
            pMem += w*4
        end for
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (gImage_from_Pixbuf)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    return image
end function

