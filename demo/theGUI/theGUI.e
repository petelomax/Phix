        for i=1 to l do
--DEV no thought quick fix (atsaa):
if sequence(bexpand[i]) then
            integer space = slack-bexpand[i][idx-2]
            if space then
                if flag=TG_SPACE_LEFT then -- (===TG_SPACE_TOP)
                    bexpand[i][idx] += space
                else -- assume TG_SPACE_BETWEEN / TG_SPACE_AROUND / TG_SPACE_CENTRE
--if i=1 then balance = floor(space/2) end if
                    bexpand[i][idx] += floor(space/2)
                end if
            end if
end if
        end for
--      s1 = ??
    end if
    {idx,flag,slack} = primary
    if flag!=TG_SPACE_NONE
    and flag!=TG_SPACE_RIGHT    -- (===TG_SPACE_BOTTOM)
    and slack!=0 then
--      if flag=TG_SPACE_RIGHT then
--          -- do nothing
--      elsif flag=TG_SPACE_LEFT then -- (===TG_SPACE_TOP)
        if flag=TG_SPACE_LEFT then -- (===TG_SPACE_TOP)
            for i=1 to l do
-- ditto
if sequence(bexpand[i]) then
                bexpand[i][idx] += slack
end if
            end for
        elsif flag=TG_SPACE_BETWEEN
           or flag=TG_SPACE_AROUND then 
            integer tadj = 0, f = and_bits(flag,TG_SPACE_RIGHT)
                                        -- (===TG_SPACE_BOTTOM)
            for i=2-f to l do
                integer adj = round(slack/(l-i+1+f))
--if i=1 then balance = adj end if
                slack -= adj
                tadj += adj
                bexpand[i][idx] += tadj
            end for
--          assert(slack = 0)
        elsif flag=TG_SPACE_CENTRE then
            integer adj = floor(slack/2)
            for i=1 to l do
                bexpand[i][idx] += adj
            end for
--      elsif flag=TG_SPACE_MATCH then
--          assert(crossflag=TG_SPACE_CENTRE or crossflag=TG_SPACE_AROUND)
--          for i=1 to l do
--              bexpand[i][idx] += balance
--          end for
        else
            ?9/0    -- placeholder?
        end if
    end if
    return bexpand
end function

local procedure tg_lm_accumulate_and_disperse_user_sizes(gdx id, integer cw, ch, x=0, y=0, string who="self")
if and_bits(DF_ACTIVE,or_bits(DF_SET_WH,DF_SET_XY)) then
    ?{"tg_lm_accumulate_and_disperse_user_sizes",id,cw,ch,x,y,who}
end if
    -- called on initial gShow and any resize (inc splitter movement)
    string self = `tg_lm_aadus`
--?{self, id, cw, ch, x, y}
    --
    -- Invoked by gShow and WM_SIZE/tg_gtk_configure_event with the //client// size of the dialog,
    --  and then recursively distributes sizes down the hierarchy and accumulates them back up.
    -- As the name suggests this is a little tricky, either of the following shd get same results:
    --  gdx cnv = gCanvas(redraw,`SIZE=300x300`),   |   gdx cnv = gCanvas(redraw),
    --      dlg = gDialog(cnv,`Title`)              |   dlg = gDialog(cnv,`Title`,`SIZE=302x332`)
    --
    -- Obviously, sets SZ_W/SZ_H, and also calculates the SZ_X/SZ_Y offsets.
    --
    -- This humble little routine is really the beating heart and soul of theGUI.
    --
    integer uw = ctrl_size[id][SZ_USER_W],
            uh = ctrl_size[id][SZ_USER_H],
            nw = ctrl_size[id][SZ_NORMAL_W],
            nh = ctrl_size[id][SZ_NORMAL_H],
            mw = ctrl_size[id][SZ_MIN_W],
            mh = ctrl_size[id][SZ_MIN_H],
             w = max(iff(mw?min(mw,nw):nw),uw),
             h = max(iff(mh?min(mh,nh):nh),uh),
            ct = ctrl_types[id], fha = 0,
           cfi = ctrl_flags[id] 
    if ct!=DIALOG then
        -- Aside: we /could/ set x,y when called from from tg_gtk_configure_event(), but
        --        WM_SIZE does not have them to hand and gShow() uses the result of this
        --        to calculate what x,y shd be for most of the >TG_CURRENT cases anyway?
        g_log(`set`,`ctrl_sizeXY`,{self,source_line()},{id,x,y})
        ctrl_size[id][SZ_X] = x
        ctrl_size[id][SZ_Y] = y
    end if
    if ct=BOX and and_bits(cfi,CF_CONCRETE) then
--      -- do nothing... (maybe validate only cBox-nesting?)
    elsif ct=BOX then
        nullable_string title = ctrl_titles[id]
        if title!=NULL then
            if length(title) then
                integer {tw,th} = gGetTextExtent(title,id)
                fha = th+1
            else
                fha = 2
            end if
            x += 1
            y += fha-1
            cw -= 2
            ch -= fha
        end if
        sequence children = children_ids[id]
        if and_bits(cfi,CF_SPLIT) then  
            gdx {l,{},r} = children
            bool bHoriz = gGetInt(id,`ORIENTATION`)
            sequence idii = iff(bHoriz?{SZ_W,SZ_NORMAL_W}
                                      :{SZ_H,SZ_NORMAL_H})
            integer {szwh,norm} = idii,
                    lsiz = ctrl_size[l][szwh],
                    rsiz = ctrl_size[r][szwh]
            ctrl_size[l][norm] = floor(lsiz/2)
            ctrl_size[r][norm] = floor(rsiz/2)
        end if
        bool bVert = and_bits(cfi,CF_VERTICAL)!=0
        integer gap = ctrl_xtra[id][CX_BOX_GAP],
                nc = length(children),
                xs = cw, -- x slack
                ys = ch, -- y slack
              flag = iff(bVert?CF_VEXPAND:CF_HEXPAND)
        sequence bexpand = repeat(false,length(children))
        atom aw = 0, ah = 0,    -- all width/height
             ew = 0, eh = 0     -- expandable ""
        -- if any zero are detected then trying to pro-rata based
        --  on existing sizes ceases to be viable, and instead it 
        --  should just distribute any slack evenly (/many_left)
        integer any_zero = false,
               many_left = 0

        -- collect children which expand in the primary direction:
        for i,child in children do
            integer cflags = ctrl_flags[child],
                 {mt,mr,mb,ml} = tg_get_margins(child),
                       ccw = ctrl_size[child][SZ_NORMAL_W]+ml+mr,
                       cch = ctrl_size[child][SZ_NORMAL_H]+mt+mb
            if gGetAttribute(child,`VISIBLE`) then
                if bVert then
                    aw = max(aw,ccw)
                    ah += cch
                    if cch=0 then any_zero = true end if
                else
                    aw += ccw
                    ah = max(ah,cch)
                    if ccw=0 then any_zero = true end if
                end if
                if and_bits(cflags,flag)!=0 then
                    many_left += 1
                    bexpand[i] = true
                    ew += ccw
                    eh += cch
                end if
            end if
        end for
        integer g = gap*(nc-1)
        if bVert then
            ah += g
            xs -= aw
            ys -= g
        else
            aw += g
            xs -= g
            ys -= ah
        end if
        integer wslack = max(0,cw-aw),
                hslack = max(0,ch-ah)
        for i,child in children do
            if gGetAttribute(child,`VISIBLE`) then
                integer cflags = ctrl_flags[child],
                 {mt,mr,mb,ml} = tg_get_margins(child),
                           mlr = ml+mr,
                           mtb = mt+mb,
                           ecw = ctrl_size[child][SZ_NORMAL_W]+mlr,
                           ech = ctrl_size[child][SZ_NORMAL_H]+mtb,
                            xw = iff(and_bits(cflags,CF_HEXPAND)>0?cw-ecw:0),
                            xh = iff(and_bits(cflags,CF_VEXPAND)>0?ch-ech:0)
                if bexpand[i] then
                    if bVert then
                        if any_zero then -- share evenly
                            xh = round(hslack/many_left) -- (last is /1 == 100% of
                            many_left -= 1               --  whatever then remains) 
                        else             -- pro-rata it
                            xh = round((ech/eh)*hslack)  -- (maintain size ratios)
                        end if
                        hslack -= xh
                        eh -= ech
                    else
                        if any_zero then
                            xw = round(wslack/many_left) --         ""
                            many_left -= 1
                        else
                            xw = round((ecw/ew)*wslack)
                        end if
                        wslack -= xw
                        ew -= ecw
                    end if
                end if
                nw = ecw+xw
                nh = ech+xh
                -- Aside: if *any* bexpand were true, it/they would have absorbed *all* slack,
                --        hence no need to preserve flag for tg_lm_apply_space() to skip no's.
                bexpand[i] = {nw-mlr,nh-mtb,x+ml,y+mt}
                if bVert then
                    y += nh+gap
                    ys -= nh
                else
                    x += nw+gap
                    xs -= nw
                end if
            end if
        end for
        -- adjust x,y by slack space
        if xs or ys then
            integer sv = ctrl_xtra[id][CX_BOX_SPACE_V], -- (goes with 3 aka bexpand.x)
                    sh = ctrl_xtra[id][CX_BOX_SPACE_H], -- (goes with 4 aka bexpand.y)
                    fw = cw,
                    fh = ch
            -- note: slack is full in cross orientation, excess in primary
            sequence crossax = iff(bVert?{3,sv,fw}:{4,sh,fh}),
                     primary = iff(bVert?{4,sh,ys}:{3,sv,xs})
            bexpand = tg_lm_apply_space(id,bexpand,crossax,primary)
        end if
        for i,bi in bexpand do
            if sequence(bi) then
                {w,h,x,y} = bi
                tg_lm_accumulate_and_disperse_user_sizes(children[i],w,h,x,y)
            end if
        end for
        if fha then -- (frame aka BOX with title!=NULL)
            cw += 2
            ch += fha
        end if
    elsif ct=DIALOG then
        integer nc = length(children_ids[id])
        if nc then
            gdx child = children_ids[id][1]
            integer xs = cw, ys = ch
            if gGetAttribute(child,`VISIBLE`) then
                integer cflags = ctrl_flags[child],
                           ecw = ctrl_size[child][SZ_NORMAL_W],
                           ech = ctrl_size[child][SZ_NORMAL_H],
                        wslack = max(0,cw-ecw),
                        hslack = max(0,ch-ech),
                 {mt,mr,mb,ml} = tg_get_margins(child),
                           mlr = ml+mr,
                           mtb = mt+mb
                -- YEAH, hard slam with borders!!!
                nw = max(ecw+wslack,ecw+mlr)
                nh = max(ech+hslack,ech+mtb)
                tg_lm_accumulate_and_disperse_user_sizes(child,nw-mlr,nh-mtb,ml,mt)
            end if -- visible
        end if -- nc!=0
        -- totally messes up resize in gCanvas.exw under GTK: [FIXED]
--      if backend=TG_WINAPI or not ctrl_xtra[id][DX_FULLSCREEN] then
-- for gVidCut.exw:
--      if backend==TG_WINAPI or not ctrl_xtra[id][DX_FULLSCREEN] then
        if not ctrl_xtra[id][DX_FULLSCREEN] then
            cw += 2
            ch += 32
--      elsif backend=TG_JS then    
--          #ilJS{
--              crash(`JS (tg_lm_accumulate_and_disperse_user_sizes)`);
--          #}ilJS
        end if
--      if backend=TG_GTK
        if backend==TG_GTK
        and (nc or (uw=0 and uh=0)) then
            integer {dw,dh} = tg_get_dialog_decoration_size(id)
            {w,h} = {cw,ch} -- (for Tic_tac_toe.exw)
            if w>0 and h>0 then 
                atom handle = ctrl_handles[id]
                integer dcw = max(w-dw,1),
                        dch = max(h-dh,1)
                g_proc(x_gtk_window_resize,{handle,dcw,dch},source_line())
                g_proc(x_gtk_window_set_default_size,{handle,dcw,dch},source_line())
            end if
            if nc then -- for gDialog.exw(NULL child)
--          if nc -- for gDialog.exw(NULL child)
--          and not gGetAttribute(id,`FULLSCREEN`) then -- for gVidCut.exw
                w += dw
                h += dh
            end if
--      elsif backend=TG_JS then    
--          #ilJS{
--              crash(`JS (tg_lm_accumulate_and_disperse_user_sizes2)`);
--          #}ilJS
        end if
    end if
    g_log(`set`,`ctrl_sizeWH`,{self,source_line()},{id,cw,ch}) -- line 4584
    ctrl_size[id][SZ_W] = cw
    ctrl_size[id][SZ_H] = ch
end procedure

