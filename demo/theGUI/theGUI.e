local function tg_list_get_data_length(gdx list)
    -- (for the benefit of tg_popup)
    object data = ctrl_xtra[list][LX_DATA]
    if integer(data) then
        string sig = tg_get_sig(data)
        if sig=`FI` then
            data = data(0)
        elsif sig=`FOI` then
            data = data(list,0)
        else
            ?9/0 -- unrecognised sig
        end if
    else
        data = length(data)
    end if
    return data
end function

