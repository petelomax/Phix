integer timer_ids = NULL

local function tg_WinAPI_timer_proc(atom /*hWnd*/, integer /*msg*/, atom wid, /*mstime*/)
    integer id = getd(wid,timer_ids)
    {} = tg_gtk_timer_proc(id)
    return 0
end function
local atom tg_WinAPI_timer_proc_cb = NULL

local function tg_set_timer_attribute(gdx id, string name, object v, integer nFrames)
    -- nb bRunning aka not CF_INACTIVE means it is an active running timer
    atom handle = ctrl_handles[id]
    integer flags = ctrl_flags[id]
    bool bOK = false, bRunning = not and_bits(flags,CF_INACTIVE)
    if bRunning then
        if backend=TG_GTK then  
            c_funz(x_g_source_remove,{handle})
        elsif backend=TG_WINAPI then
            c_funz(xKillTimer,{NULL,handle})
            deld(handle,timer_ids)
        elsif backend=TG_JS then
            #ilJS{
                crash(`JS (tg_set_timer_attribute)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
        handle = NULL
        flags = or_bits(flags,CF_INACTIVE)
    end if
    if name=`MSECS`
    or name=`MSEC`
    or name=`TIME` then
        if string(v) then v = to_number(v) end if
        assert(atom(v) and v>=0,"<=0?",nFrames+2)
        deferred_attr[id] = v
        bOK = true
    elsif name=`RUN`
       or name=`RUNNING`
       or name=`ACTIVE` then
        v = tg_to_bool(v,nFrames+2)
        bRunning = v
        bOK = true
    end if
    if bOK then
        atom msecs = deferred_attr[id]
        if bRunning and msecs then
            if backend=TG_GTK then
                if tg_gtk_timer_proc_cb==NULL then
                    tg_gtk_timer_proc_cb = call_back({'+',tg_gtk_timer_proc})
                end if
                handle = c_func(x_g_timeout_add,{msecs,tg_gtk_timer_proc_cb,id})
            elsif backend=TG_WINAPI then
                if tg_WinAPI_timer_proc_cb=NULL then
                    tg_WinAPI_timer_proc_cb = call_back({'+',tg_WinAPI_timer_proc})
                end if
                handle = c_func(xSetTimer,{NULL,0,msecs,tg_WinAPI_timer_proc_cb})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_set_timer_attribute2)`);
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
            setd(handle,id,timer_ids)
            flags -= CF_INACTIVE
        end if
        ctrl_handles[id] = handle
        ctrl_flags[id] = flags
    end if
    return bOK
end function

function tg_get_timer_attribute(gdx id, string name, integer nFrames)
    if name=`MSECS`
    or name=`MSEC`
    or name=`TIME` then
        return deferred_attr[id]
    elsif name=`RUN`
       or name=`RUNNING`
       or name=`ACTIVE` then
        return not and_bits(ctrl_flags[id],CF_INACTIVE)
    end if
    tg_bad_attr(id,name,nFrames+1)
end function

global function gTimer(rtn action=NULL, atom msecs=40, boolean active=true, object user_data=NULL)
    if not bInit then tg_Init() end if
    if timer_ids=NULL then timer_ids = new_dict() end if
    integer timer = tg_add_control(TIMER,CF_INACTIVE)
    tg_register_handler(TIMER,`ACTION`,{`PO`,`P`})
    ctrl_set_attr[TIMER] = tg_set_timer_attribute
    ctrl_get_attr[TIMER] = tg_get_timer_attribute
    if action!=NULL then gSetHandler(timer,`ACTION`,action) end if
    gSetAttributes(timer,`==`,{{`MSECS`,msecs},
                               {`RUN`,active},
                               {`USER_DATA`,user_data}},nFrames:=2)
    return timer
end function 

local procedure tg_redraw_dlg(gdx timer)
    gdx dlg = gGetAttribute(timer,`USER_DATA`)
    gSetAttribute(timer,`RUN`,false)
    gRedraw(dlg)
end procedure

local procedure schedule_redraw(gdx dlg)
    gdx timer = ctrl_xtra[dlg][DX_RIP_TIMER]
    if timer==NULL then
        timer = gTimer(tg_redraw_dlg,125,true,dlg)
        ctrl_xtra[dlg][DX_RIP_TIMER] = timer
    else
        gSetAttribute(timer,`RUN`,true)
    end if
end procedure


--gboolean focus(GtkWidget* self, GtkDirectionType direction, gpointer user_data)
local function tg_gtk_focus(atom widget, integer direction, gdx id)
    -- GTK only part (WinAPI equivalent in tg_WinAPI_process_key) [DEV, erm, pardon?!]
    -- Same tab handling as WinAPI, since GTK often gets it wrong.
    assert(id=tg_getID(widget))
    integer ct = ctrl_types[id] 
    assert(ct=DIALOG)
    gdx fid = gGetFocus()
    if fid then id = fid end if
    tg_find_next_tab_stop(id,direction)
    return true
end function

local function tg_gtk_hide(atom handle, gdx id)
    -- GTK-only.
    -- keep parented windows for reuse, let main window perish
    --   maybe: keep a count of windows currently active...
    --      maybe: compare against PrimaryWindowID...
    assert(id=tg_getID(handle))
    integer ct = ctrl_types[id] 
    assert(ct=DIALOG)
    if not tg_close_handler(id) then
        -- ugh, but it works! (but not top-level windows)
        c_proc(x_gtk_widget_show,{handle})
        return true
    end if
    if id==PrimaryWindowID then return false end if
    c_proc(x_gtk_widget_hide,{handle})
    return true
end function

local function tg_gtk_delete(atom handle, event, gdx id)
--reminder: this triggers when you click on the RED CLOSE BUTTON or Alt-F4, and /NOT/ when you tap escape!
    return tg_gtk_hide(handle, id)
end function

local function tg_gtk_state_event(atom /*widget*/, event, integer id)
    if gdx(id) then -- left-over from unit_tests??
        atom event_type = get_struct_field(idGdkEventWindowState,event,`event_type`),
             changed = get_struct_field(idGdkEventWindowState,event,`changed_mask`),
             state = get_struct_field(idGdkEventWindowState,event,`new_window_state`)
        assert(event_type==GDK_WINDOW_STATE)
        ctrl_xtra[id][DX_GTK_STATE] = state
        if and_bits(changed,GDK_WINDOW_STATE_ICONIFIED)
        and and_bits(state,GDK_WINDOW_STATE_ICONIFIED) then
            if tg_gtk_kill_menu(id) then return true end if
        end if
    end if
    -- TRUE to stop other handlers from being invoked for the event. FALSE to propagate the event further.
    return false
end function

local function tg_gtk_dialog_draw(atom canvas, cairo, gdx id) -- (GTK only)
    assert(id=tg_getID(canvas))
    nnatom window = c_func(x_gtk_widget_get_window,{canvas})
    if not bGTK3 then
        cairo = c_func(x_gdk_cairo_create,{window})
    end if
    integer ct = ctrl_types[id]
    assert(ct=DIALOG)
    atom back = gGetAttribute(id,`BGCLR`),
      {r,g,b} = to_rgba(back)
    c_proc(x_cairo_set_source_rgb,{cairo,r/255,g/255,b/255})
    c_proc(x_cairo_paint,{cairo})
    tg_draw_dialog(id)
    if not bGTK3 then
        c_proc(x_cairo_destroy,{cairo})
    end if
    return true
end function

local function tg_gtk_scroll(atom /*widget*/, event, gdx id)
    integer direction = get_struct_field(idGdkEventScroll,event,`direction`),
                state = get_struct_field(idGdkEventScroll,event,`state`),
                delta = iff(direction?-1:+1),
                shift = and_bits(state,0b01)!=0,
                ctrl = and_bits(state,0b100)!=0,
                alt = and_bits(state,0b1000)!=0,
                x = get_struct_field(idGdkEventScroll,event,`x`),
                y = get_struct_field(idGdkEventScroll,event,`y`)
    if ctrl_types[id]=DIALOG then
        id = hit_test(id,x,y)
    end if
    tg_mousewheel(id, delta, ctrl, shift, alt)
    -- TRUE to stop other handlers from being invoked for the event. FALSE to propagate the event further.
    return false
end function

local function tg_gtk_mouseleave(atom widget, event, gdx dlg)
    assert(dlg=tg_getID(widget))
    integer event_type = get_struct_field(idGdkEventCrossing,event,`event_type`)
    if event_type=GDK_LEAVE_NOTIFY then
        tg_mouseleave(dlg) -- nb as per WM_MOUSELEAVE, dialog only
    end if
    -- TRUE to stop other handlers from being invoked for the event. FALSE to propagate the event further.
    return false
end function

local function tg_gtk_grab_broken(atom widget, event, integer dlg)
    if gdx(dlg) then
        assert(dlg=tg_getID(widget))
        if tg_gtk_kill_menu(dlg) then return true end if
    end if
    -- TRUE to stop other handlers from being invoked for the event. FALSE to propagate the event further.
    return false
end function

local function tg_gtk_click(atom widget, event, gdx id)
    -- GTK only part (WinAPI equivalent in tg_WinAPI_WndProc)
    bool bPopup = and_bits(ctrl_flags[id],CF_POPUP)!=0
    assert(bPopup or (id=tg_getID(widget)))
    if bPopup or widget=ctrl_handles[id] then -- (ignore ctrl_xtra[id][DX_CANVAS] events)
        integer event_type = get_struct_field(idGdkEventButton,event,`event_type`)
        if event_type!=GDK_TRIPLE_BUTTON_PRESS then -- (ignore(6), since WinAPI has nothing similar)
            integer btn = get_struct_field(idGdkEventButton,event,`button`),
                 button = `LMRXY`[btn],
                pressed = `SD?R`[event_type-3], -- GDK_BUTTON_PRESS..GDK_BUTTON_RELEASE
                  state = get_struct_field(idGdkEventButton,event,`state`),
                   ctrl = and_bits(state,GDK_CONTROL_MASK)!=0,
                  shift = and_bits(state,GDK_SHIFT_MASK)!=0,
                    alt = and_bits(state,GDK_ALT_MASK)!=0,
                      x = get_struct_field(idGdkEventButton,event,`x`,true),
                      y = get_struct_field(idGdkEventButton,event,`y`,true)
            if pressed='S' and not bPopup then {} = tg_gtk_kill_menu(id) end if
            sequence status = {button,pressed,ctrl,shift,alt}
            return tg_click_handler(id,status,x,y)=TG_IGNORE
        end if
    end if
-- TRUE to stop other handlers from being invoked for the event. FALSE to propagate the event further.
    return false
end function

local procedure tg_setID(atom handle, integer id)
    integer ct = ctrl_types[id]
    assert(ct!=TIMER)
    ctrl_handles[id] = handle
    if backend=TG_GTK then
        setd(handle,id,GTK_ID_LOOKUP)
    elsif backend=TG_WINAPI then
        if handle!=NULL then -- (not a virtual box)
            {} = c_func(xSetWindowLong,{handle,GWL_USERDATA,id})
        end if
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_setID)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
end procedure

--local function tg_WinAPI_create_control(integer id, string class_name, nullable_string lbl, atom pHwnd, w, h, dwStyle, dwExStyle)
local function tg_WinAPI_create_control(integer id, atom class_name, lbl, pHwnd, w, h, dwStyle, dwExStyle)
    sequence cw_params = {dwExStyle,        -- extended style
                          class_name,       -- lpszClassName
                          lbl,              -- lpszWindowName
                          dwStyle,          -- window style
                          CW_USEDEFAULT,    -- initial x position
                          CW_USEDEFAULT,    -- initial y position
                          w,                -- initial x size
                          h,                -- initial y size
                          pHwnd,            -- parent window handle
                          NULL,             -- window menu handle OR user id for child windows
                          NULL,             -- program instance handle - Legacy of Win16 apps. 0 will work too.
                          NULL}             -- creation parameters
    assumed_hWnd = NULL
    assume_id = id
    atom hWnd = c_func(xCreateWindowEx,cw_params)
    if hWnd=0 then
        crash(`CreateWindowEx error #%08x`,{c_func(xGetLastError,{})})
    end if
    assert(assumed_hWnd=NULL or assumed_hWnd=hWnd)
    assume_id = 0
    tg_setID(hWnd,id)
    return hWnd  -- (nb handle not id!)
end function

function tg_gtk_query_tooltip(atom /*widget*/, integer x, y, /*keyboard_mode*/, tooltip, integer dlg)
    gdx id = hit_test(dlg,x,y)
