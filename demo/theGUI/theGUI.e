procedure plot_aa(gcp canvas, atom x,y)
    integer ix = floor(x), nx = ix+1,
            iy = floor(y), ny = iy+1

    atom fx = x-ix, gx = (1-fx),
         fy = y-iy, gy = (1-fy)

    tg_plot(canvas,ix,iy,gx*gy)
    tg_plot(canvas,nx,iy,fx*gy)
    tg_plot(canvas,ix,ny,gx*fy)
    tg_plot(canvas,nx,ny,fx*fy)
end procedure

--puts(1,"")
local procedure tg_wu_ellipse(gcp canvas, atom xc, yc, w, h, a1, a2, rot, colour, integer width, object style)
--?{"tg_wu_ellipse",style}
--
-- (draws a circle when w=h) credit:
-- https://yellowsplash.wordpress.com/2009/10/23/fast-antialiased-circles-and-ellipses-from-xiaolin-wus-concepts/
--
    if w<=0 or h<=0 then return end if
    tg_wu_set_rgbL(colour)
    xc = round(xc)
    yc = round(yc)
    w = round(w)
    h = round(h)

    a1 = mod(a1,360)
    a2 = mod(a2,360)
    if a2<=a1 then a2 += 360 end if

    integer dots = 1, d = floor(width/2)
    bool every_other = true
    sequence dasher = iff(sequence(style)?style:dashers[style])

    atom a = w/2,
         b = h/2,
        cr = cos(rot*TG_DEG2RAD),
        sr = sin(rot*TG_DEG2RAD),
         t = a1*TG_DEG2RAD,
        te = a2*TG_DEG2RAD

    while t<=te do

        atom ct = cos(t),
             st = sin(t),
              x = xc + a*ct*cr - b*st*sr,
              y = yc + a*ct*sr + b*st*cr

        every_other = not every_other
        if style!=TG_DOTTED or every_other=1 then
            dots = iff(dots=length(dasher)?1:dots+1)
        end if
        if dasher[dots] then
            plot_aa(canvas,x,y)
        end if

        atom dxdt = -a*st*cr - b*ct*sr,
             dydt = -a*st*sr + b*ct*cr,
                s = sqrt(dxdt*dxdt + dydt*dydt),
               dt = min(0.25,0.75/s)
        t += dt
    end while
end procedure

local procedure tg_wu_bezier(gcp canvas, atom x1, y1, x2, y2, x3, y3, x4, y4, colour, integer width, object style)
    --
    -- draw a cubic bezier curve from x1,y1 to x4,y4 
    --          using control points x2,y2 and x3,y3
    -- aside: {x2,y2}=={x3,y3} shd == gDrawQuadBezier
    --
    integer wu_d = floor(width/2), wub_dots = 1
    tg_wu_set_rgbL(colour)

    sequence curve = {{x1,y1,x2,y2,x3,y3,x4,y4}},
        wub_dasher = iff(sequence(style)?style:dashers[style])
    while length(curve) do -- main bisect loop
        {x1,y1,x2,y2,x3,y3,x4,y4} = curve[$]
        --
        -- Uses the de Castejau method, with particular credit to 
        -- https://hcklbrrfnn.files.wordpress.com/2012/08/bez.pdf
        -- (or see a similar diagram in gCanvas.htm/technicalia)
        --
        --   -- l,m,r are the first mid-points,
        atom lx = (x1+x2)/2,  ly = (y1+y2)/2,
             mx = (x2+x3)/2,  my = (y2+y3)/2,
             rx = (x3+x4)/2,  ry = (y3+y4)/2,
             -- n,p are the secondary mid-points,
             nx = (lx+mx)/2,  ny = (ly+my)/2,
             px = (mx+rx)/2,  py = (my+ry)/2,
             -- q is the (single) found point on the curve.
             qx = (nx+px)/2,  qy = (ny+py)/2,
             -- the size of the square containing s,q,e:
             sx = max({x1,qx,x4})-min({x1,qx,x4}),
             sy = max({y1,qy,y4})-min({y1,qy,y4})

            atom dx = x1-x4,
                 dy = y1-y4
            bool bSteep = abs(dx)<abs(dy)

        bool bSubPixel = sx<1 and sy<1
        if not bSubPixel then
            --
            -- bisect curve[$] until it is:
            --
            curve[$] = {qx,qy,px,py,rx,ry,x4,y4}
            curve  &= {{x1,y1,lx,ly,nx,ny,qx,qy}}
        else
            curve = curve[1..$-1] -- discard/done
            --
            -- It is quite likely we will have split a segment length 1.5
            -- into 0.76 and 0.77, since nowt here is genuinely straight,
            -- and one of those straddles (say) y=12 whereas the other is 
            -- entirely between y=12 and y=13. For the straddler estimate
            -- x using straight-line algebra and draw two pixels, whereas
            -- we can/should just ignore the other and let prev/next segs
            -- set their more accurate pixels (on y=12 and y=13).
            --
            wub_dots = iff(wub_dots=length(wub_dasher)?1:wub_dots+1)
            if wub_dasher[wub_dots] then
                if ceil(y1)!=ceil(y4) then
                    atom cy = floor(max(y1,y4)),
                         iy = x1 + dx/dy*(cy-y1)
                    integer x = floor(iy)
                    atom fx = iy-x
                    if wu_d=0 then
                        tg_plot(canvas,x,cy,1-fx)
                        tg_plot(canvas,x+1,cy,fx)
                    else
                        tg_plot(canvas,x-wu_d,cy,1-fx)
                        for i=-wu_d+1 to wu_d-1 do
                            tg_plot(canvas,x+i,cy,1)
                        end for
                        tg_plot(canvas,x+wu_d,cy,fx)
                    end if
                end if -- straddles a unit y
                if ceil(x1)!=ceil(x4) then
                    atom cx = floor(max(x1,x4)),
                         ix = y1 + dy/dx*(cx-x1)
                    integer y = floor(ix)
                    atom fy = ix-y
                    if wu_d=0 then
                        tg_plot(canvas,cx,y,1-fy)
                        tg_plot(canvas,cx,y+1,fy)
                    else
                        cx -= 1
                        tg_plot(canvas,cx,y-wu_d,1-fy)
                        for i=-wu_d+1 to wu_d-1 do
                            tg_plot(canvas,cx,y+i,1)
                        end for
                        tg_plot(canvas,cx,y+wu_d,fy)
                    end if
                end if -- straddles a unit x
            end if -- dasher
        end if -- subpixel
    end while -- main bisect loop
end procedure

global procedure gDrawCubicBezier(gcps canvas, atom x1, y1, xc1, yc1, xc2, yc2, x2, y2, colour=-1, object style=-1, integer width=-1)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    if colour=-1 then colour = gGetAttribute(canvas,`FGCLR`) end if
    if width=-1 then width = gGetAttribute(canvas,`LINEWIDTH`) end if
    if style=-1 then style = gGetAttribute(canvas,`LINESTYLE`) end if
    if canvas>0 then -- a gCanvas
        canvas = ctrl_images[canvas]
    end if
    if odd(canvas) then                 -- gImage
        integer gid = (-canvas+1)/2
        if backend=TG_GTK then
            atom pixbuf = gimages[gid][TG_IMG_HANDLE]
            integer pw = c_func(x_gdk_pixbuf_get_width,{pixbuf}),
                    ph = c_func(x_gdk_pixbuf_get_height,{pixbuf}),
                stride = c_func(x_gdk_pixbuf_get_rowstride,{pixbuf})
            atom pixels = c_func(x_gdk_pixbuf_get_pixels,{pixbuf}),
                surface = c_func(x_cairo_image_surface_create_for_data,
                          {pixels, CAIRO_FORMAT_ARGB32, pw, ph, stride}),
                  cairo = c_func(x_cairo_create,{surface})
            object rect = gimages[gid][TG_IMG_CLIP]
            if rect!=NULL then
                atom {xmin, ymin, xmax, ymax} = rect
                c_proc(x_cairo_rectangle,{cairo,xmin,ymin,xmax-xmin,ymax-ymin})
                c_proc(x_cairo_clip,{cairo})
            end if
            colour = tg_GTK_rgba_to_bgra(colour)
            tg_gtk_set_image_pen(cairo, colour, width, style)
            c_proc(x_cairo_move_to,{cairo,x1+.5,y1+.5})
            c_proc(x_cairo_curve_to,{cairo,xc1+.5,yc1+.5,xc2+.5,yc2+.5,x2+.5,y2+.5})
            c_proc(x_cairo_stroke,{cairo})
            c_proc(x_cairo_destroy,{cairo})
            c_proc(x_cairo_surface_destroy,{surface})
        elsif backend=TG_WINAPI then
            atom hDC = tg_WinAPI_GetDestDC(),
                hTgt = gimages[gid][TG_IMG_HANDLE],
                pTgt = c_func(xSelectObject,{hDC,hTgt}),
                hPen = tg_WinAPI_get_pen(canvas, colour, width, style),
                pPen = c_func(xSelectObject,{hDC,hPen}) 
--          imageDC = hDC
            tg_wu_bezier(canvas,x1,y1,xc1,yc1,xc2,yc2,x2,y2,colour,width,style)
            tg_WinAPI_handles_match(hPen,c_func(xSelectObject,{hDC,pPen}),source_line())
            tg_WinAPI_handles_match(hTgt,c_func(xSelectObject,{hDC,pTgt}),source_line())
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gDrawCubicBezier)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    else                                -- gPixbuf
        integer pid = -canvas/2
--      pbw = length(gpixbufs[pid][1])
--      pbh = length(gpixbufs[pid])
        tg_wu_bezier(canvas,x1,y1,xc1,yc1,xc2,yc2,x2,y2,colour,width,style)
    end if
end procedure

global procedure gDrawQuadBezier(gcps canvas, atom x1, y1, cx, cy, x2, y2, colour=-1, object style=-1, integer width=-1)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    -- draw a cubic bezier curve from x1,y1 to x2,y2 
    --                 using the control point cx,cy
    gDrawCubicBezier(canvas,x1,y1,cx,cy,cx,cy,x2,y2,colour,style,width)
end procedure

global function gRotatePolygon(sequence poly, object angle)
--
--  DEV this is a fair bit slower than I thought it would be...
--  In demo\theGUI\gDrawPolygon.exw the Phix logo with 33 {x,y}
--  rotates worse than twice as slowly as the house with 5 {x,y}
--  whereas I expected it would be keyboard-repeat-rate bound...
--
--  Update: there is a 10* faster #ilASM{} version of this in 
--         demo\theGUI\gDrawPoly.exw in case it is ever needed.
--
    atom cx, cy
    if sequence(angle) then
        {angle,cx,cy} = angle
    else
        {cx,cy} = poly[1]
    end if
    if angle!=0 then
        integer lp = length(poly)
        sequence res = repeat(0,lp)
        atom rr = angle*TG_DEG2RAD,
             sr = sin(rr),
             cr = cos(rr)
        for i,pi in poly do
            integer lpi = length(pi)
            if lpi=0 then
                res[i] = {}
            elsif lpi>=8 then
                crash(`arc segments not supported`,nFrames:=2)
            elsif odd(lpi) then
                crash(`odd segment length found`,nFrames:=2)
            else
                sequence ri = repeat(0,lpi)
                for j=1 to lpi-1 by 2 do
                    integer k = j+1
                    atom x = pi[j] - cx,
                         y = pi[k] - cy
                    -- counter-clockwise:
--                  {x,y} = {y*s + x*c + cx, 
--                           y*c - x*s + cy}
                    -- clockwise:
--                  {x,y} = {x*c - y*s + cx, 
--                           x*s + y*c + cy}
--                  pi[j] = x
--                  pi[k] = y
--                  pi[j] = x*c - y*s + cx
--                  pi[k] = x*s + y*c + cy
                    ri[j] = x*cr - y*sr + cx
                    ri[k] = x*sr + y*cr + cy
                end for
                res[i] = ri
            end if
        end for
        return res
    end if
    return poly
end function

function ellipse_point(atom xc, yc, a, b, cr, sr, t)
    atom ct = cos(t),
         st = sin(t)
    return { xc + a*ct*cr - b*st*sr,
             yc + a*ct*sr + b*st*cr }
end function

--global procedure gDrawArc(gcps canvas, atom xc, yc, w, h, angle1=0, angle2=360, rot=0, flags=0, colour=-1, integer width=-1, object style=-1)
global procedure gDrawArc(gcps canvas, atom xc, yc, w, h, angle1=0, angle2=360, rot=0, flags=0, colour=-1, object style=-1)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    -- The arc starts at the point (xc+(w/2)*cos(angle1),
    --                              yc+(h/2)*sin(angle1))
    -- and ditto ends/angle2 (but WinAPI goes counter-clockwise):
    atom a = w/2,
         b = h/2,
        cr = cos(rot*TG_DEG2RAD),
        sr = sin(rot*TG_DEG2RAD),
        t1 = angle1*TG_DEG2RAD,
        t2 = angle2*TG_DEG2RAD,
        {sx,sy} = ellipse_point(xc,yc,a,b,cr,sr,t1),
        {ex,ey} = ellipse_point(xc,yc,a,b,cr,sr,t2)
    sequence poly
    bool bFilled = and_bits(flags,TG_FILLED)
    if bFilled then
        poly = {{sx,sy,xc,yc,w,h,angle2,angle1,rot},{ex,ey}}
        if and_bits(flags,TG_SECTOR) then
            poly &= {{xc,yc}}
        end if
    end if

    if colour=-1 then colour = gGetAttribute(canvas,`FGCLR`) end if
--  if width=-1 then width = gGetAttribute(canvas,`LINEWIDTH`) end if
    integer width = 1
    if style=-1 then style = gGetAttribute(canvas,`LINESTYLE`) end if
    if canvas>0 then -- a gCanvas
        canvas = ctrl_images[canvas]
    end if
    if odd(canvas) then                 -- gImage
        integer gid = (-canvas+1)/2
        if backend=TG_GTK then
            atom pixbuf = gimages[gid][TG_IMG_HANDLE]
            integer pw = c_func(x_gdk_pixbuf_get_width,{pixbuf}),
                    ph = c_func(x_gdk_pixbuf_get_height,{pixbuf}),
                stride = c_func(x_gdk_pixbuf_get_rowstride,{pixbuf})
            atom pixels = c_func(x_gdk_pixbuf_get_pixels,{pixbuf}),
                surface = c_func(x_cairo_image_surface_create_for_data,
                          {pixels, CAIRO_FORMAT_ARGB32, pw, ph, stride}),
                  cairo = c_func(x_cairo_create,{surface})
            object rect = gimages[gid][TG_IMG_CLIP]
            if rect!=NULL then
                atom {xmin, ymin, xmax, ymax} = rect
                c_proc(x_cairo_rectangle,{cairo,xmin,ymin,xmax-xmin,ymax-ymin})
                c_proc(x_cairo_clip,{cairo})
            end if
            colour = tg_GTK_rgba_to_bgra(colour)
            tg_gtk_set_image_pen(cairo, colour, width, style)
            c_proc(x_cairo_new_path,{cairo})
            c_proc(x_cairo_save,{cairo})
            c_proc(x_cairo_translate,{cairo,xc,yc})
            if rot then
                c_proc(x_cairo_rotate,{cairo,rot*PI/180})
            end if
            c_proc(x_cairo_scale,{cairo,w/2,h/2})
--          c_proc(x_cairo_arc,{cairo,0,0,1,a1r,a2r})
            c_proc(x_cairo_arc,{cairo,0,0,1,t1,t2})
            if and_bits(flags,TG_SECTOR) then
                c_proc(x_cairo_line_to,{cairo,0,0})
                c_proc(x_cairo_close_path,{cairo})
            end if
            c_proc(x_cairo_restore,{cairo})
            if bFilled then
                c_proc(x_cairo_fill,{cairo})
            else
                c_proc(x_cairo_stroke,{cairo})
            end if
            c_proc(x_cairo_destroy,{cairo})
            c_proc(x_cairo_surface_destroy,{surface})
        elsif backend=TG_WINAPI then
            atom hDC = tg_WinAPI_GetDestDC(),
                hTgt = gimages[gid][TG_IMG_HANDLE],
                pTgt = c_func(xSelectObject,{hDC,hTgt}),
                hPen = tg_WinAPI_get_pen(canvas, colour, width, style),
                pPen = c_func(xSelectObject,{hDC,hPen}) 
--          imageDC = hDC
--My gDrawArc routine contains this code:
            tg_wu_ellipse(canvas,xc,yc,w,h,angle1,angle2,rot,colour,width,style)
            if and_bits(flags,TG_SECTOR) then
                tg_wu_line(canvas,sx,sy,xc,yc,colour,width,style)
                tg_wu_line(canvas,xc,yc,ex,ey,colour,width,style)
            elsif and_bits(flags,TG_CHORD) or bFilled then
                tg_wu_line(canvas,sx,sy,ex,ey,colour,width,style)
            end if
--And for obvious reasons that is leaving the sector/chord lines unrotated, what fix might you suggest?

            tg_WinAPI_handles_match(hPen,c_func(xSelectObject,{hDC,pPen}),source_line())
            tg_WinAPI_handles_match(hTgt,c_func(xSelectObject,{hDC,pTgt}),source_line())
            if bFilled then
                tg_polyfill(canvas,poly,colour) -- (colour not used)
            end if
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gDrawArc)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    else                                -- gPixbuf
        integer pid = -canvas/2
--      pbw = length(gpixbufs[pid][1])
--      pbh = length(gpixbufs[pid])
        tg_wu_ellipse(canvas,xc,yc,w,h,angle1,angle2,rot,colour,width,style)
        if and_bits(flags,TG_SECTOR) then
            tg_wu_line(canvas,sx,sy,xc,yc,colour,width,style)
            tg_wu_line(canvas,xc,yc,ex,ey,colour,width,style)
        elsif and_bits(flags,TG_CHORD) then
            tg_wu_line(canvas,sx,sy,ex,ey,colour,width,style)
        end if
        if bFilled then
            tg_polyfill(canvas,poly,colour)
        end if
    end if
end procedure

