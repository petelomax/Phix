local function compact_string(object c)
    -- helper/shortener for tg_lm_dump_ctrls
    if not sequence(c) then return sprintf(`%v`,c) end if
    integer l = length(c)
    string res = `{`
    while l do
        integer prev = c[1]
        for i=2 to l+1 do
            if i>l or c[i]!=prev+1 then
                if i=2 then
                    res &= sprintf(`%d`,prev)
                elsif i=3 then
                    res &= sprintf(`%d,%d`,c[1..2])
                else
                    res &= sprintf(`%d..%d`,{c[1],c[i-1]})
                end if
                c = c[i..$]
                if i<=l then res &= `,` end if
                exit
            end if
            prev += 1
        end for
        l = length(c)
    end while
    res &= `}`
    return res
end function

bool bDumpMargins = false
bool bShowBGCLR = false

procedure tg_lm_dump_ctrls(integer srcline, string what)
    string stuff = iff(bDumpMargins?`margins`
                  :iff(bShowBGCLR?`bgclr`:`flags`))
    printf(1,"id ---ctyp---   x   y   w   h  nw  nh  uw  uh  p  children   %s [%d, %s]\n",{stuff,srcline,what})
    for id=1 to length(ctrl_types) do
        integer ct = ctrl_types[id],
                 x = ctrl_size[id][SZ_X],
                 y = ctrl_size[id][SZ_Y],
                 w = ctrl_size[id][SZ_W],
                 h = ctrl_size[id][SZ_H],
                nw = ctrl_size[id][SZ_NORMAL_W],
                nh = ctrl_size[id][SZ_NORMAL_H],
                uw = ctrl_size[id][SZ_USER_W],
                uh = ctrl_size[id][SZ_USER_H],
                 p = ctrl_parent[id]
        string idt = ctrl_names[ct],
              csch = compact_string(children_ids[id])
        integer flags = ctrl_flags[id]
        if ct=BOX then
            integer c = and_bits(flags,CF_CONCRETE),
                    v = and_bits(flags,CF_VERTICAL)
            idt := iff(c?`gCbox`:iff(v?`gVbox`:`gHbox`))
            flags -= v+c
        end if
        string f
        if bDumpMargins then
            f = sprintf(`%v`,{ctrl_size[id][SZ_MARGIN]})
        elsif bShowBGCLR then
            f = gGetColourName(ctrl_bg[id]) -- (-1's better in a dump anyway)
        else
            f = decode_flags(cf_glags,flags)
            f = substitute(f,`+CF_`,`+`)
            f = substitute(f,`CONTAINER`,`CTNR`)
            f = substitute(f,`DECORATED`,`DECOR`)
            f = substitute(f,`CLOSE_ON_ESC`,`CLESC`)
        end if
        printf(1,"%2d %-10s %3d %3d %3d %3d %3d %3d %3d %3d %2d  %-10s %s\n",
                 { id,  idt,  x,  y,  w,  h, nw, nh, uw, uh,  p,  csch, f})
    end for
end procedure

local procedure tg_resize_for_splitter(gdx splitter)
    gdx dlg = gGetDialog(splitter)
    integer x = ctrl_size[dlg][SZ_X],
            y = ctrl_size[dlg][SZ_Y],
            w = ctrl_size[dlg][SZ_W],
            h = ctrl_size[dlg][SZ_H]
    if backend=TG_WINAPI or not ctrl_xtra[dlg][DX_FULLSCREEN] then
        w -= 2
        h -= 32
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_resize_for_splitter)`);
        #}ilJS
    end if
    tg_lm_accumulate_and_disperse_user_sizes(dlg,w,h,who:="tg_resize_for_splitter")
end procedure

bool bDumpOnRedraw = false -- set via gSetGlobal(`DIAGNOSTICS`,`DUMPONREDRAW`)

forward local procedure schedule_redraw(gdx dlg)

global procedure gRedraw(gdx id, bool bNow = false)
    -- Aside: the invalidate rect seems to be enough to trigger tg_lm_ stuff...
    if and_bits(ctrl_flags[id],CF_SPLIT) then
        tg_resize_for_splitter(id)
    end if
    gdx dlg = gGetDialog(id)
    if dlg then
        if and_bits(ctrl_flags[dlg],CF_REDRAW_IP) then
            -- gRedraw() won't work as hoped when called from a REDRAW handler
            -- (as needed by OpenGL and libmpv), so schedule another in 0.125s:
            schedule_redraw(dlg)
        else
--          integer w = max(ctrl_size[dlg][SZ_USER_W],ctrl_size[dlg][SZ_NORMAL_W]),
--                  h = max(ctrl_size[dlg][SZ_USER_H],ctrl_size[dlg][SZ_NORMAL_H]),
            integer w = ctrl_size[dlg][SZ_W],
                    h = ctrl_size[dlg][SZ_H]
--          if not gGetAttribute(dlg,`FULLSCREEN`) then
                integer {dw,dh} = tg_get_dialog_decoration_size(dlg)
                w -= dw
                h -= dh
--          end if
            tg_lm_accumulate_and_disperse_user_sizes(dlg,w,h,who:="gRedraw")
            if bDumpOnRedraw then
                tg_lm_dump_ctrls(source_line(), `gRedraw`)
            end if
            atom handle = ctrl_handles[dlg]
            if backend=TG_GTK then
                atom window = c_func(x_gtk_widget_get_window,{handle})
                if window then
                    atom pTitle = c_func(x_gtk_window_get_title,{handle})
                    if pTitle then
                        c_proc(x_gtk_window_set_title,{handle,pTitle})
                    end if
                    c_proc(x_gdk_window_invalidate_rect,{window,NULL,true})
                end if
                c_proc(x_gtk_widget_queue_draw,{handle})
                -- Aside: I'm sure this was once needed for gProgress.exw,
                --        but now it seems to make no difference... (in a good way)
                -- hence I've taken bNow out of the docs / -> technicalia...
                if window and bNow then
                    c_proc(x_gdk_window_process_updates,{window,true})
                end if
            elsif backend=TG_WINAPI then
                c_funk(xInvalidateRect,{handle,NULL,false});
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (gRedraw)`);
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    else
        -- note this is for popups; for (only) the menubar just gRedraw(menu)
        if backend=TG_GTK then
            atom hPopup = ctrl_hdc[id][2]
            c_proc(x_gtk_widget_queue_draw,{hPopup})
        elsif backend=TG_WINAPI then
            atom hWnd = ctrl_hdc[id][1]
            c_funk(xInvalidateRect,{hWnd,NULL,false});
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gRedraw2)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
    end if
end procedure 

local procedure tg_defer_attr(gdx id, string name, object v)
    integer k = find(name,vslice(deferred_attr[id],1))
    if k then
        deferred_attr[id][k][2] = v 
    else
        deferred_attr[id] &= {{name,v}}
    end if
end procedure

