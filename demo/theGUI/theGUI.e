local function tg_gtk_mnemonicalize(string s)
    -- eg "&File" -> "_File", so the F actually gets underlined
    string out = ""
    bool bSkip = false
    for i,ch in s do
        if bSkip then
            bSkip = false
        elsif ch='&' then
            if i=length(s) or s[i+1]='&' then
                out &= "&amp;"
                bSkip = true
            else
                out &= "_"
            end if
        elsif ch='<' then
            out &= "&lt;"
        elsif ch='>' then
            out &= "&gt;"
        elsif ch='_' then
            out &= "__"
        else
            out &= ch
        end if
    end for
    return out
end function

local function tg_demnemonicalize(string s)
    -- convert eg `&Help` to `Help` for sizing, more examples below
    --  (also used on menus for the alt key mnemonic toggling)
    string res = ``
    integer l = length(s)
    bool skip = false
    for i=1 to l do
        if skip then
            skip = false
        else
            integer c = s[i]
            if c!='&' or i=l then
                res &= c
            else
                res &= s[i+1]
                skip = true
            end if
        end if
    end for
    return res
end function

local integer tg_gte_image_cache = NULL

global function gGetTextExtent(sequence text, object tgt=TG_STD_FONT, bool bNorm=false)
    -- bNorm false: treat eg &www as the first w underlined (eg gButton, gLabel, gMenu, ..)
    --        true: treat that as-is (eg in theEditor, a gText, gList, gTable, gTree[?], ..)
    assert(not gdp(tgt),`gGetTextExtent cannot be used on a gPixBuf!`,nFrames:=2)
    string face = iff(string(tgt)?tgt:gGetAttribute(tgt,`FONT`))
    if string(tgt) or not gdm(tgt) then
        if gdx(tgt) then tgt = gGetAttribute(tgt,`FONT`) end if
        if tg_gte_image_cache==NULL then tg_gte_image_cache = new_dict() end if
        gdn res = getdd(tgt,NULL,tg_gte_image_cache)
        if res=NULL then
            res = gImage(10,10)
            setd(tgt,res,tg_gte_image_cache)
        end if
        tgt = res
    end if
--  if string(text) then text = split(text,'\n') end if
    if string(text) then text = split(text,'\n',false) end if
    integer w = 0, h = max(length(text),1)
    atom layout, hDC, prev, angle=0
    if backend=TG_GTK then
        layout = tg_gtk_get_layout(tgt)
        tg_set_font(0,layout,face,angle)
        h *= tg_GTK_get_image_text_height(layout)
    elsif backend=TG_WINAPI then
        hDC = tg_WinAPI_GetDestDC()
        atom pixbuf = gimages[(-tgt+1)/2][TG_IMG_HANDLE]
        prev = c_func(xSelectObject,{hDC,pixbuf})
        tg_set_font(0,hDC,face,angle)
--?{"gte",h}
        h *= tg_WINAPI_get_image_text_height(hDC)
--?h
    elsif backend=TG_JS then    
        tgt = gimages[(-tgt+1)/2][TG_IMG_HANDLE]
        #ilJS{
            h *= tg_JS_get_image_height(tgt,face); // (sets font and ctx)
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    for i,t in text do
        if backend=TG_GTK then
            if not bNorm then
                t = tg_gtk_mnemonicalize(t) -- eg "&File" -> "_File"
            end if
            w = max(w,tg_GTK_get_image_text_width(layout,t,bNorm))
        elsif backend=TG_WINAPI then
            if not bNorm then
                t = tg_demnemonicalize(t) -- eg `&File` --> `File`
            end if
            sequence utf16 = utf8_to_utf16(t)
            integer l = length(utf16)
            atom pUTF16 = allocate(2*l)
            poke2(pUTF16,utf16)
            c_funk(xGetTextExtentPoint32W,{hDC,pUTF16,l,pSIZE})
            w = max(w,get_struct_field(idSIZE,pSIZE,`cx`))
            free(pUTF16)
        elsif backend=TG_JS then    
            #ilJS{
                let ti = t.replace(js_re_sp,"_");
                if (bNorm) {
                    // "as-is":
                    ti = ti.replace(js_re_am,"&amp;");
                } else {
                    // treat &www as <u>w</u>www or equivalently just "www"
                    ti = ti.replace(js_re_am,"");
                }
                let tm = tgt.ctx.measureText(ti),
                    wi = tm.actualBoundingBoxLeft + tm.actualBoundingBoxRight;
                w = max(w,wi);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    end for
    return {w,h}
end function

