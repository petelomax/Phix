global function gVersion(integer bBack=false)
    if not bInit then tg_Init() end if
    if bBack then
        if bBack=-1 then return backend end if -- TG_GTK/TG_WINAPI..
--      if bBack=-3 then return backend end if -- TG_GTK/TG_WINAPI..
        if bBack=-2 then
            if backend=TG_GTK then
                return iff(bGTK3?3:2)
            elsif backend=TG_WINAPI then
                return WINDOWS_VERSION
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (gVersion)`);
                #}ilJS
            else
                ?9/0 -- placeholder
            end if
        end if
        if backend=TG_GTK then
            return iff(bGTK3?`GTK3`:`GTK2`)
        elsif backend=TG_WINAPI then
            return sprintf(`Win%dAPI`,machine_bits())
        elsif backend=TG_JS then
            --/*
            return `JS`;
            --*/
        else
            ?9/0 -- placeholder
        end if
    end if
    integer pdx = find(platform(),{WINDOWS,LINUX,ARM,JS})
    string bare = `theGUI 2.0`, backing,
           plat = {`Windows`,`Linux`,`Arm`,`JavaScript`}[pdx]
    if backend=TG_GTK then
        backing = sprintf(`GTK %d.%d.%d`,gtk_version)
    elsif backend=TG_WINAPI then
        backing = `WinAPI`
        plat = sprintf(`Windows %d`,WINDOWS_VERSION)
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (gVersion2)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    return sprintf(`%s on Phix version %s (%d bits) on %s, using %s`,
                   {bare,version(),machine_bits(),plat,backing})
end function

global function rgba(object red, atom green=-1, blue=-1, alpha=0)
    if sequence(red) then
        assert(green=-1 and blue=-1 and alpha=0) -- (check exactly one arg)
        -- not only would (`red`) or (`#FF0000`) be quite wrong, the
        --  following also acts as a JavaScript compatibility check,
        --  as in pre-emptively crashing on desktop/Phix way b4 p2js.
        assert(not string(red))
        integer lr = length(red)
        if lr=3 then
            {red,green,blue} = red
        elsif lr=4 then
            {red,green,blue,alpha} = red
        else
            crash(`red not length 3|4)`,nFrames:=2)
        end if
--      assert(atom(red)) -- (will be caught by and_bits anyway)
    end if
    -- guard against rgba(atom) and rgba(atom,atom) calls:
    assert(green!=-1 and blue!=-1)
    atom colour = and_bits(alpha,#FF)*#1000000 +
                  and_bits(red,  #FF)*#10000 + 
                  and_bits(green,#FF)*#100 + 
                  and_bits(blue, #FF)
    return colour
end function

global function hsv_to_rgba(atom h, s, v, a=0)
    integer i = floor(h*6)
    atom f = h*6-i
    integer p = and_bits(v*(1-s)*#FF,#FF),
            q = and_bits(v*(1-s*f)*#FF,#FF),
            t = and_bits(v*(1-s*(1-f))*#FF,#FF),
            r,g,b
    v = and_bits(v*#FF,#FF)
--  a = #FF-and_bits(a*#FF,#FF)
    a = and_bits(a*#FF,#FF)
    switch i do
        case 0,
             6: {r,g,b} = {v,t,p}
        case 1: {r,g,b} = {q,v,p}
        case 2: {r,g,b} = {p,v,t}
        case 3: {r,g,b} = {p,q,v}
        case 4: {r,g,b} = {t,p,v}
        case 5: {r,g,b} = {v,p,q}
    end switch
    return rgba(r,g,b,a)
end function

global function to_rgb(atom colour)
    integer red = and_bits(colour,#FF0000)/#10000,
          green = and_bits(colour,#FF00)/#100,
           blue = and_bits(colour,#FF)
    return {red,green,blue}
end function    

global function to_rgba(atom colour)
    integer red = and_bits(colour,#FF0000)/#10000,
          green = and_bits(colour,#FF00)/#100,
           blue = and_bits(colour,#FF),
          alpha = and_bits(colour,#FF000000)/#1000000
--  return {red,green,blue,#FF-alpha}
    return {red,green,blue,alpha}
end function    

local function tg_WinAPI_rgb_to_bgr(atom colour)
    -- (aside: in case it helps, this is bi-directional)
    atom r = and_bits(colour,#00FF0000)/#10000,
         b = and_bits(colour,#000000FF)*#10000,
         c = and_bits(colour,#FF00FF00)+r+b
    return c
end function

--/*
My rgba to bgra colour conversion routine appears to be dog-slow.
What x86/X64 assembly would I need to convert say #AABBCCDD in eax/rax to #55DDCCBB?

OK, the first version looks good, although actually 6 instructions, but the slightly
tighter one is also 6 instructions, three bytes longer, and will produce #55CCBBAA, won't it?

OK, I may as well explain what the real situation is here (bit of old-fashioned rubber duck debugging, if you will).
Obviously there is a fair bit of code around this, but it's identical for gtk/win32, the latter inner bit is just:
            poke4(pMem,colour)
which manages a quite respectable 200,000/s, whereas the gtk side has this inner bit
            poke4(pMem,tg_GTK_rgba_to_bgra(colour))
along with
            function tg_GTK_rgba_to_bgra(atom colour)
                atom a = #FF000000-and_bits(colour,#FF000000),
                     r = and_bits(colour,#00FF0000)/#10000,
                     b = and_bits(colour,#000000FF)*#10000,
                     c = and_bits(colour,#0000FF00)+a+r+b
                return c
            end function
which crawls along at a paltry 60/s, quite astonishingly slower by worse than 3,000 times!

colour = xor_bits(colour,#FF000000)
       + and_bits(colour,#0000FF00)
       + (and_bits(colour,#00FF0000) >> 16)
       + (and_bits(colour,#000000FF) << 16)
poke4(pMem,c)

mov     ecx, eax
xor     ecx, 0FF000000h ; invert alpha
bswap   eax
shr     eax, 8
and     ecx, 0FF000000h
or      eax, ecx

nah, this is better/cooler!

bswap   eax
ror     eax,8
xor     eax,0FF000000h

AABBCCDD   original
DDCCBBAA   bswap
AADDCCBB   ror 8
55DDCCBB   xor FF000000
--*/

local function tg_GTK_rgba_to_bgra(atom colour)
    -- (aside: in case it helps, this is bi-directional)
    atom a = #FF000000-and_bitsu(colour,#FF000000),
         r = and_bits(colour,#00FF0000)/#10000,
         b = and_bits(colour,#000000FF)*#10000,
         c = and_bits(colour,#0000FF00)+a+r+b
    return c
end function

local integer tg_XPM_from_shorthand,        -- see thegui_xpm.e
              tg_winAPI_create_DIB,         -- "" 
              tg_winAPI_create_DIB_from_xpm,  -- "" 
              tg_get_colour_table           -- ""

local function tg_xpm_callback(object xpm)
    -- low-level operations for tg_xpm.e (avoids making anything global)
    if backend=TG_GTK then
        atom pList = tg_word_array(xpm),
            pixbuf = c_func(x_gdk_pixbuf_new_from_xpm_data,{pList})
--          pixbuf = c_func(x_gdk_pixbuf_new_from_file,{`test.xpm`, NULL})
        pList = free(pList)
        integer w = c_func(x_gdk_pixbuf_get_width,{pixbuf}),
                h = c_func(x_gdk_pixbuf_get_height,{pixbuf})
        atom pMem = c_func(x_gdk_pixbuf_get_pixels,{pixbuf})
--?{`tg_xpm_callback_pMem`,peek({pMem,4})&-1}
        sequence img = repeat(0,TG_IMG_SIZE)
        img[TG_IMG_HANDLE] = pixbuf
        img[TG_IMG_PIXEL_MEM] = pMem
        img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
        img[TG_IMG_HEIGHT] = h
--      img[TG_IMG_HEIGHT] = abs(h)
        img[TG_IMG_BGCLR] = TG_WHITE
        img[TG_IMG_LINESTYLE] = 1
        img[TG_IMG_LINEWIDTH] = 1
        return img

    elsif backend=TG_WINAPI then
        string what = xpm[1]
        if what=`NEWSECT` then
            atom {pBIH,hdrSize} = xpm[2],
                 pMem = allocate_word(),
                  hDC = tg_WinAPI_getDC0() -- Get the screen's device context.
            nnatom pImg = c_func(xCreateDIBSection,{hDC,            -- handle to DC
                                                    pBIH,           -- Pointer to a BITMAPINFO structure
                                                    DIB_RGB_COLORS, -- flag to enable palette
                                                    pMem,           -- points to location that gets pointer to bits location
                                                    NULL,           -- handle to file mapping object - not needed here
                                                    NULL}),         -- offset to bitmap bit values - not needed here
                   pBits = peek4u(pMem)
            ReleaseDC0(hDC)
            free(pMem)
            return {pImg,pBits}
        else
            ?9/0
        end if
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_xpm_callback)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
end function

local sequence xpm_texts = {},
               xpm_clrs = {}

local function tg_WinAPI_replace_bgclr(integer imgid, atom bgclr)
--printf(1,"tg_WinAPI_replace_bgclr(%d,%x)\n",{imgid,bgclr})
    -- if there is already one of this background colour, use that
    integer gi = xpm_clrs[imgid]
    while gi do
        if gimages[gi][TG_IMG_TRANSPARENT]=bgclr then
            return gi
        end if
        gi = gimages[gi][TG_IMG_NEXT]
    end while
    -- else create a new bitmap
    sequence xpm = xpm_texts[imgid],
             img = repeat(0,TG_IMG_SIZE)
    atom {hDIB,pMem,w,h,cTrans} = tg_winAPI_create_DIB_from_xpm(xpm,tg_xpm_callback,bgclr,true)
    img[TG_IMG_HANDLE] = hDIB
    img[TG_IMG_TRANSPARENT] = cTrans
    img[TG_IMG_PIXEL_MEM] = pMem
    img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
    img[TG_IMG_HEIGHT] = h
--  img[TG_IMG_HEIGHT] = abs(h)
    img[TG_IMG_BGCLR] = TG_WHITE
    img[TG_IMG_LINESTYLE] = 1
    img[TG_IMG_LINEWIDTH] = 1
    img[TG_IMG_NEXT] = xpm_clrs[imgid]
    gimages = append(gimages,img)
    gimgrey = append(gimgrey,NULL)
    integer id = length(gimages)
    xpm_clrs[imgid] = id
    return id
end function

local function xpm_image_slot()
    integer id = gi_freelist
    if id then
        gi_freelist = gimages[id]
        gimgrey[id] = NULL
    else
        gimages &= 0
        gimgrey &= 0
        id = length(gimages)
    end if
    return id
end function

global function gImageDestroy(object dead)
    if sequence(dead) then
        for i,d in dead do
            dead[i] = gImageDestroy(d)
        end for
    elsif dead then
        assert(gdm(dead))
        integer id = (-dead+1)/2
        if backend=TG_WINAPI then
            c_proc(xDeleteObject, {gimages[id][TG_IMG_HANDLE]})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gImageDestroy)`);
            #}ilJS
        end if
        gimages[id] = gi_freelist
        gi_freelist = id
        integer k = find(id,gimgrey)
        if k then gimgrey[k] = NULL end if
        dead = 0
    end if
    return dead
end function

global function gPixbuf_from_Pixels(sequence pixels)
    if platform()!=JS then
        integer refcount
        #ilASM{
            [32]
                mov eax,[pixels]
                mov eax,[ebx+eax*4-8]
                mov [refcount],eax
            [64]
                mov rax,[pixels]
                mov rax,[rbx+rax*4-16]
                mov [refcount],rax
            []
              }
        assert(refcount=1,`reference count not 1`,nFrames:=2)
    end if
    integer id = gpb_freelist
    if id then
        gpb_freelist = gpixbufs[id]
    else
        gpixbufs &= 0
        id = length(gpixbufs)
    end if
    gpixbufs[id] = pixels
    gdp pixbuf = -id*2
    return pixbuf
end function

global function gPixbuf_take_Pixels(gdp pid) 
    assert(integer(pid)) -- not a 2d sequence form
    integer id = -pid/2 -- (we've already proved it is even and -ve)
    sequence pixels = gpixbufs[id]
    gpixbufs[id] = gpb_freelist
    gpb_freelist = id
    return pixels
end function

global function gPixbuf(integer w, h, atom bgclr=TG_WHITE, bool bOwned=false) 
    gdp pixbuf = repeat(repeat(bgclr,w),h)
    if bOwned then
        pixbuf = gPixbuf_from_Pixels(pixbuf)
    end if
    return pixbuf
end function

global function gPixbuf_from_Image(gdn img, bool bOwned=false) 
    integer id = (-img+1)/2,
             w = gimages[id][TG_IMG_WIDTH],
             h = gimages[id][TG_IMG_HEIGHT]
    sequence gim = gimages[id]
    object pixels = repeat(0,h)
    atom pMem = gim[TG_IMG_PIXEL_MEM]
    for i=1 to h do
        sequence pi = peek4u({pMem,w})
        if backend=TG_GTK then
            pi = apply(pi,tg_GTK_rgba_to_bgra)
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gPixbuf_from_Image)`);
            #}ilJS
        end if
        pixels[i] = pi
        pMem += w*4
    end for
    img = gImageDestroy(img)
    gdp res = pixels
    pixels = 0 // kill refcount
    if bOwned then
        res = gPixbuf_from_Pixels(res)
    end if
    return res
end function

local function xImage_from_XPM(sequence xpm, atom transparent=TG_WHITE, integer nFrames=5)
    if not bInit then tg_Init() end if
    if string(xpm) then xpm = split(xpm,'\n') end if
    integer imgid = find(xpm,xpm_texts), id
    if imgid then
        if backend=TG_GTK then
            id = xpm_clrs[imgid]
        elsif backend=TG_WINAPI then
            id = tg_WinAPI_replace_bgclr(imgid,transparent)
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (xImage_from_XPM)`);
            #}ilJS
        else
            ?9/0
        end if
    else
        id = xpm_image_slot()
        xpm_texts = append(xpm_texts,xpm)
        xpm_clrs = append(xpm_clrs,id)
        sequence img -- as per XMG_IMG_XXX
        if backend=TG_GTK then
            img = tg_xpm_callback(xpm)
        elsif backend=TG_WINAPI then
            img = repeat(0,TG_IMG_SIZE)
            atom {hDIB,pMem,w,h,cTrans} = tg_winAPI_create_DIB_from_xpm(xpm,tg_xpm_callback,transparent,true,nFrames)
            img[TG_IMG_HANDLE] = hDIB
            img[TG_IMG_TRANSPARENT] = cTrans
            img[TG_IMG_PIXEL_MEM] = pMem
            img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
            img[TG_IMG_HEIGHT] = h
--          img[TG_IMG_HEIGHT] = abs(h)
            img[TG_IMG_BGCLR] = TG_WHITE
            img[TG_IMG_LINESTYLE] = 1
            img[TG_IMG_LINEWIDTH] = 1
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (xImage_from_XPM2)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
--      img[TG_IMG_NEXT] = imgid -- no, 0 is fine
        gimages[id] = img
    end if
    gdm res = -id*2+1
    return res
end function

global function gImage_from_XPM(sequence xpm)
    --  Aside: WinAPI now always creates a 32bpp DIBSection.
    return xImage_from_XPM(xpm,TG_WHITE,nFrames:=5)
end function

global function gGreyscale(atom clr, bool bBlack2Grey=false)
    atom res = TG_DARK_GREY
    if clr!=TG_BLACK or not bBlack2Grey then
        integer {rr,gg,bb,aa} = to_rgba(clr)
        rr = floor(sqrt((rr+gg+bb)/(255*3))*255)
        res = rgba(rr,rr,rr,aa)
    end if
    return res
end function

global function gGreyscale_XPM(object xpm, bool bBlack2Grey=false)
    bool asImage = gdm(xpm)
    integer id
    if asImage then
        id = (-xpm+1)/2
        -- mini-opt (not actually even the slightlest bit critical)
        if gimgrey[id] then return -gimgrey[id]*2+1 end if
        integer imgidx = find(id,xpm_clrs)
        if imgidx=0 then return xpm end if
        xpm = xpm_texts[imgidx]
    end if
    bool asString = string(xpm)
    if asString then
        xpm = split(xpm,'\n')
    else                     // (possibly quite unnecessary but)
        xpm = deep_copy(xpm) // (simply not worth arguing over!)
    end if                   // (xpm more likely const than not)

    sequence {cc, clrs} = tg_get_colour_table(xpm)
    for i,c in cc from 2 do
        xpm[i+1] = sprintf(`%s c #%06x`,{c,gGreyscale(clrs[i],bBlack2Grey)})
    end for
    if asImage then
        xpm = gImage_from_XPM(xpm)
        gimgrey[id] = (-xpm+1)/2
    elsif asString then
        xpm = join(xpm,'\n')
    end if
    return xpm
end function

