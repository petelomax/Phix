local function tg_set_canvas_attribute(gdx id, string name, object v, integer /*nFrames*/)
    if name=`SPLIT` then -- (private/undocumented, for hSplit.exw only)
        assert(v=`AYE`)
        integer flags = ctrl_flags[id]
        assert(and_bits(flags,CF_SPLIT)=0)
        flags += CF_SPLIT
        ctrl_flags[id] = flags
        return true
    elsif name=`MPV_INIT` then -- (see libmvp)
        -- aside: technically I suppose v is a handler, so this ought to be set 
        --        via gSetHandler(), but it's much harder to make that do this:
        ctrl_types[id] = VIDEO
        ctrl_xtra[id] = repeat(0,CX_VIDEO_LEN)
        ctrl_xtra[id][CX_MPV_INIT] = v
        ctrl_xtra[id][CX_MPV_AREA] = -1
        gdx dlg = gGetDialog(id)
if dlg then
        -- aside: max 1 movie per dialog, set once.
        assert(ctrl_xtra[dlg][DX_MPV_AREA]=NULL)
        ctrl_xtra[dlg][DX_MPV_AREA] = id
end if
        return true
    end if
    return false
end function

local procedure tg_canvas_edge(gdx canvas, integer w,h)
--  gDrawRect(canvas,0,0,w-1,h-1,colour:=TG_BLUE)
--  gDrawRect(canvas,0,0,w-1,h-1,true,colour:=TG_BLUE)
    gDrawRect(canvas,1,1,w-2,h-2)
    object ud = gGetAttribute(canvas,`USER_DATA`)
    if string(ud) then
        gDrawText(canvas,w/2,h/2,ud,{},TG_C)
    else
        gDrawLine(canvas,1,1,w-2,h-2)
        gDrawLine(canvas,w-2,1,1,h-2)
        -- and the size with a meticulously centred 'x':
        integer l = length(sprintf(`%d`,max(w,h)))
        string fmt = sprintf(`%%%dd x %%%dd`,{l,-l})
        gDrawText(canvas,w/2,h/2,fmt,{w,h},TG_C,style:=`Monospace,8`)
    end if
end procedure

global function gCanvas(object redraw=NULL, sequence attributes=``, args={}, integer nFrames=1)
    if redraw=`edge` then redraw = NULL end if
    {redraw,attributes,args} = paranormalise_raa(redraw,attributes,args)
    -- aside: all canvas-based controls can rely on this call:
    if not bInit then tg_Init() end if
    gdx id = tg_add_control(CANVAS,CF_EXPANDB+CF_CANVAS)
    ctrl_set_attr[CANVAS] = tg_set_canvas_attribute
    -- (aside: ctrl_xtra is not used on a plain gCanvas)
    ctrl_fg[id] = TG_BLACK
--  ctrl_bg[id] = TG_WHITE
    if redraw!=NULL then
        gSetHandler(id,`REDRAW`,redraw)
    end if
    if length(attributes) then
        gSetAttributes(id,attributes,args,nFrames+1)
    end if
    -- Aside: no-one really cares about the natural size of a canvas,
    --        but I really shd set a baseline for canvas-based ctrls,
    --        and if redraw is NULL it is odds-on to be one of those.
    if not and_bits(ctrl_flags[id],CF_SPLIT) then -- for hSplit.exw
if ctrl_size[id][SZ_USER_W]=0
and ctrl_size[id][SZ_USER_H]=0 then -- for sample.exw/separator
        ctrl_size[id][SZ_NORMAL_W] = 10
        ctrl_size[id][SZ_NORMAL_H] = 10
end if
    end if
    return id
end function 

