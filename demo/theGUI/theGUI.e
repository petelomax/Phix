function paranormalise_draa(object ymd, value_changed, sequence attributes, dword_seq args)
-- used by gCalendar ([object ymd=NULL,] [rtn value_changed=NULL,] string attributes=``, sequence args={}) (only)
-- This routine is designed to crash on the slightest oddity, hopefully with a decent easily understood message.
    integer nFrames = 3 -- (change this back to 1 to debug)
--  integer nFrames = 1 -- (change this back to 1 to debug)
    if dword_seq(ymd) then
        -- gCalendar(ymd[,rtn][,attr[,args]]) cases, leave ymd where it is
        -- ditto leave rtn and the rest alone for gCalendar(ymd,rtn..) cases
        if string(value_changed) then
            if length(attributes) then
                args = attributes
            end if
            attributes = value_changed
            value_changed = NULL
        end if
    elsif rtn(ymd) then
        -- gCalendar(rtn,..) cases, bump that along...
        if dword_seq(attributes) then
            args = attributes
            attributes = value_changed -- (verified to be string below)
        elsif string(value_changed) then
            attributes = value_changed
        end if
        value_changed = ymd
        ymd = NULL
    elsif string(ymd) then
        -- gCalendar(attr[,args]) cases:
        if dword_seq(value_changed) then args = value_changed end if
        attributes = ymd
        value_changed = NULL
        ymd = NULL
--  else -- (zero parameters case, do nowt)
    end if
    assert(rtn(value_changed),`invalid value_changed routine`,nFrames:=nFrames)
    assert(ymd=NULL or dword_seq(ymd),`not NULL/seq ymd`,nFrames:=nFrames)
    assert(string(attributes),`not string attributes`,nFrames:=nFrames)
--  assert(dword_seq(args),`not dword_seq args`,nFrames:=nFrames)
    return {ymd, value_changed, attributes, args}
end function
            
