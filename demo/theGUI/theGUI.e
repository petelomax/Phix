--*************** Link functions from OpenGl32.dll **********

atom opengl32 = NULL
local procedure open_gl32()
    string dll_so = iff(platform()=LINUX?GL_LIBPATH & "libGL.so":"opengl32.dll")
    opengl32 = open_dll(dll_so)
end procedure
--DEV temp:
if opengl32=NULL then open_gl32() end if

local function define_opengl32_proc(string name, sequence args)
    if opengl32=NULL then open_gl32() end if
    return define_c_proc(opengl32,name,args)
end function

local function define_opengl32_func(string name, sequence args, atom return_type)
    if opengl32=NULL then open_gl32() end if
    return define_c_func(opengl32,name,args,return_type)
end function

