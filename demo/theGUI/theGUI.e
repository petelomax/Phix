local procedure tg_gtk_rect(atom cairo, xmin, xmax, ymin, ymax, bool bFill=false, integer rc=0)
    integer aa = c_func(x_cairo_get_antialias,{cairo})
    c_proc(x_cairo_set_antialias,{cairo, CAIRO_ANTIALIAS_NONE})
    atom width = xmax-xmin+1,
        height = ymax-ymin+1
    xmin += 1
    ymin += 1
    if rc then
-- 7/6/26 -1 added for gProgressBar.exw (final green)
        xmin += rc-1
        xmax -= rc-1
        ymin += rc-1
        ymax -= rc-1
        c_proc(x_cairo_new_path,{cairo})
        c_proc(x_cairo_arc,{cairo,xmin,ymin,rc,PI,3*PI/2})
        c_proc(x_cairo_arc,{cairo,xmax,ymin,rc,3*PI/2,2*PI})
        c_proc(x_cairo_arc,{cairo,xmax,ymax,rc,0,PI/2})
        c_proc(x_cairo_arc,{cairo,xmin,ymax,rc,PI/2,PI})
        c_proc(x_cairo_close_path,{cairo})
    else
        c_proc(x_cairo_rectangle,{cairo,xmin,ymin,width,height})
    end if
    if bFill then
        c_proc(x_cairo_fill,{cairo})
    else
        c_proc(x_cairo_stroke,{cairo})
    end if
    c_proc(x_cairo_set_antialias,{cairo, aa})
end procedure

local function tg_gtk_timer_proc(integer id)
    integer action = gGetHandler(id,`ACTION`)
    if action then
        if tg_get_sig(action)=`PO` then
            action(id)
        else
            action()
        end if
    end if
    return true
end function
local atom tg_gtk_timer_proc_cb = NULL

local procedure tg_scrollbar_timer(gdx timer)
    gdx canvas = gGetAttribute(timer,`USER_DATA`)
    tg_scrollbar_timer_action(canvas)
end procedure

forward global function gTimer(rtn action=NULL, atom msecs=40, boolean active=true, object user_data=NULL)

local function tg_scrollbar_click(gdx canvas, sequence status, integer x, y)
    object sbinfo = ctrl_sbinfo[canvas]
    if not sequence(sbinfo) then return false end if
    sbinfo = NULL
    string clikmon = tg_get_mouse_on_scrollbar(canvas,x,y)
    ctrl_sbinfo[canvas][SB_CKMON] = clikmon
    ctrl_sbinfo[canvas][SB_CLIKX] = x
    ctrl_sbinfo[canvas][SB_CLIKY] = y
    bool dragg = status[2]!='R',
       wasdrag = ctrl_sbinfo[canvas][SB_DRAGG]
    ctrl_sbinfo[canvas][SB_DRAGG] = dragg
    gdx timer = ctrl_sbinfo[canvas][SB_TIMER]
    if dragg then
        if not find(clikmon,{``,`VT`,`HT`}) then
            tg_scrollbar_timer_action(canvas)
            if not timer then
                timer = gTimer(tg_scrollbar_timer,500,true,canvas)
                ctrl_sbinfo[canvas][SB_TIMER] = timer
            else
                gSetAttribute(timer,`TIME`,500)
                gSetAttribute(timer,`RUN`,true)
            end if
            ctrl_sbinfo[canvas][SB_DRAGG] = false
            dragg = false
        end if
    else
        if timer then gSetAttribute(timer,`RUN`,false) end if
    end if
    g_log(`set`,`ctrl_sbinfo`,source_line(),deep_copy(ctrl_sbinfo[canvas]))
    if dragg!=wasdrag then gRedraw(canvas) end if
    return clikmon!=``
end function

local function tg_click_handler(gdx dlg, sequence status, integer x, y)
    -- GTK and WinAPI part
    gdx id = dlg, menu = NULL
--  integer clickhandler = gGetHandler(id,`CLICK`)
--  if ctrl_types[dlg]=DIALOG and clickhandler=NULL then
    if ctrl_types[dlg]=DIALOG then
        id = hit_test(dlg,x,y)
        menu = ctrl_xtra[dlg][DX_ACTIVEPOP]
        gSetFocus(id) -- 10/11/25, for hCalendar
    end if
    integer clickhandler = gGetHandler(id,`CLICK`),
                      ct = ctrl_types[id]
    if ct!=MENU and menu and status[2]='S' then
        crash("tg_hide(menu)") -- yet to see this happen...
    end if
    if and_bits(ctrl_flags[id],CF_CANVAS) then
        if tg_scrollbar_click(id,status,x,y) then
            clickhandler = NULL
        end if
    end if

    if clickhandler then
        string sig = tg_get_sig(clickhandler)
        if ct!=DIALOG and length(sig)>3 then
            x -= ctrl_size[id][SZ_X]
            y -= ctrl_size[id][SZ_Y]
        end if
        object res = TG_IGNORE
        if sig=`FOPII` then
            res = clickhandler(id,status,x,y)
        elsif sig=`POPII` then
            clickhandler(id,status,x,y)
        elsif sig=`FOP` then
            res = clickhandler(id,status)
        elsif sig=`POP` then
            clickhandler(id,status)
        else
            ?9/0 -- unknown sig...
        end if
        if string(res) then
            if res=`CAPTURE` then
                if backend=TG_GTK then
                    atom widget = ctrl_handles[dlg]
                    c_funk(x_gtk_widget_grab_focus,{widget})
                    c_proc(x_gtk_grab_add,{widget})
                elsif backend=TG_WINAPI then
                    c_proc(xSetCapture,{ctrl_handles[dlg]})
                elsif backend=TG_JS then    
                    #ilJS{
                        crash(`JS (tg_click_handler)`);
                    #}ilJS
                else
                    ?9/0 -- unknown backend
                end if
                ctrl_xtra[dlg][DX_CAPTURE] = id
            elsif res=`RELEASE` then
                if backend=TG_GTK then
                    c_proc(x_gtk_grab_remove,{ctrl_handles[dlg]})
                elsif backend=TG_WINAPI then
                    c_proc(xReleaseCapture,{})
                elsif backend=TG_JS then    
                    #ilJS{
                        crash(`JS (tg_click_handler2)`);
                    #}ilJS
                else
                    ?9/0 -- unknown backend
                end if
                ctrl_xtra[dlg][DX_CAPTURE] = NULL
            else
                ?9/0 -- unknown string res
            end if
            res = TG_IGNORE
        end if
        if res=TG_CLOSE then
            gHide(gGetDialog(id))
        end if
        return res
    end if
    return TG_CONTINUE
end function

atom hTooltip = NULL
integer tip_ctrl = 0,
      hover_ctrl = 0
bool bShowTimerActive = false,
     bHideTimerActive = false

integer xm = 0, ym = 0
local procedure tg_WinAPI_MOUSEMOVE(gdx id, atom hWnd, lParam, wParam)
    xm = and_bits(lParam,#FFFF)
    ym = floor(lParam/#10000)
    if xm>#7FFF then xm -= #10000 end if
    if ym>#7FFF then ym -= #10000 end if
    bool bLeft = and_bits(wParam,MK_LBUTTON)!=0,
       bMiddle = and_bits(wParam,MK_MBUTTON)!=0,
        bRight = and_bits(wParam,MK_RBUTTON)!=0,
         bCtrl = and_bits(wParam,MK_CONTROL)!=0,
        bShift = and_bits(wParam,MK_SHIFT)!=0,
          bAlt = and_bits(c_func(xGetKeyState,{VK_XALT}),#8000)!=0
    object was_tip = iff(tip_ctrl?tool_tips[tip_ctrl]:NULL)
    tg_mousemove_handler(id,xm,ym,bLeft,bMiddle,bRight,bCtrl,bShift,bAlt)
    if ctrl_types[id]=DIALOG then
        integer new_ctrl = hit_test(id,xm,ym)
        if new_ctrl!=tip_ctrl
        or (new_ctrl and tool_tips[tip_ctrl]!=was_tip) then
            if bShowTimerActive then
                c_funz(xKillTimer,{hWnd,IDT_TIPSHOW})
                bShowTimerActive = false
            end if
            if bHideTimerActive then
                c_funz(xKillTimer,{hWnd,IDT_TIPHIDE})
                bHideTimerActive = false
            end if

            -- hide any current tooltip
--          set_struct_field(idTOOLINFO,pTOOLINFO,"uFlags",TTF_TRACK)
            set_struct_field(idTOOLINFO,pTOOLINFO,"hWnd",hWnd)
--          set_struct_field(idTOOLINFO,pTOOLINFO,"uId",1)

            if hTooltip!=NULL then
                {} = c_func(xSendMessage,{hTooltip,TTM_TRACKACTIVATE,false,pTOOLINFO})
            end if

            tip_ctrl = 0
            hover_ctrl = new_ctrl

            if tool_tips[new_ctrl]!=NULL then
                {} = c_func(xSetTimer,{hWnd,IDT_TIPSHOW,750,NULL})
                bShowTimerActive = true
            end if
        end if
    end if
end procedure

integer WINAPI_PENS = 0

--DEV added for LorenzAttractor.exw, I think this is proof positive that we shouldn't bother to cache pens at all...
function kill_pen(object /*cws*/, atom hPen, /*user_data*/)
    c_proc(xDeleteObject,{hPen})
    return 1
end function

local function tg_WinAPI_get_pen(gdc id=0, atom pencolour=-1, integer penwidth=-1, object penstyle=-1)
    if pencolour=-1 then -- (all assumed)
        assert(gdx(id))
        pencolour = ctrl_fg[id]
        penwidth = ctrl_penstyle[id]
        penstyle = ctrl_penwidth[id]
    end if
    --
    -- Aside: the official WinAPI way to prevent GDI resource leaks is:
    --
    --      hPen = CreatePen(...)
    --      hPrev = SelectObject(hDC,hPen)  -- (save)
    --          .. draw stuff ...
    --      [hPen =] SelectObject(hDC,hPrev) -- (restore)
    --      [assert not 0] DeleteObject(hPen)
    --
    -- however I think it's better to save every pen we ever create,
    -- never recreate the same thing twice, and reuse them many times.
    -- Typically I might only need 4 pens, but the WinAPI way encourages
    -- me (seriously) to create and destroy 4000/s.. [yet ~4 cope fine]
    --
    sequence key = {pencolour,penwidth,penstyle}
    nnatom hPen
    if WINAPI_PENS=0 then WINAPI_PENS = new_dict() end if
    integer node = getd_index(key,WINAPI_PENS)
    if node!=NULL then
        hPen = getd_by_index(node,WINAPI_PENS)
    else
        if dict_size(WINAPI_PENS)>1000 then
            -- there's a hard limit of 10,000 pens in Windows, should
            -- the application be creating random pens, throw em away.
            traverse_dict(kill_pen,0,WINAPI_PENS)
            destroy_dict(WINAPI_PENS,true)
        end if
        atom bgr = tg_WinAPI_rgb_to_bgr(pencolour)
        if penstyle=TG_DOTTED then
            set_struct_field(idLOGBRUSH,pLOGBRUSH,`lbStyle`,PS_SOLID)
            set_struct_field(idLOGBRUSH,pLOGBRUSH,`lbColor`,bgr)
            -- (PS_COSMETIC implied)
            hPen = c_func(xExtCreatePen,{PS_ALTERNATE,penwidth,pLOGBRUSH,0,NULL})
        elsif sequence(penstyle) then
            ?9/0 --DEV
        else
--integer nPens = dict_size(WINAPI_PENS)
            hPen = c_func(xCreatePen,{penstyle-1,penwidth,bgr})
        end if
        setd(key,hPen,WINAPI_PENS)
    end if
    return hPen
end function

global procedure gDrawPixel(gcps canvas, atom x, y, colour)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    x = round(x)
    y = round(y)
    if canvas>0 then -- a gCanvas
        canvas = ctrl_images[canvas]
    end if
    if odd(canvas) then -- gImage
        integer id = (-canvas+1)/2
        sequence gim = gimages[id]
        atom pMem = gim[TG_IMG_PIXEL_MEM]
        integer ih = gim[TG_IMG_HEIGHT],
                iw = gim[TG_IMG_WIDTH] 
--DEV clip region...
        if x>=0 and x<iw 
        and y>=0 and y<ih then
            pMem += 4*(iw*y+x)
            if backend=TG_GTK then
                colour = #FF000000
                       + and_bits(colour,#0000FF00)
                       + (and_bits(colour,#00FF0000) >> 16)
                       + (and_bits(colour,#000000FF) << 16)
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (gDrawPixel)`);
                #}ilJS
            end if
            poke4(pMem,colour)
            -- (quietly ignore off-image pixels)
        end if
    else
        integer pid = -canvas/2
        if x>=0 and x<length(gpixbufs[pid][1])
        and y>=0 and y<length(gpixbufs[pid]) then
            gpixbufs[pid][y+1,x+1] = colour
            -- (quietly ignore off-pixbuf pixels)
        end if
    end if
end procedure

global function gGetPixel(gcps canvas, atom x,y)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    x = round(x)
    y = round(y)
    atom colour = -1
    if canvas>0 then -- a gCanvas
        canvas = ctrl_images[canvas]
    end if
    if odd(canvas) then -- gImage
        integer id = (-canvas+1)/2,
                 w = gimages[id][TG_IMG_WIDTH],
                 h = gimages[id][TG_IMG_HEIGHT]
        if x>=0 and x<w
        and y>=0 and y<h then
            atom pMem = gimages[id][TG_IMG_PIXEL_MEM]
            pMem += 4*(w*y+x)
            colour = peek4u(pMem)
            if backend=TG_GTK then
                colour = xor_bits(colour,#FF000000)
                       + and_bits(colour,#0000FF00)
                       + (and_bits(colour,#00FF0000) >> 16)
                       + (and_bits(colour,#000000FF) << 16)
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (gGetPixel)`);
                #}ilJS
            end if
        end if
    else
        integer pid = -canvas/2
        if x>=0 and x<length(gpixbufs[pid][1])
        and y>=0 and y<length(gpixbufs[pid]) then
            colour = gpixbufs[pid][y+1,x+1]
        end if
    end if
    return colour
end function

