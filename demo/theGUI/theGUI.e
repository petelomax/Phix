local function tg_getID(atom handle)
    -- returns: a gdx
    integer id = 0
    if handle!=NULL then
        if backend=TG_GTK then
--DEV could use g_object_set_data(widget,"id",id) and g_object_get_data(widget,"id")...
            id = getd(handle,GTK_ID_LOOKUP)
        elsif backend=TG_WINAPI then
            id = c_func(xGetWindowLong,{handle,GWL_USERDATA})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_getID)`);
//?             id = handle["ID"];
//?             id = handle[$ID];
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    end if
    return id
end function

