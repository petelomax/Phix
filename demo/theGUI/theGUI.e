local procedure tg_list_hover(gdx list, integer /*x*/,y, left,middle,right, onscroll)
    if gGetAttribute(list,`ACTIVE`) then
        tg_reactivate_caret(list)
        object list_attr = ctrl_xtra[list]
        atom bgclr = ctrl_bg[list],
             bghov = list_attr[LX_BGHOV],
             line_height = list_attr[LX_LINEHT]
        if bgclr!=bghov and line_height!=0 then
            integer top_line = list_attr[LX_TOPLINE],
                    was_hov = list_attr[LX_HOVLINE],
                    n_rows = list_attr[LX_N_ROWS]
            list_attr = 0 -- (kill refcount)
            integer line = top_line + floor(y/line_height), new_hov = 0
            if line<=n_rows and not (onscroll or left or middle or right) then
                new_hov = line
            end if
            if new_hov!=was_hov then
--?{"list_hov",new_hov,onscroll}
                ctrl_xtra[list][LX_HOVLINE] = new_hov
                gRedraw(list)
            end if
        end if
    end if
end procedure

local procedure tg_table_transfer_actcols_to_columns(gdx table)
    -- purpose: the columns table may bear little resemblance to reality;
    --          replace all the sizes to match what's actually on screen.
    sequence columns = ctrl_xtra[table][CXTBL_COLUMNS],
             actcols = ctrl_xtra[table][CXTBL_ACTCOLS]
    ctrl_xtra[table][CXTBL_COLUMNS] = 0
    sequence cs = repeat(0,length(columns))
    for i,c in columns do
        integer ai = actcols[i]
        if string(c) then ?9/0 end if
        c = c[2] -- (get width and kill refcount)
        columns[i][2] = ai
        cs[i] = c
    end for
    ctrl_xtra[table][CXTBL_COLUMNS] = columns
end procedure

local procedure tg_table_change_hover(gdx table, integer hov_line, hov_col)
    -- common code for leave[table_header_area]
    gSetAttribute(table,`CURSOR`,NULL)
    ctrl_xtra[table][CXTBL_RESIZEHOV] = 0
    integer was_hov_line = ctrl_xtra[table][CXTBL_HOVLINE],
            was_hov_col = ctrl_xtra[table][CXTBL_HOVCOL]
    if hov_line!=was_hov_line
    or hov_col!=was_hov_col then
        -- (nb we still need these even when bghov==bgclr)
        ctrl_xtra[table][CXTBL_HOVLINE] = hov_line
        ctrl_xtra[table][CXTBL_HOVCOL] = hov_col
        gRedraw(table)
    end if
end procedure

local procedure tg_table_mousemove(gdx table, integer x,y, left,/*middle*/,/*right*/, /*ctrl*/,/*shift*/,/*alt*/, bool onscroll)
    if gGetAttribute(table,`ACTIVE`) then
        -- note the hover line is completely unaffected by sorting, whereas selected /is/.
        object tbl_attr = ctrl_xtra[table],
                coldrag = tbl_attr[CXTBL_COLDRAG]
        atom bgclr = gGetAttribute(table,`BGCLR`)
        sequence cols = tbl_attr[CXTBL_ACTCOLS]
        integer {ox,oy,vw,vh} = gGetAttribute(table,`VIEWPORT`),
                 was_hov_line = tbl_attr[CXTBL_HOVLINE],
                      selmode = tbl_attr[CXTBL_SELMODE],
                           lh = tbl_attr[CXTBL_LINEHT],
                          rcx = tbl_attr[CXTBL_RCX],
                      colsize = tbl_attr[CXTBL_COLSIZE],
                   resize_hov = tbl_attr[CXTBL_RESIZEHOV],
                  resize_sink = tbl_attr[CXTBL_RESIZESINK], -- (a ddx)
                   drag_title = tbl_attr[CXTBL_DRAGTITLE],
                     on_title = 0,
                       n_cols = length(cols),
                     hov_line = 0,
                      hov_col = 0 -- nb display dx
        tbl_attr = 0 -- (kill refcount)
        if lh=0 then lh = 24 end if

        if not onscroll then
            if colsize and resize_hov and left then
--          if resize_hov and left and not onscroll then
                -- (cols[widths]:=act_cols, adjusted:)
                integer rc = resize_hov,
                        rn = resize_hov+1 -- next non-zero... (no)
                if sequence(coldrag) then
                    rc = coldrag[rc]
                    rn = coldrag[rn]
                end if
                tg_table_transfer_actcols_to_columns(table)
                integer rcw = cols[rc],
                        rnw = cols[rn],
                        nx = x-rcx
                if rcw+nx<0 then nx = -rcw end if
                if rnw-nx<0 then nx = rnw end if
                sequence columns = ctrl_xtra[table][CXTBL_COLUMNS]
                ctrl_xtra[table][CXTBL_COLUMNS] = 0
                for i in {rc,rn} do
                    columns[i][2] += nx
                    nx = -nx
                end for
                ctrl_xtra[table][CXTBL_COLUMNS] = columns
                ctrl_xtra[table][CXTBL_RCX] += nx
                gRedraw(table)
                return
            end if
            hov_line = iff(y<=lh?0:floor((y+oy)/lh))
            integer w = x+ox, -- (work copy/scratch var)
                  otl = 0       -- lh edge of on_title
            for i,cw in cols do
                if sequence(coldrag) then cw = cols[coldrag[i]] end if
                hov_col += 1
                if drag_title=0 and hov_line=0 and colsize and not left then
                    resize_hov = i<n_cols and abs(cw-w)<=5 -- (nb :=0 important!)
                    if resize_hov then resize_hov = i exit end if
                end if
                on_title = i -- (only kept when c>w)
                if cw>w then exit end if -- (ie next edge would be past it)
                w -= cw
                otl += cw
            end for
            if coldrag!=false and drag_title and on_title and left then
                --
                -- Column dragging: drag_title is a display index, such that
                --  columns[coldrag[drag_title]] was left-clicked on, where
                --  coldrag==true is treated as tagset(length(columns)).
                -- First determine which (display) column the mouse is on
                --  (already done above and saved in on_title, also otl).
                -- Flip when doing so would mean the mouse is on the moved
                --  drag_title, and since that has moved, update/replace it.
                -- For example with {{description,50},{OK,10}} dragging OK
                --  left flips when the mouse reaches 0..10, and then drag
                --  right flips back when the mouse reaches 50..60.
                -- Note that some columns may be zero-width, so it has to
                --  cope with {1,0,3,0,5} => {3,1,0,0,5} or {1,0,0,5,3}.
                --                 ^dt        ^ot                    ^ot
                -- (were it to shuffle the 0s about quietly, I wouldn't
                --  care at all, but cw>w won't ever trigger when cw=0,
                --  besides, we must never replace drag_title with "".)
                --
                if on_title!=drag_title then
                    if coldrag==true then coldrag = tagset(length(cols)) end if
                    integer dtw = cols[coldrag[drag_title]],
                            otw = cols[coldrag[on_title]],
                            bWasRS = drag_title==resize_sink
                    ctrl_xtra[table][CXTBL_COLDRAG] = 0 -- kill refcount
                    if on_title<drag_title then
                        if x<=otl+dtw then
                            sequence lo = coldrag[on_title..drag_title-1]
                            coldrag[on_title] = coldrag[drag_title]
                            coldrag[on_title+1..drag_title] = lo
                            drag_title = 0
                        end if
                    else -- on_title>drag_title
                        if x>=otl+otw-dtw then
                            sequence hi = coldrag[drag_title+1..on_title]
                            coldrag[on_title] = coldrag[drag_title]
                            coldrag[drag_title..on_title-1] = hi
                            drag_title = 0
                        end if
                    end if
                    ctrl_xtra[table][CXTBL_COLDRAG] = coldrag
                    if drag_title=0 then
                        -- both CXTBL_RESIZESINK and CXTBL_DRAGTITLE are ddx [FFS cdx!!]
                        if bWasRS then
                            ctrl_xtra[table][CXTBL_RESIZESINK] = on_title
                        end if
                        ctrl_xtra[table][CXTBL_DRAGTITLE] = on_title
                        gRedraw(table)
                    end if
                end if
                return
            end if
        end if
        if colsize and resize_hov and hov_line=0 then
            gSetAttribute(table,`CURSOR`,`WE_RESIZE`)
            ctrl_xtra[table][CXTBL_RESIZEHOV] = resize_hov
            ctrl_xtra[table][CXTBL_RCX] = x
            if was_hov_line then
                ctrl_xtra[table][CXTBL_HOVLINE] = 0
                gRedraw(table)
            end if
        else
            tg_table_change_hover(table, hov_line, hov_col)
        end if
    end if
end procedure

local procedure tg_mousemove_handler(gdx dlg, integer x,y, left,middle,right, ctrl,shift,alt)
    -- GTK and WinAPI part
    integer id = dlg
    if ctrl_types[dlg]=DIALOG then
        tg_track_mouseleave(dlg,true)
        integer lm = ctrl_xtra[dlg][DX_LAST_MOUSE]
        id = hit_test(dlg,x,y)
        if lm and lm!=id then tg_mouseleave(dlg) end if
        ctrl_xtra[dlg][DX_LAST_MOUSE] = id
--else
--  ?9/0 -- temp, see whether we can remove that test! -- no, triggrs on a gDropDown
    end if
    do // until ct=DIALOG
        integer ct = ctrl_types[id], 
                mousehandler = gGetHandler(id,`MOUSEMOVE`),
                cx = 0, cy = 0
        if ct!=DIALOG then
--DEV now that I think about it, it does not make any sense to allow a MOUSEMOVE handler on any container...
            cx = ctrl_size[id][SZ_X]
            cy = ctrl_size[id][SZ_Y]
        end if
        cx = x-cx
        cy = y-cy
        if mousehandler then
            string sig = tg_get_sig(mousehandler)
            -- 20 possible sigs: P, PO, POI..POIIIIIIII and F versions
            integer l = length(sig)-1
--          sequence args = {id,cx,cy,left,middle,right,ctrl,shift,alt}[1..l]
            sequence args = {id,cx,cy,left,middle,right,ctrl,shift,alt,false}[1..l]
            if sig[1]='F' then
                if call_func(mousehandler,args) then exit end if
            else
                call_proc(mousehandler,args)
            end if
        end if
        if and_bits(ctrl_flags[id],CF_CANVAS) then
            bool onscroll = tg_scrollbar_mousemove(id, cx,cy, left,middle,right)
            if ct=LIST then
                tg_list_hover(id, cx,cy, left,middle,right, onscroll)
            elsif ct=TABLE then
                tg_table_mousemove(id, cx,cy, left,middle,right, ctrl,shift,alt, onscroll)
            end if
        end if
        id = gGetParent(id)
    until ct=DIALOG or id=0
end procedure

local function tg_gtk_mousemove(atom widget, event, gdx id)
    -- GTK only part (WinAPI equivalent in tg_WinAPI_WndProc)
--?"not if it's a popup..."
--  assert(id=tg_getID(widget))
    bool bPopup = and_bits(ctrl_flags[id],CF_POPUP)!=0
    assert(bPopup or (id=tg_getID(widget)))
    integer event_type = get_struct_field(idGdkEventMotion,event,`event_type`),
                 state = get_struct_field(idGdkEventMotion,event,`state`),
                  left = and_bits(state,GDK_LEFT_MASK)!=0,
                middle = and_bits(state,GDK_MIDDLE_MASK)!=0,
                 right = and_bits(state,GDK_RIGHT_MASK)!=0,
                  ctrl = and_bits(state,GDK_CONTROL_MASK)!=0,
                 shift = and_bits(state,GDK_SHIFT_MASK)!=0,
                   alt = and_bits(state,GDK_ALT_MASK)!=0,
--DEV under 64-bit GTK3, x was 68.22259521 ... summat not right... [round() prob.temp]
--[24/5/26] seems fine now... (gSplit.exw anyway)
                     x = get_struct_field(idGdkEventMotion,event,`x`,true),
                     y = get_struct_field(idGdkEventMotion,event,`y`,true)
--                   x = round(get_struct_field(idGdkEventMotion,event,`x`,true)),
--                   y = round(get_struct_field(idGdkEventMotion,event,`y`,true))

--  if and_bits(state,GDK_BUTTON1_MASK) then
    if and_bits(state,GDK_BUTTON1_MASK) and not bPopup then
        {} = tg_gtk_kill_menu(id)
    end if

    tg_mousemove_handler(id,x,y,left,middle,right,ctrl,shift,alt)

    return true
end function

local function tg_gtk_configure_event(atom widget, event, integer id)
    if gdx(id) then -- left-over from unit_tests??
        assert(id=tg_getID(widget))
        if tg_gtk_kill_menu(id) then return true end if
        integer {dw,dh} = tg_get_dialog_decoration_size(id),
                x = get_struct_field(idGdkEventConfigure,event,`x`)-dw-6,
                y = get_struct_field(idGdkEventConfigure,event,`y`)-dh+1,
                w = get_struct_field(idGdkEventConfigure,event,`width`),
                h = get_struct_field(idGdkEventConfigure,event,`height`)
        g_log(`set`,`ctrl_sizeXY`,{`tg_gtk_configure_event`,source_line()},{id,x,y})
        ctrl_size[id][SZ_X] = x
        ctrl_size[id][SZ_Y] = y
        tg_lm_accumulate_and_disperse_user_sizes(id,w,h,who:="tg_gtk_configure_event")
        if dump_ctrls_on_resize then
            tg_lm_dump_ctrls(source_line(),`tg_gtk_configure_event`)
        end if
        -- see libmpv.e
        gdx video = ctrl_xtra[id][DX_MPV_AREA]
        if video and ctrl_xtra[video][CX_MPV_AREA]!=-1 then
            atom main_window = ctrl_handles[id],
                 draw_area = ctrl_xtra[video][CX_MPV_AREA],
                 video_child = c_func(x_gtk_widget_get_parent,{draw_area})
            c_proc(x_gtk_window_get_position,{main_window,pX,pY})
            c_proc(x_gtk_window_get_size,{main_window,pW,pH})
            {x,y,w,h} = extract(ctrl_size[video],{SZ_X,SZ_Y,SZ_W,SZ_H})
            x += get_struct_field(idGdkRectangle,pRECT,`x`) + 7
            y += get_struct_field(idGdkRectangle,pRECT,`y`) + 30
            c_proc(x_gtk_window_move,{video_child,x,y})
            c_proc(x_gtk_window_resize,{video_child,w,h})
            c_proc(x_gtk_widget_set_size_request,{draw_area,w,h})
        end if
    end if
--NB: this stopped gCanvas resizing itself...
--  return true
    return false
end function

local function tg_gtk_focusinout(atom widget, event, integer id)
    if gdx(id) then -- left-over from unit_tests??
        assert(id=tg_getID(widget))
        integer e_in = get_struct_field(idGdkEventFocus,event,`in`)
        if e_in then -- (in, not out!)
            gSetFocus(id)
        else
            {} = tg_gtk_kill_menu(id)
        end if
    end if
    return false
end function

global function gGetBrother(gdx id, bool bPrev=false)
    -- (deliberately crashes for non-containers)
    integer pid = ctrl_parent[id]
    sequence children = children_ids[pid]
    nnatom k = find(id,children)
    return iff(bPrev?iff(k=1?NULL:children[k-1])
                    :iff(k=length(children)?NULL:children[k+1]))
end function

global function gGetChild(gdx id, integer pos)
    -- (deliberately crashes for non-containers)
    return children_ids[id][pos]
end function

global function gGetChildCount(gdx id)
    -- (deliberately crashes for non-containers)
    -- (not really only useful for gDialog[==1])
    return length(children_ids[id])
end function

local function tg_tab_to_next_valid_control(integer id, nextsibling, owner, bool bPrev)
    -- only called from (self) and tg_find_next_tab_stop
    if not id then -- 2ndpass, from start
        id = owner
    elsif id=owner and nextsibling then -- 1st pass, hit end so now exit
        return id
    end if

    integer pID = ctrl_parent[id]
    object siblings

    if pID and nextsibling then
        siblings = children_ids[pID]
        if integer(siblings) then
            return NULL
        end if
        integer index = find(id, siblings)
        if not index then
            return NULL
        end if
        index += iff(bPrev?-1:+1)
        if index<1 or index>length(siblings) then
            return tg_tab_to_next_valid_control(pID, 1, owner, bPrev)
        end if
        id = siblings[index]
        if gGetAttribute(id,`CANFOCUS`)
        and gGetAttribute(id,`ACTIVE`) then
            return id
        end if
    end if

    -- loop through all children from first to last, possibly recursively, seeking a valid TAB spot
    siblings = children_ids[id]
    pID = id
    if sequence(siblings) then
        integer {first,last,step} = iff(bPrev?{length(siblings),1,-1}:
                                              {1,length(siblings),+1})
        for i=first to last by step do
            id = siblings[i]
            if gGetAttribute(id,`CANFOCUS`)
            and gGetAttribute(id,`ACTIVE`) then
                return id
            elsif not find(ctrl_types[id],{DIALOG,MENU}) then
                id = tg_tab_to_next_valid_control(id, 0, owner, bPrev) -- go down a level
                if id then
                    return id
                end if
            end if
        end for
    end if

    -- exit, failure here, go up to next level
    return tg_tab_to_next_valid_control(pID, 1, owner, bPrev)

end function

local procedure tg_find_next_tab_stop(gdx id, bool shift)
    integer ct = ctrl_types[id],
        window = gGetDialog(id) -- if id is already a window then will return itself
    integer newid = tg_tab_to_next_valid_control(id, 1, window, shift) -- 1st pass, to start
    if newid=window then
        newid = tg_tab_to_next_valid_control(0, 0, window, shift) -- 2nd pass, from end
    end if
    if newid!=NULL then
        gRedraw(id)
        gSetFocus(newid)
        gRedraw(newid)
    end if
end procedure

