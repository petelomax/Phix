local function tg_set_list_attribute(gdx id, string name, object v, integer nFrames)
    integer gxdx = find(name,list_attr_names)
    if gxdx then
        -- aside: common up by type, but feel free to do  
        -- anything that needs special treatment by name
        integer vtype = list_attr_types[gxdx]
        if vtype='B' then
            v = tg_to_bool(v,nFrames+2)
            if gxdx=LX_CARET and v then
                gdx timer = ctrl_xtra[id][LX_CARETIMER]
                if timer=0 then
                    timer = gTimer(tg_list_cursorblink_action,400,true,id)
                    ctrl_xtra[id][LX_CARETIMER] = timer
                else
                    gSetAttribute(timer,`RUN`,true)
                end if
                tg_reactivate_caret(id)
            end if
        elsif vtype='C' then
            v = tg_get_colour_value(v)
            assert(atom(v))
        elsif vtype='I' then
            if string(v) and is_integer(v) then
                v = to_integer(v)
            else
                assert(integer(v),nFrames:=nFrames+2)
            end if
        elsif vtype='N' then
            if string(v) then v = to_number(v) end if
            assert(atom(v),nFrames:=nFrames+2) -- (fail if `` yields {})
--/*
            if ct=LIST and name=`SELECTED` and sequence(v) then
                integer k = sum(v)
                if k=0 then
                    v = 0
                elsif k=1 then
                    v = find(1,v)
                end if
--*/
--      elsif vtype='S' then
--          assert(string(v),nFrames:=nFrames+2)
--      elsif vtype='P' then
--          assert(sequence(v),nFrames:=nFrames+2)
        elsif vtype!='O' then
            ?9/0
        end if
        ctrl_xtra[id][gxdx] = v
        return true
    end if
    return false
end function

function tg_get_list_attribute(gdx id, string name, integer nFrames)
    integer gxdx = find(name,list_attr_names)
    if gxdx then
        return ctrl_xtra[id][gxdx]
    end if
    tg_bad_attr(id,name,nFrames+1)
end function

global function gList(object data, selected=NULL, sequence attributes=``, dword_seq args={})
    {selected,attributes,args} = paranormalise_raa(selected,attributes,args)
    gdx list = gCanvas(tg_redraw_list,nFrames:=2)
    ctrl_types[list] = LIST
    ctrl_set_attr[LIST] = tg_set_list_attribute
    ctrl_get_attr[LIST] = tg_get_list_attribute
    object list_attr = repeat(0,LX_LEN)
    list_attr[LX_DATA] = data
    list_attr[LX_BGSEL] = #CCE8FF
    list_attr[LX_BGHOV] = #E5F3FF
--  list_attr[LX_CARET] = true
    list_attr[LX_CARET] = false -- (for gVidCut)
    ctrl_xtra[list] = list_attr
    list_attr = 0
    tg_reactivate_caret(list)
    gdx timer = gTimer(tg_list_cursorblink_action,400,false,list)
    ctrl_xtra[list][LX_CARETIMER] = timer
    gSetHandler(list,`CLICK`,tg_list_click)
    gSetHandler(list,`MOUSELEAVE`,tg_list_mouseleave)
    gSetHandler(list,`KEY`,tg_list_key)
    -- aside: when called, only tests length 3 vs length 2:
    tg_register_handler(LIST,`SELECTED`,{`POI`,`POO`,`PI`,`PO`})
    if selected!=NULL then
        gSetHandler(list,`SELECTED`,selected)
    end if
    if length(attributes) then
        gSetAttributes(list,attributes,args,2)
    end if
    return list
end function

local function tg_find_menu_id(gdx menu, integer id, nFrames)
    -- id is the potentially keystroke-like menu line identifier
    sequence menus = ctrl_xtra[menu][CX_MENUS]
    for mdx,m in menus do
        for hit,mi in m[MX_ITEMS] do
            if mi[MX_ID]=id then
                return {mdx,hit}
            end if
        end for
    end for
    crash(`menu id %v not found`,{iff(id>' '?gGetKeyName(id):id)},nFrames:=nFrames)
end function

global procedure gMenuSetAttribute(gdx menu, object id, string name, object v, integer nFrames=2)
    if sequence(menu) then
        for m in menu do
            gMenuSetAttribute(m,id,name,v,nFrames+1)
        end for
        return
    elsif sequence(id) then
        for i in id do
            gMenuSetAttribute(menu,i,name,v,nFrames+1)
        end for
        return
    end if
    integer ct = ctrl_types[menu]
    assert(ct=MENU and id>0)
    if name=`DATA` then -- (id is an mdx)
        ctrl_xtra[menu][CX_MENUS][id] = v
        tg_compute_menu_size(menu,id)
        return
    end if
    integer {mdx,hit} = tg_find_menu_id(menu,id,nFrames+1)
    if name=`ACTIVE` then
        ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_ENABLED] = v
    elsif name=`CHECKED`
       or name=`VALUE` then
        string rc = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_IMAGE]
        if rc=`??` then -- radio group
            if v then tg_clear_and_set_radio_group(menu,mdx,hit) end if
        else -- checked item
            ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_CHECKED] = v
        end if
    elsif name=`IMAGE` then
        if string(v) then v = gImage_from_XPM(v) end if
        assert(gdm(v))
        ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_IMAGE] = v
    elsif name=`TITLE` then
        ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_TEXT] = v
    else
        crash(`gMenuSetAttribute(%s) not supported`,{name},nFrames:=nFrames)
    end if
end procedure

global function gMenuGetAttribute(gdx menu, integer id, string name)
    integer ct = ctrl_types[menu]
    assert(ct=MENU and id>0)
    -- (deal with the id is an mdx cases first)
    if name=`DATA`
       or name=`DATA+` then
        object res = ctrl_xtra[menu][CX_MENUS][id]
        if name=`DATA+` then ctrl_xtra[menu][CX_MENUS][id] = NULL end if
        return res
    elsif name=`DATA*` then
        -- (intended for use in hMenu.exw, though not actually used/tested thus far)
        return ctrl_xtra[menu][CX_MEXTRA][id]
    end if
    integer {mdx,hit} = tg_find_menu_id(menu,id,3)
    if name=`ACTIVE` then
        return ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_ENABLED]
    elsif name=`CHECKED`
       or name=`VALUE` then
        return ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_CHECKED]
    elsif name=`MDXHIT` then
        return {mdx,hit}
    elsif name=`IMAGE` then
        return ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_IMAGE]
    elsif name=`TITLE` then
        return ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_TEXT]
    end if
    crash(`gMenuGetAttribute(%s) not supported`,{name},nFrames:=2)
end function

global procedure gMenuToggleInt(gdx menu, object id, string name)
    if sequence(menu) then
        for m in menu do
            gMenuToggleInt(m,id,name)
        end for
        return
    elsif sequence(id) then
        for i in id do
            gMenuToggleInt(menu,i,name)
        end for
        return
    end if
    bool flag = gMenuGetAttribute(menu,id,name)
    gMenuSetAttribute(menu,id,name,not flag)
end procedure

local sequence menu_images = {} -- from tg_xpm.e/`chk_xpm` (when/if actually needed).

local procedure tg_draw_one_menu(gdx menu, gdm img, sequence items, mxtra)
    integer w = mxtra[MX_WIDTH],
            h = mxtra[MX_HEIGHT],
           kb = mxtra[MX_KEYMODE],
     hot_item = mxtra[MX_HOT],
           hh = floor(TG_MENUITEM_HEIGHT/2),
            y = 4
    bool bAnyImages = false
    for item in items do
        if item[MX_IMAGE]!=NULL then
            bAnyImages = true
            exit
        end if
    end for
    for i,item in items do
        string text = item[MX_TEXT], shortcutkey
        if text=`-` then
            y += 3
            gDrawLine(img,4,y,w-4,y,TG_MENUSEP_FGCLR)
            y += 3
        else
            if i=hot_item then
                if kb then
                    gDrawRect(img,3,y,w-3,y+TG_MENUITEM_HEIGHT,colour:=TG_BLACK)
                else
                    gDrawRect(img,0,y,w-1,y+TG_MENUITEM_HEIGHT,true,colour:=TG_MENUHOV_BGCLR)
                end if
            end if
            bool enabled = item[MX_ENABLED]
            integer submenu = item[MX_SUBMENU]
            if submenu and length(gMenuGetAttribute(menu,submenu,`DATA`)[MX_ITEMS])=0 then
                enabled = false
            end if
            object image = item[MX_IMAGE]
            if string(image) then
                if length(menu_images)=0 then
                    menu_images = gGetGlobal(`chk_xpm`)
                    -- {ucb,ccb,urb,crb,irb}
                end if
                bool checked = item[MX_CHECKED]
                integer l = length(image)
                image = menu_images[l*2-1+checked]
                if not enabled then
                    image = iff(l=2?menu_images[5]:gGreyscale_XPM(image))
                end if
            end if
            if image then
                integer {iw,ih} = gGetAttribute(image,`SIZE`)
                gDrawImage(image,img,16-iw/2,y+hh-ih/2)
            end if
            integer k = find('\t',text),
                   id = item[MX_ID]
            if k then
                shortcutkey = text[k+1..$]
                text = text[1..k-1]
                if shortcutkey="" then
                    if not and_bits(id,M_NOT_KEY) then
                        shortcutkey = sprintf(`(%s)`,gGetKeyName(id))
                    else
                        k = 0 -- (don't show it then)
                    end if
                end if
            end if
            atom clr = iff(i==hot_item?TG_MENUHOV_FGCLR
                      :iff(enabled?TG_BLACK:TG_DARK_GREY))
            gDrawText(img,iff(bAnyImages?30:7),y+hh,text,colour:=clr)
            if submenu then
--menu_images[6]?
                gDrawText(img,w-16,y+hh,`>`,colour:=clr)
            elsif k then
                gDrawText(img,w-6,y+hh,shortcutkey,align:=TG_W,colour:=clr,style:=TG_MENU_KEY_FONT)
            end if
            y += TG_MENUITEM_HEIGHT
        end if
    end for
    gDrawRect(img,0,0,w-1,h-1,colour:=0x00E5E5E5)
end procedure
draw_menu = tg_draw_one_menu -- overrideable via gSetGlobal(`drawmenu`), for hMenu.exw

local procedure tg_draw_menubar(gdx menu, integer w,h)
    sequence items = ctrl_xtra[menu][CX_MENUS][1][MX_ITEMS],
             cxmx1 = ctrl_xtra[menu][CX_MEXTRA][1],
       text_widths = cxmx1[MX_WIDTHS]
    bool bActive = gGetAttribute(menu,`ACTIVE`)
    integer hov = cxmx1[MX_HOT]
    if hov then
        integer l = sum(text_widths[1..hov-1]),
                r = l+text_widths[hov]-1,
                t = iff(backend=TG_GTK and bGTK3?16:0)
        gDrawRect(menu,l,t,r,18,true,colour:=TG_MENUHOV_BGCLR)
    end if
    integer x = 6
    for i,t in vslice(items,MX_TEXT) do
        integer tab = find('\t',t)
        if tab then
            t = t[1..tab-1]
        end if
        -- convert eg `&File` to `File` when needed:
        if bMenuNorm then t = tg_demnemonicalize(t) end if
        bool enabled = iff(bActive?items[i][MX_ENABLED]:false)
        atom clr = iff(i==hov?TG_MBARHOV_FGCLR
                  :iff(enabled?TG_BLACK:TG_DARK_GREY))
        gDrawText(menu,x,10,t,{},TG_E,colour:=clr)
        integer tw = text_widths[i]
        x += tw
    end for
    gDrawRect(menu,0,h-2,w-1,h-1,true,colour:=#F0F0F0)
end procedure

local procedure tg_menubar_mousemove(gdx menu, integer x,/*y*/)
    sequence items = ctrl_xtra[menu][CX_MENUS][1][MX_ITEMS],
       text_widths = ctrl_xtra[menu][CX_MEXTRA][1][MX_WIDTHS]
    integer hover = 0, mx = 0
    bool bActive = gGetAttribute(menu,`ACTIVE`)
    if bActive then
        for i,w in text_widths do
            if x>=mx and x<=mx+w then
                if items[i][MX_ENABLED] then
                    hover = i
                end if
                exit
            end if
            mx += w
        end for
    end if
    integer prevor = ctrl_xtra[menu][CX_MEXTRA][1][MX_HOT]
    if hover!=prevor then
        integer prev = tg_menu_visible(menu,1,false)
        if hover and prev then
            integer submenu = items[hover][MX_SUBMENU]
            if items[hover][MX_ENABLED] then
                tg_hide_submenus(menu,prev,true)
                if submenu!=0 then
                    tg_menubar_showtop(menu,hover)
                    tg_call_menu_handler(menu,1,hover,true,false)
                end if
            end if
        end if
        ctrl_xtra[menu][CX_MEXTRA][1][MX_HOT] = hover
        ctrl_xtra[menu][CX_MEXTRA][1][MX_KEYMODE] = false
        gRedraw(menu)
    end if
end procedure

local procedure tg_menubar_mouseleave(gdx menu)
    if ctrl_xtra[menu][CX_MEXTRA][1][MX_HOT] then
        -- (this just hides mouse hover highlight background)
        ctrl_xtra[menu][CX_MEXTRA][1][MX_HOT] = 0
        gRedraw(menu)
        tg_call_menu_handler(menu,1,0,true,false)
    end if
end procedure

global function gMenu(sequence children, rtn handler)
    -- convert from nested form, or assume already in internal form
    sequence menus = iff(string(children[1][1]) ? tg_build_menu({},children) : children)
    integer lm = length(menus)
    gdx menu = gCanvas(tg_draw_menubar)
    ctrl_types[menu] = MENU
    tg_register_handler(MENU,`HANDLER`,{`FOII`,`FOI`,`POII`,`POI`})
    object menu_attr = repeat(0,CX_MENU_LEN)
    menu_attr[CX_MENUS] = menus -- w,h,keybd,hot,sel,Ownr,hWnd,hWgt,x,y,img,widths:
    menu_attr[CX_MEXTRA] = repeat({0,0,NULL,NULL,NULL,false,  0,  0,0,0,NULL,NULL},lm)
    ctrl_xtra[menu] = menu_attr
    menu_attr = 0
    for mdx=1 to lm do
        tg_compute_menu_size(menu,mdx)
    end for
    gSetAttribute(menu,`BGCLR`,TG_WHITE)
    gSetAttribute(menu,`FONT`,TG_MENU_FONT)
    gSetAttribute(menu,`EXPAND`,`HORIZONTAL`)
    gSetAttribute(menu,`SIZE`,{0,20})
    gSetAttribute(menu,`BGCLR`,TG_MENUBAR_BGCLR)
    gSetHandler(menu,`MOUSEMOVE`,tg_menubar_mousemove)
    gSetHandler(menu,`MOUSELEAVE`,tg_menubar_mouseleave)
    gSetHandler(menu,`CLICK`,tg_menubar_click)
    gSetHandler(menu,`HANDLER`,handler)
    return menu
end function

local function tg_find_popup(atom handle, integer hdx)
    --  find the popup calendar/list with the right handle...
    --  hdx must be 1 and handle a hWnd on WinAPI,
    --           or 2 and handle a widget on GTK
    for popup,parent in ctrl_parent do
        if parent=0
        and and_bits(ctrl_flags[popup],CF_POPUP)
        and sequence(ctrl_hdc[popup])
        and handle=ctrl_hdc[popup][hdx] then
            return popup
        end if
    end for
    return 0
end function

local function tg_GTK_popup_draw(atom widget, cairo, integer mdx)
    -- GTK3 version, which gets the cairo context it should draw on.
    --  (also invoked from GTK2 version, with the cairo it created)
    integer popup = tg_find_popup(widget,2)
                integer w = ctrl_size[popup][SZ_USER_W],
                        h = ctrl_size[popup][SZ_USER_H]
                ctrl_size[popup][SZ_W] = w
                ctrl_size[popup][SZ_H] = h
                if ctrl_bg[popup]=-1 then ctrl_bg[popup] = TG_WHITE end if
                tg_draw_control_images(popup)
                gdm img = ctrl_images[popup]
                integer imdx = (-img+1)/2
    atom src_img = gimages[imdx][TG_IMG_HANDLE]
    c_proc(x_gdk_cairo_set_source_pixbuf,{cairo,src_img,0,0})
    c_proc(x_cairo_paint,{cairo})
    c_proc(x_cairo_fill,{cairo})
    return false
end function

local function tg_GTK_popup_expose(atom widget, /*event*/, integer mdx)
    -- GTK2 version, which needs to create a cairo context to draw on.
    --  (then invokes GTK3 version, passing said cairo just created)
    nnatom win = c_func(x_gtk_widget_get_window,{widget}),
         cairo = c_func(x_gdk_cairo_create,{win})
    integer res = tg_GTK_popup_draw(widget,cairo,mdx)
    c_proc(x_cairo_destroy,{cairo})
    return res
end function

local function tg_GTK_popup_click(atom widget, atom event, integer popup)
    integer button = get_struct_field(idGdkEventButton,event,`button`)
    if button=1 then -- left
        return tg_gtk_click(widget, event, popup)
    end if
    return true
end function

procedure tg_popup_leave(gdx popup)
    -- shared WinAPI/GTK code
    integer ct = ctrl_types[popup]
    if ct=LIST then
        tg_list_mouseleave(popup)
    elsif ct=CALENDAR then
        tg_calendar_mouseleave(popup)
    else
        ?9/0
    end if
end procedure

local function tg_GTK_popup_leave(atom widget, atom event, integer popup)
    tg_popup_leave(popup)
    return true
end function

local function tg_WinAPI_PopupWndProc(atom hWnd, msg, wParam, lParam)
    integer popup = tg_find_popup(hWnd,1)
    if popup then -- ignore eg WM_CREATE which can arrive before
                  -- very next line can store hWnd in ctrl_hdc[]
        switch msg do

            case WM_ACTIVATE:  -- (not strictly needed, but safer)
                if LOWORD(wParam)=WA_INACTIVE then
                    tg_hide(popup)
                end if
                return 0

            case WM_SETFOCUS:  -- (not strictly needed, but safer)
                return 0

            case WM_NCACTIVATE:  -- (not strictly needed, but safer)
                return true

            case WM_MOUSEACTIVATE:
                return MA_NOACTIVATE

            case WM_MOUSEMOVE:
                tg_WinAPI_MOUSEMOVE(popup,hWnd,lParam,wParam)

            case WM_MOUSELEAVE:
                tg_popup_leave(popup)
                return 0

            case WM_MOUSEWHEEL,
                 WM_MOUSEHWHEEL:
                tg_WINAPI_mousewheel(popup, msg, lParam, wParam)

            case WM_LBUTTONDOWN:
                return tg_WinAPI_BUTTONDOWN(popup, msg, wParam, lParam, hWnd)

            case WM_LBUTTONUP:
                c_proc(xReleaseCapture,{})

            case WM_PAINT:
                integer w = ctrl_size[popup][SZ_USER_W],
                        h = ctrl_size[popup][SZ_USER_H]
                ctrl_size[popup][SZ_W] = w
                ctrl_size[popup][SZ_H] = h
                if ctrl_bg[popup]=-1 then ctrl_bg[popup] = TG_WHITE end if
                tg_draw_control_images(popup)
                gdm img = ctrl_images[popup]
                integer imdx = (-img+1)/2,
                        iw = gimages[imdx][TG_IMG_WIDTH],
                        ih = gimages[imdx][TG_IMG_HEIGHT]
                gDrawRect(img,0,0,iw-1,ih-1,colour:=TG_BLACK)
                atom dstDC = c_func(xBeginPaint,{hWnd,pPAINTSTRUCT}),
                     srcDC = tg_WinAPI_GetSrcDC(),
                   src_img = gimages[imdx][TG_IMG_HANDLE],
                    prevBM = c_func(xSelectObject,{srcDC,src_img})
                c_funk(xBitBlt,{dstDC,0,0,w,h,srcDC,0,0,SRCCOPY})
                prevBM = c_func(xSelectObject,{srcDC,prevBM})
                c_proc(xEndPaint,{hWnd,pPAINTSTRUCT})
                return 0

            case WM_KEYDOWN:
--              -- directly routed as if via this by WndProc:
--              return tg_calendar_key(popup,key)
-- or:          return tg_list_key(popup,key,ctrl,shift) 
                return 0 -- (extra paranoia, let WndProc always do it)

        end switch
    end if
    return c_func(xDefWindowProc,{hWnd,msg,wParam,lParam})
end function
bool bPopupWndProcRegistered = false

local procedure tg_popup(gdx owner, ctrl) -- (exported via gGetGlobal to hText.exw)
    gdx dlg = gGetDialog(owner)
    integer ct = ctrl_types[ctrl],
            {w,h} = gGetIntInt(ctrl,`USERSIZE`),
            {ow,oh} = gGetIntInt(owner,`SIZE`),
            x = ctrl_size[owner][SZ_X],
            y = ctrl_size[owner][SZ_Y]
            y += oh+23
    if ctrl_hdc[ctrl]=NULL then ctrl_hdc[ctrl]={NULL,NULL,dlg,w,h} end if
    if w=0 or h=0 then
        assert(ct==LIST)
        if w=0 then w = ctrl_size[owner][SZ_W] end if
        if h=0 then
            integer l = min(tg_list_get_data_length(ctrl),10)
            h = gGetTextExtent(`X`,ctrl)[2]*l+2
        end if
        ctrl_size[ctrl][SZ_USER_W] = w
        ctrl_size[ctrl][SZ_USER_H] = h
    end if
    if not gGetAttribute(dlg,`MAXIMISED`) then
        x += ctrl_size[dlg][SZ_X]+8
        y += ctrl_size[dlg][SZ_Y]+8
    end if
    if screen_width=-1 then
--      {screen_width,screen_height} = gGetGlobalIntInt(`SCREENSIZE`)
        {screen_width,screen_height} = tg_get_screensize() -- ""
    end if
    if x+w>screen_width then x = x+ow-w end if  -- flip horizontally
    if y+h>screen_height then y = y-oh-h end if -- flip vertically
    ctrl_flags[ctrl] = or_bits(ctrl_flags[ctrl],CF_POPUP)
    ctrl_xtra[dlg][DX_ACTIVEPOP] = ctrl
    atom hWnd = ctrl_hdc[ctrl][1], hPopup, hDraw,
         hOwn = ctrl_handles[dlg]
    if hWnd=NULL then
        if backend=TG_GTK then
            hPopup = c_func(x_gtk_window_new,{GTK_WINDOW_POPUP})
            c_proc(x_gtk_window_set_type_hint,{hPopup,GDK_WINDOW_TYPE_HINT_POPUP_MENU})
            c_proc(x_gtk_window_set_decorated,{hPopup,false})

            hDraw = c_func(x_gtk_drawing_area_new,{})
            c_proc(x_gtk_container_add,{hPopup,hDraw})

            atom event_mask = GDK_POINTER_MOTION_MASK + 
                              GDK_BUTTON_PRESS_MASK + 
                              GDK_LEAVE_NOTIFY_MASK
            c_proc(x_gtk_widget_add_events,{hDraw,event_mask})

            ctrl_hdc[ctrl][1..3] = {hPopup,hDraw,dlg}

            {string signal, atom cb} = iff(bGTK2?{`expose_event`,tg_GTK_popup_expose}
                                          /*GTK3*/:{      `draw`,tg_GTK_popup_draw  }) 
            tg_gtk_signal_connect(hDraw,signal,cb,ctrl)
            tg_gtk_signal_connect(hDraw,`motion_notify_event`,tg_gtk_mousemove,ctrl)
            tg_gtk_signal_connect(hDraw,`button_press_event`,tg_GTK_popup_click,ctrl)
            tg_gtk_signal_connect(hDraw,`leave-notify-event`,tg_GTK_popup_leave,ctrl)
            tg_gtk_signal_connect(hDraw,`scroll-event`,tg_gtk_scroll,ctrl)
            c_proc(x_gtk_window_set_transient_for,{hPopup,hOwn})
            hWnd = hPopup
        elsif backend=TG_WINAPI then
            if not bPopupWndProcRegistered then
                tg_WINAPI_register_popup_class(popup,call_back(tg_WinAPI_PopupWndProc))
                bPopupWndProcRegistered = true
            end if
            atom hInst = NULL,
             dwExStyle = WS_EX_TOPMOST+WS_EX_NOACTIVATE -- (for the popup only)
--          hWnd = c_func(xCreateWindowEx,{dwExStyle,popup,"",WS_POPUP,0,0,100,100,hOwn,NULL,hInst,NULL})
            hWnd = c_func(xCreateWindowEx,{dwExStyle,popup,NULL,WS_POPUP,0,0,100,100,hOwn,NULL,hInst,NULL})
            assert(hWnd!=NULL)
            ctrl_hdc[ctrl][1..3] = {hWnd,NULL,dlg}
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_popup)`);
            #}ilJS
        end if
    else
        if backend=TG_GTK then
            c_proc(x_gtk_window_set_transient_for,{hWnd,hOwn})
        elsif backend=TG_WINAPI then
            if c_func(xGetParent,{hWnd})!=hOwn then
                if hOwn=NULL then ?9/0 end if
                c_proc(xSetParent,{hWnd,hOwn})
            end if
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_popup2)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
    end if
    if backend=TG_GTK then
        {hPopup,hDraw} = ctrl_hdc[ctrl]
        c_proc(x_gtk_widget_set_size_request,{hDraw,w,h})
        c_proc(x_gtk_window_resize,{hPopup,w,h})
        c_proc(x_gtk_widget_show_all,{hPopup})
        c_proc(x_gtk_window_move,{hPopup,x,y})
    elsif backend=TG_WINAPI then
        integer uFlags = SWP_SHOWWINDOW+SWP_NOACTIVATE
        c_funk(xSetWindowPos,{hWnd,HWND_TOPMOST,x,y,w,h,uFlags})
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_popup3)`);
        #}ilJS
    else
        ?9/0 -- unknown backend
    end if
end procedure

local gdn stripes = NULL -- [drifting] background image for a gProgressBar.

local procedure tg_redraw_progressbar(gdx pbar, integer w,h)
    gdn img = ctrl_xtra[pbar][CX_PROGRESS_IMAGE]
    if img=NULL or gGetAttribute(img,`SIZE`)!={w+15,h} then
        if img!=NULL then img = gImageDestroy(img) end if
        img = gImage(w+15,h)
        if stripes=NULL then
            stripes = gImage_from_XPM(tg_XPM_from_shorthand("stripes"))
        end if
        integer x = 0
        do
            integer y = 0
            do
                gDrawImage(stripes,img,x,y)
                y += 15
            until y>h
            x += 15
        until x>w+15
        ctrl_xtra[pbar][CX_PROGRESS_IMAGE] = img
    end if
    integer drift = ctrl_xtra[pbar][CX_PROGRESS_DRIFT]
    atom v = ctrl_xtra[pbar][CX_PROGRESS_VALUE],
     start = ctrl_xtra[pbar][CX_PROGRESS_START],
     limit = ctrl_xtra[pbar][CX_PROGRESS_LIMIT],
        pc = min((v-start)/(limit-start)*100,100), l = w
    if pc>=100 then
        gDrawRect(pbar,0,0,w-1,h-1,true,3,#198754)
        gdx pbtimer = ctrl_xtra[pbar][CX_PROGRESS_TIMER]
        gSetAttribute(pbtimer,"RUN",false)
    else
        l = floor((v-start)/(limit-start)*w)
        gDrawImage(img,pbar,0,0,drift,0,l)
    end if
    gDrawText(pbar,l/2,h/2,"%.2f%%",{pc},TG_C,0,TG_WHITE)
    drift = rmdr(drift+1,15)
    ctrl_xtra[pbar][CX_PROGRESS_DRIFT] = drift
end procedure

local procedure tg_progress_action(gdx pbtimer)
    gdx pbar = user_data[pbtimer]
    gRedraw(pbar)
end procedure

local function tg_set_progressbar_attribute(gdx pbar, string name, object v, integer nFrames)
    if name=`VALUE` then
        bool bRun = true
        if sequence(v) then
            switch length(v) with fallthrough do
                case 4: bRun = v[4]
                case 3: ctrl_xtra[pbar][CX_PROGRESS_START] = v[3]
                case 2: ctrl_xtra[pbar][CX_PROGRESS_LIMIT] = v[2]
                case 1: ctrl_xtra[pbar][CX_PROGRESS_VALUE] = v[1]
                        break
                default: crash("uh?",nFrames:=nFrames+2) -- wot len dat den?
            end switch
            v = v[1]
        else
            ctrl_xtra[pbar][CX_PROGRESS_VALUE] = v
        end if
        gRedraw(pbar)
        gdx pbtimer = ctrl_xtra[pbar][CX_PROGRESS_TIMER]
        gSetAttribute(pbtimer,"RUN",bRun)
        return true
    end if
    return false
end function

local function tg_get_progressbar_attribute(gdx pbar, string name, integer nFrames)
    if name=`VALUE` then
        return ctrl_xtra[pbar][CX_PROGRESS_VALUE]
    end if
    tg_bad_attr(pbar,name,nFrames+1)
end function

global function gProgressBar()
    gdx pbar = gCanvas(tg_redraw_progressbar),
     pbtimer = gTimer(tg_progress_action,100,true,pbar)
    ctrl_types[pbar] = PROGRESS
    ctrl_set_attr[PROGRESS] = tg_set_progressbar_attribute
    ctrl_get_attr[PROGRESS] = tg_get_progressbar_attribute
    object cx = repeat(0,CX_PROGRESS_LEN)
--  cx[CX_PROGRESS_IMAGE] = NULL
--  cx[CX_PROGRESS_DRIFT] = 0
    cx[CX_PROGRESS_TIMER] = pbtimer
--  cx[CX_PROGRESS_VALUE] = 0
--  cx[CX_PROGRESS_START] = 0
    cx[CX_PROGRESS_LIMIT] = 100
    ctrl_xtra[pbar] = cx
    cx = 0
    gSetAttribute(pbar,`BGCLR`,TG_WHITE)
    gSetAttribute(pbar,`EXPAND`,'H')
    gSetAttribute(pbar,`SIZE`,`x25`)
    return pbar
end function

local gdn slider_thumb = NULL, slider_vthumb

local procedure tg_draw_slider(gdx slider, integer w,h)
    bool bActive = gGetAttribute(slider,`ACTIVE`),
         bHoriz = ctrl_xtra[slider][CX_SLIDER_HORIZ]
    atom v = ctrl_xtra[slider][CX_SLIDER_VALUE]
    if slider_thumb=NULL then
        -- (otherwise undocumented, as defined in tg_xpm.e:)
        {slider_thumb, slider_vthumb} = gGetGlobal(`slider_thumb`)
    end if
    if bHoriz then
        gDrawRect(slider,0,7,w-1,8,true,colour:=#E7EAEA)
        gDrawRect(slider,0,6,w-1,9,false,colour:=#D6D6D6)
        gDrawImage(slider_thumb,slider,(w-10)*v,0)
        gDrawLine(slider,5,20,5,h-1,colour:=#C4C4C4)
        gDrawLine(slider,w-5,20,w-5,h-1,colour:=#C4C4C4)
    else
        gDrawRect(slider,7,0,8,h-1,true,colour:=#E7EAEA)
        gDrawRect(slider,6,0,9,h-1,false,colour:=#D6D6D6)
        gDrawImage(slider_vthumb,slider,0,(h-10)*v)
        gDrawLine(slider,20,5,w-1,5,colour:=#C4C4C4)
        gDrawLine(slider,20,h-5,w-1,h-5,colour:=#C4C4C4)
    end if
end procedure

local procedure tg_slider_mousemove(gdx slider, integer x,y, bool left, middle, right)
    bool bActive = gGetAttribute(slider,`ACTIVE`),
         bDragg = ctrl_xtra[slider][CX_SLIDER_DRAGG],
         bHoriz = ctrl_xtra[slider][CX_SLIDER_HORIZ]
    integer dxy = ctrl_xtra[slider][CX_SLIDER_DRAGXY],
          {w,h} = gGetAttribute(slider,`SIZE`)
    atom v = ctrl_xtra[slider][CX_SLIDER_VALUE]
    integer xy = iff(bHoriz?x:y),
            wh = iff(bHoriz?w:h)
    if not left then -- (DEV maybe mouseleave? maybe not...)
        ctrl_xtra[slider][CX_SLIDER_DRAGG] = false
        bool bOnThumb = abs(xy-wh*v)<=5
        string wens = iff(bHoriz?`WE_RESIZE`:`NS_RESIZE`)
        gSetAttribute(slider,`CURSOR`,iff(bOnThumb?wens:NULL))
        ctrl_xtra[slider][CX_SLIDER_ONTHUMB] = bOnThumb
    elsif bDragg then
        v = max(min(xy/wh,1),0)
        ctrl_xtra[slider][CX_SLIDER_VALUE] = v
        ctrl_xtra[slider][CX_SLIDER_DRAGXY] = xy
        gRedraw(slider)
        rtn value_changed = gGetHandler(slider,`VALUE_CHANGED`)
        if value_changed then
            string sig = tg_get_sig(value_changed)
            atom {lo,hi} = ctrl_xtra[slider][CX_SLIDER_MINMAX]
            v = v*(hi-lo)+lo
            if sig=`PON` then
                value_changed(slider,v)
            elsif sig=`PN` then
                value_changed(v)
            else
                ?9/0    
            end if
        end if
    end if
end procedure

local function tg_slider_click(gdx slider, sequence status, integer x, y) 
    if gGetAttribute(slider,`ACTIVE`) then
        if status[1]='L' then
            bool bHoriz = ctrl_xtra[slider][CX_SLIDER_HORIZ]
            integer xy = iff(bHoriz?x:y), s2 = status[2]
            if s2='S' then
                if ctrl_xtra[slider][CX_SLIDER_ONTHUMB] then
                    ctrl_xtra[slider][CX_SLIDER_DRAGG] = true
                    ctrl_xtra[slider][CX_SLIDER_DRAGXY] = xy
                    return `CAPTURE`
                end if
            elsif s2='R' then
                if ctrl_xtra[slider][CX_SLIDER_DRAGG] then
                    ctrl_xtra[slider][CX_SLIDER_DRAGG] = false
                    return `RELEASE`
                end if
                integer wh = gGetAttribute(slider,`SIZE`)[iff(bHoriz?1:2)]
                atom v = max(min(xy/wh,1),0)
                ctrl_xtra[slider][CX_SLIDER_VALUE] = v
                ctrl_xtra[slider][CX_SLIDER_DRAGXY] = xy
                gRedraw(slider)
            end if
        end if
    end if
    return TG_IGNORE
end function

local function tg_set_slider_attribute(gdx slider, string name, object v, integer nFrames)
    if name=`VALUE` then
        if string(v) then v = to_number(v) end if
        if sequence(v) then
            assert(length(v)=2 and atom(v[1]) and atom(v[2]),"{lo,hi}",nFrames:=nFrames+2)
            atom {lo,hi} = v[2]
            ctrl_xtra[slider][CX_SLIDER_MINMAX] = {lo,hi}
            v = (v[1]-lo)/(hi-lo) -- (convert to 0.0..1.0)
        end if
        assert(atom(v),nFrames:=nFrames+2)
        ctrl_xtra[slider][CX_SLIDER_VALUE] = v
        return true
    end if
    return false
end function

local function tg_get_slider_attribute(gdx slider, string name, integer nFrames)
    if name=`VALUE` then
        return ctrl_xtra[slider][CX_SLIDER_VALUE]
    end if
    tg_bad_attr(slider,name,nFrames+1)
end function

global function gSlider(object value_changed=NULL, sequence attributes="", args={})
    {value_changed,attributes,args} = paranormalise_vaa(value_changed,attributes,args)
    gdx slider = gCanvas(tg_draw_slider,nFrames:=2)
    ctrl_types[slider] = SLIDER
    ctrl_set_attr[SLIDER] = tg_set_slider_attribute
    ctrl_get_attr[SLIDER] = tg_get_slider_attribute
    object cx = repeat(0,CX_SLIDER_LEN)
--  cx[CX_SLIDER_HORIZ] = true -- (set below, after SIZE set)
    cx[CX_SLIDER_VALUE] = 0
    cx[CX_SLIDER_MINMAX] = {0,1}
    ctrl_xtra[slider] = cx
    cx = 0
    if length(attributes) then
        gSetAttributes(slider,attributes,args,2)
    end if
    integer {w,h} = gGetAttribute(slider,`USERSIZE`)
    bool bHoriz = w=0 or (h!=0 and w>h)
    ctrl_xtra[slider][CX_SLIDER_HORIZ] = bHoriz
    if w=0 and h=0 then
        gSetAttribute(slider,`SIZE`,`x24`)
    end if
    if and_bits(ctrl_flags[slider],CF_EXPANDB) then -- (still both)
        gSetAttribute(slider,`EXPAND`,iff(bHoriz?'H':'V'))
    end if
    gSetHandler(slider,`CLICK`,tg_slider_click)
    gSetHandler(slider,`MOUSEMOVE`,tg_slider_mousemove)
    tg_register_handler(SLIDER,`VALUE_CHANGED`,{`PON`,`PN`,`POI`,`PI`,`POO`,`PO`})
    if value_changed!=NULL then
        gSetHandler(slider,`VALUE_CHANGED`,value_changed)
    end if
    return slider
end function

local procedure tg_draw_sizer(gdx sizer, integer w,h)
    -- (sizer is the middle bar, rather than the h/vbox container)
    if gGetAttribute(sizer,`ACTIVE`) then
        bool bHoriz = gGetInt(gGetParent(sizer),`ORIENTATION`)
        -- note the non-expanding w|h must be odd, else
        --  a) this will typecheck due to the 0.5
        --  b) the thing would display lop-sided.
        {w,h} = {w-1,h-1}
        if bHoriz then w /= 2 else h /= 2 end if
        integer {x,y} = iff(bHoriz?{w,0}:{0,h})
        gDrawLine(sizer,x,y,w,h)
    end if
end procedure

