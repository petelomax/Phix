local integer assume_id -- for betwixt xCreateWindowEx() and tg_setID()... (windows only)
local atom assumed_hWnd -- ""
                        -- In other words, tg_WinAPI_WndProc is likely to get WM_CREATE etc 
                        --  messages, before it has managed to properly log the new control.

local function tg_WinAPI_WndProc(atom hWnd, msg, wParam, lParam)
    bool bAssumed = false
--  atom_string msgname = tg_WinAPI_get_wm_name(msg) -- (debug aid)
    integer id = tg_getID(hWnd)
    if id=0 and msg!=WM_SIZE then
        -- assume betwixt xCreateWindowEx() and tg_setID()...
        --  (whereas any subclassing occurs after """ )
        bAssumed = true
        id = assume_id
        if assumed_hWnd=NULL then
            assumed_hWnd = hWnd
        else
            assert(assumed_hWnd=hWnd)
        end if
        -- ... and these all seemed fair enough for that
--      if not find(msg,{xWM_CREATE,xWM_MOVE,WM_SIZE,WM_SHOWWINDOW,WM_GETMINMAXINFO}) then
--          ?{`bAssumed`,`msg`,msg,tg_WinAPI_get_wm_name(msg),`id`,id}
--      end if
    end if
    integer ct = iff(id?ctrl_types[id]:0)
    gdx popup = iff(id?ctrl_xtra[id][DX_ACTIVEPOP]:0)
    if msg=WM_CREATE then       -- 1
        ctrl_xtra[id][DX_MAIN_DC] = c_func(xGetDC,{hWnd})
-->>>
--      DragAcceptFiles(hWnd,true)
    elsif msg=WM_KILLFOCUS      -- 8
       or msg=WM_ENTERSIZEMOVE  -- 561
--     or msg=WM_CAPTURECHANGED -- 533
       or msg=WM_SYSCOMMAND then    -- 274
        if popup then tg_hide(popup) end if

    elsif msg=WM_CHAR
       or msg=WM_KEYDOWN
       or msg=WM_KEYUP
       or msg=WM_SYSCHAR
       or msg=WM_SYSKEYDOWN
       or msg=WM_SYSKEYUP then
        bool bUp = msg=WM_KEYUP or msg=WM_SYSKEYUP
        if tg_WinAPI_process_key(id,msg,wParam,lParam,bUp)=0 then return 0 end if
--      return 1
        return 0

    elsif msg=WM_MOUSEWHEEL
       or msg=WM_MOUSEHWHEEL then
        if popup then tg_hide(popup) end if
        tg_WINAPI_mousewheel(id, msg, lParam, wParam)

    elsif msg>=WM_LBUTTONDOWN
      and msg<=WM_XBUTTONDOWN then  -- (excluding WM_MOUSEWHEEL just handled)
        if popup and (msg=WM_LBUTTONDOWN or 
                      msg=WM_RBUTTONDOWN or 
                      msg=WM_MBUTTONDOWN or
                      msg=WM_XBUTTONDOWN) then 
            tg_hide(popup)
        end if
        return tg_WinAPI_BUTTONDOWN(id,msg,wParam,lParam,hWnd)

    elsif msg=WM_MOUSEMOVE then
        tg_WinAPI_MOUSEMOVE(id,hWnd,lParam,wParam)

    elsif msg=WM_MOUSELEAVE then
        tg_mouseleave(id) -- nb dialog only, other cases handled in mousemove

        if hTooltip!=NULL then
            tip_ctrl = 0
--          set_struct_field(idTOOLINFO,pTOOLINFO,"uFlags",TTF_TRACK)
            set_struct_field(idTOOLINFO,pTOOLINFO,"hWnd",hWnd)
--          set_struct_field(idTOOLINFO,pTOOLINFO,"uId",1)
            {} = c_func(xSendMessage,{hTooltip,TTM_TRACKACTIVATE,false,pTOOLINFO})
            if bShowTimerActive then
                c_funz(xKillTimer,{hWnd,IDT_TIPSHOW})
                bShowTimerActive = false
            end if
            if bHideTimerActive then
                c_funz(xKillTimer,{hWnd,IDT_TIPHIDE})
                bHideTimerActive = false
            end if
            hover_ctrl = 0
        end if

    elsif msg=WM_PAINT then
        assert(ct=DIALOG)
        tg_draw_dialog(id)
        c_funk(xValidateRect,{hWnd,NULL})
        return 1

--/*
    elsif msg=WM_ERASEBKGND then
        if ct!=DIALOG --then
        or (length(children_ids[id])=1 and and_bits(ctrl_flags[children_ids[id][1]],CF_CANVAS)) then
            return 1 -- (signal done)
        end if
-- messes up gButton.exw... r3d.exw (resize) now seems fine w/o this...
--      return 1 -- (signal done)
--*/
    elsif msg=WM_SIZE then
        if id then
            assert(ct=DIALOG)
            integer w = LOWORD(lParam),
                    h = HIWORD(lParam)
            tg_lm_accumulate_and_disperse_user_sizes(id,w,h,who:="WM_SIZE")
            if dump_ctrls_on_resize
            and and_bits(ctrl_flags[id],CF_INVISIBLE)=0 then
                tg_lm_dump_ctrls(source_line(),`WM_SIZE`)
            end if
            c_funk(xInvalidateRect,{hWnd,NULL,false})
        end if

    elsif msg=WM_MOVING
       or msg=WM_SIZING then
        if popup then tg_hide(popup) end if
        atom pRect = lParam
        integer left = get_struct_field(idRECT,pRect,`left`),
                 top = get_struct_field(idRECT,pRect,`top`),
               right = get_struct_field(idRECT,pRect,`right`),
              bottom = get_struct_field(idRECT,pRect,`bottom`)
        assert(ct=DIALOG)   
        ctrl_size[id][SZ_X] = left
        ctrl_size[id][SZ_Y] = top
        -- aside: this is /always/ a dialog
        ctrl_size[id][SZ_USER_W] = right-left-14
        ctrl_size[id][SZ_USER_H] = bottom-top-7

    elsif msg=WM_SETFOCUS then
if bDiagnostics and not nodump then
?`WM_SETFOCUS`
end if
--      return 0 -- (no help)
--/*
--??    ctrl_xtra[pid][DX_LAST_FOCUS] = id
        -- focus on the saved item rather than the window
        -- (for task switching, eg/ie Alt-Tab)
        if ct=DIALOG then
            integer last_focus = ctrl_xtra[id][DX_LAST_FOCUS]
            if last_focus!=UNDEFINED
            and ctrl_types[last_focus]!=DIALOG then
                {} = c_func(xSetFocus,{ctrl_handles[last_focus]})
                return 0
            end if
        end if
--*/

    elsif msg=WM_GETMINMAXINFO then
        atom pMM = lParam
        integer minw = ctrl_size[id][SZ_MIN_W],
                minh = ctrl_size[id][SZ_MIN_H],
                maxw = ctrl_size[id][SZ_MAX_W],
                maxh = ctrl_size[id][SZ_MAX_H]

        if minw>0 then set_struct_field(idMINMAXINFO,pMM,`ptMinTrackSize.x`,minw+14) end if
        if minh>0 then set_struct_field(idMINMAXINFO,pMM,`ptMinTrackSize.y`,minh+7) end if
        if maxw>0 then set_struct_field(idMINMAXINFO,pMM,`ptMaxTrackSize.x`,maxw+14) end if
        if maxh>0 then set_struct_field(idMINMAXINFO,pMM,`ptMaxTrackSize.y`,maxh+7) end if

        return 0
    elsif msg=WM_SETCURSOR then
        id = hit_test(id,xm,ym)
        if ctrl_cursors[id] then
            c_proc(xSetCursor,{ctrl_cursors[id]})
            return true
        end if
    elsif msg=WM_TIMER then
        if wParam=IDT_TIPSHOW then

            assert(bShowTimerActive)
            c_funz(xKillTimer,{hWnd,IDT_TIPSHOW})
--          KillTimer(hWnd, IDT_TIPSHOW)
            bShowTimerActive = false

--          if hover_side!=0 then
            if hover_ctrl!=0 then

                atom msgpos = c_func(xGetMessagePos,{})
                integer x = LOWORD(msgpos),
                        y = HIWORD(msgpos)

--              set_struct_field(idTOOLINFO,pTOOLINFO,"uFlags",TTF_TRACK)
                set_struct_field(idTOOLINFO,pTOOLINFO,"hWnd",hWnd)
--              set_struct_field(idTOOLINFO,pTOOLINFO,"uId",1)

--              atom pText = tg_raw_string_ptr(tool_tips[hover_ctrl])
                atom pText = allocate_wstring(tool_tips[hover_ctrl])
                set_struct_field(idTOOLINFO,pTOOLINFO,"lpszText",pText)
                atom pos = (x+16) + (y+24)*#10000
                if hTooltip=NULL then tg_WinAPI_create_tooltip(hWnd) end if
                {} = c_func(xSendMessage,{hTooltip,TTM_UPDATETIPTEXT,0,pTOOLINFO})
                {} = c_func(xSendMessage,{hTooltip,TTM_TRACKPOSITION,0,pos})
                {} = c_func(xSendMessage,{hTooltip,TTM_TRACKACTIVATE,true,pTOOLINFO})
                tip_ctrl = hover_ctrl
                {} = c_func(xSetTimer,{hWnd,IDT_TIPHIDE,3000,NULL})
                bHideTimerActive = true
                free(pText)
            end if
            return 0

        elsif wParam=IDT_TIPHIDE then

            assert(bHideTimerActive)
--          KillTimer(hWnd, IDT_TIPHIDE)
            c_funz(xKillTimer,{hWnd,IDT_TIPHIDE})
            bHideTimerActive = false

--          set_struct_field(idTOOLINFO,pTOOLINFO,"uFlags",TTF_TRACK)
            set_struct_field(idTOOLINFO,pTOOLINFO,"hWnd",hWnd)
--          set_struct_field(idTOOLINFO,pTOOLINFO,"uId",1)

            if hTooltip=NULL then ?9/0 end if
            {} = c_func(xSendMessage,{hTooltip,TTM_TRACKACTIVATE,false,pTOOLINFO})
            tip_ctrl = 0
            return 0
        end if

    elsif msg=WM_CLOSE then
        if tg_close_handler(id) then
            integer pid = ctrl_parent[id]
            if pid and and_bits(ctrl_flags[id],CF_MODAL) then
                c_proc(xEnableWindow,{ctrl_handles[pid],true})
            end if
            if id=PrimaryWindowID then
                c_proc(xDestroyWindow,{hWnd})
            else
                c_proc(xShowWindow,{hWnd,SW_HIDE})
                if pid then
--?{`xSetFocus`,id,pid}
                    {} = c_func(xSetFocus,{ctrl_handles[pid]})
--gSetFocus(pid)
--/!* erm...??? (untried)
                    focus_id = ctrl_xtra[pid][DX_LAST_FOCUS]
--?{"focus_id",focus_id,source_line()}
                    gRedraw(pid)
--*!/
                end if              
            end if
        end if
        return 1

    elsif msg=WM_DESTROY then
--/*
        atom hRC = ctrl_xtra[id][DX_MAIN_RC]
        if hRC!=0 then
            w glMakeCurrent(NULL,NULL)
            wglDeleteContext(hRC)
            ctrl_xtra[id][DX_MAIN_RC] = 0
        end if
--*/
        atom hDC = ctrl_xtra[id][DX_MAIN_DC]
        if hDC!=0 then
            c_funk(xReleaseDC,{hWnd,hDC})
            ctrl_xtra[id][DX_MAIN_DC] = 0
        end if
        -- MUST handle this message
        if id=PrimaryWindowID then
            if GDIPLUS!=NULL then
                c_proc(xGdiplusShutdown,{gdiplusToken})
                gdiplusToken = free(gdiplusToken)
                GDIPLUS = NULL
            end if
            c_proc(xPostQuitMessage,{0})
            return  0
        end if

    elsif msg=WM_DROPFILES then
        atom hDrop = wParam
        integer cch = c_func(xDragQueryFile,{hDrop,0,NULL,0})
        atom pBuffer = allocate(cch*2+2)
        assert(c_func(xDragQueryFile,{hDrop,0,pBuffer,cch+1})==cch)
        string filename = utf16_to_utf8(peek_wstring(pBuffer))
        free(pBuffer)
--      integer mpv_drop = ctrl_xtra[id][DX_MPV_DROP]
--      if mpv_drop then
--          mpv_drop(filename)
--      end if
        integer drop = gGetHandler(id,`DROP`)
        if drop then
            string sig = tg_get_sig(drop)
            if sig=`POS` then
                drop(id,filename)
            elsif sig=`PS` then
                drop(filename)
            else
                ?9/0
            end if
        end if
--      ?{"WM_DROP_FILES",filename,id,gdx_name(id)}

    else
        -- aside: just to make sure we're not missing any...
        -- I could make this a crash(), but there is no use
        -- stopping someone dead in their tracks over this.
        -- Or I could equally just comment this out now...
        if not tg_WinAPI_wm_ignorable(msg) then
            printf(1,"unknown msg:%v, see theGUI.e line %d\n",
                    {tg_WinAPI_get_wm_name(msg),source_line()})
        end if
    end if
    return c_func(xDefWindowProc,{hWnd,msg,wParam,lParam})
end function

