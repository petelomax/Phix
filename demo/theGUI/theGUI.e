-- for hSplit.exw
forward local function tg_hsplit_get_size(gdx id)
forward local procedure tg_hsplit_save_size(gdx id, sequence s)

object chks = NULL

global function gGetGlobal(string name)
    if not bInit then tg_Init() end if
    if name=`COPYRIGHT` then
        return COPYRIGHT
    elsif name=`MOUSEPOS` then
        return tg_get_mousepos()
    elsif name=`SCREENSIZE` then 
        return tg_get_screensize()
    elsif name=`CTRLKEY`
       or name=`CONTROLKEY` then
        return tg_get_ctrlkey()
    elsif name=`SHIFTKEY` then
        return tg_get_shiftkey()
    elsif name=`ALTKEY` then
        return tg_get_altkey()
    elsif name=`NUMLOCK`
       or name=`CAPLOCK`
       or name=`SCRLOCK` then
        integer kdx = find(name[1],"NCS")
        if platform()=WINDOWS then
            integer vk_key = {VK_NUMLOCK,VK_CAPSLOCK,VK_SCROLL}[kdx],
                    vk_dx = find(vk_key,vslice(key_mappings,2))
            vk_key = key_mappings[vk_dx][3]
            return and_bits(c_func(xGetKeyState,{vk_key}),1)
        elsif platform()=LINUX then
            ?9/0
--/*
-- Constants for X11 Keyboard Indicator Masks
constant XkbUseCoreKbd = 256,
         CAPS_MASK     = #01,
         NUM_MASK      = #02,
         SCROLL_MASK   = #04
atom x11 = open_dll("libX11.so")
integer xXOpenDisplay         = define_c_func(x11, "XOpenDisplay", {C_PTR}, C_PTR)
integer xXkbGetIndicatorState = define_c_func(x11, "XkbGetIndicatorState", {C_PTR, C_INT, C_PTR}, C_INT)
integer xXCloseDisplay        = define_c_func(x11, "XCloseDisplay", {C_PTR}, C_INT)
atom pIndicators = allocate(4) -- (permanent)
            -- Check lock key states via native Linux X11 API
            atom display = c_func(xXOpenDisplay, {NULL})
            integer success = c_func(xXkbGetIndicatorState, {display, XkbUseCoreKbd, pIndicators})
            assert(success=0)
            integer mask = peek4u(pIndicators),
                     bit = {NUM_MASK,CAPS_MASK,SCROLL_MASK}[kdx]
            bool res = and_bits(mask,bit)!=0
            {} = c_func(xXCloseDisplay, {display})
            return res
--*/
        elsif platform()=JS then
--/*
-- JS-only:
local integer numLockOn = -1,
              capsLockOn = -1,
              scrollLockOn = -1

        function updateLockStates(event) {
            numLockOn = event.getModifierState("NumLock");
            capsLockOn = event.getModifierState("CapsLock");
            scrollLockOn = event.getModifierState("ScrollLock");
        }

        erm, don't do this, piggy-back on existing event listeners instead:
        // Listen for keyboard input anywhere on the window
        window.addEventListener("keydown", updateLockStates);
        window.addEventListener("keyup", updateLockStates);
        
        // Mouse clicks also contain modifier state snapshots!
        window.addEventListener("click", updateLockStates);
--*/
--          return {numLockOn,capsLockOn,scrollLockOn}[kdx]
            ?9/0
        else
            ?9/0 -- unknown platform
        end if
    elsif name=`CLIPTXT`
       or name=`CLIPTXT?`
       or name=`CLIPTEXT`
       or name=`CLIPTEXT?` then
        bool bAvail = false, bGet = name[$]!='?'
        string clip

--      if backend==TG_GTK then     -- \ **NB**!
        if platform()=LINUX then    -- /

            nnatom clipboard = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD})
            bAvail = c_func(x_gtk_clipboard_wait_is_text_available,{clipboard})
            if bAvail and bGet then
                atom pClip = c_func(x_gtk_clipboard_wait_for_text,{clipboard})
                if pClip!=NULL then
                    clip = peek_string(pClip)
                    c_proc(x_g_free,{pClip})
                end if
            end if

--      elsif backend==TG_WINAPI then   -- \ **NB**!
        elsif platform()=WINDOWS then   -- /

--          atom hWnd = c_func(xGetActiveWindow,{}) -- (what arwen uses)
--          atom hWnd = c_func(xGetForegroundWindow,{})
--          if c_func(xOpenClipboard,{hWnd}) then
            if c_func(xOpenClipboard,{NULL}) then -- (what win_clip uses)
                bAvail = c_func(xIsClipboardFormatAvailable,{CF_TEXT})
                if bAvail and bGet then
                    atom hClip = c_func(xGetClipboardData,{CF_TEXT})
                    if hClip!=NULL then
                        atom pData = c_func(xGlobalLock,{hClip})
                        if pData then
                            integer size = c_func(xGlobalSize,{hClip})
                            clip = peek({pData,size})
                            c_proc(xGlobalUnlock,{hClip})
                            size = find(0,clip)
                            if size then
                                clip = clip[1..size-1]
                            end if
                        end if
                    end if
                end if
                c_proc(xCloseClipboard,{})
            end if
        else
            ?9/0 -- (unknown backend)
        end if
        return iff(bGet and bAvail?clip:bAvail)

    elsif name=`CLIPIMG`
       or name=`CLIPIMG?` then
        bool bAvail = false, bGet = name=`CLIPIMG`
        sequence img

--      if backend==TG_GTK then     -- \ **NB**!
        if platform()=LINUX then    -- /

            atom clip = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD}),
               pixbuf = c_func(x_gtk_clipboard_wait_for_image,{clip})
            bAvail = pixbuf!=NULL
            if bAvail and bGet then
                integer w = c_func(x_gdk_pixbuf_get_width,{pixbuf}),
                        h = c_func(x_gdk_pixbuf_get_height,{pixbuf}),
                    nchan = c_func(x_gdk_pixbuf_get_n_channels,{pixbuf})
                assert(nchan=4)
                atom pMem = c_func(x_gdk_pixbuf_get_pixels,{pixbuf})
                img = repeat(0,TG_IMG_SIZE)
                img[TG_IMG_HANDLE] = pixbuf
--              img[TG_IMG_TRANSPARENT] = null
                img[TG_IMG_PIXEL_MEM] = pMem
                img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
                img[TG_IMG_HEIGHT] = h
--              img[TG_IMG_HEIGHT] = abs(h)
                img[TG_IMG_BGCLR] = TG_WHITE
                img[TG_IMG_LINESTYLE] = 1
                img[TG_IMG_LINEWIDTH] = 1
            end if

--      elsif backend==TG_WINAPI then   -- \ **NB**!
        elsif platform()=WINDOWS then   -- /

            if c_func(xOpenClipboard,{NULL}) then
                atom hDIB = c_func(xGetClipboardData,{CF_DIB})
                bAvail = hDIB!=NULL
                if bAvail and bGet then
                    atom pDIB = c_func(xGlobalLock,{hDIB})
                    bAvail = pDIB!=NULL
                    if bAvail then
                        integer bmiLen = get_struct_size(idBITMAPINFOHEADER),
                                biSize = get_struct_field(idBITMAPINFOHEADER,pDIB,"biSize"),
                                   bpp = get_struct_field(idBITMAPINFOHEADER,pDIB,"biBitCount"),
                           compression = get_struct_field(idBITMAPINFOHEADER,pDIB,"biCompression"),
                               clrUsed = get_struct_field(idBITMAPINFOHEADER,pDIB,"biClrUsed"),
                                 {w,h} = get_struct_fields(idBITMAPINFOHEADER,pDIB,{"biWidth","biHeight"})
                        bAvail = find(bpp,{32,24,8,1})!=0 -- (just quietly ignore anything else!)
                        if bAvail then
                            atom hdc = tg_WinAPI_GetDestDC(),
                                pBMI = allocate(bmiLen),
                              ppBits = allocate(machine_word())
--                          h = abs(h)
                            mem_set(pBMI,0,bmiLen)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biSize",bmiLen)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biWidth",w)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biHeight",h)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biPlanes",1)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biBitCount",32)
                            set_struct_field(idBITMAPINFOHEADER,pBMI,"biCompression",BI_RGB)

                            nnatom handle = c_func(xCreateDIBSection,{hdc,pBMI,DIB_RGB_COLORS,ppBits,NULL,0}),
                                    pBits = peeknu(ppBits)

                            atom pSrc = pDIB + biSize, palette = pSrc
                            -- CF_DIBV5 already includes masks, so don't skip them again
                            if biSize!=get_struct_size(idBITMAPV5HEADER) then
                                -- skip bitfields (for 16/32-bit BI_BITFIELDS)
                                if compression = BI_BITFIELDS then
                                    pSrc += 3*4 -- 3 DWORD masks
                                end if

                                -- skip color table
                                integer nColors
                                if clrUsed!=0 then
                                    nColors = clrUsed
                                elsif bpp<=8 then
                                    nColors = power(2,bpp)
                                else
                                    nColors = 0
                                end if

                                pSrc += nColors*4
                            end if

                            integer stride = floor((bpp*w+31)/32)*4
                            for y=0 to abs(h)-1 do
                                atom src_row = pSrc + y*stride,
                                     dst_row = pBits + y*w*4
                                if bpp=32 then
                                    mem_copy(dst_row,src_row,w*4)
                                else
                                    atom clr
                                    for x=0 to w-1 do
                                        if bpp=24 then
                                            integer {b,g,r} = peek({src_row+x*3,3})
                                            clr = r+g*#100+b*#10000
                                        else
                                            integer idx
                                            if bpp=8 then
                                                idx = peek(src_row+x)*4
                                            elsif bpp=1 then
                                                integer byte_ = peek(src_row+floor(x/8)),
                                                      mask = power(2,7-mod(x,8)),   
                                                   bit = and_bits(byte_,mask)!=0
                                                idx = iff(bit?4:0)
                                            else
                                                ?9/0 -- cannot trigger
                                            end if
                                            clr = peek4u(palette+idx)
                                        end if
                                        poke4(dst_row+x*4,clr)
                                    end for
                                end if
                            end for
                            free(pBMI)
                            free(ppBits)
                            img = repeat(0,TG_IMG_SIZE)
                            img[TG_IMG_HANDLE] = handle
--                          img[TG_IMG_TRANSPARENT] = null
                            img[TG_IMG_PIXEL_MEM] = pBits
                            img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
--                          img[TG_IMG_HEIGHT] = h
                            img[TG_IMG_HEIGHT] = abs(h)
                            img[TG_IMG_BGCLR] = TG_WHITE
                            img[TG_IMG_LINESTYLE] = 1
                            img[TG_IMG_LINEWIDTH] = 1
                        end if -- bpp in 32,24,8,1
                        c_proc(xGlobalUnlock,{hDIB})
                    end if -- pDIB!=NULL
                    c_proc(xCloseClipboard,{})
                end if
            end if
        else
            ?9/0 -- (unknown backend/platform)
        end if
        if bGet and bAvail then
            integer id = xpm_image_slot()
            gimages[id] = img
            gdm res = -id*2+1
            return res
        end if
        return bAvail

    -- various nefarious "internal" uses, all undocumented:

--  elsif name=`tg_XPM_from_shorthand` then -- undocumented, for hscroller.exw:
--      return tg_XPM_from_shorthand
    elsif name=`chk_xpm`      -- undocumented, for hCheckbox.exw
       or name=`slider_thumb` -- undocumented, for hSlider.exw
       or name=`xlr_xpm`      -- undocumented, for hTabs.exw
       or name=`treeOCD` then -- undocumented, for hTree.exw
        return apply(tg_XPM_from_shorthand(name),gImage_from_XPM)
    elsif name=`dp_xpm`      -- undocumented, for hText/DataPick.exw
       or name=`stripes` then  -- undocumented, for hProgressBar.exw
        return gImage_from_XPM(tg_XPM_from_shorthand(name))
    elsif name=`tg_popup` then -- undocumented, for hText/DataPick/DropDown.exw
        return tg_popup
    elsif name=`tg_get_sig` then -- undocumented, for several
        return tg_get_sig
    elsif name=`tg_redraw_scrollbars` then -- undocumented, for hTable.exw
        return tg_redraw_scrollbars
    elsif name=`tg_hsplit_get_size` then -- undocumented, for hSplit.exw
        return tg_hsplit_get_size
    elsif name=`tg_hsplit_save_size` then -- undocumented, for hSplit.exw
        return tg_hsplit_save_size
    elsif name=`tree_images` then -- undocumented, for hTree.exw
        return tg_XPM_from_shorthand(name)
    elsif ends(`ICON`,name) then
        if chks=NULL then chks = gGetGlobal(`chk_xpm`) end if
        if name=`CHECKED_ICONS` then return chks end if
        integer chkdx = find(name,{`UNCHECKED_ICON`,`CHECKED_ICON`,`UNCHECKED_RICON,`,`CHECKED_RICON`,`CHECKED_DRICON`})
        if chkdx then return chks[chkdx] end if
    end if

    crash(`gGetGlobal(%s) not supported`,{name})
end function

global function gGetGlobalInt(string name)
    integer res = gGetGlobal(name)
    return res
end function

--/*
