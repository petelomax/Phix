    if hov and status[2]='S' then
        tg_menubar_showtop(menu,hov)
--      tg_call_menu_handler(menu,1,hov,false,false)
        tg_call_menu_handler(menu,1,hov,false,true)
--      return tg_call_menu_handler(menu,1,hov,false,false)
    end if
    return TG_CONTINUE
end function

