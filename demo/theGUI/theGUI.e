local enum INT16, UINT16, INT32, FLT32

local function tg_FlattenArray(sequence data, integer array_type, bool bRetSize)
    if not atom(data[1]) then
        -- data must be in column major order, ie {{1,2},{3,4}} == {1,3,2,4}.
        sequence column_major = {}
        for c=1 to length(data[1]) do
            for r=1 to length(data) do
                column_major &= data[r][c]
            end for
        end for
        data = column_major
    end if
    integer size = length(data)*iff(array_type=INT16?2:4)
    atom pData
    if platform()=JS then
        #ilJS{
            if (array_type === INT16) {
                pData = new Int16Array(data.slice(1));
            } else if (array_type === UINT16) {
                pData = new Uint16Array(data.slice(1));
            } else if (array_type === INT32) {
                pData = new Int32Array(data.slice(1));
            } else if (array_type === FLT32) {
                pData = new Float32Array(data.slice(1));
            } else {
                crash("unknown array_type");
            }
        #}ilJS
    else
        pData = allocate(size)
        if array_type=INT16
        or array_type=UINT16 then
            poke2(pData,data)
        elsif array_type=INT32 then
            poke4(pData,data)
        elsif array_type=FLT32 then
            atom p = pData
            for d in data do
                poke(p,atom_to_float32(d))
                p += 4
            end for
        else
            crash("unknown array_type");
        end if
    end if
    if bRetSize then return {pData,size} end if
    return pData
end function

