global procedure gSetGlobal(string name, object v)
    if name!=`xpm_init`
    and name!=`DIAGNOSTICS` then
        if not bInit then tg_Init() end if
    end if

    if name=`IDLE_ACTION` then

        sequence args = {}
        bool low_priority = false
        if sequence(v) then
            if length(v)=3 then
                low_priority = v[3]
            end if
            {v,args} = v
        end if
        assert(rtn(v) and v>NULL)
        if v!=idle_rtn and not find(v,idle_stack) then
            idle_stack = append(idle_stack,v)
            idle_params = append(idle_params,args)
            low_priorities = append(low_priorities,low_priority)
            if hg_pop_or_prioritise_idle_stack()
            and backend=TG_GTK then
                if gtk_idle_func_cb==NULL then
                    gtk_idle_func_cb = call_back({'+',gtk_idle_func})
                end if
                gtk_idle_id = c_func(x_g_idle_add,{gtk_idle_func_cb,NULL});
            end if
        end if

    elsif name=`CLIPTXT`
       or name=`CLIPTEXT`
       or (name=`CLIPIMG` and v=NULL) then -- (just clear the clipboard)

--      if backend==TG_GTK then     -- \ **NB**!
        if platform()=LINUX then    -- /

            nnatom clipboard = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD})
            c_proc(x_gtk_clipboard_clear,{clipboard})
            if v!=NULL then
                c_proc(x_gtk_clipboard_set_text,{clipboard,v,-1})
            end if

--      elsif backend==TG_WINAPI then   -- \ **NB**!
        elsif platform()=WINDOWS then   -- /

--          atom hWnd = c_func(xGetActiveWindow,{}) -- (what arwen uses)
--          atom hWnd = c_func(xGetForegroundWindow,{})
--          if c_func(xOpenClipboard,{hWnd}) then
            if c_func(xOpenClipboard,{NULL}) then -- (what win_clip uses)
                if c_func(xEmptyClipboard,{}) and sequence(v) then
                    sequence text = v
                    v = NULL
                    integer len = length(text)
                    if len!=0 then
                        if text[len]!='\0' then
                            text &= '\0'
                            len += 1
                        end if
                        atom hGlobal = c_func(xGlobalAlloc,{GMEM_CLIPBOARD,len})
                        if hGlobal!=NULL then
                            atom pData = c_func(xGlobalLock,{hGlobal})
                            if pData=NULL then
                                hGlobal = c_func(xGlobalFree,{hGlobal})
                                -- or just warn...? or log...
                                assert(hGlobal=NULL)
                            else
                                poke(pData,text)
                                c_proc(xGlobalUnlock,{hGlobal})
                                
                                -- copy data to clipboard & close
                                hGlobal = c_func(xSetClipboardData,{CF_TEXT,hGlobal})
                                --Note that we should NOT GlobalFree hGlobal,
                                --      since the clipboard now owns it.
                                assert(hGlobal!=NULL)
                            end if
                        end if
                    end if
                end if
                c_proc(xCloseClipboard,{})
            end if
        else
            ?9/0 -- (unknown backend)
        end if
    elsif name=`CLIPIMG` then
        assert(gdm(v))
        integer imgidx = (-v+1)/2,
                     w = gimages[imgidx][TG_IMG_WIDTH],
                     h = gimages[imgidx][TG_IMG_HEIGHT]

--      if backend==TG_GTK then     -- \
        if platform()=LINUX then    -- / **NB**!!

--/*
            if atom_png=NULL then
                atom_png = c_func(x_gdk_atom_intern,{"image/png", false})
                atom_targets = c_func(x_gdk_atom_intern,{"TARGETS", false})
                pAtoms = allocate_word(atom_png)
            end if

            -- build_png_in_buffer:

            atom pBuffer = allocate(machine_word()),
                   pSize = allocate(machine_word()),
                  pixbuf = gimages[imgidx][TG_IMG_HANDLE]

            poken(pBuffer, 0)
            poken(pSize,   0)

            bool ok = c_func(x_gdk_pixbuf_save_to_buffer,{pixbuf,pBuffer,pSize,"png",NULL,NULL})
            if not ok then
                ? "PNG encode failed"
            else

                atom buf = peeknu(pBuffer)   -- char*
                integer len = peeknu(pSize)  -- size_t

                -- free previous if any
                if png_data!=NULL then
                    free(png_data)
                end if

                png_data = allocate(len)
                png_len = len

                mem_copy(png_data, buf, len)

                -- free GTK buffer
                c_proc(x_g_free,{buf})
            end if

            free(pBuffer)
            free(pSize)

            integer nCT = 2 -- length(clip_targets)
            if pClipTargets=NULL then
                sequence clip_targets = {{"TARGETS", 0, 0},
                                         {"image/png", 0, 1}}
                atom pN_Targets = allocate(machine_word()),
                    target_list = c_func(x_gtk_target_list_new,{NULL, 0})

                for t in clip_targets do
                    {string target, integer flags, integer info} = t
                    atom atgt = c_func(x_gdk_atom_intern,{target,FALSE})
                    c_proc(x_gtk_target_list_add,{target_list,atgt,flags,info})
                end for
                pClipTargets = c_func(x_gtk_target_table_new_from_list,{target_list,pN_Targets})
                free(pN_Targets)
            end if
--*/
            nnatom clip = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD}),
                 pixbuf = gimages[imgidx][TG_IMG_HANDLE]
--          c_proc(x_gtk_clipboard_set_can_store,{clip,NULL,0}) -- "all"?
            c_proc(x_gtk_clipboard_set_image,{clip,pixbuf})
            c_proc(x_gtk_clipboard_store,{clip})
--          nnatom display = c_func(x_gdk_display_get_default,{})
--          c_proc(x_gdk_display_store_clipboard,{display,window,NULL,NULL,0})
--          pixbuf = c_func(x_gtk_clipboard_wait_for_image,{clip}) -- (and re-fetch to force the store!)
--/*
--  The problem with using gtk_clipboard_store is that (on GTK 3.22.20) I get a flurry of these warnings:
--  "Don't know how to transmute from target 0x0000000000000050 to format 0x8", plus one of these:
--  "Setting selection property with 0x0000000000000000 == NULL or 0x0 == 0 or 0x0000000000000000 == 0"
--  [Above is when using gUseGTK() on Windows with my crummy 8-year-old dlls, btw]
--
--  I had removed all calls to gtk_selection_data_set(), and get the warnings just doing
--              nnatom clip = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD})
--              c_proc(x_gtk_clipboard_set_image,{clip,pixbuf})
--              c_proc(x_gtk_clipboard_store,{clip})
--  The warnings stop appearing immediately if I comment out the last line, but appear when the
--  program closes down (as they also do with it).
--  Aside: On Windows, one thing I spotted is that running a GTK program clears the clipboard on exit,
--          unless I pasted the image into mspaint, then then it didn't  ----        """         ----,
--          so /maybe/ running a dummy "paste this" program is a way to prevent      """     ....?
--*/

--      elsif backend==TG_WINAPI then   -- \ **NB**!!
        elsif platform()=WINDOWS then   -- /

            integer bmiLen = get_struct_size(idBITMAPINFOHEADER),
                  lineSize = w*4
            nnatom hMem = c_func(xGlobalAlloc,{GMEM_MOVEABLE,bmiLen+lineSize*h}),
                   pMem = c_func(xGlobalLock,{hMem}),
                  pBits = gimages[imgidx][TG_IMG_PIXEL_MEM]

            mem_set(pMem,0,bmiLen)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biSize",bmiLen)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biWidth",w)
--          set_struct_field(idBITMAPINFOHEADER,pMem,"biHeight",-h)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biHeight",h)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biPlanes",1)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biBitCount",32)
            set_struct_field(idBITMAPINFOHEADER,pMem,"biCompression",BI_RGB)
--          mem_copy(pMem+bmiLen,pBits,dataSize) --upside down!
            for l=1 to h do
                atom pSrc = pBits+(l-1)*lineSize,
--                   pTgt = pMem+bmiLen+(h-l)*lineSize
                     pTgt = pMem+bmiLen+(l-1)*lineSize
                if backend=TG_GTK then
                    --
                    -- Note: this is a fairly unusual case of converting a
                    --       GTK-created GdkPixbuf into a Windows CF_DIB.
                    -- GdkPixbuf does not preserve RGB values when alpha=0.
                    -- Fully transparent pixels often := black transparent.
                    -- So we have litte choice but to asssume was TG_WHITE
                    -- (real end users are unlikely to ever run this code)
                    --
                    sequence p = peek4u({pSrc,w})
                    for i,c in p do
                        -- transparent -> white else RGBA -> BGR
                        c = iff(c=0?TG_WHITE:and_bits(c,#FF0000)/#10000
                                           + and_bits(c,#00FF00)
                                           + and_bits(c,#0000FF)*#10000)
                        p[i] = c
                    end for
                    poke4(pTgt,p)
                elsif backend=TG_WINAPI then
                    mem_copy(pTgt,pSrc,lineSize)
                elsif backend=TG_JS then
                    #ilJS{
                        crash(`JS (gSetGlobal %s)`,{name});
                    #}ilJS
                else
                    ?9/0
                end if
            end for

            c_proc(xGlobalUnlock,{hMem})

            if c_func(xOpenClipboard,{NULL}) then
                {} = c_func(xEmptyClipboard,{})
                -- Aside: CF_DIB is mspaint compatible, CF_DIBV5 ain't.
                {} = c_func(xSetClipboardData,{CF_DIB,hMem})
                c_proc(xCloseClipboard,{})
            end if
        else
            ?9/0 -- (unknown backend)
        end if

    elsif name=`CLIPIMGFILE` then   -- desktop/Phix only!

        string filename = v

--      if backend==TG_GTK then     -- \ **NB**!
        if platform()=LINUX then    -- /

            atom err = NULL,
              pixbuf = c_func(x_gdk_pixbuf_new_from_file,{filename,err})
            if pixbuf!=NULL and c_func(x_gdk_pixbuf_get_width,{pixbuf}) then
                atom clip = c_func(x_gtk_clipboard_get,{GDK_SELECTION_CLIPBOARD})
                c_proc(x_gtk_clipboard_set_image,{clip,pixbuf})
            end if

--      elsif backend==TG_WINAPI then   -- \ **NB**!
        elsif platform()=WINDOWS then   -- /

            if GDIPLUS=NULL then
                GDIPLUS = open_dll("GdiPlus.dll")
                gdiplusToken = allocate_word()
                xGdiplusStartup = define_c_func(GDIPLUS,"GdiplusStartup",
                    {C_PTR,     --  __out  ULONG_PTR token *token
                     C_PTR,     --  __in   const GdiplusStartupInput *input
                     C_PTR},    --  __out  GdiplusStartupOutput *output
                    C_INT)      -- Status
                xGdipLoadImageFromFile = define_c_func(GDIPLUS,"GdipLoadImageFromFile",
                    {C_PTR,     --  WCHAR* filename
                     C_PTR},    --  ppImage **image
                    C_LONG)     -- Status
                xGdipGetImageWidth = define_c_func(GDIPLUS,"GdipGetImageWidth",
                    {C_PTR,     --  pImage *image
                     C_PTR},    --  UNIT *width
                    C_LONG)     -- Status
                xGdipGetImageHeight = define_c_func(GDIPLUS,"GdipGetImageHeight",
                    {C_PTR,     --  pImage *image
                     C_PTR},    --  UNIT *height
                    C_LONG)     -- Status
                xGdipBitmapLockBits = define_c_func(GDIPLUS,"GdipBitmapLockBits",
                    {C_PTR,     --  GpBitmap* bitmap
                     C_PTR,     --  GDIPCONST GpRect *rect
                     C_PTR,     --  UINT flags
                     C_PTR,     --  PixelFormat format
                     C_PTR},    --  BitmapData *lockeddata
                    C_INT)      -- GpStatus
                xGdipBitmapUnlockBits = define_c_func(GDIPLUS,"GdipBitmapUnlockBits",
                    {C_PTR,     --  GpBitmap* bitmap
                     C_PTR},    --  BitmapData *lockedBitmapData
                    C_INT)      -- GpStatus
                xGdipDisposeImage = define_c_func(GDIPLUS,"GdipDisposeImage",
                    {C_PTR},    --  pImage *image
                    C_LONG)     -- Status
                xGdiplusShutdown = define_c_proc(GDIPLUS,"GdiplusShutdown",
                    {C_PTR})    --  pToken
                idGdiplusStartupInput = define_struct("""typedef struct {
                                                          UINT32         GdiplusVersion;
                                                          DebugEventProc DebugEventCallback;
                                                          BOOL           SuppressBackgroundThread;
                                                          BOOL           SuppressExternalCodecs;
                                                        } GdiplusStartupInput;""")
                pGdiplusStartupInput = allocate_struct(idGdiplusStartupInput)
                set_struct_field(idGdiplusStartupInput,pGdiplusStartupInput,"GdiplusVersion",1)
                integer res = c_func(xGdiplusStartup,{gdiplusToken,pGdiplusStartupInput,NULL})
                if res=UnsupportedGdiplusVersion then ?9/0 end if
                assert(res=GDI_STATUS_OK)
            end if
            atom lpFilePathW = allocate_wstring(utf8_to_utf16(filename))
            integer status = c_func(xGdipLoadImageFromFile,{lpFilePathW,pWord}),
                    bmiLen = get_struct_size(idBITMAPINFOHEADER), w, h, res
            free(lpFilePathW)
            if status==GDI_OK then
                atom pImage = peek4u(pWord),
                        hDC = tg_WinAPI_CreateCompatibleDC(NULL),
                       pBMI = allocate(bmiLen),
                     ppBits = allocate(machine_word())
                assert(c_func(xGdipGetImageWidth,{pImage,pWord})=GDI_OK);   w = peek4u(pWord)
                assert(c_func(xGdipGetImageHeight,{pImage,pWord})=GDI_OK);  h = peek4u(pWord)
                mem_set(pBMI,0,bmiLen)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biSize",bmiLen)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biWidth",w)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biHeight",-h)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biPlanes",1)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biBitCount",32)
                set_struct_field(idBITMAPINFOHEADER,pBMI,"biCompression",BI_RGB)
                atom hNew = c_func(xCreateDIBSection,{hDC,pBMI,DIB_RGB_COLORS,ppBits,NULL,0}),
                    pBits = peeknu(ppBits),
                  bmpData = allocate(32) -- BitmapData
                poke4(pRECT,{0,0,w,h})
                res = c_func(xGdipBitmapLockBits,{pImage,pRECT,ImageLockModeRead,PixelFormat32bppARGB,bmpData})
                assert(res==GDI_STATUS_OK)
                atom srcScan0 = peeknu(bmpData+16) -- Scan0
                integer srcStride = peek4s(bmpData+8)
                if srcStride<0 then
                    srcScan0 += (h-1)*srcStride
                    srcStride = -srcStride
                end if

                -- copy rows (respect stride!)
                for y=0 to h-1 do
                    atom src = srcScan0 + y*srcStride
                    atom dst = pBits + y*w*4
                    mem_copy(dst, src, w*4)
                end for

                assert(c_func(xGdipBitmapUnlockBits,{pImage,bmpData})==GDI_STATUS_OK)
                assert(c_func(xGdipDisposeImage,{pImage})==GDI_STATUS_OK)
                assert(c_func(xDeleteDC,{hDC})!=0)
                free(pBMI)
                free(bmpData)
                free(ppBits)
                integer dataSize = w*abs(h)*4
                atom hMem = c_func(xGlobalAlloc,{GMEM_MOVEABLE,bmiLen+dataSize}),
                     pMem = c_func(xGlobalLock,{hMem})
                mem_set(pMem,0,bmiLen)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biSize",bmiLen)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biWidth",w)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biHeight",-h)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biPlanes",1)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biBitCount",32)
                set_struct_field(idBITMAPINFOHEADER,pMem,"biCompression",BI_RGB)
                mem_copy(pMem+bmiLen,pBits,dataSize)
                c_proc(xGlobalUnlock,{hMem})
                if c_func(xOpenClipboard,{NULL}) then
                    {} = c_func(xEmptyClipboard,{})
                    -- Aside: CF_DIB is mspaint compatible, CF_DIBV5 ain't.
                    hMem = c_func(xSetClipboardData,{CF_DIB,hMem})
                    --Note that we should NOT GlobalFree hGlobal,
                    --      since the clipboard now owns it.
                    assert(hMem!=NULL)
                    c_proc(xCloseClipboard,{})
                end if
                c_proc(xDeleteObject,{hNew})
            end if

        else
            ?9/0 -- (unknown backend)
        end if

--/*
-- maybe, for copying files, maybe in a different (/non-js) file:
--      When running Windows Explorer, I can copy files in one window and paste them in another. How is that done programatically? For WinAPI I 
--      would guess it is either CF_HDROP or CF_SYLK, and the only likely candidates I can see for GTK are gtk_clipboard_set_with_data and
--      gtk_clipboard_set_with_owner?
--
--      For Windows Explorer-style "copy files / paste files", the clipboard format is primarily CF_HDROP, often accompanied by some shell-specific metadata.
--
--      CF_SYLK is unrelated (spreadsheet interchange format).
--
--      The usual mechanism is:
--
--      put a DROPFILES structure plus a double-null-terminated filename list on the clipboard as CF_HDROP
--      optionally add preferred drop effect info (copy vs move) using the registered clipboard format "Preferred DropEffect"
--
--      On paste, Explorer (or another app) reads the filenames from CF_HDROP.
--
--      A minimal WinAPI outline is:
--
--      OpenClipboard(hwnd);
--      EmptyClipboard();
--
--      HGLOBAL hMem = GlobalAlloc(GMEM_MOVEABLE,sizeof(DROPFILES)+bytes);
--
--      DROPFILES *df = GlobalLock(hMem);
--
--      df->pFiles = sizeof(DROPFILES);
--      df->fWide = TRUE;   // Unicode
--
--      WCHAR *p = (WCHAR*)((BYTE*)df + sizeof(DROPFILES));
--
--      wcscpy(p, L"C:\\tmp\\file1.txt");
--      p += wcslen(p)+1;
--
--      wcscpy(p, L"C:\\tmp\\file2.txt");
--      p += wcslen(p)+1;
--
--      *p = 0; // extra null terminator
--
--      GlobalUnlock(hMem);
--
--      SetClipboardData(CF_HDROP, hMem);
--
--      CloseClipboard();
--
--      The payload after DROPFILES is:
--
--      file1\0
--      file2\0
--      \0
--
--      with UTF-16 strings if fWide=TRUE.
--
--      To distinguish copy vs move, Explorer also commonly uses:
--
--      UINT fmt = RegisterClipboardFormat(CFSTR_PREFERREDDROPEFFECT);
--
--      with a DWORD containing:
--
--      DROPEFFECT_COPY
--
--      or
--
--      DROPEFFECT_MOVE
--
--      Without that, many targets assume copy.
--
--      For GTK:
--
--      GTK does not provide a special "file clipboard API" because on X11/Wayland/macOS/Windows the underlying conventions differ. 
--      The normal GTK mechanism is indeed:
--
--      gtk_clipboard_set_with_data()
--      or simpler gtk_clipboard_set_text(), gtk_clipboard_set_image(), etc.
--
--      For files, GTK typically uses URI targets such as:
--
--      text/uri-list
--
--      containing:
--
--      file:///c:/tmp/file1.txt
--      file:///c:/tmp/file2.txt
--
--      So on GTK/Windows there are effectively two worlds:
--
--      Environment                     Clipboard format
--      Native WinAPI / Explorer        CF_HDROP
--      GTK / cross-platform DnD        "text/uri-list"
--
--      GTK on Windows may internally translate between them during drag-and-drop, but clipboard support is less automatic.
--
--      If your goal is specifically:
--
--      "make Windows Explorer paste files copied from my app"
--
--      then use native WinAPI CF_HDROP.
--
--      If your goal is:
--
--      "GTK app interoperates cross-platform"
--
--      then use "text/uri-list" targets via gtk_clipboard_set_with_data().
--
--      A typical GTK setup looks like:
--
--      GtkTargetEntry targets[] = {
--          { "text/uri-list", 0, 0 }
--      };
--
--      gtk_clipboard_set_with_data(
--          clipboard,
--          targets,
--          1,
--          get_func,
--          clear_func,
--          user_data);
--
--      and in get_func:
--
--      gtk_selection_data_set_uris(selection_data, uris);
--
--      where uris is a NULL-terminated array like:
--
--      {
--        "file:///C:/tmp/a.txt",
--        "file:///C:/tmp/b.txt",
--        NULL
--      }
--
--      One subtle point: Explorer clipboard-copy is not just "filenames". It is actually part of the shell drag/drop subsystem 
--      (IDataObject, CFSTR_SHELLIDLIST, virtual files, etc.). But for ordinary real files, CF_HDROP alone is usually sufficient.
--*/

    -- various nefarious "internal" uses, all undocumented:

    elsif name=`xpm_init` then 
        -- linkage from thegui_xpm.e, not documented
        {tg_XPM_from_shorthand,
         tg_winAPI_create_DIB,
         tg_winAPI_create_DIB_from_xpm,
         tg_get_colour_table,
         idBITMAPINFOHEADER} = v

    elsif name=`DIAGNOSTICS` then -- undocumented, see hXxxx.exw for examples
        -- The plan is several in parallel and spare innocent bystanders.
        --  (eg hFrame is mid-margin issue, while hMenu is mid-bgclr..)
        -- Use string forms of v rather than add any new global constants.
        -- Candidates include g_log(), run_unit_tests, tg_lm_xxx(), etc.
        -- theGUI.e should quietly ignore things meant for theGUI.js, and 
        -- vice-versa. There should be no issues setting multiple things
        -- on together, via several calls in quick succession, hopefully.
        if v=`MARGINS` then
            bDumpMargins = true
            v = true
        elsif v=`SET_NORM` then
            DF_ACTIVE = or_bits(DF_ACTIVE,DF_SET_NORM)
            v = true
        elsif v=`SET_USER` then
            DF_ACTIVE = or_bits(DF_ACTIVE,DF_SET_USER)
            v = true
        elsif v=`SB_INFO` then
            DF_ACTIVE = or_bits(DF_ACTIVE,DF_SB_INFO)
            v = true
        elsif v=`DF_SET_WH` then
            DF_ACTIVE = or_bits(DF_ACTIVE,DF_SET_WH)
            v = true
        elsif v=`DF_SET_XY` then
            DF_ACTIVE = or_bits(DF_ACTIVE,DF_SET_XY)
            v = true
        elsif v=`DUMPONREDRAW` then
            bDumpOnRedraw = true
            v = true
        elsif v=`DUMPONRESIZE` then
            dump_ctrls_on_resize = true
            v = true
        elsif v=`DUMP_NOW` then
            tg_lm_dump_ctrls(source_line(),v)
            v = true
        elsif v=`BGCLR` then
            bShowBGCLR = true
            v = true
        elsif v=`ignore_TextExtent_errors` then
            bIgnoreTextExtentErrors = true
            return
        end if
        if v=true or v=false then
            bDiagnostics = v
            puts(1,"") -- (since that usually helps with the focus)
        elsif v!=`something meant for theGUI.js` then
            ?{`gSetGlobal(DIAGNOSTICS)`,v}
        end if
    elsif name=`drawmenu` then -- undocumented, for hMenu.exw
        draw_menu = v
    else
        crash(`gSetGlobal(%s,%v) not supported`,{name,v})
    end if
end procedure

-- (this might one day become a builtin??)
local procedure crash_hat(string msg, txt, integer carat, nFrames=1)
    -- neither txt nor "^ msg" should fall off rhs (79 chars)
    integer lm = carat+1+length(msg)
    if lm>79 then
        txt = `...`&txt[lm-75..$]
        carat -= lm-79
    end if
    if length(txt)>79 then
        txt = txt[1..76]&`...`
    end if
    msg = sprintf("%s\n%s^ %s\n",{txt,repeat(' ',carat-1),msg})
    crash(msg,nFrames:=nFrames)
end procedure

local constant TG_LEX_TK_END    = 0,
               TG_LEX_TK_SET    = 1,
               TG_LEX_TK_COMMA  = 2,
               TG_LEX_TK_NAME   = 3,
               TG_LEX_TK_HEX    = 4;

--with trace

local function tg_parse_attributes(string attributes, sequence args, integer nFrames=1)
--?attributes
    // (manually translated from iup_attrib.c)
    if length(args) then attributes = sprintf(attributes,args) end if
    args = {}
    integer i = 1,
            l = length(attributes)
    string token = ``
    object name = null,
            val = null
    bool get_name = true // (else get_value)
    while true do
        integer toktype = TG_LEX_TK_END
        while i<=l do
            integer ch = attributes[i]
            i += 1
            string delims = ``
            switch ch do
                case '%':   // Skip comment
                    while i<=l do
                        ch = attributes[i]
                        i += 1
                        if ch=='\n' then exit end if
                    end while
                case '#':   // Hex constant
                    toktype = TG_LEX_TK_HEX
                    i -= 1;                     // unget first character
                    delims = ", \n\r\t"         // get until delimiter
                case ' ', '\n', '\r':
                    break
                case '=':
                    toktype = TG_LEX_TK_SET
                case ',':
                    toktype = TG_LEX_TK_COMMA
                case '"':                       // string
--                  delims = `""`
                    delims = `"`
--                  i += 1
                case '{':
                    delims = `}`
                default:
                    if ch>' ' then              // identifier
                        i -= 1;                 // unget first character
                        delims = "=, \n\r\t"    // get until delimiter
                    end if
            end switch
            if length(delims) then
                token = ``
                while i<=l do
                    ch = attributes[i]
                    i += 1
                    if find(ch,delims) then exit end if
                    if toktype=TG_LEX_TK_HEX then
                        --DEV/SUG "source line with ^"-style error, if we can:
                        -- maybe crash_hat(`bad hex char`,attributes,i,1,nFrames)
                        --   ==>    gSetAttributes(dlg,`BGCLR=#1234J678`)
                        --                                         ^ bad hex char
                        -- or       bad hex char (`...234(>>J<<)678...`) if no match
                        -- better:      `...234J678...`
                        --                     ^ bad hex char
                        -- crash_hat() attempts to deliver a source-level error with
                        -- a caret indicating the exact point of failure, however and
                        -- of course a compiled program has no access to source code 
                        -- to point at, so that will be more like a normal crash().
                        -- You provide a code fragment, offset and length, which it
                        -- tries to match against the source code line if it can.
                        -- To keep things simple, there is no auto-sprintf(msg,args)
                        -- option in crash_hat(). For an example see theGUI.e
--                      assert(find(ch,`#01234567890ABCDEFabcdef`)!=0,`bad hex char`)
--DEV untested:
                        if find(ch,`#01234567890ABCDEFabcdef`)=0
                        or (ch='#' and token!=``) then
                            crash_hat(`bad hex char`,attributes,i-1,nFrames+1)
                        end if
--                      assert(ch!='#' or token=``,`multiple # chars?`)
--                      if ch='#' and token!=`` then
--                          crash_hat(`multiple # chars?`,attributes,i-1,nFrames+1)
--                      end if
                    end if
                    token &= ch
                end while
                if length(delims)>1 and find(ch,delims) then
                    i -= 1  // unget delimiter
                end if
                if toktype!=TG_LEX_TK_HEX then
                    toktype = TG_LEX_TK_NAME
                end if
            end if
            if toktype!=TG_LEX_TK_END then exit end if
        end while
        switch toktype do
--DEV compiler error... (with nFrames:=nFrames+1)
--          case TG_LEX_TK_END:
--              bEnd = true
--              fallthrough
--          case TG_LEX_TK_COMMA:
            case TG_LEX_TK_END,
                 TG_LEX_TK_COMMA:
                if name!=NULL then
--                  gSetAttribute(id,name,val,nFrames:=nFrames+1)
                    args = append(args,{name,val})
--                  gSetAttribute(id,name,val,nFrames:=nFrames)
--                  names = append(names,name)
--                  vals = append(vals,name)
                end if
--              if bEnd then return end if
                if toktype=TG_LEX_TK_END then return args end if
                name = null
                val = null
                get_name = true
            case TG_LEX_TK_SET:
                get_name = false
            case TG_LEX_TK_NAME:
                if get_name then
                    name = token
                else
                    val = token
                end if
            case TG_LEX_TK_HEX:
                assert(not get_name)
                val = token
        end switch
    end while
    return args
end function

global procedure gSetAttributes(gcxs id, string attributes, sequence args={}, integer nFrames=1)
    if length(attributes) then
        if attributes!=`==` then args = tg_parse_attributes(attributes,args,nFrames+2) end if
        for a in args do
            {string n, object v} = a
            if length(a)>2 then v = sprintf(v,a[3]) end if
            gSetAttribute(id,n,v,{},nFrames+1)
        end for
    end if
end procedure

