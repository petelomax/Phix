local procedure tg_list_mouseleave(gdx list)
--?"mouseleave"
    bool bRedraw = false
    if ctrl_xtra[list][LX_HOVLINE] then
        ctrl_xtra[list][LX_HOVLINE] = 0
        bRedraw = true
    end if
    object sbinfo = ctrl_sbinfo[list]
    if sequence(sbinfo)
    and sbinfo[SB_MONLD]!=`` then
        sbinfo = NULL
        ctrl_sbinfo[list][SB_MONLD] = ``
        bRedraw = true
    end if
    if bRedraw then
        gRedraw(list)
    end if
end procedure

