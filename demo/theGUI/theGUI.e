local function tg_set_checkbox_attribute(gdx chk, string name, object v, integer nFrames)
    if name=`VALUE` then
        if string(v) then
            if v=`TOGGLE` then
                v = not ctrl_xtra[chk][CXCHK_VALUE]
            else
                v = tg_to_bool(v,nFrames+2)
            end if
        end if
        assert(v=true or v=false,"t/f?",nFrames:=nFrames+2)
        integer radio = ctrl_xtra[chk][CXCHK_RADIO]
        if radio then
            if not v then 
                crash("gSetAttribute(radio,`VALUE`,false) is illegal",nFrames:=nFrames+2)
            end if
            gdx prv = radio_selected[radio]
            ctrl_xtra[prv][CXCHK_VALUE] = false
            ctrl_xtra[chk][CXCHK_VALUE] = true
            radio_selected[radio] = chk
        else
            ctrl_xtra[chk][CXCHK_VALUE] = v
        end if
        gdx dlg = gGetDialog(chk)
        if dlg!=NULL and ctrl_handles[dlg]!=NULL then
            gRedraw(dlg)
        end if
        return true
    end if
    return false
end function

function tg_get_checkbox_attribute(gdx chk, string name, integer nFrames)
    if name=`VALUE` then
        return ctrl_xtra[chk][CXCHK_VALUE]
    end if
    tg_bad_attr(chk,name,nFrames+1)
end function

global function gCheckbox(object title=NULL, value_changed=NULL, sequence attributes=``, dword_seq args={}) 
    integer icon_align = TG_E, pair_align = TG_E
    if sequence(title) and not string(title) then
        {{title,icon_align},pair_align} = {title,title[$]}
    end if
    {title,value_changed,attributes,args} = paranormalise_traa(title,value_changed,attributes,args)
    gdx chk = gCanvas(tg_chk_redraw,nFrames:=2)
    ctrl_types[chk] = CHECKBOX
    ctrl_set_attr[CHECKBOX] = tg_set_checkbox_attribute
    ctrl_get_attr[CHECKBOX] = tg_get_checkbox_attribute
    gSetAttribute(chk,`EXPAND`,false)
    object chk_attr = repeat(0,CXCHK_LEN)
    chk_attr[CXCHK_IALGN] = icon_align
    chk_attr[CXCHK_PALGN] = pair_align
    ctrl_xtra[chk] = chk_attr
    chk_attr = 0
    if title!=NULL then
        gSetAttribute(chk,`TITLE`,title)
    end if
    gSetAttribute(chk,`CANFOCUS`,true)
    tg_register_handler(CHECKBOX,`VALUE_CHANGED`,{`POI`,`PO`,`PI`,`P`},true)
    gSetHandler(chk,`CLICK`,tg_chk_mouse_click)
    gSetHandler(chk,`KEY`,tg_chk_key)
    if value_changed!=NULL then
        gSetHandler(chk,`VALUE_CHANGED`,value_changed)
    end if
    if length(attributes) then
        gSetAttributes(chk,attributes,args,2)
    end if
    return chk
end function

global procedure gRadio(gdx chks)
    radio_sets = append(radio_sets,chks)
    integer rdx = length(radio_sets), sdx = 0
    for chk in chks do
        assert(ctrl_types[chk]=CHECKBOX)
        -- not already part of any other radio group:
        if ctrl_xtra[chk][CXCHK_RADIO] then ?9/0 end if
        ctrl_xtra[chk][CXCHK_RADIO] = rdx
        if ctrl_xtra[chk][CXCHK_VALUE] then
            if sdx=0 then sdx = chk else ?9/0 end if
        end if
    end for
    if sdx=0 then 
        sdx = chks[1]
        ctrl_xtra[sdx][CXCHK_VALUE] = true
    end if
    radio_selected = append(radio_selected,sdx)
end procedure

global function gRadioItem(gdx chk)
    if sequence(chk) then chk = chk[1] end if -- [pick any one of them]
    assert(ctrl_types[chk]=CHECKBOX)
    integer rdx = ctrl_xtra[chk][CXCHK_RADIO] -- [0 if no prior gRadio()]
    return radio_selected[rdx]
end function

local function tg_greyscale(atom clr)
    integer {rr,gg,bb,aa} = to_rgba(clr)
    rr = floor(sqrt((rr+gg+bb)/(255*3))*255)
    atom res = rgba(rr,rr,rr,aa)
    return res
end function

