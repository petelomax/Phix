local function tg_get_box_spacing_name(object s, integer id=NULL)
    assert(id<=0 or ctrl_types[id]=BOX)
    if sequence(s) then
        assert(length(s)=2)
        integer {s1,s2} = s -- (force typecheck)
        string r1 = tg_get_box_spacing_name(s1),
               r2 = tg_get_box_spacing_name(s2,-1)
        return sprintf(`{%s,%s}`,{r1,r2})
    end if
    string res = ``
    integer k = find(s,box_spacing_masks)
    assert(k!=0,`unknown box spacing:0b%b`,s)
    if id!=NULL
    and (id=-1 or and_bits(ctrl_flags[id],CF_VERTICAL))
    and box_spacing_masks[k+1]==s then
        k += 1
    end if
    res &= box_spacing_descs[k]
    return res
end function

global constant M_CTRL = #2000_0000,    -- bit 30
               M_SHIFT = #1000_0000,    -- bit 29
                 M_ALT = #0800_0000,    -- bit 28
             M_NOT_KEY = #0400_0000     -- bit 27

global function gGetKeyName(integer ch)
    string prefix = ""
    if ch>=M_NOT_KEY then
        if    M_CTRL&&ch then prefix &= `Ctrl+`;    ch -= M_CTRL    end if
        if   M_SHIFT&&ch then prefix &= `Shift+`;   ch -= M_SHIFT   end if
        if     M_ALT&&ch then prefix &= `Alt+`;     ch -= M_ALT     end if
        if M_NOT_KEY&&ch then prefix &= `NOT KEY+`; ch -= M_NOT_KEY end if
    end if
    for k in key_mappings do
        if ch=k[2] then
            string k1 = k[1]
            if begins(`VK_`,k1) then
                k1 = k1[4..$]
            end if
            return prefix&k1
        end if
    end for
    if ch>=' ' and ch<='~' then
        return prefix&ch
    end if
    return sprintf(`unknown(%s#%x)`,{prefix,ch})
end function

global function gMenuCcsa(integer c)
    -- simple assist for menu -> key handler offloading
    bool ctrl = c&&M_CTRL, shift = c&&M_SHIFT, alt = c&&M_ALT
    integer ch = and_bits(c,M_NOT_KEY-1)
    return {ch,ctrl,shift,alt}
end function

global function gGetColourName(atom c)
    if c=-1 then return `-1` end if
    integer k = find(c,known_colour_values)
    return iff(k?known_colour_names[k]:sprintf(`#%06x`,c))
end function

local function tg_get_colour_value(object s)
    if string(s) then s = to_number(s,s) end if
    if not string(s) then
        return s
    end if
    s = upper(substitute(s,`GRAY`,`GREY`))
    if not begins(`TG_`,s) then s = `TG_`&s end if
    integer k = find(s,known_colour_names)
    if k then return known_colour_values[k] end if
    integer clr = to_number(s,`unknown colour:`&s) -- (typecheck on error)
    return clr
end function

