local procedure tg_hide(gdx id)
    integer ct = ctrl_types[id]
    string idt = ctrl_names[ct]
    if ct=MENU then
        tg_hide_submenus(id,1,true)
    else
        atom {hWnd,?,owner,w,h} = ctrl_hdc[id]
        if backend=TG_GTK then
            c_proc(x_gtk_widget_hide,{hWnd})
        elsif backend=TG_WINAPI then
            c_proc(xShowWindow,{hWnd,SW_HIDE})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_hide)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
        ctrl_xtra[owner][DX_ACTIVEPOP] = NULL
        --- restore user size in case the gText gets resized:
        ctrl_size[id][SZ_USER_W] = w
        ctrl_size[id][SZ_USER_H] = h
    end if
end procedure

local function tg_gtk_kill_menu(gdx dlg)
    integer ct = ctrl_types[dlg] 
    assert(ct=DIALOG)
    gdx menu = ctrl_xtra[dlg][DX_ACTIVEPOP]
    if menu then
        tg_hide(menu)
        return true
    end if
    return false
end function

local procedure tg_clear_and_set_radio_group(gdx menu, integer mdx, hit)
    integer group_start = hit,
            l = length(ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS])
    while group_start>1 
      and ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][group_start-1][MX_IMAGE]=`??` do
        group_start -= 1
    end while
    while group_start<=l 
      and ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][group_start][MX_IMAGE]=`??` do
        ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][group_start][MX_CHECKED] = false
        group_start += 1
    end while
    ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_CHECKED] = true
end procedure

local procedure tg_call_menu_handler(gdx menu, integer mdx, hit, bool bHover, bClose)
    -- when called with bHover==true, bClose is ignored
    -- while clicks on a popup/dropdown may want the menu closing,
    --       clicks on a menubar (leaf item) in contrast do not!
    bool bRadioOrChecked = false
    integer id = 0
    if hit then
        object item = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit]
        bool enabled = item[MX_ENABLED] 
        bRadioOrChecked = string(item[MX_IMAGE])
        id = item[MX_ID] -- the potentially keystroke-like menu line identifier
        if enabled and id then
            if bRadioOrChecked and bHover=0 then
                bool checked = item[MX_CHECKED],
                      bRadio = (item[MX_IMAGE]==`??`)
                item = 0 -- (kill refcount)
                if bRadio then
                    if not checked then
                        tg_clear_and_set_radio_group(menu,mdx,hit)
                    end if
                else
                    ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hit][MX_CHECKED] = not checked
                end if
--DEV: erm, later, if not closed?
                tg_menu_redraw(menu, mdx)
            end if
        else
            id = -1 -- (don't call handler)
        end if
    end if
    if id!=-1 then
        integer menu_handler = gGetHandler(menu,`HANDLER`),
                -- don't close radios and checked items by default:
                res = iff(bRadioOrChecked?TG_DEFAULT:TG_CLOSE)
        string sig = tg_get_sig(menu_handler)
        if sig=`FOII` then
            res = menu_handler(menu,id,bHover)
        elsif sig=`POII` then
            menu_handler(menu,id,bHover)
        elsif bHover=0 and hit then
            if sig=`FOI` then
                res = menu_handler(menu,id)
            elsif sig=`POI` then
                menu_handler(menu,id)
            end if
        end if
        -- TG_CLOSE on a radio/check just closes the menu
        if not bHover and bClose and hit then
            if res=TG_CLOSE or not bRadioOrChecked then
                tg_hide_up(menu,mdx)
            end if
            if res=TG_CLOSE and not bRadioOrChecked 
            and ctrl_parent[menu]!=0 then -- barmenu
                gHide(gGetDialog(menu))
            end if
        end if
    end if
end procedure

local procedure tg_menu_mousemove(gdx menu, integer mdx, x, y)
    object cxm = ctrl_xtra[menu][CX_MEXTRA][mdx],
         items = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS]
    integer hit = tg_menu_hit_test(menu,mdx,x,y),
        hot_item = cxm[MX_HOT],
            prev = cxm[MX_SEL],
             kbd = cxm[MX_KEYMODE]
    if hit<0 then ?9/0 end if
    atom hWnd = cxm[MX_POPUP],
       widget = cxm[MX_WIDGET]
    cxm = 0 -- (kill refcount)
    if hot_item and backend=TG_WINAPI then
        set_struct_field(idTRACKMOUSEEVENT,pTRACKMOUSEEVENT,`dwFlags`,TME_LEAVE)
        set_struct_field(idTRACKMOUSEEVENT,pTRACKMOUSEEVENT,`hWndTrack`,hWnd)
        c_funk(xTrackMouseEvent,{pTRACKMOUSEEVENT})
    end if
    if hit then
        sequence item = items[hit]
        integer submenu = item[MX_SUBMENU]
        if submenu=0 then
            tg_hide_submenus(menu,mdx,false)
        elsif hit!=prev and not kbd then
            if prev then
                tg_hide_submenus(menu,mdx,false)
            end if
            bool enabled = item[MX_ENABLED]
            if length(ctrl_xtra[menu][CX_MENUS][submenu][MX_ITEMS])=0 then
                enabled = false
            end if
            if enabled then
                tg_open_child_menu(menu,submenu,mdx,hit)
            end if
        end if
    elsif tg_menu_hit_test(menu,mdx,x,y,true) then
        -- (hit=0 but ""!=0 ==> hovering on a disabled item):
        tg_hide_submenus(menu,mdx,false)
    end if
    -- cancel MX_KEYMODE (only) when **ON** a different item,
    -- else/not "", update on any change (inc on/off/in/out).
    bool bRedraw = (hit or not kbd) and hit!=hot_item
    if bRedraw then
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] = false
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_SEL] = hit
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = hit
        tg_menu_redraw(menu,mdx)
        items = NULL -- (kill refcount)
        tg_call_menu_handler(menu,mdx,hit,true,false)
    end if
end procedure

local function tg_GTK_menu_mousemove(atom widget, atom event, integer mdx)
    integer menu = tg_find_menu(widget,MX_WIDGET,mdx),
           {x,y} = get_struct_fields(idGdkEventMotion,event,{`x`,`y`})
    tg_menu_mousemove(menu,mdx,x,y)
    return true
end function

local procedure tg_menu_leftclick(gdx menu, integer mdx)
    integer hot_item = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT]
    if hot_item>0 then
        object item = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][hot_item]
        if item[MX_ENABLED] and item[MX_SUBMENU]=0 then
            item = NULL -- (kill refcount)
            tg_call_menu_handler(menu,mdx,hot_item,false,true)
        end if
    end if
end procedure

local function tg_GTK_menu_click(atom widget, atom event, integer mdx)
    integer button = get_struct_field(idGdkEventButton,event,`button`)
    if button=1 then -- left
        integer menu = tg_find_menu(widget,MX_WIDGET,mdx)
        tg_menu_leftclick(menu,mdx)
    end if
    return true
end function

procedure tg_menu_leave(gdx menu, integer mdx)
    if not ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] then
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = 0
        tg_menu_redraw(menu,mdx)
        tg_call_menu_handler(menu,mdx,0,true,false)
    end if
end procedure

local function tg_GTK_menu_leave(atom widget, atom event, integer mdx)
    integer menu = tg_find_menu(widget,MX_WIDGET,mdx)
    tg_menu_leave(menu,mdx)
    return true
end function

local function tg_next_enabled(gdx menu, sequence items, integer i, d)
    integer l = length(items)
    for k=1 to l do -- (max once round/check nowt twice)
        i += d
        if i<1 then
            i = l
        elsif i>l then
            i = 1
        end if
        bool enabled = items[i][MX_ENABLED]
        integer submenu = items[i][MX_SUBMENU]
        if submenu and length(ctrl_xtra[menu][CX_MENUS][submenu][MX_ITEMS])=0 then
            enabled = false
        end if
        if enabled then
            return i
        end if
    end for
    return 0
end function

function tg_process_menu_keydown(gdx menu, integer mdx, key)
    -- invoked from main_key() rather than menu_key() (GTK)
    -- invoked from WndProc rather than PopMenuWndProc (WinAPI)
    object cxm = ctrl_xtra[menu],
         mxtra = cxm[CX_MEXTRA][mdx]
    sequence items = cxm[CX_MENUS][mdx][MX_ITEMS]
    integer sel_item = mxtra[MX_SEL],
            parent = cxm[CX_MENUS][mdx][MX_PARENT]
    atom hWnd = mxtra[MX_POPUP],
        hMenu = mxtra[MX_WIDGET]
    cxm = 0 -- (kill refcount)
    mxtra = 0 -- (kill refcount)
    if key=VK_UP
    or key=VK_DOWN then
        integer d = iff(key=VK_UP?-1:+1)
        sel_item = tg_next_enabled(menu,items,sel_item,d)
        if sel_item<0 then ?9/0 end if
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_SEL] = sel_item
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = sel_item
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] = true
        tg_menu_redraw(menu,mdx)
        tg_call_menu_handler(menu,mdx,sel_item,true,false)

    elsif key=VK_CR
      and sel_item>0
      and items[sel_item][MX_SUBMENU]=0 then
        tg_call_menu_handler(menu,mdx,sel_item,false,true)
--      return true -- GTK?

    elsif key=VK_RIGHT
       or key=VK_CR then
        if sel_item>0 then
            bool enabled = items[sel_item][MX_ENABLED]
            integer submenu = items[sel_item][MX_SUBMENU]
            if submenu and length(ctrl_xtra[menu][CX_MENUS][submenu][MX_ITEMS])=0 then
                enabled = false
            end if
            if submenu and enabled then
                ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] = true
                ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = 0
                tg_menu_redraw(menu,mdx)
                tg_open_child_menu(menu,submenu,mdx,sel_item)
                -- auto-select top item:
                items = ctrl_xtra[menu][CX_MENUS][submenu][MX_ITEMS]
                integer first = tg_next_enabled(menu,items, 0, +1)
                ctrl_xtra[menu][CX_MEXTRA][submenu][MX_KEYMODE] = true
                ctrl_xtra[menu][CX_MEXTRA][submenu][MX_SEL] = first
                ctrl_xtra[menu][CX_MEXTRA][submenu][MX_HOT] = first
                tg_call_menu_handler(menu,submenu,first,true,false)
            end if
        end if

    elsif key=VK_LEFT then
        if parent>0 then
            tg_hide_one_menu(menu,mdx,false)
            integer psel = ctrl_xtra[menu][CX_MEXTRA][parent][MX_SEL]
            ctrl_xtra[menu][CX_MEXTRA][parent][MX_HOT] = psel
            ctrl_xtra[menu][CX_MEXTRA][parent][MX_KEYMODE] = true
            tg_menu_redraw(menu,parent)
            tg_call_menu_handler(menu,parent,psel,true,false)
        end if

    end if
    return 0
end function

