global function gQuit()
    -- standard Close/Quit button shorthand
    return TG_CLOSE
end function

function tg_set_dialog_attribute(gdx id, string name, object v, integer nFrames)
    atom handle = ctrl_handles[id]
    if name=`DEFAULTENTER`
    or name=`DEFAULTESC` then
        if v=gQuit then v=TG_CLOSE end if
        bool bOK = v=NULL or v=TG_CLOSE or v=TG_IGNORE or 
                    (gdx(v) and ctrl_types[v]=BUTTON)
        assert(bOK,"bad "&name,nFrames:=nFrames+2)
        integer dx = iff(name=`DEFAULTENTER`?DX_DEF_ENTER:DX_DEF_ESCAPE)
        ctrl_xtra[id][dx] = v
    elsif name=`MODAL` then
        v = tg_to_bool(v,nFrames+2)
        tg_set_ctrl_flag(id,CF_MODAL,v)
    elsif name=`FULLSCREEN` then
        v = tg_to_bool(v,nFrames+2)
        if handle=NULL then
            tg_defer_attr(id,name,v)
        else
            bool bFullScreen = v,
                 bWasMaximised = ctrl_xtra[id][DX_WAS_MAXIMISED]
            ctrl_xtra[id][DX_FULLSCREEN] = bFullScreen
            if backend=TG_GTK then
                if bFullScreen then
                    c_proc(x_gtk_window_fullscreen,{handle})
                else
                    c_proc(x_gtk_window_unfullscreen,{handle})
                end if
            elsif backend=TG_WINAPI then
                atom wstyle = c_func(xGetWindowLong,{handle,GWL_STYLE})
                if pWINDOWPLACEMENT=NULL then
                    pWINDOWPLACEMENT = allocate_struct(idWINDOWPLACEMENT,false)
                    integer wplen = get_struct_size(idWINDOWPLACEMENT)
                    set_struct_field(idWINDOWPLACEMENT,pWINDOWPLACEMENT,`length`,wplen)
                end if
                if bFullScreen then
                    wstyle -= and_bits(wstyle,WS_CAPTION) -- remove titlebar
                    bWasMaximised = not c_func(xIsZoomed, {handle})
                    ctrl_xtra[id][DX_WAS_MAXIMISED] = bWasMaximised
                    if bWasMaximised then
                        {} = c_func(xGetWindowPlacement,{handle,pWINDOWPLACEMENT})
                        set_struct_field(idWINDOWPLACEMENT,pWINDOWPLACEMENT,`showCmd`,SW_MAXIMIZE)
                        {} = c_func(xSetWindowPlacement,{handle,pWINDOWPLACEMENT})
                    end if
                else
                    wstyle = or_bits(wstyle,WS_CAPTION) -- replace titlebar
                    if bWasMaximised then
                        set_struct_field(idWINDOWPLACEMENT,pWINDOWPLACEMENT,`showCmd`,SW_RESTORE)
                        ctrl_xtra[id][DX_FULLSCREEN] = -1          -- suppress resizing[?] ...
                        {} = c_func(xSetWindowPlacement,{handle,pWINDOWPLACEMENT})
                        ctrl_xtra[id][DX_FULLSCREEN] = bFullScreen -- ... until SetWindowLong
                    end if
                end if
                -- apply style mod and force full rebuild/redisplay:
                --  (SWP_UPDATECACHE includes NOSIZE+NOMOVE+3more)
                {} = c_func(xSetWindowLong,{handle,GWL_STYLE,wstyle})
                {} = c_func(xSetWindowPos, {handle, 0, 0, 0, 0, 0, SWP_UPDATECACHE})
--              {} = g_func(xSetWindowPos, {handle, 0, 0, 0, 0, 0, SWP_UPDATECACHE},source_line())

                -- rebuild the windows taskbar as it will most likely have been mangled:
--              atom taskbar = c_func(xFindWindow, {`Shell_TrayWnd`, NULL})
                atom taskbar = c_func(xFindWindow,{Shell_TrayWnd,NULL})
                {} = c_func(xSetWindowPos, {taskbar, 0, 0, 0, 0, 0, SWP_UPDATECACHE+SWP_NOACTIVATE})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_set_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    elsif name=`MAXIMISED` 
       or name=`MAXIMIZED`
       or name=`MINIMISED` 
       or name=`MINIMIZED` then
        v = tg_to_bool(v,nFrames+2)
        if handle=NULL then
            tg_defer_attr(id,name,v)
        else
            if backend=TG_GTK then
                if name[2]='A' then -- MAXIMI(S|Z)ED
                    if v then
                        c_proc(x_gtk_window_maximize,{handle})
                    else
                        c_proc(x_gtk_window_unmaximize,{handle})
                    end if
                else                -- MINIMI(S|Z)ED
                    if v then
                        c_proc(x_gtk_window_iconify,{handle})
                    else
                        c_proc(x_gtk_window_deiconify,{handle})
                    end if
                end if
            elsif backend=TG_WINAPI then
                {} = c_func(xGetWindowPlacement,{handle,pWINDOWPLACEMENT})
                integer flag = iff(v?iff(name[2]='A'?SW_MAXIMIZE
                                                    :SW_MINIMIZE)
                                    :SW_RESTORE)
                set_struct_field(idWINDOWPLACEMENT,pWINDOWPLACEMENT,`showCmd`,flag)
                {} = c_func(xSetWindowPlacement,{handle,pWINDOWPLACEMENT})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_set_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    elsif name=`HDR` 
       or name=`MNZ` 
       or name=`RST`
       or name=`CLX` then
        integer fdx = find(name[1],`HMRC`)
        v = tg_to_bool(v,nFrames+2)
        if handle=NULL then
            tg_defer_attr(id,name,v)
        else
            if backend=TG_GTK then
--gdk_window_get_type_hint()
--gdk_window_set_type_hint()
--gtk_window_set_type_hint()
                switch fdx do
                    case 1: c_proc(x_gtk_window_set_decorated,{handle,v}) -- HDR
--                  case 2: -- (MNZ ignored on GTK)
                    case 3: c_proc(x_gtk_window_set_resizable,{handle,v}) -- RST
                    case 4: c_proc(x_gtk_window_set_deletable,{handle,v}) -- CLX [greys out the X]
                end switch
            elsif backend=TG_WINAPI then
                integer flag = {WS_BORDER,WS_MINIMIZEBOX,WS_MAXIMIZEBOX,WS_SYSMENU}[fdx]
                atom dwStyle = c_func(xGetWindowLong,{handle,GWL_STYLE})
                    dwStyle -= and_bits(dwStyle,flag)
                if v then dwStyle += flag end if
                {} = c_func(xSetWindowLong,{handle,GWL_STYLE,dwStyle})
                {} = c_func(xSetWindowPos,{handle,0,0,0,0,0,SWP_UPDATECACHE})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_set_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
--DEV DX_NOTITLE? (should that be CX_HDR anyway?)
    elsif name=`CLOSE_ON_ESCAPE` then
        v = tg_to_bool(v,nFrames+2)
        tg_set_ctrl_flag(id, CF_CLOSE_ON_ESC, v)
--  elsif name=`MPV_DROP` then -- (see libmvp)
--      assert(ctrl_xtra[id][DX_MPV_AREA]!=NULL)
--      ctrl_xtra[id][DX_MPV_DROP] = v
    else
        return false
    end if
    return true
end function

function tg_get_dialog_attribute(gdx id, string name, integer nFrames)
    object dflt
    atom handle = ctrl_handles[id]
    integer flags = ctrl_flags[id]
    if name=`RESIZE` then
        return and_bits(flags,CF_RESIZE)!=0
    elsif name=`MODAL` then
        return and_bits(flags,CF_MODAL)!=0
    elsif name=`DEFAULTENTER`
       or name=`DEFAULTESC` then
        integer dx = iff(name=`DEFAULTENTER`?DX_DEF_ENTER:DX_DEF_ESCAPE)
        return ctrl_xtra[id][dx]
    elsif name=`FULLSCREEN` then
        if handle!=NULL then
            return ctrl_xtra[id][DX_FULLSCREEN]
        end if
        dflt = false
    elsif name=`MINIMISED`
       or name=`MINIMIZED` then
        if handle=NULL then
            dflt = false
        else
            if backend=TG_GTK then
                integer state = ctrl_xtra[id][DX_GTK_STATE]
                return and_bits(state,GDK_WINDOW_STATE_ICONIFIED)!=0
            elsif backend=TG_WINAPI then
                return c_func(xIsIconic, {handle})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_get_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    elsif name=`MAXIMISED`
       or name=`MAXIMIZED` then
        if handle=NULL then
            dflt = false
        else
            if backend=TG_GTK then
                integer state = ctrl_xtra[id][DX_GTK_STATE]
                return and_bits(state,GDK_WINDOW_STATE_MAXIMIZED)!=0
            elsif backend=TG_WINAPI then
                return c_func(xIsZoomed, {handle})
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_get_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    elsif name=`CLOSE_ON_ESCAPE` then
        return and_bits(CF_CLOSE_ON_ESC,flags)!=0
    elsif name=`HDR` 
       or name=`MNZ` 
       or name=`RST`
       or name=`CLX` then
        integer fdx = find(name[1],`HMRC`)
        if handle=NULL then
            dflt = true
        else
            if backend=TG_GTK then
                switch fdx do
                    case 1: return c_func(x_gtk_window_get_decorated,{handle}) -- HDR
                    case 2: return true                   -- (inoperative on GDX) MNZ
                    case 3: return c_func(x_gtk_window_get_resizable,{handle}) -- RST
                    case 4: return c_func(x_gtk_window_get_deletable,{handle}) -- CLX
                end switch
            elsif backend=TG_WINAPI then
                integer flag = {WS_BORDER,WS_MINIMIZEBOX,WS_MAXIMIZEBOX,WS_SYSMENU}[fdx]
                atom dwStyle = c_func(xGetWindowLong,{handle,GWL_STYLE})
                return and_bits(dwStyle,flag)!=0
            elsif backend=TG_JS then
                #ilJS{
                    crash(`JS (tg_get_dialog_attribute %s)`,{name});
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if
    elsif name=`HWND` then
        -- undocumented, used by gtk_file_open.exw and win_file_open.exw
        return handle
    end if
    sequence did = deferred_attr[id]
    for k=length(did) to 1 by -1 do
        if did[k][1]=name then
            return did[k][2]
        end if
    end for
    if not object(dflt) then -- (if unassigned)
        tg_bad_attr(id,name,nFrames+1)
    end if
    return dflt
end function

global function gDialog(gdx child, object parent=NULL, title=``, attributes=``, args={}, bool bEsc=true)
    {parent,title,attributes,args,bEsc} = paranormalise_ptaab(parent,title,attributes,args,bEsc)
    if not bInit then tg_Init() end if
    assert(parent=NULL or ctrl_types[parent]=DIALOG)
    assert(child=NULL or ctrl_types[child]!=DIALOG)
    integer flags = iff(bEsc?CF_CLOSE_ON_ESC:0)+CF_RESIZE+CF_CONTAINER+CF_MODAL+CF_INVISIBLE,
               id = tg_add_control(DIALOG,flags)
    ctrl_parent[id] = parent
    if child then
        ctrl_parent[child] = id
        children_ids[id] = {child}
    else
        children_ids[id] = {}
    end if
    tg_register_handler(DIALOG,`CLOSE`,{`FO`,`F`,`PO`,`P`})
    tg_register_handler(DIALOG,`DROP`,{`POS`,`PS`})
--  tg_register_handler(DIALOG,`RESIZE`,{{3,3,`FOII`}})
    ctrl_set_attr[DIALOG] = tg_set_dialog_attribute
    ctrl_get_attr[DIALOG] = tg_get_dialog_attribute

    object cxi = repeat(0,DX_DLG_LEN)
    cxi[DX_LAST_FOCUS] = UNDEFINED
    ctrl_xtra[id] = cxi
    atom bgclr = iff(backend=TG_GTK?iff(bGTK3?#E8E8E7:#DCDAD5)
                :iff(backend=TG_WINAPI?#F0F0F0:9/0))                
    ctrl_bg[id] = bgclr
    gSetAttribute(id,`TITLE`,title)
    if length(attributes) then
        gSetAttributes(id,attributes,args,nFrames:=2)
    end if
    return id
end function

function tg_set_box_attribute(gdx id, string name, object v, integer nFrames)
    integer cfi = ctrl_flags[id]

    if name=`GAP` then
        if string(v) then v = to_number(v) end if
        bool bSplit = and_bits(cfi,CF_SPLIT)!=0
        assert(not bSplit,`no GAP on splitters!`,nFrames:=nFrames+2)
        assert(integer(v) and v>=0,"GAP must be >=0",nFrames:=nFrames+2)
        ctrl_xtra[id][CX_BOX_GAP] = v

    elsif name=`NORMALISE`
       or name=`NORMALIZE` then
        if and_bits(cfi,CF_CONCRETE) then return false end if -- (not gCbox...)
        -- (feel free to rescind the above if/when it becomes helpful to do so)
        gNormalize(children_ids[id],v)

    elsif name=`SPACE` then
        assert(and_bits(cfi,CF_SPLIT)==0,`no SPACE on splitters!`,nFrames:=nFrames+2)
        if string(v) then
            if v[1]='{' then
                assert(v[$]='}')
                v = v[2..-2]
            end if
            if find(',',v) then
                v = split(v,',')
            else
                v = {v,v}
            end if
        elsif integer(v) then
            v = {v,v}
        elsif length(v)=1 then
            v = append(v,v[1])
        end if
        assert(length(v)=2)
        for i=CX_BOX_SPACE_H to CX_BOX_SPACE_V do
            object vi = v[i-(CX_BOX_SPACE_H-1)]
            if string(vi) then
                integer k = find(vi,box_spacing_descs)
                assert(k!=0,`gSetAttribute(BOX,"SPACE","%s")`,{vi},nFrames:=nFrames+2)
                vi = box_spacing_masks[k]
            end if              
            assert(integer(vi) and vi>=0b000 and vi<=0b1001)
            ctrl_xtra[id][i] = vi
        end for

    elsif name=`SPLIT` then -- (private/undocumented, for hSplit.exw only)
        assert(v=`AYE`)
        assert(and_bits(cfi,CF_SPLIT)=0)
        cfi += CF_SPLIT
        ctrl_flags[id] = cfi
    else
        return false
    end if
    return true
end function

function tg_get_box_attribute(gdx id, string name, integer nFrames)
    integer cfi = ctrl_flags[id]
    if name=`SPACE` then -- see also gGetInt()
        integer h = ctrl_xtra[id][CX_BOX_SPACE_H],
                v = ctrl_xtra[id][CX_BOX_SPACE_V]
        string res = tg_get_box_spacing_name(iff(h==v?h:{h,v}))
        return res
    elsif name=`ORIENTATION` then
        return iff(and_bits(cfi,CF_VERTICAL)?`VERTICAL`:`HORIZONTAL`)
    end if
    tg_bad_attr(id,name,nFrames+1)
end function

local function gBox(integer hvc, gdx children, object title=NULL, sequence attributes="", args={}, integer nFrames=1)
    if not sequence(children) and children!=NULL then children = {children} end if
    {title,attributes,args} = paranormalise_taa(title,attributes,args)
    if not bInit then tg_Init() end if
    integer flags = CF_CONTAINER+CF_EXPANDB+{0,CF_VERTICAL,CF_CONCRETE}[find(hvc,`HVC`)],
               id = tg_add_control(BOX,flags)
    ctrl_set_attr[BOX] = tg_set_box_attribute
    ctrl_get_attr[BOX] = tg_get_box_attribute
    if hvc!='C' then
        ctrl_xtra[id] = {0,                 -- CX_BOX_GAP,
                         TG_SPACE_NONE, -- CX_BOX_SPACE_H,
                         TG_SPACE_NONE} -- CX_BOX_SPACE_V
    end if
    children_ids[id] = children
    for child in children do
        ctrl_parent[child] = id
    end for
    ctrl_bg[id] = -1 -- (inherit)
    ctrl_titles[id] = title
    if length(attributes) then
        gSetAttributes(id,attributes,args,nFrames+1)
    end if
    return id
end function 

global function gHbox(gdx children={}, object title=NULL, sequence attributes=``, args={})
    return gBox('H',children,title,attributes,args,nFrames:=2)
end function

global function gVbox(gdx children={}, object title=NULL, sequence attributes=``, args={})
    return gBox('V',children,title,attributes,args,nFrames:=2)
end function

global function gCbox(gdx children={}, object title=NULL, sequence attributes=``, args={})
    return gBox('C',children,title,attributes,args,nFrames:=2)
end function

