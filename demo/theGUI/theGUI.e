local procedure tg_table_set_top_line(gdx table, integer top_line=-1, col=-1)
    integer line_height = ctrl_xtra[table][CXTBL_LINEHT],
          {ox,oy,vw,vh} = gGetAttribute(table,`VIEWPORT`)
    if line_height=0 then line_height = 24 end if
    if top_line!=-1 then
        oy = (top_line-1)*line_height
        -- NB next line is ineffective, while we could just as well let redraw set it, 
        --    someone somewhere sometime would no doubt moan if fetch!=the recent set,
        --   plus this way I don't need another ugly explanation in the documentation.
        -- In other words, this allows you to refer to/return TOPLINE from anywhere,
        --  but it's actually the above line that is in charge of where things are.
        ctrl_xtra[table][CXTBL_TOPLINE] = top_line
    end if
    if col!=-1 then
        sequence actcols = ctrl_xtra[table][CXTBL_ACTCOLS]
        object coldrag = ctrl_xtra[table][CXTBL_COLDRAG]
        integer {x,w} = tg_table_sum_to_col(col, actcols, coldrag),
                   xw = x+w
        if x<ox then ox := x
        elsif xw-ox>vw then ox = max(xw-vw,0) end if
    end if
    gSetAttribute(table,`VIEWPORT`,{ox,oy})
    gRedraw(table)
end procedure

local procedure tg_table_ensure_visible(gdx table, integer line, col=-1)
    integer lpp = ctrl_xtra[table][CXTBL_LINESPP],
       top_line = ctrl_xtra[table][CXTBL_TOPLINE]
    top_line = min(top_line,line)
    top_line = max(top_line,line-lpp)
    tg_table_set_top_line(table,top_line,col)
    ctrl_xtra[table][CXTBL_CURSORY] = line -- (an SDX)
    ctrl_xtra[table][CXTBL_CURSORX] = col
end procedure

local procedure tg_table_ensure_line_visible(gdx table, integer line, bool bRDX=false)
    -- line should be sdx aka display index, or rdx aka data index with bRDX=true.
    if bRDX then
        object itag = ctrl_xtra[table][CXTBL_INVTAG]
        if sequence(itag) then line = itag[line] end if -- (RDX -> SDX)
    end if
    integer lpp = ctrl_xtra[table][CXTBL_LINESPP],
       top_line = ctrl_xtra[table][CXTBL_TOPLINE]
    top_line = min(top_line,line)
    top_line = max(top_line,line-lpp+1)
    tg_table_set_top_line(table,top_line)
    ctrl_xtra[table][CXTBL_CURSORY] = line -- (an SDX)
end procedure

local procedure tg_table_ensure_col_visible(gdx table, integer col, bool bCDX=false)
    -- col should be ddx aka display index, or cdx aka columns index with bCDX=true.
    integer {ox,oy,vw,vh} = gGetAttribute(table,`VIEWPORT`)
    sequence actcols = ctrl_xtra[table][CXTBL_ACTCOLS]
    object coldrag = ctrl_xtra[table][CXTBL_COLDRAG]
    if bCDX then
        if sequence(coldrag) then col = coldrag[col] end if
    end if
    integer {x,w} = tg_table_sum_to_col(col, actcols, coldrag),
               xw = x+w
    if x<ox then ox := x
    elsif xw-ox>vw then ox = max(xw-vw,0) end if
    gSetAttribute(table,`VIEWPORT`,{ox,oy})
    ctrl_xtra[table][CXTBL_CURSORX] = col -- a DDX
end procedure

local function tg_table_column_sort(integer i, integer j, sequence data, cols)
    integer c, ac
    for col in cols do
        c = sign(col)
        ac = abs(col)
        c *= compare(data[i][ac],data[j][ac])
        if c!=0 then exit end if
    end for
    if c=0 then c = compare(i,j) end if
    return c
end function

local procedure tg_table_set_tagsets(gdx table, object colset)
    object tags = 0, itag = 0
    if sequence(colset) then
        object data = ctrl_xtra[table][CXTBL_DATA][1]
        integer len_d = iff(integer(data)?data(0):length(data))
        if integer(data) then
            sequence r = repeat(0,len_d)
            for i=1 to len_d do r[i] = data(i) end for
            data = r
        end if
        tags = custom_sort(tg_table_column_sort,tagset(len_d),{data,colset})
        itag = repeat(0,len_d)
        for i,t in tags do
            itag[t] = i
        end for
    end if
    ctrl_xtra[table][CXTBL_TAGSET] = tags
    ctrl_xtra[table][CXTBL_INVTAG] = itag
    ctrl_xtra[table][CXTBL_SORTCOLS] = colset
end procedure

local procedure tg_table_set_selection(gdx table, integer line, col, bool ctrl, shift)
    object tbl_attr = ctrl_xtra[table],
               tags = tbl_attr[CXTBL_TAGSET],
               itag = tbl_attr[CXTBL_INVTAG],
            coldrag = tbl_attr[CXTBL_COLDRAG],
                sel
    integer selmode = tbl_attr[CXTBL_SELMODE],
             n_rows = tbl_attr[CXTBL_N_ROWS],
            wasline = line
    tbl_attr = 0
    if sequence(tags) then line = tags[line] end if
    if selmode=1 then -- cell
        if col and sequence(coldrag) then col = coldrag[col] end if
        sel = {line,col}
    elsif selmode=0 then -- line
        sel = line
    elsif selmode=-1 then -- multi
        sel = ctrl_xtra[table][CXTBL_SELECTED]
        ctrl_xtra[table][CXTBL_SELECTED] = 0 -- (kill refcount)
        if shift then
            integer lstart = max(ctrl_xtra[table][CXTBL_SSTART],1)
            if sequence(tags) then lstart = itag[lstart] end if
            if lstart>wasline then {wasline,lstart} = {lstart,wasline} end if
            if atom(sel) or not ctrl then
                sel = repeat(0,n_rows)
            end if
            for i=lstart to wasline do
                sel[iff(sequence(tags)?tags[i]:i)] = true
            end for
        else
            if ctrl then
                if atom(sel) then
                    integer psel = sel
                    sel = repeat(0,n_rows)
                    if psel then sel[psel] = true end if
                end if
                sel[line] = not sel[line]
            else
                sel = line
            end if
            ctrl_xtra[table][CXTBL_SSTART] = line
        end if
    else
        ?9/0 -- unknown selmode...
    end if
    ctrl_xtra[table][CXTBL_SELECTED] = sel
    integer selected = gGetHandler(table,`SELECTED`)
    if selected then
        string sig = tg_get_sig(selected)
        if sig=`POI` then
            selected(table,line)
        elsif sig=`PI` then
            selected(line)
        elsif sig=`POII` then
            assert(selmode=1,"SELMODE must be CELL")
            selected(table,line,col)
        elsif sig=`PII` then
            assert(selmode=1,"SELMODE must be CELL")
            selected(line,col)
        elsif sig=`POO` then
            selected(table,sel)
        elsif sig=`PO` then
            selected(sel)
        else
            ?9/0
        end if
    end if
end procedure

local procedure tg_table_click(gdx table, sequence status, integer x, y) 
    if gGetAttribute(table,`ACTIVE`) then
        object tbl_attr = ctrl_xtra[table],
                   tags = tbl_attr[CXTBL_TAGSET],
                coldrag = tbl_attr[CXTBL_COLDRAG],
                   cols = tbl_attr[CXTBL_COLSORT],
                 colset = tbl_attr[CXTBL_SORTCOLS]
        object data = tbl_attr[CXTBL_DATA][1]
        integer col = tbl_attr[CXTBL_HOVCOL],       -- ddx
               line = tbl_attr[CXTBL_HOVLINE],
            selmode = tbl_attr[CXTBL_SELMODE],
         resize_hov = tbl_attr[CXTBL_RESIZEHOV], -- (don't colsort or select when non-zero)
        resize_sink = tbl_attr[CXTBL_RESIZESINK], -- a ddx
         drag_title = tbl_attr[CXTBL_DRAGTITLE], -- (ditto)
             n_rows = iff(integer(data)?data(0):length(data))
        tbl_attr = 0 -- (kill refcount)
        if status[1]='L' then
            if status[2]='S' and col and resize_hov=0 and drag_title=0 then
                if line=0 then
                    bool ctrl = status[3],
                        shift = status[4]
                    if ctrl then -- resize sink
                        tg_table_transfer_actcols_to_columns(table)
                        if shift then
                            -- reveal/hide any "lost" columns with widths <= 5:
                            sequence columns = ctrl_xtra[table][CXTBL_COLUMNS]
                            ctrl_xtra[table][CXTBL_COLUMNS] = 0
                            integer coldx = iff(sequence(coldrag)?coldrag[col]:col),
                                       cw = columns[coldx][2]
                            for i,c in columns do -- (each c being {title,width,align})
                                c = c[2]          --                      ^
                                if i!=coldx then  -- (not the resize sink itself!)
                                    if    c=5           then cw += 5    c = 0
                                    elsif c<5 and cw>10 then cw -= 5-c  c = 5 end if
                                    columns[i][2] = c
                                end if
                            end for
                            columns[coldx][2] = cw
                            ctrl_xtra[table][CXTBL_COLUMNS] = columns
                        end if
                        -- toggle, or just replace if/when moved:
                        if col=resize_sink then col = 0 end if
                        ctrl_xtra[table][CXTBL_RESIZESINK] = col        -- THAT'S A DDX
                    elsif shift and line=0 and col then
                        gSetAttribute(table,`CURSOR`,`SIZE_ALL`)
                        ctrl_xtra[table][CXTBL_DRAGTITLE] = col
                    else
                        ctrl_xtra[table][CXTBL_RESIZESINK] = 0
                        -- column sort
                        if col and sequence(coldrag) then col = coldrag[col] end if
                        if cols=true -- (ignore sort attempts when false)
                        or (sequence(cols) and cols[col]) then
                            if atom(colset) then
                                colset = {col}
                            else
                                ctrl_xtra[table][CXTBL_SORTCOLS] = NULL
                                if col=colset[1] then
                                    colset[1] = -col
                                elsif col=-colset[1] then
                                    if length(colset)=1 then
                                        colset = true
                                    else
                                        colset = colset[2..$]
                                    end if
                                else
                                    integer k = find(col,sq_abs(colset))
                                    -- (implicitly k!=1 here, and when k!=0
                                    --  then "" length(cols)>1 as well, btw)
                                    if k then colset[k..k] = {} end if
                                    colset = prepend(colset,col)
                                end if
                            end if
                            tg_table_set_tagsets(table,colset)
                            object sel = ctrl_xtra[table][CXTBL_SELECTED]
                            if selmode=1 and sequence(sel) then -- cell: {line,col}
                                sel = sel[1]
                            end if
                            if atom(sel) and sel!=NULL then
                                tg_table_ensure_line_visible(table, sel, true)
                            end if
                            ctrl_xtra[table][CXTBL_SSTART] = 0
                        end if
                    end if
                else
                    integer ctrl = status[3],
                           shift = status[4]
                    tg_table_set_selection(table,line,col,ctrl,shift)
                end if
                gRedraw(table)
            elsif status[2]='R' then
                if not resize_hov then
                    gSetAttribute(table,`CURSOR`,NULL)
                end if
                ctrl_xtra[table][CXTBL_DRAGTITLE] = 0
            end if
        end if -- [1]='L'
        if line!=0 and line<=n_rows and col!=0 then
            integer tabclick = gGetHandler(table,`TABCLICK`)
            if tabclick then
                if sequence(tags) then line = tags[line] end if
                if sequence(coldrag) then col = coldrag[col] end if
                tabclick(table,status,line,col)
            end if
        end if
    end if -- active
end procedure

local function tg_table_key(gdx table, integer c, bool ctrl, shift, alt, up)
    if gGetAttribute(table,`ACTIVE`) then
        if not (alt or up) then
            object tbl_attr = ctrl_xtra[table],
                   selected = tbl_attr[CXTBL_SELECTED],
                    coldrag = tbl_attr[CXTBL_COLDRAG],
                       itag = tbl_attr[CXTBL_INVTAG],
                       tags = tbl_attr[CXTBL_TAGSET]
            integer selmode = tbl_attr[CXTBL_SELMODE],
                     n_cols = length(tbl_attr[CXTBL_COLUMNS]),
                       line = tbl_attr[CXTBL_CURSORY],
                        col = tbl_attr[CXTBL_CURSORX],
                   top_line = tbl_attr[CXTBL_TOPLINE], // shd be SDX
                     n_rows = tbl_attr[CXTBL_N_ROWS], -- aka length(data)
                        lpp = tbl_attr[CXTBL_LINESPP]
            tbl_attr = 0 -- kill refcount
            if ctrl then
                if upper(c)='A' then
                    if selmode=-1 then -- multiple
                        selected = repeat(true,n_rows)
                        ctrl_xtra[table][CXTBL_SELECTED] = selected
                        gRedraw(table)
                    end if
                end if
            elsif c=VK_LEFT
               or c=VK_RIGHT then
                if selmode=1 then -- cell
                    if sequence(selected) then
                        {line,col} = selected
                        if sequence(coldrag) then
                            for i,ci in coldrag do
                                if ci=col then
                                    if c=VK_LEFT and i>1 then
                                        col = coldrag[i-1]
                                    elsif c=VK_RIGHT and i<n_cols then
                                        col = coldrag[i+1]
                                    end if
                                    exit
                                end if
                            end for
                        else
                            if c=VK_LEFT and col>1 then
                                col -= 1
                            elsif c=VK_RIGHT and col<n_cols then
                                col += 1
                            end if
                        end if
                    else
                        line = iff(sequence(tags)?tags[1]:1)
                        col = iff(sequence(coldrag)?coldrag[1]:1)
                    end if          
                    ctrl_xtra[table][CXTBL_SELECTED] = {line,col}
                    tg_table_ensure_visible(table,line,col) -- (primarily widthwise here)
                    gRedraw(table)
                end if
            else
                switch c do
                    case VK_UP:     line = max(line-1,1)            top_line = min(top_line,line)
                    case VK_DOWN:   line = min(line+1,n_rows)       top_line = max(top_line,line-lpp+1)
                    case VK_PGUP:   line = max(line-lpp,1)          top_line = max(top_line-lpp,1)
                    case VK_PGDN:   line = min(line+lpp,n_rows)     top_line = min(top_line+lpp,n_rows)
                    case VK_HOME:   line = 1                        top_line = 1
                    case VK_END:    line = n_rows                   top_line = max(top_line,line-lpp+1)
                    default:        line = 0
--                  default: c = 0
                end switch
--              if c then
                if line then
                    tg_table_set_top_line(table,top_line)
                    ctrl_xtra[table][CXTBL_CURSORY] = line -- (an SDX)
                    tg_table_set_selection(table,line,col,false,shift)
                end if
            end if
        end if
        integer tabkey = gGetHandler(table,`TABKEY`)
        if tabkey then
            string sig = tg_get_sig(tabkey)
            if sig=`POI` then
                if not (ctrl or shift or alt or up) then
                    tabkey(table,c)
                end if
            elsif sig=`POII` then
                if not (shift or alt or up) then
                    tabkey(table,c,ctrl)
                end if
            elsif sig=`POIII` then
                if not (alt or up) then
                    tabkey(table,c,ctrl,shift)
                end if
            elsif sig=`POIIII` then
                if not up then
                    tabkey(table,c,ctrl,shift,alt)
                end if
            elsif sig=`POIIIII` then
                tabkey(table,c,ctrl,shift,alt,up)
            else
                ?9/0
            end if
        end if
    end if
    return TG_CONTINUE
end function

local function tg_set_table_attribute(gdx table, string name, object v, integer nFrames)
    if name=`COLUMNS` then
        sequence columns = deep_copy(v)
        -- trash drag/sort/resize_sink when to not would inevitably crash:
        integer lc = length(columns),
            resize_sink = ctrl_xtra[table][CXTBL_RESIZESINK]
        object col_drag = ctrl_xtra[table][CXTBL_COLDRAG],
               col_sort = ctrl_xtra[table][CXTBL_COLSORT],
                col_set = ctrl_xtra[table][CXTBL_SORTCOLS]
        if sequence(col_drag) and length(col_drag)!=lc then
            ctrl_xtra[table][CXTBL_COLDRAG] = true
        end if
        if sequence(col_sort) and length(col_sort)!=lc then
            ctrl_xtra[table][CXTBL_COLSORT] = true
            ctrl_xtra[table][CXTBL_SORTCOLS] = NULL
        elsif col_sort=true and iff(sequence(col_set)?max(col_set):col_set)>lc then
            ctrl_xtra[table][CXTBL_SORTCOLS] = NULL
        end if
        if resize_sink>lc then
            ctrl_xtra[table][CXTBL_RESIZESINK] = 0
        end if
        for i,c in columns do
            if string(c) then
                columns[i] = {c,80}
            end if
        end for
        ctrl_xtra[table][CXTBL_COLUMNS] = columns

    elsif name=`COL_DRAG` then
--      if string(v) then v = tg_to_bool(v,nFrames+1) end if -- erm, NO
        ctrl_xtra[table][CXTBL_COLDRAG] = v

    elsif name=`COL_SIZE` then
        if string(v) then v = tg_to_bool(v,nFrames+1) end if
        ctrl_xtra[table][CXTBL_COLSIZE] = v

    elsif name=`COL_SORT` then
        integer l = length(ctrl_xtra[table][CXTBL_COLUMNS])
        if atom(v) or (length(v)=l and max(v)<=1) then
            ctrl_xtra[table][CXTBL_COLSORT] = v
            ctrl_xtra[table][CXTBL_SORTCOLS] = NULL
            ctrl_xtra[table][CXTBL_TAGSET] = NULL
            ctrl_xtra[table][CXTBL_INVTAG] = NULL
        else
            if length(v) and sequence(v[1]) then v = v[1] end if -- discard tagset/invtag, or the {{1}} special case
            tg_table_set_tagsets(table, colset:=v)
        end if

    elsif name=`DATA` then
        ctrl_xtra[table][CXTBL_DATA] = v
        ctrl_xtra[table][CXTBL_N_ROWS] = 0
        if v!=NULL then
            object v1 = v[1]
            integer n_rows = iff(integer(v1)?v1(0):length(v1))
            ctrl_xtra[table][CXTBL_N_ROWS] = n_rows
            object colset = ctrl_xtra[table][CXTBL_SORTCOLS]
            tg_table_set_tagsets(table, colset)
            sequence data = v
            integer lh = ctrl_xtra[table][CXTBL_LINEHT],
                    nl = n_rows+1, -- (+1=col hdrs)
                    w = 0
            if lh=0 then lh = 24 end if
            for c in ctrl_xtra[table][CXTBL_COLUMNS] do
                w += iff(string(c)?80:abs(c[2]))
            end for
            gSetAttribute(table,`SCROLLSIZE`,{w,lh*nl})
            integer rows = -ctrl_size[table][SZ_USER_H]
            if rows>0 then
                ctrl_size[table][SZ_USER_H] = lh*rows
            end if
            if ctrl_size[table][SZ_USER_W]=0 then
                ctrl_size[table][SZ_USER_W] = w
            end if
        end if

    elsif name=`LINEHT` then
        ctrl_xtra[table][CXTBL_LINEHT] = v

    elsif name=`SELECTED` then
        ctrl_xtra[table][CXTBL_SELECTED] = v

    elsif name=`SELMODE`
       or name=`CELLMODE` then
        if string(v) then
            integer k = find(v,{`CELL`,`LINE`,`MULTIPLE`})
            if k!=0 then v = {true,false,-1}[k] end if
        end if
        if not find(v,{true,false,-1}) then
            crash("gSetAttribute(TABLE,%s,%v)",{name,v},nFrames+2)
        end if
        ctrl_xtra[table][CXTBL_SELMODE] = v
        ctrl_xtra[table][CXTBL_SELECTED] = NULL

    elsif name=`SHOWLINE` then
        if sequence(v) then
            tg_table_ensure_line_visible(table,v[1],true)
            tg_table_ensure_col_visible(table,v[2],true)
        else
            tg_table_ensure_line_visible(table,v,true)
        end if
    elsif name=`TOPLINE` then
        ctrl_xtra[table][CXTBL_TOPLINE] = v
    else
        return false
    end if
    return true
end function

local function tg_get_table_attribute(gdx table, string name, integer nFrames)
    if name=`COLUMNS` then
        return ctrl_xtra[table][CXTBL_COLUMNS]
    elsif name=`COL_DRAG` then
        return ctrl_xtra[table][CXTBL_COLDRAG]
    elsif name=`COL_SIZE` then
        return ctrl_xtra[table][CXTBL_COLSIZE]
    elsif name=`COL_SORT` then
?9/0 -- (see docs/revisit when|if gTable.exw does the full restore thingy)
--      integer l = length(ctrl_xtra[table][CXTBL_COLUMNS])
--      if atom(v) or (length(v)=l and max(v)<=1) then
--          ctrl_xtra[table][CXTBL_COLSORT] = v
--          ctrl_xtra[table][CXTBL_SORTCOLS] = NULL
--          ctrl_xtra[table][CXTBL_TAGSET] = NULL
--          ctrl_xtra[table][CXTBL_INVTAG] = NULL
--      else
--          if length(v) and sequence(v[1]) then v = v[1] end if -- discard tagset/invtag, or the {{1}} special case
--          tg_table_set_tagsets(table, colset:=v)
--      end if
    elsif name=`DATA` then
        return ctrl_xtra[table][CXTBL_DATA]
    elsif name=`LINEHT` then
        return ctrl_xtra[table][CXTBL_LINEHT]
    elsif name=`SELECTED` then
        return ctrl_xtra[table][CXTBL_SELECTED]
    elsif name=`SELMODE`
       or name=`CELLMODE` then
        return ctrl_xtra[table][CXTBL_SELMODE]
    elsif name=`TOPLINE` then
        return ctrl_xtra[table][CXTBL_TOPLINE]
    end if
    tg_bad_attr(table,name,nFrames+1)
end function

global function gTable(sequence columns, data, object rows=10, sequence attributes=``, args={})
    {rows,attributes,args} = paranormalise_raa(rows,attributes,args,bCheckRid:=false)
    gdx table = gCanvas(tg_redraw_table,nFrames:=2)
    ctrl_types[table] = TABLE
    ctrl_set_attr[TABLE] = tg_set_table_attribute
    ctrl_get_attr[TABLE] = tg_get_table_attribute
    object tbl_attr = repeat(0,CXTBL_LEN)
    tbl_attr[CXTBL_BGSEL] = #CCE8FF
    tbl_attr[CXTBL_BGHOV] = #E5F3FF
    tbl_attr[CXTBL_COLDRAG] = true
    tbl_attr[CXTBL_COLSIZE] = true
    tbl_attr[CXTBL_COLSORT] = true
--  tbl_attr[CXTBL_DATA] = data -- see below...
--  tbl_attr[CXTBL_N_ROWS] = length(data[1]) -- ""
    object d1 = data[1] 
    tbl_attr[CXTBL_N_ROWS] = iff(integer(d1)?d1(0):length(d1))
--  tbl_attr[CXTBL_SELMODE] = 0 -- line (default)
    ctrl_xtra[table] = tbl_attr
    tbl_attr = 0 -- (kill refcount)
    ctrl_bg[table] = TG_WHITE
    ctrl_size[table][SZ_USER_H] = -rows -- for tg_set_table_attribute(DATA)
    {} = tg_set_table_attribute(table,`COLUMNS`,columns,2)
    if length(attributes) then
        gSetAttributes(table,attributes,args,2)
    end if
    gSetAttribute(table,`DATA`,data)
    tg_register_handler(TABLE,`SELECTED`,{`POI`,`POII`,`PI`,`PII`,`POO`,`PO`})
    tg_register_handler(TABLE,`TABCLICK`,{`POPII`})
    tg_register_handler(TABLE,`TABKEY`,{`POI`,`POII`,`POIII`,`POIIII`,`POIIIII`})
--  gSetHandler(table,`MOUSEMOVE`,tg_table_mousemove)
    gSetHandler(table,`MOUSELEAVE`,tg_table_mouseleave)
    gSetHandler(table,`CLICK`,tg_table_click)
    gSetHandler(table,`KEY`,tg_table_key)
    return table
end function 

