local procedure tg_tabs_redraw(gdx tabs, integer w,h)
    if ximg=NULL then
        {ximg,ltab,rtab} = gGetGlobal(`xlr_xpm`) -- (not documented)
    end if
    -- first pass: calculate all the tab widths
    sequence tabset = tg_tabs_get_tabset(tabs),
          tabwidths = {}
    bool rover_needed = false,
         bHasFocus = gGetFocus()=tabs,
         bActive = gGetAttribute(tabs,`ACTIVE`),
         bClose = ctrl_xtra[tabs][CXTAB_CLOSE],
         bBump = ctrl_xtra[tabs][CXTAB_BUMP]
    integer {mx,my} = gGetAttribute(tabs,`MOUSEPOS`),
           selected = ctrl_xtra[tabs][CXTAB_SEL],
           firsttab = ctrl_xtra[tabs][CXTAB_1ST],
              tw, x = iff(firsttab>1?10:0)
    gdm img
    for i,t in tabset from firsttab do
        tw = 0
        if not string(t) then
            {t,img} = t
            tw += gGetAttribute(img,`SIZE`)[1]+4
        end if
        tw += gGetTextExtent(t,tabs)[1]+12
        if bClose then tw += 10 end if
        x += tw
        rover_needed = x>(w-(i<length(tabset))*11)
        if rover_needed then
            if i>selected or not bBump then exit end if
            if firsttab=1 then x += 10 end if
            x -= tabwidths[1]
            tabwidths = tabwidths[2..$]
            firsttab += 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
            rover_needed = false -- (i/c i==$)
        end if
        tabwidths &= tw
        if i=length(tabset) then
            while firsttab>1 do
                -- when resizing, drag in any that now fit, aka
                --  when it would have left rover_needed false.
                t = tabset[firsttab-1]
                tw = 0
                if not string(t) then
                    {t,img} = t
                    tw += gGetAttribute(img,`SIZE`)[1]+4
                end if
                tw += gGetTextExtent(t,tabs)[1]+12
                if bClose then tw += 10 end if
                if x+tw-(firsttab=2)*10>w then exit end if
                x += tw
                tabwidths = tw & tabwidths
                firsttab -= 1
                ctrl_xtra[tabs][CXTAB_1ST] = firsttab
            end while
        end if
    end for
    x = 0
    if firsttab>1 then
        -- show leftarrow:
        if mx>=0 and mx<10 
        and my>2 and my<22 and bActive then
            -- show hover highlight on leftarrow:
            gDrawRect(tabs, 0, 3, 9, 21, true, colour:=TAB_OVER_HOV)
        end if
        gDrawImage(ltab,tabs,2,8)
        x = 10
    end if
    -- save for mouse handling:
    ctrl_xtra[tabs][CXTAB_TWSAVE] = tabwidths
    atom txtclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
    for i,t in tabset from firsttab do
        integer wdx = i-firsttab+1, ty, bg
        if wdx>length(tabwidths) then
            assert(rover_needed)
            gDrawText(tabs,x+5,1,"...",{},TG_SE,colour:=txtclr)
            exit
        end if
        tw = tabwidths[wdx]
        if i=selected and bActive then
            ty = 0
            bg = TAB_BG_SEL
        else
            ty = 2
            if mx>x and mx<x+tw
            and my>2 and my<22 and bActive then
                bg = TAB_BG_HOV
            else
                bg = TAB_BG_NS
            end if
        end if
        gDrawRect(tabs,x,ty,x+tw,h-1,true,colour:=bg)
        if bHasFocus and i=selected and bActive then
            -- draw focus rect  
            integer fb = iff(backend=TG_GTK?h-8:
                         iff(backend=TG_WINAPI?h-5:9/0))
--          gDrawRect(tabs,x+2,ty+2,x+tw-1,fb,rc:=2,colour:=TG_BLACK,style:=TG_DOTTED)
            gDrawRect(tabs,x+2,ty+2,x+tw-1,fb,rc:=0,colour:=TG_BLACK,style:=TG_DOTTED)
        end if
        -- left edge
        gDrawLine(tabs,x,ty,x,h-1,colour:=TAB_BORDER)
        integer iw = 0, ih
        if not string(t) then
            {t,img} = t
            {iw,ih} = gGetAttribute(img,`SIZE`)
            iw += 4
            if not bActive then img = gGreyscale_XPM(img) end if
            gDrawImage(img,tabs,x+6,ty+10-floor(ih/2))
        end if
        gDrawText(tabs,x+iw+5,ty+3,t,{},TG_SE,colour:=txtclr)
        if bClose then
            gDrawImage(ximg,tabs,x+tw-12,ty+6)
        end if
        -- top edge
        gDrawLine(tabs,x,ty,x+tw,ty,colour:=TAB_BORDER)
        if i!=selected then
            -- bottom edge
            gDrawLine(tabs,x,h-2,x+tw,h-2,colour:=TAB_BORDER)
        end if
        x += tw     
        -- right edge
        gDrawLine(tabs,x,ty,x,h-2,colour:=TAB_BORDER)
    end for
    -- save for tg_tabs_click:
    ctrl_xtra[tabs][CXTAB_ROVER] = rover_needed
    if rover_needed then
        bool bHovr = mx>=w-10 and mx<w and my>2 and my<22 and bActive
        atom bgclr = iff(bHovr?TAB_OVER_HOV:TAB_BGCLR)
        gDrawRect(tabs, w-10, 3, w-1, 21, true, colour:=bgclr)
        gDrawImage(rtab,tabs,w-9,8)
    end if
end procedure

local procedure tg_tabs_mousemoveleave(gdx tabs)
    gRedraw(tabs)
end procedure

procedure tg_tabs_click(gdx tabs, sequence status, integer x, y) 
    if gGetAttribute(tabs,`ACTIVE`) then
        integer {w,h} = gGetAttribute(tabs,`SIZE`), tdx = -2,
             old_posn = ctrl_xtra[tabs][CXTAB_SEL],
             firsttab = ctrl_xtra[tabs][CXTAB_1ST]
        bool doleft = false,
             doright = false,
             doclose = false,
             dochange = false,
             doredraw = true,
             bClose = ctrl_xtra[tabs][CXTAB_CLOSE],
             rover_needed = ctrl_xtra[tabs][CXTAB_ROVER]
        if status[1..2]=`LS` 
        and y>2 and y<22 then
            if firsttab>1 
            and x>=0 and x<10 then
                doleft = true
                tdx = -1
            elsif rover_needed
              and x>=w-10 and x<w then
                doright = true
                tdx = 0
            else
                integer tx = iff(firsttab>1?10:0)
                sequence twsave = ctrl_xtra[tabs][CXTAB_TWSAVE]
                for i,rhs in twsave do
                    tx += rhs
                    if x<=tx then
                        tdx = firsttab+i-1
                        doclose = bClose and tx-x<=10
                        dochange = not doclose
                        exit
                    end if
                end for
                if tdx=-2 and rover_needed then
                    doright = true
                    tdx = 0
                end if
            end if
        end if
--/*
--NB: "LS" check must occur below this, which must occur after tdx determined:
    rtn tabclick = gGetHandler(tabs,`TABCLICK`)
    if tabclick then
        integer res = tabclick(tabs,status,x,y,tdx,action='X')
        if res=TG_IGNORE then return end if
        assert(res=TG_CONTINUE or res=TG_DEFAULT)
    end if
--*/

        if doleft then
            firsttab -= 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
        elsif doright then
            firsttab += 1
            ctrl_xtra[tabs][CXTAB_1ST] = firsttab
        elsif doclose then
            {old_posn,tdx,dochange} = {tdx,0,true}
        elsif dochange then
            ctrl_xtra[tabs][CXTAB_SEL] = tdx
        else
            doredraw = false
        end if
        if doredraw then
            -- allow bump: show as many tabs as you can while ensuring sel is visible,
            --       however that can disable l/r arrow buttons, so they set it false, 
            --       & it can be annoying for close to jump back, so that does so too.
            ctrl_xtra[tabs][CXTAB_BUMP] = dochange and tdx!=0
            gRedraw(tabs)
        end if
        if dochange and old_posn!=tdx then
            if not tg_tab_change(tabs,old_posn,tdx)
               and doclose then
                crash(`TABCHANGED not defined`)
            end if
        end if
    end if
end procedure

local function tg_tabs_key_handler(gdx tabs, integer c) 
    if gGetAttribute(tabs,`ACTIVE`) then
        integer selected = ctrl_xtra[tabs][CXTAB_SEL],
                firsttab = ctrl_xtra[tabs][CXTAB_1ST]
        bool bRedraw = false
        if c=VK_LEFT then
            if selected>1 then
                selected -= 1
                if firsttab>selected then
                    firsttab = selected
                    ctrl_xtra[tabs][CXTAB_1ST] = firsttab
                end if
                bRedraw = true
            end if
        elsif c=VK_RIGHT then
            sequence tabset = tg_tabs_get_tabset(tabs)
            if selected<length(tabset) then
                selected += 1
                bRedraw = true
            end if
        end if
        if bRedraw then
            ctrl_xtra[tabs][CXTAB_SEL] = selected
            ctrl_xtra[tabs][CXTAB_BUMP] = true
            gRedraw(tabs)
            return TG_IGNORE
        end if
    end if
    return TG_CONTINUE
end function

local function tg_set_tabs_attribute(gdx tabs, string name, object v, integer nFrames)
    if name=`POSN` then
        if string(v) then v = to_integer(v) end if
        integer l = length(tg_tabs_get_tabset(tabs))
        assert(v>=1 and v<=l,"bad POSN",nFrames:=nFrames+2)
        ctrl_xtra[tabs][CXTAB_SEL] = v
    elsif name=`SHOWCLOSE` then
        if string(v) then v = tg_to_bool(v,nFrames+2) end if
        if not integer(ctrl_xtra[tabs][CXTAB_ITEMS])
        and v==true then
            crash(`SHOWCLOSE:=true invalid on static tabitems`,nFrames:=nFrames+2)
        end if
        ctrl_xtra[tabs][CXTAB_CLOSE] = v
    else
        return false
    end if
    return true
end function

local function tg_get_tabs_attribute(gdx tabs, string name, integer nFrames)
    if name=`POSN` then
        return ctrl_xtra[tabs][CXTAB_SEL]
    elsif name=`SHOWCLOSE` then
        return ctrl_xtra[tabs][CXTAB_CLOSE]
    end if
    tg_bad_attr(tabs,name,nFrames+1)
end function

global function gTabs(object tabitems, rtn tabchanged=NULL, sequence attributes="", args={})
    {tabchanged,attributes,args} = paranormalise_raa(tabchanged,attributes,args)
    gdx tabs = gCanvas(tg_tabs_redraw,`SIZE=0x24,EXPAND=HORIZONTAL`,nFrames:=2)
    ctrl_types[tabs] = TABS
    ctrl_set_attr[TABS] = tg_set_tabs_attribute
    ctrl_get_attr[TABS] = tg_get_tabs_attribute
    object tabs_attr = repeat(0,CXTAB_LEN)
    tabs_attr[CXTAB_ITEMS] = tabitems
    tabs_attr[CXTAB_SEL] = 1
    tabs_attr[CXTAB_1ST] = 1
    tabs_attr[CXTAB_BUMP] = true
    ctrl_xtra[tabs] = tabs_attr
    tabs_attr = 0
    tg_register_handler(TABS,`TABITEMS`,{`FO`,`F`})
    tg_register_handler(TABS,`TABCHANGED`,{`POII`,`PII`})
--  tg_register_handler(TABS,`TABCLICK`,{`POPIIII`})
    gSetAttribute(tabs,`BGCLR`,TAB_BGCLR)
    gSetHandler(tabs,{`MOUSEMOVE`,`MOUSELEAVE`},tg_tabs_mousemoveleave)
    gSetHandler(tabs,`CLICK`,tg_tabs_click)
    gSetHandler(tabs,`KEY`,tg_tabs_key_handler)
    if integer(tabitems) then
        gSetHandler(tabs,`TABITEMS`,tabitems) -- (for the sig check only)
    end if
    if tabchanged then
        gSetHandler(tabs,`TABCHANGED`,tabchanged)
    end if
    if length(attributes) then
        gSetAttributes(tabs,attributes,args,2)
    end if
    return tabs
end function

-- gText
-- =====

local function tg_nearest_cpos(gdx text, integer x)
    -- perform a binary chop to find the nearest cpos, taking cfrom into account
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM]
    if x<=5 then return cfrom end if
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)[cfrom..$]
    integer lo = 0,
            hi = length(utf32),
            lopos = 5,
            hipos = 5 + gGetTextExtent(utf32_to_utf8(utf32),text)[1]
    if x>=hipos then return cfrom+hi end if
    while hi>lo+1 do
        integer mid = floor((hi+lo)/2)
        -- may as well leave these in (never triggered for me)
        if mid<=lo then ?9/0 end if
        if mid>=hi then ?9/0 end if
        integer midpos = 5 + gGetTextExtent(utf32_to_utf8(utf32[1..mid]),text)[1]
        if x<midpos then
            hi = mid
            hipos = midpos
        else
            lo = mid
            lopos = midpos
        end if
    end while
    -- aside: I was planning on nearest(hi,lo) here, but this seems fine:
    return cfrom+lo
end function

local function tg_gtext_prev_word_boundary(integer cpos, sequence utf32)
    cpos = max(cpos-1,1)
    while cpos>1 do
        if utf32[cpos-1]=' ' then
            exit
        end if
        cpos -= 1
    end while
    return cpos
end function

local function tg_gtext_next_word_boundary(integer cpos, len, sequence utf32)
    cpos = min(cpos+1,len+1)
    while cpos<=len do
        if utf32[cpos-1]=' '
        and utf32[cpos]!=' ' then
            exit
        end if
        cpos += 1
    end while
    return cpos
end function

local procedure tg_text_process_mouseclickmove(gdx text, integer d, x)
    --
    -- process mouse click/move:
    -- d is 'S' or 'D' for single./double click, 'M' for mousemove.
    -- 
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM],
             cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
         selstart = ctrl_xtra[text][CXTEXT_SELSTART],
        prev_cpos = cpos
    if backend=TG_GTK then
        if bGTK2 then x += 4 end if
        if bGTK3 then x -= 2 end if
    elsif backend=TG_JS then    
        // do nothing...
    end if
    cpos = tg_nearest_cpos(text, x)
    if d='S' then
        bool shift = gGetGlobal(`SHIFTKEY`)
        if shift and selstart=0 then
            selstart = prev_cpos
        elsif selstart=0 or not shift then
            selstart = cpos
        end if
    elsif d='D' then
        selstart = tg_gtext_prev_word_boundary(cpos,utf32)
        cpos = tg_gtext_next_word_boundary(cpos,length(utf32),utf32)
    elsif d='M' then
        if x<=5 then
            if cfrom>1 then
                cfrom -= 1
                ctrl_xtra[text][CXTEXT_CHARSFROM] = cfrom
            end if
            cpos = cfrom
--      else
--          cpos = tg_nearest_cpos(text,x)
        end if
--      ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
    else
        ?9/0
    end if
    ctrl_xtra[text][CXTEXT_SELSTART] = selstart
    ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
end procedure

local atom date_pick_icon = NULL

local procedure tg_gtext_redraw(gdx text, integer w, h)
    string txt = ctrl_xtra[text][CXTEXT_VALUE], substr
    sequence utf32 = utf8_to_utf32(txt)
    bool unicode = length(txt)!=length(utf32),
           tType = ctrl_types[text]
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM],
             cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
           last_w = ctrl_xtra[text][CXTEXT_LASTW],
         selstart = ctrl_xtra[text][CXTEXT_SELSTART],
           riconw = ctrl_xtra[text][CXTEXT_RICONW],
              hov = ctrl_xtra[text][CXSPIN_HOV]
    ctrl_xtra[text][CXTEXT_LASTW] = w
    bool bHasFocus = (gGetFocus()==text), 
       bDrawCursor = false
    if backend=TG_GTK then
        if bGTK2 then
            gDrawLine(text,0,0,w-1,0,colour:=#9E9A91)
            gDrawLine(text,0,0,0,h-1,colour:=#9E9A91)
            gDrawLine(text,1,1,w-2,1,colour:=TG_BLACK)
            gDrawLine(text,1,1,1,h-2,colour:=TG_BLACK)
            gDrawLine(text,w-2,2,w-2,h-2,colour:=#DCDAD5)
            gDrawLine(text,2,h-2,w-2,h-2,colour:=#DCDAD5)
        elsif bGTK3 then
            gDrawRect(text,0,0,w-1,h-1,false,0,colour:=#E8E8E7,width:=1)

            if bHasFocus then
                gDrawRect(text,1,1,w-2,h-5,false,2,colour:=#4A90D9,width:=2)
            else
                gDrawRect(text,0,0,w-1,h-8,false,4,colour:=#808080,width:=1)
            end if
        end if
    elsif backend=TG_WINAPI then
        atom boxclr = iff(bHasFocus?#0078D4:#646464)
        gDrawRect(text,0,0,w-1,h-1,colour:=boxclr)
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_gtext_redraw)`);
        #}ilJS
    else
        ?9/0
    end if
    integer x = floor(h/5), y = floor(h/2), tw, th
    if backend=TG_GTK then
        if bGTK2 then x -= 2 y += 1 end if
        if bGTK3 then x += 4 y += 1 end if
    elsif backend=TG_JS then    
        // do nothing...
    end if

    -- ensure cpos on-screen, by adjusting cfrom as needed:
    integer l1 = length(iff(unicode?utf32:txt))+1
    cpos = min(cpos,l1)
    integer newfrom = min(iff(cfrom>=cpos?1:cfrom),l1)
    substr = iff(unicode?utf32_to_utf8(utf32[newfrom..cpos-1])
                                        :txt[newfrom..cpos-1])
    {tw,th} = gGetTextExtent(substr,text,bNorm:=true)
--  integer maxw = w-6-(tType!=TEXT)*(h-6)
    integer maxw = w-6-riconw
--  if tw>=maxw then
    if tw>=maxw and tw!=0 then
        newfrom = max(1,cpos-floor((cpos-newfrom)*(((w-riconw)*2/3)/tw)))
        substr = iff(unicode?utf32_to_utf8(utf32[newfrom..cpos-1])
                                            :txt[newfrom..cpos-1])
        {tw,th} = gGetTextExtent(substr,text,bNorm:=true)

    elsif w-riconw>last_w and newfrom>1 then
        -- increase newfrom while txt[$] still visible
        while newfrom>1 do
            substr = iff(unicode?utf32_to_utf8(utf32[newfrom-1..$])
                                                :txt[newfrom-1..$])
            {tw,th} = gGetTextExtent(substr,text,bNorm:=true)
            if tw>=maxw then exit end if
            newfrom -= 1
        end while
    end if
    if newfrom!=cfrom then
        cfrom = newfrom
        ctrl_xtra[text][CXTEXT_CHARSFROM] = cfrom
    end if

    -- cursor:
    gdx cursorblinktimer = ctrl_xtra[text][CXTEXT_CARETIMER]
    -- Aside: GTK only shows cursor when no text selected, WinAPI always
--  if bHasFocus and ((not (bGTK2 or bGTK3)) or selstart=0 or selstart=cpos) then
    if bHasFocus then
        if not ctrl_xtra[text][CXTEXT_HADFOCUS] then
            ctrl_xtra[text][CXTEXT_CARETCT] = 6
            gSetAttribute(cursorblinktimer,`RUN`,true)
        end if
        if gGetAttribute(cursorblinktimer,`RUN`) then
            atom caretime = ctrl_xtra[text][CXTEXT_CARETIME],
                 caretclr = ctrl_xtra[text][CXTEXT_CARETCLR]
            if time()>=caretime then
--              caretclr = iff(caretclr=TG_BLACK?bgsel:TG_BLACK)
                caretclr = iff(caretclr=TG_BLACK?TG_WHITE:TG_BLACK)
                ctrl_xtra[text][CXTEXT_CARETCLR] = caretclr
                ctrl_xtra[text][CXTEXT_CARETIME] = time()+0.5
                if caretclr=TG_BLACK then
                    ctrl_xtra[text][CXTEXT_CARETCT] -= 1
                    if ctrl_xtra[text][CXTEXT_CARETCT]<=0 then
                        gSetAttribute(cursorblinktimer,`RUN`,false)
                    end if
                end if
            end if
            bDrawCursor = (caretclr=TG_BLACK)
        end if
    else
        gSetAttribute(cursorblinktimer,`RUN`,false)
    end if
    gCanvasClip(text,{1,1,maxw+5,h-1})
    atom fgclr = ctrl_fg[text]
    if tType=SPIN then
        y += 1
--DEV should also go red when out-of-range...
        if not is_integer(txt) then fgclr:=TG_RED end if
    elsif tType=DATEPICK then
        y += 1
        x -= 1
    end if
    if selstart and bHasFocus then
        if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
        integer sx = x
        if selstart>cfrom then
            substr = iff(unicode?utf32_to_utf8(utf32[cfrom..selstart-1])
                                                :txt[cfrom..selstart-1])
            gDrawText(text,sx,y,substr,colour:=fgclr)
            sx += gGetTextExtent(substr,text,bNorm:=true)[1]
            cfrom = selstart
        end if
        substr = iff(unicode?utf32_to_utf8(utf32[cfrom..cpos-1])
                                            :txt[cfrom..cpos-1])
        sequence selclr
        if backend=TG_GTK then
            if bGTK2 then
                selclr = {TG_WHITE,iff(bHasFocus?#4B6983:#9C9A94)}
            elsif bGTK3 then
                selclr = {#DBFFF2,#0078D7}
            else
                ?9/0
            end if
        elsif backend=TG_WINAPI then
            selclr = {#DBFFF2,#0078D7}
        elsif backend=TG_JS then
            #ilJS{
                crash(`JS (tg_gtext_redraw2)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
        gDrawText(text,sx,y,substr,colour:=selclr)
        if cpos<=length(txt) then
            sx += gGetTextExtent(substr,text,bNorm:=true)[1]
            substr = iff(unicode?utf32_to_utf8(utf32[cpos..$])
                                                :txt[cpos..$])
            gDrawText(text,sx,y,substr,colour:=fgclr)
        end if
    else
        substr = iff(unicode?utf32_to_utf8(utf32[cfrom..$])
                                            :txt[cfrom..$])
        if length(substr)=0 then
            sequence cb = ctrl_xtra[text][CXTEXT_CUEBANNER]
            if string(cb) then
                gDrawText(text,x,y,cb,colour:=TG_GREY)
            else
                substr = cb[1]
                atom clr = cb[2]
                object style = iff(length(cb)=3?cb[3]:-1)
                gDrawText(text,x,y,substr,colour:=clr,style:=style)
            end if
        else
            gDrawText(text,x,y,substr,colour:=fgclr)
        end if
    end if
    gCanvasClip(text,NULL)
    if tType=SPIN then
--DEV we should probably force a gSpin to have an odd height...
--    I also suspect a gText height should depend on FONT or an explicit SIZE, but not/refuse to expand heightwise.
        integer g = ceil(h/10),
                m = ceil(h/2),
                l = w-h+5,
                r = w-2
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        gDrawLine(text,l,r+1,m,r+1,colour:=#D2D2D2)
        if hov then 
            integer {t,b} = iff(hov=1?{1,m-1}:{m,h-2})
            gDrawRect(text,l,t,r,b,true,colour:=#D8E6F1)
            if hov=1 then t -= 1 end if
            gDrawRect(text,l,t,r+1,b+1,false,colour:=#0078D4)
        end if
        -- draw the up and down arrows themselves
        integer xl = w-m+2, la = 0, yb = h-g-1
        for yt=g+1 to m-g-1 do
            integer xr = xl+la+1, aclr = #505050
            gDrawLine(text,xl,yt,xr,yt,aclr)
            gDrawLine(text,xl,yb,xr,yb,aclr)
            xl -= 1
            la += 2
            yb -= 1
        end for
    elsif tType=DATEPICK then
        integer l = w-28
        if hov then -- DEV or drop-down visible
            gDrawRect(text,l,1,w-2,h-2,true,colour:=#D8E6F1)
        end if
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        if date_pick_icon=NULL then date_pick_icon = gGetGlobal("dp_xpm") end if
        -- "" is 22x14: (revisit this with a resizable datepick in v2..)
        gDrawImage(date_pick_icon,text,w-25,h/2-7)
--      y -= 4
    elsif tType=DROPDOWN then
        integer l = w-19
        if hov then -- DEV or drop-down visible
            gDrawRect(text,l,1,w-2,h-2,true,colour:=#D8E6F1)
        end if
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        for y=8 to 12 do
            gDrawLine(text,w+y-22,y,w-y+3,y,#505050)
        end for
        y -= 3
    end if
    if bDrawCursor then
        if th=0 then th = gGetTextExtent("|",text)[2] end if
        integer cx = x+tw+1,
               hth = floor(th/2)
        if backend=TG_GTK then  
            if bGTK2 then cx += 1 end if
            if bGTK3 then cx -= 1 y -= 1 end if
        elsif backend=TG_JS then    
            // do nothing...
        end if
        gDrawLine(text,cx,y-hth,cx,y+hth,TG_BLACK)
    end if
    ctrl_xtra[text][CXTEXT_HADFOCUS] = bHasFocus
end procedure   

local procedure tg_gtext_cursorblink_action(gdx cursorblinktimer)
    gdx text = user_data[cursorblinktimer]
    gRedraw(text)
end procedure

--
-- undo/redo handling:
--
local constant TG_GTEXT_DEL=-1,
               TG_GTEXT_SAME=0,
               TG_GTEXT_INS=+1,
               TG_GTEXT_CPLX=9

-- this lot may need to be utf32 sequences rather than utf8 strings...
local function tg_gtext_onediff(string s1, s2)
    -- part of undo/redo: do s1,s2 differ by a single/central
    --  insert/delete, and if so how long is it, and where?
    -- nb something much cleverer than this may be desired...
    -- aside: this relies heavily on unit_tests() passing.
    integer l1 = length(s1),
            l2 = length(s2),
            s = 1
    while l1 and l2 and s1[l1] = s2[l2] do
        l1 -= 1
        l2 -= 1
    end while
    while l1 and l2 and s1[s] = s2[s] do
        s += 1
        l1 -= 1
        l2 -= 1
    end while
    if l1=0 and l2=0 then return {TG_GTEXT_SAME,0,0} end if
    if l1=0 then return {TG_GTEXT_INS,l2,s} end if
    if l2=0 then return {TG_GTEXT_DEL,-l1,s} end if
    return {TG_GTEXT_CPLX,0,0}
end function

local integer upos  -- copy of crl_xtra[txt][CXTEXT_UNDOPOS] (pbr not needed)

local function tg_gtext_update_undo(sequence undo, string c)
    -- aside: this relies heavily on unit_tests() passing,
    --         as opposed to being intuitively easy code.
    -- undo[1] is the initial state and is never changed.
    bool bAddNew = true
    if length(undo)!=1 then
        -- c is the current value, b,a are the last two
        string b = undo[-1],
               a = undo[-2]
        if c==b then
            bAddNew = false
        else
            -- {tg_gtext_type, length, position}:
            integer {act,acl,sac} = tg_gtext_onediff(a,c),
                    {abt,abl,sab} = tg_gtext_onediff(a,b)
            -- if ac is one insert/delete and one more than ab then 
            if act==abt and (abl+act)==acl
            and ((act==TG_GTEXT_DEL and sac-acl==sab-abl) or
                 (act==TG_GTEXT_INS and sac ==sab    )) then
                undo[$] = c -- replace b
                bAddNew = false
            end if
        end if  
    elsif c==undo[1] then
        bAddNew = false
    end if
    if bAddNew then
        -- add new entry
        undo = append(undo,c)
        upos += 1
        assert(upos==length(undo)) -- (quick sanity check)
    end if
    return undo
end function

local function tg_gtext_key_handler(gdx text, integer c, bool ctrl, shift) 
    -- <save some diag info>
    integer kp = ctrl_xtra[text][CXTEXT_KLOGPOS]
    if kp=0 then
        ctrl_xtra[text][CXTEXT_KEYLOG] = repeat(0,10)
        kp = 1
    end if
    ctrl_xtra[text][CXTEXT_KEYLOG][kp]=c+ctrl*M_CTRL+shift*M_SHIFT
    kp = rmdr(kp,10)+1
    ctrl_xtra[text][CXTEXT_KEYLOG][kp]=0
    ctrl_xtra[text][CXTEXT_KLOGPOS] = kp
    -- </save some diag info>
    bool redraw = true, -- (and not TG_IGNORE)
       bAltered = false,
       bGraphic = (not ctrl) and ((c>=' ' and c<=#7E) or c=VK_POUND)
        -- ^certainly avoid #A1..#A4 (udlr), #E0..E6 (VK_APPS..VK_SCROLL),
        --                  #90 (VK_NUMLOCK), or #F1..FC (VK_F1..F12)...
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)
    integer cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
        selstart = ctrl_xtra[text][CXTEXT_SELSTART], was_ss = selstart,
             len = length(utf32),
           tType = ctrl_types[text]
    bool unicode = length(txt)!=len
    --
    -- Aside: the next few conditions here are absolutely critical, and
    --        non-intuitive, at least until you enumerate them out loud:
    --          shift VK_RIGHT starts/extends the selection
    --          shift 'c' gets you a capital(/caplock) 'C'.
    --          ctrl VK_RIGHT starts/extends the selection
    --          ctrl ACXVZ only change selection indirectly
    --          .. (I could go on almost forever...)
    --        It is certainly more valuable and probably much easier,
    --        albeit rather tedious, to properly extend unit_tests()
    --        than it would be to make these tests crystal clear...
    --
    if selstart and (bGraphic or find(c,{VK_BS,VK_DEL})) then
        if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
        if unicode then
            utf32[selstart..cpos-1] = {}
            len = length(utf32)
            txt = utf32_to_utf8(utf32)
        else
            txt[selstart..cpos-1] = ``
            len = length(txt)
        end if
        cpos = selstart
        selstart = 0
        if not bGraphic then c=-1 end if
        bAltered = true
    else
        if shift and (not bGraphic) then
            if selstart=0 then selstart = cpos end if
        elsif not ctrl then
            selstart = 0
        end if
    end if
    if c=VK_HOME then
        cpos = 1
    elsif c=VK_END then
        cpos = len+1
    elsif c=VK_BS then
        if cpos>1 then
            if unicode then
                utf32 = utf32[1..cpos-2] & utf32[cpos..len]
                txt = utf32_to_utf8(utf32)
            else
                txt = txt[1..cpos-2] & txt[cpos..len]
            end if
            cpos = max(cpos-1,1)
        end if
        selstart = 0
        bAltered = true
    elsif c=VK_DEL then
        if cpos<=len then
            if unicode then
                utf32 = utf32[1..cpos-1] & utf32[cpos+1..len]
                txt = utf32_to_utf8(utf32)
            else
                txt = txt[1..cpos-1] & txt[cpos+1..len]
            end if
        end if
        bAltered = true
    elsif ctrl then
        c = upper(c)
        if c='A' then
            selstart = 1
            cpos = len+1
        elsif c='C'
           or c='X'
           or c='V' then
            sequence clip = ``
            if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
            if c='V' then
                clip = gGetGlobal(`CLIPTXT`)
                clip = clip[1..find_any("\r\n",clip)-1]
            elsif selstart and selstart!=cpos then
                clip = iff(unicode?utf32_to_utf8(utf32[selstart..cpos-1])
                                                  :txt[selstart..cpos-1])
                gSetGlobal(`CLIPTXT`,clip)
            end if
            if c!='C' and length(clip) then
                if selstart and selstart!=cpos then
                    if unicode then
                        utf32[selstart..cpos-1] = {}
                        txt = utf32_to_utf8(utf32)
                    else
                        txt[selstart..cpos-1] = ``
                    end if
                    cpos = selstart
                end if
                bAltered = true
                selstart = 0
                if c='V' then
                    if unicode then
                        clip = utf8_to_utf32(clip)
                        utf32[cpos..cpos-1] = clip
                        txt = utf32_to_utf8(utf32)
                    else
                        txt[cpos..cpos-1] = clip
                    end if
                    cpos += length(clip)
                end if
            end if
        elsif c='Y' or c='Z' then -- redo/undo
            bAltered = true -- (see below)
        elsif c=VK_RIGHT then
            cpos = tg_gtext_next_word_boundary(cpos,len,utf32)
            if not shift then selstart = 0 end if
        elsif c=VK_LEFT then
            cpos = tg_gtext_prev_word_boundary(cpos,utf32)
            if not shift then selstart = 0 end if
        else
            redraw = false
        end if  
    elsif c=VK_RIGHT then
        if not shift and was_ss and was_ss!=cpos then
            cpos = max(was_ss,cpos)
        else
            cpos = min(cpos+1,len+1)
        end if
    elsif c=VK_LEFT then
        if not shift and was_ss and was_ss!=cpos then
            cpos = min(was_ss,cpos)
        else
            cpos = max(cpos-1,1)
        end if
    elsif c=VK_UP
       or c=VK_DOWN then
        if tType=SPIN then
            integer {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD],
                     v = to_integer(ctrl_xtra[text][CXTEXT_VALUE])
            if c=VK_UP then
                v = max(lo,v+step)
                if v>hi then v = iff(bWrap?lo:hi) end if
            else          -- down
                v = min(hi,v-step)
                if v<lo then v = iff(bWrap?hi:lo) end if
            end if
            txt = sprintf("%d",v)
            cpos = length(txt)+1
            redraw = true
            bAltered = true
--      elsif tType=DATEPICK, DROPDOWN -- maybe... (with Alt)
        end if
    elsif bGraphic then
        object cc = iff(c=VK_POUND?iff(unicode?#A3:x"C2A3"):c)
        if unicode then
            utf32 = utf32[1..cpos-1] & cc & utf32[cpos..len]
            txt = utf32_to_utf8(utf32)
        else
            txt = txt[1..cpos-1] & cc & txt[cpos..len]
        end if
        cpos += 1
        bAltered = true
    else
        redraw = false
    end if
    if redraw or c=-1 then
        if bAltered then
            object undo = ctrl_xtra[text][CXTEXT_UNDO]
            if not sequence(undo) then
                undo = {ctrl_xtra[text][CXTEXT_VALUE]}
                upos = 1
            else
                upos = ctrl_xtra[text][CXTEXT_UNDOPOS]
            end if
            if ctrl and (c='Z' or c='Y') then
                string was_txt = txt
                if c='Z' then -- undo
                    if upos>1 then
                        upos -=1
                        txt = undo[upos]
                    end if
                elsif c='Y' then -- redo
                    if upos<length(undo) then
                        upos += 1
                        txt = undo[upos]
                    end if
                end if
                integer {t,l,s} = tg_gtext_onediff(txt,was_txt)
                if t=TG_GTEXT_DEL then
                    selstart = s
                    cpos = s-l
                elsif t=TG_GTEXT_INS then
                    cpos = s
                    selstart = 0
                end if
            else
                ctrl_xtra[text][CXTEXT_UNDO] = 0 -- (kill refcount)
                if upos<length(undo) then undo = undo[1..upos] end if
                undo = tg_gtext_update_undo(undo,txt)
                ctrl_xtra[text][CXTEXT_UNDO] = undo
            end if
            ctrl_xtra[text][CXTEXT_UNDOPOS] = upos
        end if
        ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
        ctrl_xtra[text][CXTEXT_VALUE] = txt
        ctrl_xtra[text][CXTEXT_HADFOCUS] = false -- (restart caret timer)
        ctrl_xtra[text][CXTEXT_SELSTART] = selstart
        gRedraw(text)
        if bAltered then
            rtn value_changed = gGetHandler(text,`VALUE_CHANGED`)
            if value_changed then
                string sig = tg_get_sig(value_changed)
                if sig=`POS`
                or sig=`POO` then
                    value_changed(text,txt)
                elsif sig=`PS` then
                    value_changed(txt)
                elsif sig=`POI` then
                    if is_integer(txt) then
                        value_changed(text,to_integer(txt))
                    end if
                elsif sig=`PI` then
                    if is_integer(txt) then
                        value_changed(to_integer(txt))
                    end if
                else
                    ?9/0
                end if
            end if
        end if
        return TG_IGNORE -- dealt with; do not propagate
    end if
    return TG_DEFAULT
end function

local gdx gtext_menu = NULL

-- the following uses control key codes for menu ids:
local constant TG_GTEXT_POPUP_MENU = {{"Undo\t",M_CTRL+'Z'},
                                      {"Redo\t",M_CTRL+'Y'},
                                      `-`,
                                      {"Cut\t",M_CTRL+'X'},
                                      {"Copy\t",M_CTRL+'C'},
                                      {"Paste\t",M_CTRL+'V'},
                                      {"Delete\t",VK_DEL},
                                      `-`,
                                      {"Select all\t",M_CTRL+'A'}}
--
--- The native (WinAPI) version also has no icons and:
--      Right to left Reading order
--      Show Unicode control characters
--      Insert Unicode control character
--      Open IME
--      Reconversion
--  (none of which I have any interest in or understanding of)
--  [Clearly per field r2l is just sheer utter lunatic madness]
--  The native (GTK2) version also has five (ugly) icons and:
--      InputMethods
--      Insert Unicode Control Character
--  The native (GTK3) version also has no icons and:
--      Insert Emoji
--  (not very interested in latter but more than rest combined)

local procedure tg_gtext_menu_handler(gdx menu, integer id)
    -- Get the gText from the (private) gMenu(TG_GTEXT_POPUP_MENU):
    gdx text = gGetAttribute(gtext_menu,`USER_DATA`)
    integer {ch,ctrl,shift} = gMenuCcsa(id)
    {} = tg_gtext_key_handler(text,ch,ctrl,shift) 
end procedure

function tg_gtext_click(gdx text, sequence status, integer x, /*y*/)
    switch status[1..2] do
        case `RR`:  -- (right button released)
                    gSetFocus(text)
                    if gtext_menu=NULL then
                        gtext_menu = gMenu(TG_GTEXT_POPUP_MENU,tg_gtext_menu_handler)
                        gSetAttribute(gtext_menu,`USER_DATA`,text)
                    end if
                    object undo = ctrl_xtra[text][CXTEXT_UNDO]
                    integer undolen = iff(sequence(undo)?length(undo):0),
                            undopos = ctrl_xtra[text][CXTEXT_UNDOPOS],
                           selstart = ctrl_xtra[text][CXTEXT_SELSTART],
                           caretpos = ctrl_xtra[text][CXTEXT_CARETPOS]
                    string txt = ctrl_xtra[text][CXTEXT_VALUE]
                    bool selected = selstart and selstart!=caretpos,
                         cliptext = gGetGlobal(`CLIPTXT?`)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'Z',`ACTIVE`,undopos>1)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'Y',`ACTIVE`,undopos<undolen)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'X',`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'C',`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'V',`ACTIVE`,cliptext)
                    gMenuSetAttribute(gtext_menu,VK_DEL,`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'A',`ACTIVE`,length(txt)>0)
                    gPopupMenu(gGetDialog(text),gtext_menu)
                    return TG_IGNORE
        case `LS`:  -- (left button single click/down) [or]
        case `LD`:  -- (left button double click: select word)
                    integer hov = ctrl_xtra[text][CXSPIN_HOV],
                          tType = ctrl_types[text]
                    if hov then
                        if tType=SPIN then
                            integer {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD],
                                     v = to_integer(ctrl_xtra[text][CXTEXT_VALUE])
                            if hov=1 then -- up
                                v = max(lo,v+step)
                                if v>hi then v = iff(bWrap?lo:hi) end if
                            else          -- down
                                v = min(hi,v-step)
                                if v<lo then v = iff(bWrap?hi:lo) end if
                            end if
                            ctrl_xtra[text][CXTEXT_VALUE] = sprintf("%d",v)
--                          gSetAttribute(v,"VALUE",sprint("%d",v))
--                          ?{"spin",v}
                            rtn value_changed = gGetHandler(text,`VALUE_CHANGED`)
                            if value_changed then
                                string sig = tg_get_sig(value_changed)
                                if sig=`POI` then
                                    value_changed(text,v)
                                elsif sig=`PI` then
                                    value_changed(v)
                                else
                                    ?9/0
                                end if
                            end if
                        elsif tType=DATEPICK then
                            {gdx calendar} = ctrl_xtra[text][CXTEXT_SDD]
                            tg_popup(text,calendar)
                        elsif tType=DROPDOWN then
                            {gdx list} = ctrl_xtra[text][CXTEXT_SDD]
                            tg_popup(text,list)
                        end if
                    else
                        tg_text_process_mouseclickmove(text, status[2], x)
                    end if
                    -- restart cursorblink...
                    ctrl_xtra[text][CXTEXT_HADFOCUS] = false
                    gSetFocus(text) -- ... whether this matters or not
                    gRedraw(text)
    end switch
    return TG_DEFAULT
end function

procedure tg_gtext_mousemove(gdx text, integer x,y, bool left,/*middle*/,/*right*/)
    integer tType = ctrl_types[text], hov = 0
    bool bRedraw = false
    if tType!=TEXT then
        integer {w,h} = gGetAttribute(text,"SIZE"), 
               washov = ctrl_xtra[text][CXSPIN_HOV]
        if tType=SPIN then
            if x>w-h+4 then hov = 1 + (y>h/2) end if
        elsif tType=DATEPICK then
            hov = x>=w-28
        elsif tType=DROPDOWN then
            hov = x>=w-19
        end if
        if hov!=washov then
            ctrl_xtra[text][CXSPIN_HOV] = hov
            bRedraw = true
        end if
    end if
-- erm...
--  if left then
    if left and hov=0 then
        tg_text_process_mouseclickmove(text, 'M', x)
        -- restart cursorblink:
        ctrl_xtra[text][CXTEXT_HADFOCUS] = false
        bRedraw = true
    end if
    if bRedraw then gRedraw(text) end if
end procedure

local procedure tg_gtext_mouseleave(gdx text)
    ctrl_xtra[text][CXSPIN_HOV] = 0
    gRedraw(text)
end procedure

function tg_set_text_attribute(gdx text, string name, object v, integer /*nFrames*/)
    if name=`VALUE`
    or name=`CUEBANNER` then
        if integer(v) then v = sprintf("%d",v) end if
        assert(string(v))
        if name=`VALUE` then
            ctrl_xtra[text][CXTEXT_VALUE] = v
            ctrl_xtra[text][CXTEXT_CARETPOS] = 1
            ctrl_xtra[text][CXTEXT_CHARSFROM] = 1
            ctrl_xtra[text][CXTEXT_SELSTART] = 0
            ctrl_xtra[text][CXTEXT_UNDO] = NULL
            ctrl_xtra[text][CXTEXT_UNDOPOS] = 0
        else
            ctrl_xtra[text][CXTEXT_CUEBANNER] = v
        end if
        return true
    elsif name=`SPIN` and ctrl_types[text]==SPIN then
        integer {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD]
        switch length(v) with fallthrough do
            case 4: bWrap = v[4]
            case 3: step = v[3]
            case 2: hi = v[2]
            case 1: lo = v[1]
        end switch
        ctrl_xtra[text][CXTEXT_SDD] = {lo,hi,step,bWrap}
        return true
    end if
    return false
end function

function tg_get_text_attribute(gdx text, string name, integer nFrames)
    if name=`VALUE` then
        return ctrl_xtra[text][CXTEXT_VALUE]
    elsif name=`CUEBANNER` then
        return ctrl_xtra[text][CXTEXT_CUEBANNER]
    elsif name=`SPIN` then
        return ctrl_xtra[text][CXTEXT_SDD]
    end if
    tg_bad_attr(text,name,nFrames+1)
end function

global function gText(object value_changed=NULL, sequence attributes=``, args={})
    {value_changed,attributes,args} = paranormalise_raa(value_changed,attributes,args)
    string hsz = iff(backend=TG_GTK and bGTK2?`x22`
                :iff(backend=TG_GTK and bGTK3?`x34`:`x20`))
    gdx id = gCanvas(tg_gtext_redraw,`SIZE=%s`,{hsz},nFrames:=2)
    ctrl_types[id] = TEXT
    ctrl_set_attr[TEXT] = tg_set_text_attribute
    ctrl_get_attr[TEXT] = tg_get_text_attribute
    object cx = repeat(0,CXTEXT_LEN)
    cx[CXTEXT_CARETCLR] = TG_BLACK
    cx[CXTEXT_CARETCT] = 6
--  cx[CXTEXT_CARETIME] = time()
    cx[CXTEXT_CARETIMER] = gTimer(tg_gtext_cursorblink_action,525,true,id)
    cx[CXTEXT_CARETPOS] = 1
    cx[CXTEXT_CHARSFROM] = 1
--  cx[CXTEXT_HADFOCUS] = 0 -- (already is)
--  cx[CXTEXT_SELSTART] = 0 -- (already is)
    cx[CXTEXT_VALUE] = ``
    cx[CXTEXT_CUEBANNER] = ``
--  cx[CXTEXT_UNDOPOS] = 1 -- (NO, 0)
--  cx[CXTEXT_KEYLOG] = repeat(0,10)
--  cx[CXTEXT_KLOGPOS] = 1
    ctrl_xtra[id] = cx
    cx = 0
    gSetAttribute(id,`EXPAND`,`HORIZONTAL`)
    gSetAttribute(id,`BGCLR`,TG_WHITE)
    gSetAttribute(id,`CANFOCUS`,true)
--  tg_register_handler(TEXT,`VALUE_CHANGED`,{`POS`,`POO`,`PS`})
    tg_register_handler(TEXT,`VALUE_CHANGED`,{`POS`,`POO`,`PS`,`P`})
    gSetHandler(id,`KEY`,tg_gtext_key_handler)
    gSetHandler(id,`CLICK`,tg_gtext_click)
    gSetHandler(id,`MOUSEMOVE`,tg_gtext_mousemove)
    gSetHandler(id,`MOUSELEAVE`,tg_gtext_mouseleave)
    if value_changed then
        gSetHandler(id,`VALUE_CHANGED`,value_changed)
    end if
    if length(attributes) then
        gSetAttributes(id,attributes,args,2)
    end if
    return id
end function

global function gSpin(object value_changed=NULL, sequence attributes=``, args={})
    {value_changed,attributes,args} = paranormalise_raa(value_changed,attributes,args)
    gdx spin = gText()
    ctrl_types[spin] = SPIN
    ctrl_set_attr[SPIN] = tg_set_text_attribute
    ctrl_get_attr[SPIN] = tg_get_text_attribute
--  ctrl_xtra[spin][CXTEXT_SDD] = {3,7,1,false}
    ctrl_xtra[spin][CXTEXT_SDD] = {0,9,1,false}
    ctrl_xtra[spin][CXTEXT_RICONW] = 15 -- (icon width)
    tg_register_handler(SPIN,`VALUE_CHANGED`,{`POI`,`PI`})
    if value_changed then
        gSetHandler(spin,`VALUE_CHANGED`,value_changed)
    end if
    gSetAttribute(spin,`EXPAND`,`NONE`)
    if length(attributes) then
        gSetAttributes(spin,attributes,args,2)
    end if
    integer {lo,hi} = ctrl_xtra[spin][CXTEXT_SDD]
    integer w = 25+7*max(length(sprintf("%d",lo)),
                         length(sprintf("%d",hi)))
    gSetAttribute(spin,`SIZE`,{w,21})
    return spin 
end function

global function gDatePick(gdx calendar, rtn value_changed=NULL, sequence attributes="", args={})
    {value_changed,attributes,args} = paranormalise_raa(value_changed,attributes,args)
    gdx datepick = gText(value_changed)
    gSetAttribute(datepick,`SIZE`,`109x21`)
    gSetAttribute(datepick,`EXPAND`,`NONE`)
    ctrl_types[datepick] = DATEPICK
    ctrl_set_attr[DATEPICK] = ctrl_set_attr[TEXT]
    ctrl_get_attr[DATEPICK] = ctrl_get_attr[TEXT]
    -- note it is the application's responsibility to tie together
    --      all interactions between the datepick and the calendar
    --      (theGUI is busy enough showing/hiding/forwarding keys)
    ctrl_xtra[datepick][CXTEXT_SDD] = {calendar}
    ctrl_xtra[datepick][CXTEXT_RICONW] = 27 -- (icon width)
    if value_changed!=NULL then
        -- aside: gSetHandler treats DATEPICK as TEXT
        gSetHandler(datepick,`VALUE_CHANGED`,value_changed)
    end if
    if length(attributes) then
        gSetAttributes(datepick,attributes,args,2)
    end if
    return datepick
end function

