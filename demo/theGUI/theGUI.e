                hPen = tg_WinAPI_get_pen(canvas, colour, width, style),
                pPen = c_func(xSelectObject,{hDC,hPen}),
              pBrush = c_func(xSelectObject,{hDC,hBrush})
            if rc then
                c_funk(xRoundRect,{hDC,xmin,ymin,xmax+1,ymax+1,rc,rc})
            else
                -- MSDN: The rectangle that is drawn excludes the bottom and right edges.
                c_funk(xRectangle,{hDC,xmin,ymin,xmax+1,ymax+1})
            end if
            tg_WinAPI_handles_match(hBrush,c_func(xSelectObject,{hDC,pBrush}),source_line()) -- (restore)
            tg_WinAPI_handles_match(hPen,c_func(xSelectObject,{hDC,pPen}),source_line())
            tg_WinAPI_handles_match(hTgt,c_func(xSelectObject,{hDC,pTgt}),source_line())
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gDrawRect)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if

    else -- gPixbuf
--/*
>> DEV this is rc==0 only...

--*/
        if bFill then
            integer pid = -canvas/2,
                {x1,x2,y1,y2} = {xmin+1,xmax+1,ymin+1,ymax+1}
            for l=y1 to y2 do
                gpixbufs[pid][l][x1..x2] = colour
            end for
        else
            gDrawLine(canvas,xmin,ymin,xmax,ymin,colour,style,width)    -- top
            gDrawLine(canvas,xmax,ymin,xmax,ymax,colour,style,width)    -- right
            gDrawLine(canvas,xmin,ymin,xmin,ymax,colour,style,width)    -- left
            gDrawLine(canvas,xmin,ymax,xmax,ymax,colour,style,width)    -- btm
        end if
    end if
end procedure
--*/
global procedure gDrawRect(gcps canvas, atom xmin, ymin, xmax, ymax, bool bFill=false, atom rc=0, colour=-1, object style=-1, width=-1)
--?{"gDrawRect",canvas, xmin, ymin, xmax, ymax, bFill, rc, colour, style, width}
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    xmin = round(xmin)
    xmax = round(xmax)
    ymin = round(ymin)
    ymax = round(ymax)
    if colour=-1 then colour = gGetAttribute(canvas,`FGCLR`) end if
    if bFill then {width,style} = {1,TG_CONTINUOUS}
    else
        if rc!=0 then width = 1
        elsif width=-1 then width = gGetAttribute(canvas,`LINEWIDTH`) end if
        if style=-1 then style = gGetAttribute(canvas,`LINESTYLE`) end if
    end if
    if canvas>0 then
        canvas = ctrl_images[canvas]
    end if
    if rc then
--      integer wh = rc*2+1,
        atom wh = rc*2+1,
              l = xmin+rc+1,
              t = ymin+rc+1,
              r = xmax-rc-1,
              b = ymax-rc-1,
              f = TG_FILLED+TG_SECTOR
--X           f = iff(bFill?TG_FILLED+TG_SECTOR:0)
        if bFill then
            gDrawArc(canvas,l,t,wh,wh,180,270,0,f,colour,style)
            gDrawArc(canvas,r,t,wh,wh,270,360,0,f,colour,style)
            gDrawArc(canvas,l,b,wh,wh, 90,180,0,f,colour,style)
            gDrawArc(canvas,r,b,wh,wh,  0, 90,0,f,colour,style)
        else
            gDrawCubicBezier(canvas,xmin,ymin+rc,xmin,ymin+rc/2,xmin+rc/2,ymin,xmin+rc,ymin,colour,style,width) -- tl
            gDrawCubicBezier(canvas,xmax-rc,ymin,xmax-rc/2,ymin,xmax,ymin+rc/2,xmax,ymin+rc,colour,style,width) -- tr
            gDrawCubicBezier(canvas,xmax,ymax-rc,xmax,ymax-rc/2,xmax-rc/2,ymax,xmax-rc,ymax,colour,style,width) -- br
--[DEV/ERM] fills in a missing pixel on Morpion_Solitaire... (both the frame and the buttons)
--          gDrawCubicBezier(canvas,xmin+rc,ymax,xmin+rc/2,ymax,xmin,ymax-rc/2,xmin,ymax-rc,colour,style,width) -- bl
            gDrawCubicBezier(canvas,xmin+rc,ymax,xmin+rc/2,ymax,xmin,ymax-rc/2,xmin,ymax-rc-1,colour,style,width) -- bl
        end if
        l = xmin+rc
        t = ymin
        r = xmax-rc
        b = ymax--1

        if bFill then
            for i=ymin to ymin+rc do
--              gDrawLine(canvas,l,i,r,i,colour,style,width)    -- top
                gDrawLine(canvas,l,i,r,i,colour,style)  -- top
--              gDrawLine(canvas,l,b,r,b,colour,style,width)    -- btn
                gDrawLine(canvas,l,b,r,b,colour,style)  -- btn
                b -= 1
            end for
            l = xmin
            r = xmax
            for i=ymin+rc+1 to ymax-rc-1 do
--              gDrawLine(canvas,l,i,r,i,colour,style,width)    -- mid
                gDrawLine(canvas,l,i,r,i,colour,style)  -- mid
            end for
        else
--          gDrawLine(canvas,l,t,r,t,colour,style,width)    -- top
            gDrawLine(canvas,l,t,r,t,colour,style)  -- top
--          gDrawLine(canvas,l,b,r,b,colour,style,width)    -- btn
            gDrawLine(canvas,l,b,r,b,colour,style)  -- btn
            l = xmin
            t = ymin+rc
            r = xmax
            b = ymax-rc
--          gDrawLine(canvas,l,t,l,b,colour,style,width)    -- left
            gDrawLine(canvas,l,t,l,b,colour,style)  -- left
--          gDrawLine(canvas,r,t,r,b,colour,style,width)    -- right
            gDrawLine(canvas,r,t,r,b,colour,style)  -- right
        end if
    elsif bFill then
        for i=ymin to ymax do
--          gDrawLine(canvas,xmin,i,xmax,i,colour,style,width)
            gDrawLine(canvas,xmin,i,xmax+1,i,colour,style)
        end for         
    else -- square unfilled rect    
--      gDrawLine(canvas,xmin,ymin,xmax,ymin,colour,style,width)    -- top
        gDrawLine(canvas,xmin,ymin,xmax,ymin,colour,style)  -- top
--      gDrawLine(canvas,xmin,ymax,xmax,ymax,colour,style,width)    -- btm
        gDrawLine(canvas,xmin,ymax,xmax,ymax,colour,style)  -- btm
-- taken (back) out for NumberTripletsGame, after gDrawLine (wrong-way) fixed... (9.7.26)
--      ymin += 1
--      ymax -= 1
--      gDrawLine(canvas,xmin,ymin,xmin,ymax,colour,style,width)    -- left
        gDrawLine(canvas,xmin,ymin,xmin,ymax,colour,style)  -- left
--      gDrawLine(canvas,xmax,ymin,xmax,ymax,colour,style,width)    -- right
        gDrawLine(canvas,xmax,ymin,xmax,ymax,colour,style)  -- right
    end if
end procedure


global procedure gDrawPolygon(gcps canvas, sequence poly, bool bFilled=true, atom colour=-1, integer width=-1, object style=-1)
    assert(not sequence(canvas),`gPixbuf must be theGUI-owned`,nFrames:=2)
    --
    -- draw a (possibly multi-part) polygon.
    -- much credit and thanks to http://alienryderflex.com/polygon/ (but not much final code)
    --
    if colour=-1 then colour = gGetAttribute(canvas,`FGCLR`) end if
    if bFilled then
        width = 1
        style = TG_CONTINUOUS
    else
        if width=-1 then width = gGetAttribute(canvas,`LINEWIDTH`) end if
        if style=-1 then style = gGetAttribute(canvas,`LINESTYLE`) end if
    end if
    if canvas>0 then
        canvas = ctrl_images[canvas]
    end if
    -- draw outline
    integer l = length(poly), start = 1;
    for i=1 to l do
        sequence pi = poly[i]
        integer lpi = length(pi)
        if lpi==0 then -- (new loop)
            start = i+1
        else
            integer e = iff(i=l or poly[i+1]={}?start:i+1)
            assert(e!=i)
            atom {eX,eY} = poly[e],
                 {sX,sY} = pi
                 
            if lpi==2 then  // straight line
                if sX!=eX or sY!=eY then
--                  gDrawLine(canvas,sX,sY,eX,eY,colour,style,width)
                    gDrawLine(canvas,sX,sY,eX,eY,colour,style)
                end if
            elsif lpi==8 then // arc
                -- a segment of length 8 aka {sx,sy,xc,yc,w,h,a1,a2} is an arc
                --  (iX/iY/eX/eY are not used here)
                atom {xc,yc,w,h,a1,a2} = pi[3..8] -- (assumes rot of 0)
--              gDrawArc(canvas,xc,yc,w,h,a1,a2,0,false,colour,width,style)
                gDrawArc(canvas,xc,yc,w,h,a1,a2,0,false,colour,style)
            elsif lpi=4
               or lpi=6 then
                atom {xc1,yc1} = pi[3..4],
                     {xc2,yc2} = iff(lpi>4?pi[5..6]:{xc1,yc1})
                gDrawCubicBezier(canvas,sX,sY,xc1,yc1,xc2,yc2,eX,eY,colour,style,width)
            else
                crash(`unrecognised polygon segment length(%d)`,{lpi},nFrames:=2)
            end if
        end if -- (not new loop)
    end for
    if bFilled then
        tg_polyfill(canvas,poly,colour)
    end if
end procedure

local function tg_shifta(atom x, y, w, h, rot_pt, atom angle)
    --
    -- shift the NW corner to effect rotation about rot_pt
    --
    atom nx = x, ny = y
    if rot_pt!=TG_NW and angle!=0 then -- (not the do nowt cases)
        --
        -- {vx,vy} is the vector from rot_pt to {x,y} at TG_NW, in other
        --          words a transform of {x,y} such that rot_pt is {0,0}.
        --          All non-0 vx|y will in practice be -ve, which makes
        --          sense when you consider where TG_NW is, vs other 8.
        -- {tx,ty} is {vx,vy} rotated about {0,0} by angle (std geometry).
        --          Note that standard geometry has y=0 at the bottom,
        --          whereas theGUI has it at the top: signs / [counter]
        --          clockwise direction may therefore be a bit squiffy.
        -- {nx,ny} is obvs {x,y} adjusted by difference between v and t.
        --
        -- reminder: TG_{N|E|S|W} are four-bit 0bWENS bitmasks, with
        --           neither 0b1100 nor 0b0011 ever simultaneously set.
        --
        atom vx = {-w/2,-w,0}[floor(rot_pt/0b100)+1],
             --ie (  C, E, W) aka Centre/East/West, as (0|1|2)+1
             vy = {-h/2,-h,0}[rmdr(rot_pt,0b100)+1],
             --ie (  C, S, N) aka Centre/South/North,     ""
             ra = (360-angle)*TG_DEG2RAD, -- (cw <==> ccw, radians)
              c = cos(ra),
              s = sin(ra)
        integer tx = round(vy*s+vx*c),
                ty = round(vy*c-vx*s)
        nx += tx-vx
        ny += ty-vy
    end if
    return {nx,ny}
end function

global procedure gDrawText(gcps canvas, atom x, y, string text, sequence args={}, integer align=TG_E, object angle=0, colour=-1, style=-1)
--?{"gDrawText",canvas, x, y, text, args, gGetAlignName(align), angle, gGetColourName(colour), style}
    assert(gdc(canvas),`gDrawText cannot be used on a gPixBuf!`,nFrames:=2)
    if length(text)!=0 then
        if length(args) then text = sprintf(text,args) end if
        bool bNorm = false
        integer after_effect = 0
        if sequence(style) and not string(style) then
            if length(style)=3 then
                after_effect = style[3]
            end if
            {style,bNorm} = style
        end if
        if integer(style) and style>=TG_UNDERLINE then
            after_effect = style
            style = -1
        end if
        x = round(x)
        y = round(y)
        if align=TG_CENTER then align=TG_C end if
        integer N = and_bits(align,TG_N),
                E = and_bits(align,TG_E),
                W = and_bits(align,TG_W),
                S = and_bits(align,TG_S),
           rot_pt = TG_NW, w, h
        if sequence(angle) then
            {rot_pt,angle} = angle
            if rot_pt=TG_CENTER then rot_pt=TG_C end if
        end if
        atom {fgclr, bgclr} = iff(sequence(colour)?colour:{colour,-1})
        string face, pstyle = gGetAttribute(canvas,`FONT`)
        if string(style) then
            face = style
        elsif style=-1 then
            face = pstyle
        else
            --
            -- style: may be TG_NORMAL, TG_BOLD, TG_ITALIC, or TG_BOLDITALIC.
            -- aside: this is different to the similar-looking code in tg_set_font, in
            --        that we're taking an existing font and adding bold/italic to it.
            --        (and actually, TG_NORMAL+ may in fact be removing said styles..)
            --        That said, if you wanna factor out some common code be my guest.
            --
            integer comma = find(',',pstyle), fontsize = 0
            face = pstyle[1..comma-1]&`, `
            sequence styles = split(pstyle[comma+1..$])
            if length(styles) then      
                fontsize = to_integer(styles[$])
                styles = {}
            end if
            styles = {}
            if and_bits(style,TG_BOLD) then styles &= {`Bold`} end if
            if and_bits(style,TG_ITALIC) then styles &= {`Italic`} end if
            if length(styles) then
                face &= join(styles)&` `
            end if
            if fontsize<0 then
                face &= sprintf(`%dpx`,-fontsize)
            elsif fontsize then
                face &= sprintf(`%d`,fontsize)
            end if
            if pstyle==face then
                style = -1
            end if
        end if
        bool bItalic = match("Italic",face)!=0
        if fgclr=-1 then fgclr = gGetAttribute(canvas,`FGCLR`) end if
        if canvas>0 then -- a gCanvas
            canvas = ctrl_images[canvas]
        end if
        assert(gdm(canvas)) -- it **must** be a gImage here...
        integer gid = (-canvas+1)/2
        if backend=TG_GTK then
--DEV see tg_gtk_get_layout()...
            atom pixbuf = gimages[gid][TG_IMG_HANDLE]
            integer pw = c_func(x_gdk_pixbuf_get_width,{pixbuf}),
                    ph = c_func(x_gdk_pixbuf_get_height,{pixbuf}),
                stride = c_func(x_gdk_pixbuf_get_rowstride,{pixbuf})
            atom pixels = c_func(x_gdk_pixbuf_get_pixels,{pixbuf}),
                surface = c_func(x_cairo_image_surface_create_for_data,
                          {pixels, CAIRO_FORMAT_ARGB32, pw, ph, stride}),
                  cairo = c_func(x_cairo_create,{surface})
            object rect = gimages[gid][TG_IMG_CLIP]
            if rect!=NULL then
                atom {xmin, ymin, xmax, ymax} = rect
                c_proc(x_cairo_rectangle,{cairo,xmin,ymin,xmax-xmin,ymax-ymin})
                c_proc(x_cairo_clip,{cairo})
            end if

            nnatom layout = c_func(x_pango_cairo_create_layout,{cairo})
            tg_set_font(0,layout,face,angle)
--</see>
            if not bNorm then
                text = tg_gtk_mnemonicalize(text) -- eg "&File" -> "_File"
            end if
            h = max(length(split(text,'\n')),1)
            h *= tg_GTK_get_image_text_height(layout)
            w = tg_GTK_get_image_text_width(layout,text,bNorm)
            x -= iff(W?w+2:iff(E?-1:ceil(w/2)-1))
            y -= iff(N?h+1:iff(S?0:ceil(h/2)+1))
            if angle!=0 then
                {x,y} = tg_shifta(x,y,w,h,rot_pt,angle)
            end if
            if bgclr!=-1 then
                integer {t,r,b,l} = {y-1,x+w,y+h-1,x-2} 
                if angle=0 then
--DEV or 90,180,360...
                    gDrawRect(canvas,l,t,r,b,true,colour:=bgclr)
                else
                    sequence poly = {{l,t},{r,t},{r,b},{l,b}}
                    poly = gRotatePolygon(poly, angle)
                    gDrawPolygon(canvas,poly,true,colour:=bgclr)
                end if
            end if
            c_proc(x_cairo_move_to,{cairo,x+iff(bItalic?-1:+1),y})
            c_proc(x_cairo_save,{cairo})
            if angle then
                c_proc(x_cairo_rotate,{cairo,angle*PI/180})
            end if
            fgclr = tg_GTK_rgba_to_bgra(fgclr)
            atom {r,g,b} = to_rgba(fgclr)
            c_proc(x_cairo_set_source_rgb,{cairo,r/255,g/255,b/255})
            c_proc(x_pango_cairo_show_layout,{cairo,layout})
            c_proc(xg_object_unref,{layout})
            c_proc(x_cairo_restore,{cairo})
            c_proc(x_cairo_destroy,{cairo})
            c_proc(x_cairo_surface_destroy,{surface})
        elsif backend=TG_WINAPI then
            atom hDC = tg_WinAPI_GetDestDC(),
                hTgt = gimages[gid][TG_IMG_HANDLE],
                pTgt = c_func(xSelectObject,{hDC,hTgt})
            atom bgr = tg_WinAPI_rgb_to_bgr(fgclr)
            if bgclr=-1 then
                {} = c_func(xSetBkMode,{hDC,TRANSPARENT})
            else
                {} = c_func(xSetBkMode,{hDC,OPAQUE})
                atom bgbgr = tg_WinAPI_rgb_to_bgr(bgclr)
                {} = c_func(xSetBkColor,{hDC,bgbgr})
            end if
            {} = c_func(xSetTextColor,{hDC,bgr})
            tg_set_font(0,hDC,face,0)
            object wasfont = gimages[gid][TG_IMG_DRAW_FONT]
            if wasfont!=face then
                gimages[gid][TG_IMG_DRAW_FONT] = face
            end if
            {w,h} = gGetTextExtent(text,canvas,bNorm)
            if angle then
                tg_set_font(0,hDC,face,angle)
            end if
            if bNorm and find('&',text) then
                -- convert eg `&lt;` to `&&lt;` to defeat mnemonic handling / make it appear `normal`.
                string txt = ``
                for c in text do
                    txt &= iff(c='&'?`&&`:c)
                end for
                text = txt
            elsif text[$]='&' then
                -- check for lone trailing '&' --> "&&"
                bool skip = false
                for c in text do
                    if skip then
                        skip = false
                    elsif c='&' then
                        skip = true
                    end if
                end for
                if skip then text &= '&' end if
            end if
            sequence utf16 = utf8_to_utf16(text)
            integer l = length(utf16)
            atom pUTF16 = allocate(2*l)
            poke2(pUTF16,utf16)
            x -= iff(W?w+1:iff(E?-1:ceil(w/2)-1))
            y -= iff(N?h:iff(S?0:floor(h/2+1)))
            {x,y} = tg_shifta(x,y,w,h,rot_pt,angle)
            set_struct_field(idRECT,pRECT,`left`,x)
            set_struct_field(idRECT,pRECT,`top`,y)
            set_struct_field(idRECT,pRECT,`right`,x+w)
            set_struct_field(idRECT,pRECT,`bottom`,y+h)
            h = c_func(xDrawText,{hDC,pUTF16,l,pRECT,DT_NOCLIP})
            free(pUTF16)
            tg_WinAPI_handles_match(hTgt,c_func(xSelectObject,{hDC,pTgt}),source_line())
            if wasfont!=face then
                gimages[gid][TG_IMG_DRAW_FONT] = wasfont
            end if
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gDrawText)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
        if after_effect=TG_SQUIGGLE then
            -- spellcheck squiggle
            integer amp = iff(h<18 ? 1 : floor(h/10)),
                    wave = amp*3,
                 baseline = y+h-1-(backend=TG_WINAPI)
            for qx=x to x+w do
                integer p = remainder(qx-x,wave),
                     yoff = round(amp*iff(p<wave/2?p:wave-p)/(wave/2))
                gDrawPixel(canvas,qx,baseline+yoff,TG_RED)
            end for
        elsif after_effect then
            y += iff(after_effect=TG_UNDERLINE?h-1-(backend=TG_WINAPI)
                         /*else TG_STRIKEOUT*/:h/2+(backend=TG_GTK))
            if bItalic and backend=TG_GTK then x -= 2 end if
--          gDrawLine(canvas,x,y,x+w,y,TG_BLACK,TG_CONTINUOUS,1)
            gDrawLine(canvas,x,y,x+w,y,TG_BLACK,TG_CONTINUOUS)
        end if
    end if -- length(text)=0
end procedure

local constant integer SBC_BACK = #F0F0F0,
-- W10:
                     SBC_ARROWS = #606060, -- (inactive)
                     SBC_MONARB = #DADADA, -- mouse hovering on arrow background
                      SBC_THUMB = #CDCDCD, -- (inactive)
                  SBC_THUMBDRAG = #606060, -- thumb being dragged 
                   SBC_THUMBHOV = #A6A6A6, -- mouse hovering on a thumb
                  SBC_SCROLLHOV = #C0C0C0, -- hover off thumb
--                   SBC_RESIZE = #BFBFBF
-- W11:
                       SBC_THMB = #858585, -- thin/fat thumb
                       SBC_SOFT = #B8B8B8 -- (to soften thumb ends)

object ab_uldr = NULL -- ua,ub,la,lb,da,db,ra,rb (W11 scrollbar arrows)

local procedure tg_get_scroll_arrows()
    ab_uldr = apply(tg_XPM_from_shorthand(`scroll_arrows`),gImage_from_XPM)
end procedure

local procedure tg_redraw_scrollbars(gdx canvas)
    integer {w,h} = gGetIntInt(canvas,`SIZE`),
        scrollfix = gGetInt(canvas,`SCROLLFIX`),
      {scbw,scbh} = gGetIntInt(canvas,`SCROLLSIZE`),
              W10 = platform()=WINDOWS and gVersion(-2)=10
    gSetAttribute(canvas,`LINESTYLE`,TG_CONTINUOUS)
    gSetAttribute(canvas,`LINEWIDTH`,1)
    integer {mx,my} = gGetAttribute(canvas,`MOUSEPOS`),
             x, y -- scratch vars

--  string monsba = tg_get_mouse_on_scrollbar(canvas,mx,my)
    sequence sbinfo = ctrl_sbinfo[canvas]
    ctrl_sbinfo[canvas] = NULL
    integer sbwid = sbinfo[SB_VWIDE],
            sbhgh = sbinfo[SB_HHIGH],
            origx = sbinfo[SB_ORIGX],
            origy = sbinfo[SB_ORIGY]
    bool hsbvis = (scrollfix && 0b10) or w<scbw, -- (w/o vertical, for now...)
         vsbvis = (scrollfix && 0b01) or (h-(hsbvis*sbwid))<scbh,
         bDragging = sbinfo[SB_DRAGG],
         bTrackMouse = false
    string clikmon = sbinfo[SB_CKMON],
            monsba = sbinfo[SB_MONLD]
    if vsbvis then
        hsbvis = (w-sbwid)<scbw -- (ok, /with/ vertical)

        integer sbvend = h - hsbvis*sbhgh
        -- vertical thumb:
        integer vttop = sbwid,
                vtend = sbvend-sbwid,
                vtmax = sbvend-sbwid*2,
                vtlen = ceil((sbvend/scbh)*vtmax)
        if vtend<vttop then
            -- draw as single line in the middle then
            vttop = floor((vttop+vtend)/2)
--DEV this ain't quite right either... (end==top draws nowt, when it should be a line)
--          vtend = vttop
--          vtend = vttop+1
            vtlen = 1
        end if
        vttop += round((origy/scbh)*vtmax)
        vtend = vttop+vtlen
        -- (aside: arrow regions are square...)
if W10 then
        gDrawRect(canvas,w-sbwid,0,w,h,true,colour:=SBC_BACK)
        integer uarrclr = SBC_ARROWS,
                darrclr = SBC_ARROWS
        if monsba=`UA` then -- highlight uparrow background
            gDrawRect(canvas,w-sbwid+1,0,w-1,sbwid,true,colour:=SBC_MONARB)
            uarrclr = TG_BLACK
            bTrackMouse = true
        elsif monsba=`DA` then -- highlight downarrow background
            gDrawRect(canvas,w-sbwid+1,sbvend-sbwid,w-1,sbvend,true,colour:=SBC_MONARB)
            darrclr = TG_BLACK
            bTrackMouse = true
        end if
        -- draw the up and down arrows themselves
        --DEV: these 3/6/7/8/9 should probably be derived from SBWID...
        x = w-9
        for i=0 to 3 do -- 1 centre and 3 staggered side lines, ie/eg:
                        --              X            X     X
                        --             XXX           XX   XX
                        --            XX XX           XX XX
                        --           XX   XX           XXX
                        --           X     X            X
                        --          (3210123)       (3210123)
                        -- (but X chars are less square than pixels)
            integer xi = x-i,  yut = 7+i,  ydt = sbvend-8-i,
                               yub = 9+i,  ydb = sbvend-6-i
            gDrawLine(canvas,xi,yut,xi,yub,colour:=uarrclr)
            gDrawLine(canvas,xi,ydt,xi,ydb,colour:=darrclr)
            if i then
                xi = x+i
                gDrawLine(canvas,xi,yut,xi,yub,colour:=uarrclr)
                gDrawLine(canvas,xi,ydt,xi,ydb,colour:=darrclr)
            end if
        end for
        integer thumbclr = SBC_THUMB
        if bDragging and clikmon = `VT` then
            thumbclr = SBC_THUMBDRAG
            bTrackMouse = true
        elsif monsba=`VT` then
            thumbclr = SBC_THUMBHOV
            bTrackMouse = true
        elsif monsba!=`` then
            thumbclr = SBC_SCROLLHOV
            bTrackMouse = true
        end if
        gDrawRect(canvas,w-sbwid+1,vttop,w-1,vtend,true,colour:=thumbclr)
else -- W11
        gDrawRect(canvas,w-sbwid+1,0,w,h,true,colour:=SBC_BACK)
        bTrackMouse = iff(bDragging?clikmon=`VT`
                                   :find(monsba,{`UA`,`AT`,`VT`,`BT`,`DA`})!=0)
        if bTrackMouse then
            -- draw the up and down arrows
            if ab_uldr=NULL then tg_get_scroll_arrows() end if
            atom ua = ab_uldr[1+(monsba=`UA`)],
                 da = ab_uldr[5+(monsba=`DA`)]
            gDrawImage(ua,canvas,w-13,5)
            gDrawImage(da,canvas,w-13,sbvend-13)
        end if
        -- draw the fat/thin thumb
        --DEV the real thing also has a fade in/out timer...
        if bTrackMouse then
            gDrawRect(canvas,w-10,vttop+0,w-7,vtend-0,true,colour:=SBC_SOFT)
            gDrawRect(canvas,w-11,vttop+1,w-6,vtend-1,true,colour:=SBC_SOFT)
            gDrawRect(canvas,w-10,vttop+1,w-7,vtend-1,true,colour:=SBC_THMB)
            gDrawRect(canvas,w-11,vttop+2,w-6,vtend-2,true,colour:=SBC_THMB)
        end if
        gDrawRect(canvas,w-9,vttop,w-8,vtend,true,colour:=SBC_THMB)
end if
        sbinfo[SB_VTTOP] = vttop
        sbinfo[SB_VTEND] = vtend
    end if
    if hsbvis then
        integer sbhend = w - vsbvis*sbwid
        -- horizontal thumb:
        integer htlft = sbhgh,
                htend = sbhend-sbhgh,
                htmax = sbhend-sbhgh*2,
                htlen = ceil((sbhend/scbw)*htmax)
        if htend<htlft then
            -- draw as one line in the middle then
            htlft = floor((htlft+htend)/2)
--          htend = htlft
            htlen = 1
        end if
        htlft += round((origx/scbw)*htmax)
--DEV this overruns by 1 pixel, plus I think I actually want a (min) 1-pixel gap.
        htend = htlft+htlen
if W10 then
        gDrawRect(canvas,0,h-sbhgh,sbhend,h,true,colour:=SBC_BACK)
        -- left and right arrows on the horizontal:
        integer larrclr = SBC_ARROWS,
                rarrclr = SBC_ARROWS
        if monsba=`LA` then -- highlight leftarrow background
            gDrawRect(canvas,0,h-sbhgh+1,sbhgh,h-1,true,colour:=SBC_MONARB)
            larrclr = TG_BLACK
            bTrackMouse = true
        elsif monsba=`RA` then -- highlight rightarrow background
            gDrawRect(canvas,sbhend-sbhgh,h-sbhgh+1,sbhend,h-1,true,colour:=SBC_MONARB)
            rarrclr = TG_BLACK
            bTrackMouse = true
        end if
        --DEV: these 3/5/7/9 should probably be derived from SBHGH...
        y = h-9
        for i=0 to 3 do -- 1 centre with 3 staggered lines, ie/eg:
                        --         XX       (3)       XX
                        --        XX        (2)        XX
                        --       XX         (1)         XX
                        --      XX          (0)          XX 
                        --       XX         (1)         XX
                        --        XX        (2)        XX
                        --         XX       (3)       XX
                        -- (but X chars are less square than pixels)
            integer yi = y-i,  xll = 5+i,  xrl = sbhend-9-i,
                               xlr = 7+i,  xrr = sbhend-7-i
            gDrawLine(canvas,xll,yi,xlr,yi,colour:=larrclr)
            gDrawLine(canvas,xrl,yi,xrr,yi,colour:=rarrclr)
            if i then
                yi = y+i
                gDrawLine(canvas,xll,yi,xlr,yi,colour:=larrclr)
                gDrawLine(canvas,xrl,yi,xrr,yi,colour:=rarrclr)
            end if
        end for
        integer thumbclr = SBC_THUMB
        if bDragging and clikmon = `HT` then
            thumbclr = SBC_THUMBDRAG
            bTrackMouse = true
        elsif monsba=`HT` then
            thumbclr = SBC_THUMBHOV
            bTrackMouse = true
        elsif monsba!=`` then
            thumbclr = SBC_SCROLLHOV
            bTrackMouse = true
        end if
        gDrawRect(canvas,htlft,h-sbhgh+1,htend,h-1,true,colour:=thumbclr)
else -- W11
        gDrawRect(canvas,0,h-sbhgh+1,sbhend,h,true,colour:=SBC_BACK)
        bool wasTrackMouse = bTrackMouse
        bTrackMouse = iff(bDragging?clikmon=`HT`
                                   :find(monsba,{`LA`,`LT`,`HT`,`RT`,`RA`})!=0)
        if bTrackMouse then
            -- draw the left and right arrows
            if ab_uldr=NULL then tg_get_scroll_arrows() end if
            atom la = ab_uldr[3+(monsba=`LA`)],
                 ra = ab_uldr[7+(monsba=`RA`)]
            gDrawImage(la,canvas,5,h-13)
            gDrawImage(ra,canvas,sbhend-13,h-13)
        end if
        -- draw the fat/thin thumb
        --DEV the real thing also has a fade in/out timer...
        if bTrackMouse then
            gDrawRect(canvas,htlft+0,h-10,htend-0,h-7,true,colour:=SBC_SOFT)
            gDrawRect(canvas,htlft+1,h-11,htend-1,h-6,true,colour:=SBC_SOFT)
            gDrawRect(canvas,htlft+1,h-10,htend-1,h-7,true,colour:=SBC_THMB)
            gDrawRect(canvas,htlft+2,h-11,htend-2,h-6,true,colour:=SBC_THMB)
        end if
        gDrawRect(canvas,htlft,h-9,htend,h-8,true,colour:=SBC_THMB)
        bTrackMouse ||= wasTrackMouse
end if
        sbinfo[SB_HTLFT] = htlft
        sbinfo[SB_HTEND] = htend
    end if
    sbinfo[SB_HVISB] = hsbvis
    sbinfo[SB_VVISB] = vsbvis
--  sbinfo[SB_MONLD] = monsba
    ctrl_sbinfo[canvas] = sbinfo
    g_log(`set`,`ctrl_sbinfo`,source_line(),deep_copy(sbinfo))
--GTK equivalent to TrackMouseEvent and WM_MOUSELEAVE
--def window_exit(widget, event, user_data)
--The event is very important because its variable 'event.detail' tells us exactly what kind of leave-event happened. 
--In your case, you want to test if it is equal to 'gtk.gdk.NOTIFY_NONLINEAR', because that means the pointer has "truly" left the window.
--So, you should probably put something like
--if (event.detail != gtk.gdk.NOTIFY_NONLINEAR)  { return; }
--window.connect(`leave-notify-event`, window_exit, ``)
--not sure if we need this anymore... (needs testing with a mid-layout scrollbar, and/or see tg_redraw_scrollbars)
    tg_track_mouseleave(canvas,bTrackMouse)
end procedure

local function tg_gtk_draw_area_focus(atom /*widget*/, /*event*/, dlg)
    gSetFocus(dlg)
    return false -- Allow event to propagate (so clicks still register, but focus moves)
end function

local procedure tg_redraw_canvas(gdx canvas)
    -- (shared between GTK and WinAPI, via tg_gtk_canvas_draw,
    --  and WM_PAINT code in tg_WinAPI_WndProc respectively.)
    integer {w, h} = gGetIntInt(canvas,`SIZE`)
    if ctrl_types[canvas]=VIDEO then
        gdx dlg = gGetDialog(canvas)
        if dlg=NULL then
            assert(and_bits(ctrl_flags[canvas],CF_POPUP))
            dlg = ctrl_hdc[canvas][3]
        end if
        atom window = ctrl_handles[dlg], handle, video_child,
          draw_area = ctrl_xtra[canvas][CX_MPV_AREA]
        if draw_area=-1 then
            integer mpv_init = ctrl_xtra[canvas][CX_MPV_INIT]
            if backend=TG_GTK then
                video_child = c_func(x_gtk_window_new,{GTK_WINDOW_TOPLEVEL})
                c_proc(x_gtk_window_set_transient_for,{video_child,window})
                c_proc(x_gtk_window_set_decorated,{video_child,false})
                c_proc(x_gtk_window_set_resizable,{video_child,false})
                draw_area = c_func(x_gtk_drawing_area_new,{})
                c_proc(x_gtk_widget_set_size_request,{draw_area,w,h})
                c_proc(x_gtk_container_add,{video_child,draw_area})
                c_proc(x_gtk_widget_show_all,{video_child})
                tg_gtk_signal_connect(video_child,`focus-in-event`,tg_gtk_draw_area_focus,dlg)
--              ctrl_xtra[canvas][CX_MPV_AREA] = draw_area
                atom gdk_video_win = c_func(x_gtk_widget_get_window,{draw_area})
                if gdk_video_win = 0 then ?9/0 end if
                -- gdk_x11_window_get_xid(window) when on Linux??
                if platform()!=WINDOWS then ?9/0 end if -- placeholder...
                handle = iff(bGTK2?c_func(x_gdk_win32_drawable_get_handle,{gdk_video_win})
                                  :c_func(x_gdk_win32_window_get_handle,{gdk_video_win}))
            elsif backend=TG_WINAPI then
                handle = c_func(xCreateWindowEx,{
                            0,                            -- dwExStyle
                            STATIC,                       -- lpClassName (predefined static control)
                            NULL,                         -- lpWindowName (no text)
                            WS_CHILD || WS_VISIBLE,       -- dwStyle (child + visible)
                            0, 0, 0, 0,                   -- x, y, width, height (we'll size in WM_SIZE)
                            window,                       -- hWndParent (our main window)
                            NULL,instance(),NULL})
                if handle=NULL then ?9/0 end if
                draw_area = handle
--              ctrl_xtra[canvas][CX_MPV_AREA] = handle
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (tg_getID)`);
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
            ctrl_xtra[canvas][CX_MPV_AREA] = draw_area
            mpv_init(handle)
        end if
        bool bMax = gGetAttribute(dlg,`MAXIMISED`),
             bFullScreen = gGetAttribute(dlg,`FULLSCREEN`)
--/*
        integer x = 0, y = 0
        if bMax then
            {w,h} = gGetGlobal(`SCREENSIZE`)
        else
            x = ctrl_size[canvas][SZ_X]
            y = ctrl_size[canvas][SZ_Y]
        end if
--*/
        integer x = ctrl_size[canvas][SZ_X],
                y = ctrl_size[canvas][SZ_Y]
--?{"video",x,y,w,h,bMax}
--/*
BUG: [FIXED]
{"video",0,23,720,480,0}
{"video",0,23,1920,989,1}
{"video",0,23,720,480,1}
{"video",0,23,720,480,1}
{"video",0,23,720,480,1}
{"video",0,23,720,480,0}
--*/
        if backend=TG_GTK then
            c_proc(x_gtk_widget_set_size_request,{draw_area,w,h})
            set_struct_field(idGdkRectangle,pRECT,"x",0)
            set_struct_field(idGdkRectangle,pRECT,"y",0)
            set_struct_field(idGdkRectangle,pRECT,"width",w)
            set_struct_field(idGdkRectangle,pRECT,"height",h)
            c_proc(x_gtk_widget_size_allocate,{draw_area,pRECT})
            video_child = c_func(x_gtk_widget_get_parent,{draw_area})
            c_proc(x_gtk_widget_size_allocate,{video_child,pRECT})
        elsif backend=TG_WINAPI then
--          integer uFlags = SWP_NOZORDER+SWP_NOACTIVATE
            integer uFlags = SWP_NOZORDER || SWP_NOACTIVATE
--?{x,y,w,h}
--handle = draw_area
            -- for gVidCut:
            if bFullScreen then
                h += 8 
-- right amount, wrong place...
--          else
--              y -= 3
            end if
            bool bOK = c_func(xSetWindowPos,{draw_area,NULL,x,y,w,h,uFlags})
            if not bOK then ?9/0 end if
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_getID)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
        return
    end if // VIDEO
    atom back = gGetAttribute(canvas,`BGCLR`)
    object sbinfo = ctrl_sbinfo[canvas]
    if sequence(sbinfo) then
        integer mox = sbinfo[SB_SCRLW]-(w-sbinfo[SB_VVISB]*sbinfo[SB_VWIDE]),
                moy = sbinfo[SB_SCRLH]-(h-sbinfo[SB_HVISB]*sbinfo[SB_HHIGH]),
                origx = max(min(sbinfo[SB_ORIGX],mox),0),
                origy = max(min(sbinfo[SB_ORIGY],moy),0)
        sbinfo = {} -- (kill refcount)
        ctrl_sbinfo[canvas][SB_ORIGX] = origx
        ctrl_sbinfo[canvas][SB_ORIGY] = origy
        g_log(`set(orig)`,`ctrl_sbinfo`,source_line(),deep_copy(ctrl_sbinfo[canvas]))
    end if
    rtn redraw = gGetHandler(canvas,`REDRAW`)
    assert(redraw!=NULL) -- tg_canvas_edge should have kicked in...
    string sig = tg_get_sig(redraw)
    if sig=`PO` then
        redraw(canvas)
    elsif sig=`POII` then
        redraw(canvas,w,h)
    elsif sig=`POIIII` then
        integer {ox,oy} = gGetIntInt(canvas,`VIEWPORT`)
        redraw(canvas,w,h,ox,oy)
    else
        ?9/0
    end if
    if and_bits(ctrl_flags[canvas],CF_SCROLLBARS) then
        -- aside: ^^ may well have changed inside redraw()
        tg_redraw_scrollbars(canvas)
    end if
    gSetAttribute(canvas,`BGCLR`,back)
end procedure

local procedure tg_draw_control_images(gdx id)
    integer {w,h} = gGetAttribute(id,`SIZE`)
    -- always create an image, and stop 
    -- length(image[1]) from blowing up
    w = max(w,1)
    h = max(h,1)
    gdn image = ctrl_images[id]
    -- (re)create an image if we need to
    if image!=NULL then
        integer imdx = (-image+1)/2
        if w!=gimages[imdx][TG_IMG_WIDTH]
        or h!=gimages[imdx][TG_IMG_HEIGHT] then
            ctrl_images[id] = NULL -- (jic)
            image = gImageDestroy(image)
        end if
    end if
    atom bgclr = gGetAttribute(id,`BGCLR`)
    if image=NULL then
        image = gImage(w,h,bgclr)
        ctrl_images[id] = image
        string font = gGetAttribute(id,`FONT`)
        gSetAttribute(image,`FONT`,font)
    else -- just clear it
        tg_fill_image(image,w,h,bgclr)
    end if

    integer ct = ctrl_types[id]
    if ct=BOX then
        nullable_string title = ctrl_titles[id]
        if title!=NULL then -- frame aka BOX with title!=NULL
            if title="" then    --  "" untitled frame
                gDrawRect(image,0,0,w-1,h-1,rc:=5,colour:=#DCDCDC)
            else
                integer {tw,th} = gGetTextExtent(title,id)
                bool bActive = gGetAttribute(id,`ACTIVE`)
                atom txtclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
                gDrawRect(image,0,th/2,w-1,h-1,rc:=5,colour:=#DCDCDC)
                gDrawRect(image,7,1,tw+10,th,true,colour:=bgclr)
                gDrawText(image,8,0,title,{},TG_SE,colour:=txtclr)
            end if
        end if

        integer bl = ctrl_size[id][SZ_X],
                bt = ctrl_size[id][SZ_Y]
        for child in children_ids[id] do
            if gGetAttribute(child,`VISIBLE`) then
                tg_draw_control_images(child)
                integer x = ctrl_size[child][SZ_X]-bl,
                        y = ctrl_size[child][SZ_Y]-bt
                tg_copy_image(ctrl_images[child],image,x,y)
            end if
        end for
    else
        tg_redraw_canvas(id)
    end if
end procedure

local procedure tg_draw_dialog(gdx dlg)
    integer flags = ctrl_flags[dlg]
    ctrl_flags[dlg] = or_bits(flags,CF_REDRAW_IP)
    sequence children = children_ids[dlg]
    if length(children) then
        gdx child = children[1]
        if child and gGetAttribute(child,`VISIBLE`) then
            tg_draw_control_images(child)
            integer imdx = (-ctrl_images[child]+1)/2,
                       x = ctrl_size[child][SZ_X],
                       y = ctrl_size[child][SZ_Y],
                       w = ctrl_size[child][SZ_W],
                       h = ctrl_size[child][SZ_H]
            atom canvas = ctrl_xtra[dlg][DX_CANVAS],
                src_img = gimages[imdx][TG_IMG_HANDLE]
            if backend=TG_GTK then
                nnatom window = c_func(x_gtk_widget_get_window,{canvas}),
                       cairo = c_func(x_gdk_cairo_create,{window})
                c_proc(x_gdk_cairo_set_source_pixbuf,{cairo,src_img,x,y})
                c_proc(x_cairo_paint,{cairo})
                c_proc(x_cairo_fill,{cairo})
                c_proc(x_cairo_destroy,{cairo})
            elsif backend=TG_WINAPI then
                atom hWnd = ctrl_handles[dlg],
--for OpenGL:
                    dstDC = c_func(xBeginPaint,{hWnd,pPAINTSTRUCT}),
--                    hDC = c_func(xBeginPaint,{hWnd,pPAINTSTRUCT}),
--                  dstDC = ctrl_xtra[dlg][DX_MAIN_DC],
                    srcDC = tg_WinAPI_GetSrcDC(),
                   prevBM = c_func(xSelectObject,{srcDC,src_img})
                c_funk(xBitBlt,{dstDC,x,y,w,h,srcDC,0,0,SRCCOPY})
                prevBM = c_func(xSelectObject,{srcDC,prevBM})
                c_proc(xEndPaint,{hWnd,pPAINTSTRUCT})
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (tg_draw_dialog)`);
                #}ilJS
            else
                ?9/0 -- unknown backend
            end if
        end if
    end if
    ctrl_flags[dlg] = flags -- (remove CF_REDRAW_IP)
end procedure

local function tg_WinAPI_BUTTONDOWN(gdx id, integer msg, atom wParam, lParam, hWnd)
    -- given:
    --  WM_LBUTTONDOWN/UP/DBLCLK = 513/4/5,
    --  WM_RBUTTONDOWN/UP/DBLCLK = 516/7/8,
    --  WM_MBUTTONDOWN/UP/DBLCLK = 519/20/1:
    integer btn = floor((msg-WM_LBUTTONDOWN)/3)+1, -- 1..3 for l/r/m
            rb3 = remainder(msg-WM_LBUTTONDOWN,3)+1 -- 1..3 for s/r/d (single,release,double)
    if msg=WM_XBUTTONDOWN then -- (but this is different)
        btn = floor(wParam/#10000)
        assert(btn=1 or btn=2)
        rb3 = 2-(and_bits(btn*#20,wParam)!=0) -- (no dbl) -- 1..2
        btn += 3 -- 4/5 for x/y
    elsif msg=WM_LBUTTONDOWN then
        c_proc(xSetCapture,{hWnd})
    elsif msg=WM_LBUTTONUP then
        c_proc(xReleaseCapture,{})
    end if
    integer button = `LRMXY`[btn],
           pressed = `SRD`[rb3],
              x = and_bits(lParam,#FFFF),
              y = floor(lParam/#10000)
    if x>#7FFF then x -= #10000 end if
    if y>#7FFF then y -= #10000 end if
    bool ctrl = and_bits(c_func(xGetKeyState,{VK_XCTRL}),#8000)!=0,
        shift = and_bits(c_func(xGetKeyState,{VK_XSHIFT}),#8000)!=0,
          alt = and_bits(c_func(xGetKeyState,{VK_XALT}),#8000)!=0
    sequence status = {button,pressed,ctrl,shift,alt}
    integer res = tg_click_handler(id,status,x,y)
    return res=TG_IGNORE or res=TG_CLOSE
end function

local procedure tg_WINAPI_mousewheel(integer id, msg, lParam, wParam)
    bool ctrl = and_bits(c_func(xGetKeyState,{VK_XCTRL}),#8000)!=0,
        shift = and_bits(c_func(xGetKeyState,{VK_XSHIFT}),#8000)!=0 or msg=WM_MOUSEHWHEEL,
          alt = and_bits(c_func(xGetKeyState,{VK_XALT}),#8000)!=0
    integer x = and_bits(lParam,#FFFF) - ctrl_size[id][SZ_X],
            y = floor(lParam/#10000) - ctrl_size[id][SZ_Y],
            delta = iff(and_bits(wParam,#80000000)?-1:+1)
    if ctrl_types[id]=DIALOG then
        id = hit_test(id,x,y)
    end if
    tg_mousewheel(id,delta,ctrl,shift,alt)
end procedure

