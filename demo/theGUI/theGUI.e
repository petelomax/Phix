global procedure gDrawImage(gdm image, gcp canvas, atom x=0, y=0, sx=0, sy=0, integer w=-1, h=-1)
--global procedure gDrawImage(gdm image, gcp canvas, object x=0, y=0, atom sx=0, sy=0, integer w=-1, h=-1)
    assert(gdc(canvas),`gDrawImage cannot be used on a gPixBuf!`,nFrames:=2)
--  if sequence(x) then
--      -- gDrawImage(image,canvas,{x,y}[,{sx,sy}][,rest must be named]) style:
--      assert(length(x)=2 and (y=0 or (sequence(y) and length(y)=2)) and sx=0 and sy=0,`bad args`,nFrames:=2)
--      if sequence(y) then {sx,sy} = y end if
--      {x,y} = x
--      -- aside: the following calls to round() will catch any non-atoms left anyway
--  end if
    if canvas>0 then
        canvas = ctrl_images[canvas]
    end if
    assert(gdm(canvas))
    if not integer(x) then x = round(x) end if
    if not integer(y) then y = round(y) end if
    if not integer(sx) then sx = round(sx) end if
    if not integer(sy) then sy = round(sy) end if
    integer sdx = (-image+1)/2,
            tdx = (-canvas+1)/2,
             sw = gimages[sdx][TG_IMG_WIDTH],
             sh = gimages[sdx][TG_IMG_HEIGHT],
       {tw,th} = gGetAttribute(canvas,`SIZE`)
    if w=-1 then w = sw-sx end if
    if h=-1 then h = sh-sy end if
