-- also, for reasons lost in the mists of time, a gTimer stores MSECS in deferred_attr.

local procedure clear_tables() -- primarily for the benefit of tg_unit_tests()
    --
    -- ctrl_set_attr, ctrl_get_attr don't matter, likewise 
    -- gimages, gimgrey, tg_gte_image_cache, (some dicts),
    -- font_cache, cached_fonts, cached_font_names, 
    -- and idBITMAPINFOHEADER/idRGBQUAD from tg_xpm.e, as in
    -- leaving a bit of crud in there from tg_unit_tests() does not
    -- make subsequent debugging/diagnostics any harder - unlike 
    -- ~ninety meaningless entries in tg_lm_dump_ctrls() would.
    --
    ctrl_handles = {}
    ctrl_images = {}
    ctrl_types = {}
    type_names = {}
    ctrl_hdc = {}
    ctrl_flags = {}
    ctrl_parent = {}
    children_ids = {}
    ctrl_titles = {}
    tool_tips = {}
    ctrl_size = {}
    ctrl_font = {}
    ctrl_fonts = {}
    ctrl_bg = {}
    ctrl_fg = {}
    ctrl_penwidth = {}
    ctrl_penstyle = {}
    ctrl_xtra = {}
    ctrl_sbinfo = {}
    ctrl_cursors = {}
    user_data = {}
    deferred_attr = {}
    PrimaryWindowID = UNDEFINED
end procedure

