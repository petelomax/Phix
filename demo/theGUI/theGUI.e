            shl edi,2
            mov ecx,[len]
            mov eax,[bgclr]
            cmp eax,h4
            jl @f
                fld qword[ebx+eax*4]
                sub esp,8
                call :%down53
                fistp qword[esp]
                call :%near53
                mov eax,[esp]
                add esp,8
          @@:
        [64]
            mov rdi,[pDest]
            shl rdi,2
            mov rcx,[len]
            mov rax,[bgclr]
        []
            rep stosd
        }
    end if
    integer id = xpm_image_slot()
    sequence img = repeat(0,TG_IMG_SIZE)
    img[TG_IMG_HANDLE] = pImg
    img[TG_IMG_TRANSPARENT] = transparent
    img[TG_IMG_PIXEL_MEM] = pBits
    img[TG_IMG_WIDTH] = w
-- (might still be wanted, but not the culprit this time...)
    img[TG_IMG_HEIGHT] = h
--  img[TG_IMG_HEIGHT] = abs(h)
--1/7/26!!
--  img[TG_IMG_BGCLR] = TG_WHITE
    img[TG_IMG_BGCLR] = bgclr
    img[TG_IMG_LINESTYLE] = 1
    img[TG_IMG_LINEWIDTH] = 1
    gimages[id] = img
    gdm res = -id*2+1
    return res
end function

