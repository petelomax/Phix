procedure tg_btn_redraw(gdx btn, integer w, h)
    integer {tw,th} = gGetAttribute(btn,`SIZE`), tx, ty
    bool bActive = gGetAttribute(btn,`ACTIVE`),
         bHover = ctrl_xtra[btn][CXBTN_HOV]
    atom hclr
    if backend=TG_GTK then
        if bGTK2 then
            gDrawLine(btn,tw-1,0,tw-1,th-1,TG_BLACK)
            gDrawLine(btn,0,th-1,tw-1,th-1,TG_BLACK)
            gDrawLine(btn,tw-2,0,tw-2,th-2,#AFA699)
            gDrawLine(btn,0,th-2,tw-2,th-2,#AFA699)
            gDrawLine(btn,0,0,tw-2,0,TG_WHITE)
            gDrawLine(btn,0,0,0,th-2,TG_WHITE)
            {tx,ty} = {3,11}
            hclr = #EEEBE7
        elsif bGTK3 then
            gDrawRect(btn,0,0,tw-1,th-1,true,colour:=#DFDFDF) -- background
--          gDrawRect(btn,0,0,tw-1,th-1,true,colour:=#DFDF0F) -- background
--tw -= 10
            gDrawRect(btn,0,0,tw-1,th-1,colour:=#E8E8E7) -- corner bkgrnd
--          gDrawRect(btn,0,0,tw-1,th-1,colour:=#E808E7)
            gDrawLine(btn,2,1,tw-2,1,colour:=#FAFAFA) -- inner top line (subtle)
            {tx,ty} = {15,17}
            hclr = #E9E9E9
        else
            ?9/0 -- (unknown GTK version)
        end if
    elsif backend=TG_WINAPI then
        atom bgclr = gGetAttribute(btn,`BGCLR`)
        gDrawRect(btn,0,0,tw-1,th-1,true,colour:=iff(bActive?bgclr:#F9F9F9))
--      gDrawRect(btn,0,0,tw-1,th-1,true,colour:=iff(bActive?bgclr:#FDFDFD))
        gDrawRect(btn,0,0,tw-1,th-1,colour:=#F0F0F0)
--      gDrawRect(btn,0,0,tw-1,th-1,colour:=#FDFDFD)
        {tx,ty} = {4,12}
        hclr = #E0EEF9
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_btn_redraw)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    -- 2) replace inner bgclr when hovering
    if bHover and bActive then
        gDrawRect(btn,1,1,tw-2,th-2,true,colour:=hclr)
    end if
    if backend=TG_GTK then
        if bGTK3 then
            atom border = #B6B6B3
--          gDrawRect(btn,0,0,tw-1,th-6,rc:=3,colour:=border)
            gDrawRect(btn,0,0,tw-1,th-1,rc:=3,colour:=border)
        end if
    elsif backend=TG_WINAPI then
        atom border = iff(bActive?iff(bHover?#0078D4:#D0D0D0):#E9E9E9)
--      gDrawRect(btn,0,0,tw-1,th-1,rc:=5,colour:=border)
        gDrawRect(btn,0,0,tw-1,th-1,rc:=3,colour:=border)
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_btn_redraw2)`);
        #}ilJS
    else
        ?9/0
    end if
    gdn image = ctrl_xtra[btn][CXBTN_IMAGE]
    if image then
        integer {iw,ih} = gGetAttribute(image,`SIZE`)
        if not bActive then image = gGreyscale_XPM(image) end if
        gDrawImage(image,btn,tx,ty-ih/2)
        tx += iw+2
    end if
    nullable_string btn_txt = ctrl_titles[btn]
    if btn_txt!=NULL then
        gDrawText(btn,tx,ty,btn_txt,colour:=iff(bActive?TG_BLACK:TG_DARK_GREY))
    end if
    if gGetFocus()==btn and bActive then
        integer rc = 2
        atom fclr = TG_BLACK
        if backend=TG_GTK then
            if bGTK2 then
                tw -= 1
                th -= 4
                rc = 0
            elsif bGTK3 then
                th -= 6
                fclr = #909090
            else
                ?9/0
            end if
        elsif backend=TG_WINAPI then
-- for sqlite3.exw:
--          th -= 2
            th -= 3
        elsif backend=TG_JS then
            #ilJS{
                crash(`JS (tg_btn_redraw3)`);
            #}ilJS
        else
            ?9/0
        end if
        gDrawRect(btn,2,2,tw-3,th,rc:=rc,colour:=fclr,style:=TG_DOTTED)
    end if
end procedure   

local procedure tg_btn_mouse_click(gdx btn, sequence status)
    if begins(`LR`,status)
    and gGetAttribute(btn,`ACTIVE`) then
        {} = tg_button_clicked(btn)
    end if
end procedure

local procedure tg_btn_mouse_move(gdx btn)
    if not ctrl_xtra[btn][CXBTN_HOV] then
        ctrl_xtra[btn][CXBTN_HOV] = true
        gRedraw(btn)
    end if
    gdx btn_un_hover_timer = ctrl_xtra[btn][CXBTN_UHT]
    if btn_un_hover_timer!=NULL then
        gSetAttribute(btn_un_hover_timer,`RUN`,false)
    end if
end procedure

local procedure tg_btn_mouse_leave(gdx btn)
    ctrl_xtra[btn][CXBTN_HOV] = false
    gRedraw(btn)
end procedure

local procedure tg_btn_un_hover(gdx btn_un_hover_timer)
    gdx btn = gGetAttribute(btn_un_hover_timer,`USER_DATA`)
    ctrl_xtra[btn][CXBTN_HOV] = false
    gRedraw(btn)
    gSetAttribute(btn_un_hover_timer,`RUN`,false)
end procedure

function tg_btn_key(gdx btn, integer c)
    if c=' ' then
        if not ctrl_xtra[btn][CXBTN_HOV] then
            ctrl_xtra[btn][CXBTN_HOV] = true
            gRedraw(btn)
            gdx btn_un_hover_timer = ctrl_xtra[btn][CXBTN_UHT]
            if btn_un_hover_timer=NULL then
                btn_un_hover_timer = gTimer(tg_btn_un_hover,250,true,btn)
                ctrl_xtra[btn][CXBTN_UHT] = btn_un_hover_timer
            else
                gSetAttribute(btn_un_hover_timer,`RUN`,true)
            end if
        end if
        {} = tg_button_clicked(btn)
    end if
    return TG_CONTINUE
end function

global function gButton(object title=NULL, action=NULL, sequence attributes="", args={})
    {title,action,attributes,args} = paranormalise_traa(title,action,attributes,args)
    gdx btn = gCanvas(tg_btn_redraw,`EXPAND=NO, CANFOCUS=YES`,nFrames:=2)
    ctrl_types[btn] = BUTTON
    ctrl_set_attr[BUTTON] = tg_set_button_attribute
    ctrl_get_attr[BUTTON] = tg_get_button_attribute
    atom bgclr = iff(backend=TG_GTK?iff(bGTK2?#DCDAD5
                                             :#FDFDFD)
--              /*TG_WINAPI/TG_JS*/:#F0F0F0)
                /*TG_WINAPI/TG_JS*/:#FDFDFD)
    gSetAttribute(btn,`BGCLR`,bgclr)
    ctrl_titles[btn] = title
    object btn_attr = repeat(0,CXBTN_LEN)
    ctrl_xtra[btn] = btn_attr
    btn_attr = 0
    tg_register_handler(BUTTON,`ACTION`,{`FO`,`F`,`PO`,`P`})
    gSetHandler(btn,`CLICK`,tg_btn_mouse_click)
    gSetHandler(btn,`KEY`,tg_btn_key)
    gSetHandler(btn,`MOUSEMOVE`,tg_btn_mouse_move)
    gSetHandler(btn,`MOUSELEAVE`,tg_btn_mouse_leave)
    if action then
        gSetHandler(btn,`ACTION`,action)
    end if
    if length(attributes) then
        gSetAttributes(btn,attributes,args,2)
    end if
    return btn
end function

