-- gTree
-- =====

local enum TG_TREE_TEXT, -- a descriptive string for the node
           TG_TREE_CHILDREN, -- (deferred load or) 0 for leaf or {node_idx}
           TG_TREE_PARENT, -- node[parent][children] must contain node index
           TG_TREE_WIDTH, -- -1: unknown, else this node's width
           TG_TREE_CHECKED, -- true/false (ignored if CHECKS false)
            -- next two optional on leaf nodes (and as far as they go):
           TG_TREE_IMAGE, -- a gdn/xpm or two (ignored if IMAGES false)
           TG_TREE_USERDATA, -- (theGUI -> app, else ignored)
            -- branches only (all 10 /must/ be present on all branch nodes):
           TG_TREE_EXPANDED, -- expanded(t)/collapsed(f)/deferred load(-1) flag     -- ???[DEV]
           TG_TREE_WIDEST, -- -1: unknown, else some node within this subnode
           TG_TREE_VNC -- visible nodes count (uber-critical!)

local function tg_tree_n2d(gdx tree, integer n)
    -- calculate the display index of the given node index.
    if n<=0 then return 0 end if
    sequence nodes = ctrl_xtra[tree][CXTREE_DATA]
    if n>length(nodes) then return 0 end if
    integer d = 1,
            p = nodes[n][TG_TREE_PARENT]
    while p do
        if nodes[p][TG_TREE_EXPANDED]!=true then
            d = 1
        else
            sequence siblings = nodes[p][TG_TREE_CHILDREN]
            integer k = find(n,siblings)
            for s in siblings[1..k-1] do
                if nodes[s][TG_TREE_CHILDREN]!=0
                and nodes[s][TG_TREE_EXPANDED] then
                    d += nodes[s][TG_TREE_VNC]
                end if
                d += 1
            end for
            d += 1
        end if
        n = p
        p = nodes[p][TG_TREE_PARENT]
    end while
    return d
end function

local function tg_tree_d2n(gdx tree, integer d)
    -- convert a display index into a node index
    -- walks down the tree, pretty much directly
    -- to the node, with no back-tracking at all
    if d=0 then return 0 end if
    sequence nodes = ctrl_xtra[tree][CXTREE_DATA]
    integer max_d = 1, original_d = d
    if nodes[1][TG_TREE_CHILDREN]!=0
    and nodes[1][TG_TREE_EXPANDED] then
        max_d += nodes[1][TG_TREE_VNC]
    end if
    if d>max_d then return 0 end if
    if d=1 then return 1 end if
    integer n = 1, cdx = 1  
    sequence children = nodes[n][TG_TREE_CHILDREN]
    while d>1 do
        n = children[cdx]
        sequence child = nodes[n]
        if child[TG_TREE_CHILDREN]!=0        -- not a leaf node
        and child[TG_TREE_EXPANDED]==true then -- (not 0 or -1)
            integer v = child[TG_TREE_VNC]
            -- the critical part: skip whole sub-trees
            if d-1>v+1 then
                d -= v
            else -- it is somewhere in this node then
                children = nodes[n][TG_TREE_CHILDREN]
                cdx = 0
            end if
        end if
        d -= 1
        cdx += 1
    end while
    assert(tg_tree_n2d(tree, n)==original_d)
    return n
end function

local function tg_tree_get_display_code(sequence nodes, integer n)
    --
    -- returns a string (eg ` ||L`) which indicates what images
    -- need displaying on the lhs, with length == nesting depth.
    -- n should be a node index (ie //not// a display index)
    --
    -- `~LT|-M+P`:  ~ leaf/mt branch, hz link (@ root only)
    --              L leaf link, """ + uplink
    --              T leaf link, """+downlink
    --              | vertical link, no right
    --              - open branch (a - box)
    --              M "" at root, no uplink
    --              + closed branch (+ box)
    --              P "" at root, no uplink
    --
    string res = ``
    bool first = true
    do
        integer p = nodes[n][TG_TREE_PARENT], ch
        bool last = p==0 or nodes[p][TG_TREE_CHILDREN][$]==n
        if find(nodes[n][TG_TREE_CHILDREN],{0,{}}) then
            assert(first)
            ch = iff(p=0?'~':iff(last?'L':'T'))
        else
            bool expd = nodes[n][TG_TREE_EXPANDED]
            ch = iff(first?iff(p==0?iff(expd?'M':'P')
                                   :iff(expd?'-':'+'))
                :iff(last?' ':'|'))
        end if
        res &= ch
        n = p
        first = false
    until n<=1
    if n=1 then -- (ie //not// originally 1)
        res = ` `&reverse(res)
    end if
    return res
end function

local function tg_tree_vnc(gdx tree)
    integer nc = 1
    sequence nodes = ctrl_xtra[tree][CXTREE_DATA]
    if nodes[1][TG_TREE_CHILDREN]!=0
    and nodes[1][TG_TREE_EXPANDED] then
        nc += nodes[1][TG_TREE_VNC]
    end if
    return nc
end function

local sequence tree_imgs
local integer tucb = NULL, tccb
local atom Cimg = NULL, Oimg, Dimg -- closed,open,dot, see thegui_xpm.e

global enum TGTDL_TEXT,         -- 1
            TGTDL_EXPANDED,     -- 2
            TGTDL_CHECKED,      -- 3
            TGTDL_IMAGE,        -- 4
            TGTDL_USERDATA,     -- 5
            TGTDL_CHILDREN      -- 6

function tg_tree_convert_nested_to_flat(sequence res, ntree, integer parent, bool deferred=false)
    -- this code [has been] copied into theGUI.e|js
    string desc
    object children -- (can be null iff deferred load, aka expanded=-1)
    bool checked = false,
        expanded = -(length(ntree)==2 and ntree[2]==-1) -- {desc,-1} special case
    object image = NULL
    object userdata = NULL
    switch length(ntree) with fallthrough do    -- don't mix these up:
        case 6: userdata = ntree[5]             -- nb TGTDL_USERDATA(5) not TG_TREE_USERDATA(7)
        case 5:    image = ntree[4]             -- nb TGTDL_IMAGE(4) not TG_TREE_IMAGE(6)
        case 4:  checked = ntree[3]             -- nb TGTDL_CHECKED(3) not TG_TREE_CHECKED(5)
        case 3: expanded = ntree[2]             -- nb TGTDL_EXPANDED(2) not TG_TREE_EXPANDED(8)
        case 2: children = ntree[$]             -- nb not TGTDL_CHILDREN(6) nor TG_TREE_CHILDREN(2)
                    desc = ntree[1]
                break
        default: crash(`invalid length`)
    end switch
    if sequence(image) then
        if length(image)=2 then -- {open,closed pair}
            sequence im2 = {0,0} -- (avoid p2js violation)
            for i,im in image do
                im2[i] = iff(sequence(im)?gImage_from_XPM(im):im)
            end for
            image = im2
        else    
            image = gImage_from_XPM(image)
        end if
    end if
    if expanded!=-1 and children=0 then         -- detailed leaf
        sequence leaf = {desc, -- TG_TREE_TEXT
                            0, -- TG_TREE_CHILDREN
                       parent, -- TG_TREE_PARENT
                           -1, -- TG_TREE_WIDTH (set internally)
                      checked, -- TG_TREE_CHECKED
                        image, -- TG_TREE_IMAGE
                     userdata} -- TG_TREE_USERDATA
        res = append(res,leaf)
        return res
    end if
    assert(expanded==-1 or sequence(children))
    if deferred then
        assert(expanded!=-1) // *MUST* be set t/f by the deferred load, as stated in the docs
                             // (mirrors test in tg_tree_defer_load so shd never happen here)
        res[parent][TG_TREE_USERDATA] = userdata
        res[parent][TG_TREE_IMAGE] = image
        res[parent][TG_TREE_CHECKED] = checked
        res[parent][TG_TREE_EXPANDED] = expanded
        res[parent][TG_TREE_TEXT] = desc
        res[parent][TG_TREE_WIDTH] = -1
    else
        res = append(res,{desc, -- TG_TREE_TEXT
                             0, -- TG_TREE_CHILDREN (updated below)
                        parent, -- TG_TREE_PARENT
                            -1, -- TG_TREE_WIDTH (set internally)
                       checked, -- TG_TREE_CHECKED
                         image, -- TG_TREE_IMAGE
                      userdata, -- TG_TREE_USERDATA
                      expanded, -- TG_TREE_EXPANDED
                            -1, -- TG_TREE_WIDEST (set internally)
                             0}) -- TG_TREE_VNC (updated below)
        parent = length(res) -- make this the new current parent
    end if
    if expanded=-1 then
        res[parent][TG_TREE_CHILDREN] = children
    else
        integer nc = length(children)                                -- base vnc
        sequence kdx = repeat(0,nc)
        for i,child in children do
            if string(child) then                                        -- leaf
                res = append(res,{child,0,parent,-1,false,NULL,NULL})
                        --       no kids^,   width^,^u/chk, ^img, ^userdata
                kdx[i] = length(res)
            else
                integer nccp = length(res)+1 -- (predict new child's current parent)
                -- (nb: deferred arg /*not*/ recursive, but child may contain -1s:)
                res = tg_tree_convert_nested_to_flat(res,child,parent)
                if atom(child[$]) and child[2]!=-1 then         -- detailed leaf
                    assert(length(res)==nccp) -- (verify +1)
                elsif res[nccp][TG_TREE_EXPANDED]=true then   -- expanded branch
                    nc += res[nccp][TG_TREE_VNC]
                end if
                kdx[i] = nccp
            end if
        end for
        res[parent][TG_TREE_CHILDREN] = kdx
        do
            res[parent][TG_TREE_WIDEST] = -1 -- (redraw to replace)
            res[parent][TG_TREE_VNC] += nc
            integer child = parent
            parent = res[parent][TG_TREE_PARENT]
        until parent=0 
           or (not deferred)
           or not res[child][TG_TREE_EXPANDED]
    end if
    return res
end function

procedure tg_tree_defer_load(gdx tree, integer node_index)
    sequence res = ctrl_xtra[tree][CXTREE_DATA]
    ctrl_xtra[tree][CXTREE_DATA] = 0 -- (kill refcount)

    -- what you're actually going to have to do here is more like:
    object rp = res[node_index]
    assert(rp[TG_TREE_EXPANDED]==-1)
    sequence newbranch = {rp[TG_TREE_TEXT],
                          -1, -- (TG_TREE_EXPANDED)
                          rp[TG_TREE_CHECKED],
                          rp[TG_TREE_IMAGE],
                          rp[TG_TREE_USERDATA],
                          rp[TG_TREE_CHILDREN]}
    rp = NULL
    res[node_index][TG_TREE_USERDATA] = NULL -- (kill refcounts)
    res[node_index][TG_TREE_CHILDREN] = NULL
    integer defer_load = gGetHandler(tree,`DATA`)
    newbranch = defer_load(newbranch)
    assert(newbranch[TGTDL_EXPANDED]!=-1) -- (mirrored in next call)
    res = tg_tree_convert_nested_to_flat(res,newbranch,node_index,true)
    ctrl_xtra[tree][CXTREE_DATA] = res
end procedure

local procedure tg_tree_ec(gdx tree, integer n, bool bExpand)
    --
    -- Apart from marking the specified node as expanded/collapsed, propagate 
    -- any changes to the vnc (visible node count) all the way up to the root.
    -- Note that we don't actually change the vnc of the node itself here.
    --
    integer vnc = ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_VNC],
           mvnc = iff(bExpand?+vnc:-vnc) -- add or subtract sub-tree counts
    assert(vnc!=0) -- load error?
    -- if collapsed, widest is itself, else mark expanded as "needs scan":
    ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_WIDEST] = iff(bExpand?-1:n)
    ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_EXPANDED] = bExpand
    while true do // until parent 0
        integer parent = ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_PARENT]
        if parent=0 then exit end if
        ctrl_xtra[tree][CXTREE_DATA][parent][TG_TREE_VNC] += mvnc
        ctrl_xtra[tree][CXTREE_DATA][parent][TG_TREE_WIDEST] = -1
        n = parent
    end while
end procedure

local procedure tg_tree_collapse_node(gdx tree, integer n)
    tg_tree_ec(tree, n, false)
end procedure

local procedure tg_tree_expand_node(gdx tree, integer n)
    tg_tree_ec(tree, n, true)
end procedure

local function tg_tree_get_width(gdx tree, integer n)
    object nodes = ctrl_xtra[tree][CXTREE_DATA]
    integer width = nodes[n][TG_TREE_WIDTH]
    if width=-1 then
        string dc = tg_tree_get_display_code(nodes,n),
             text = nodes[n][TG_TREE_TEXT]
        integer w = gGetTextExtent(text,tree)[1]
        width = w + (length(dc)+1)*19
        nodes = 0
        ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_WIDTH] = width
    end if
    return width
end function

local function tg_leaf_or_collapsed_or_widest(gdx tree, integer n)
    return find(ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_CHILDREN],{0,{}})
             or ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_WIDEST]=n
         or not ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_EXPANDED]
end function

local function tg_tree_get_widest(gdx tree, integer n)
    if n=1 and ctrl_xtra[tree][CXTREE_DATA][1][TG_TREE_CHILDREN]=0 then
        -- special case: single leaf as root
        {} = tg_tree_get_width(tree,1)
        return 1
    end if
    integer expanded = ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_EXPANDED]
    if expanded=-1 then tg_tree_defer_load(tree, n) end if
    integer widest = ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_WIDEST]
    if widest=-1 then
        widest = n
        if expanded then
            integer width = tg_tree_get_width(tree,n)
            for c in ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_CHILDREN] do
                integer c0 = c
                while not tg_leaf_or_collapsed_or_widest(tree,c) do
                    c = tg_tree_get_widest(tree,c)
                end while
                if c=c0 and ctrl_xtra[tree][CXTREE_DATA][c][TG_TREE_CHILDREN]={}
                        and ctrl_xtra[tree][CXTREE_DATA][c][TG_TREE_EXPANDED]=-1 then
                    tg_tree_defer_load(tree, c)
                end if
                integer w = tg_tree_get_width(tree,c)
                if w>width then
                    width = w
                    widest = c
                end if
            end for
        end if
        ctrl_xtra[tree][CXTREE_DATA][n][TG_TREE_WIDEST] = widest
    end if
    return widest
end function

local procedure tg_redraw_tree(gdx tree, integer width, height)
    integer widest = tg_tree_get_widest(tree,1), -- (replace any -1s now)
     {ox,oy,vw,vh} = gGetAttribute(tree,`VIEWPORT`),
            active = gGetAttribute(tree,`ACTIVE`),
               vnc = tg_tree_vnc(tree)
    object tree_attr = ctrl_xtra[tree]
    sequence nodes = tree_attr[CXTREE_DATA]
    integer selected = tg_tree_n2d(tree,tree_attr[CXTREE_SELECTED]),
            sel_full = tree_attr[CXTREE_SELFULL],
              checks = tree_attr[CXTREE_CHECKED],
               image = tree_attr[CXTREE_IMAGE],
         line_height = 18,  -- (or maybe from image/font...)
          hover_line = tree_attr[CXTREE_HOVLINE],
           hover_col = tree_attr[CXTREE_HOVCOL],
                   w = nodes[widest][TG_TREE_WIDTH]

    atom bgclr = gGetAttribute(tree,`BGCLR`),
         bgsel = tree_attr[CXTREE_BGSEL],
         bghov = tree_attr[CXTREE_BGHOV],
         fgsel = tree_attr[CXTREE_FGSEL]
    tree_attr = 0 -- (kill refcount)
    ctrl_xtra[tree][CXTREE_LINESTEP] = line_height
    assert(w!=-1)
    gSetAttribute(tree,`SCROLLSIZE`,{w+5,line_height*(vnc+1)})
    integer l1 = max(1,floor(oy/line_height)+1),
            nr = min(vnc-l1+1,floor(vh/line_height)),
            vy = oy
    -- (save for tg_tree_click/tg_tree_hover only:)
    ctrl_xtra[tree][CXTREE_TOPITEM] = l1

    if not object(tree_imgs) then
        string {T_txt,MP_txt} = gGetGlobal(`tree_images`)
        -- corresponding to `~LT|-M+P`, as per tg_tree_get_display_code:
        tree_imgs = apply({substitute_all(T_txt,`URD`,`.0.`), -- hz bar
                           substitute_all(T_txt,`URD`,`00.`), -- L link
                           substitute_all(T_txt,`URD`,`000`), -- T link
                           substitute_all(T_txt,`URD`,`0.0`), -- vt bar
                           substitute_all(MP_txt,`Uk`,`0i`),  -- - box
                           substitute_all(MP_txt,`Uk`,`.i`),  -- ""-up
                           substitute_all(MP_txt,`Uk`,`0j`),  -- + box
                           substitute_all(MP_txt,`Uk`,`.j`)}, -- ""-up
                          gImage_from_XPM)
        {Cimg,Oimg,Dimg} = gGetGlobal(`treeOCD`) -- closed,open,dot, see thegui_xpm.e
    end if

    for rll=1 to nr do
        integer r = rll+l1-1, vx = 2
        atom clr = -1
        if bgsel!=bgclr and r=selected then
            clr = bgsel
        elsif bghov!=bgclr and r=hover_line then
            clr = bghov
        end if
        if clr!=-1 and (clr=bghov or sel_full) then
            integer ymin = vy-oy+2, ymax = ymin+line_height+1
            gDrawRect(tree,3,ymin,width-3,ymax,true,0,clr)
        end if
        integer ndx = tg_tree_d2n(tree,r)
        sequence node = nodes[ndx]
        string dc = tg_tree_get_display_code(nodes,ndx)
        integer x = vx-ox+3, y = vy-oy
        gdn img
        for i,c in dc do
            if c!=' ' then
                img = tree_imgs[find(c,`~LT|-M+P`)]
                if not active then img = gGreyscale_XPM(img) end if
                gDrawImage(img,tree,x,y)
            end if
            x += 19
        end for
        if checks then
            if tucb=NULL then
                {tucb,tccb} = gGetGlobal(`chk_xpm`) -- unchecked and checked gImages, both 13x13
                          -- (1st 2 of 5, ^^^^^^^ -- otherwise not documented anywhere)
            end if
            img = iff(node[TG_TREE_CHECKED]?tccb:tucb)
            if not active then img = gGreyscale_XPM(img) end if
            gDrawImage(img,tree,x-2,y+6)
            x += 18
        end if
        if image=NULL then
            x -= 3
        else
            if node[TG_TREE_CHILDREN]=0 then                -- leaf
                if length(node)>=TG_TREE_IMAGE
                and gdx(node[TG_TREE_IMAGE]) then
                    img = node[TG_TREE_IMAGE]
                    if img=NULL then img = Dimg end if
                else
                    img = Dimg
                end if
            else                                          -- branch
                bool e = node[TG_TREE_EXPANDED]
                object nimg = node[TG_TREE_IMAGE]
                if sequence(nimg) and nimg[2-e] then
                    img = nimg[2-e]
                elsif e then
                    img = iff(gdm(nimg)?nimg:Oimg)
                else
                    img = iff(gdm(image)?image:Cimg)
                end if
            end if
            if not active then img = gGreyscale_XPM(img) end if
            gDrawImage(img,tree,x-4,y+4)
            x += 14
        end if
        y += 12
        string txt = node[TG_TREE_TEXT]
        if clr=bgsel and not sel_full then
            gDrawText(tree,x,y,txt,colour:={fgsel,bgsel})
--          gDrawText(tree,x,y,txt,colour:={TG_BLACK,bgsel})
--          gDrawText(tree,x,y,txt,colour:={TG_WHITE,bgsel}) -- ugh, but wd be wanted for some...
        else
            gDrawText(tree,x,y,txt)
        end if
        vy += line_height
    end for
end procedure

local procedure tg_tree_click(gdx tree, sequence status, integer x, y) 
    if status[1..2]=`LS` and gGetAttribute(tree,`ACTIVE`) then
        integer ox = gGetAttribute(tree,`VIEWPORT`)[1],
                xx = x+ox,
               vnc = tg_tree_vnc(tree)
        object tree_attr = ctrl_xtra[tree],
                   nodes = tree_attr[CXTREE_DATA]
        integer line_height = tree_attr[CXTREE_LINESTEP],
                top_line = tree_attr[CXTREE_TOPITEM],
                checks = tree_attr[CXTREE_CHECKED],
                line = top_line + floor(y/line_height) -- (display index)
        tree_attr = 0 -- (kill refcount)

        if line>=1 and line<=vnc then
            line = tg_tree_d2n(tree,line)
            string dc = tg_tree_get_display_code(nodes,line)
            nodes = nodes[line]
            bool leaf = find(nodes[TG_TREE_CHILDREN],{0,{}})
            if not leaf then
                integer ec = length(dc)*19-19 
                if xx>=ec and xx<=ec+17 then
                    ec = nodes[TG_TREE_EXPANDED]
                    nodes = 0 -- (kill refcount)
                    if ec then
                        tg_tree_collapse_node(tree,line)
                    else
                        tg_tree_expand_node(tree,line)
                    end if
                    gRedraw(tree)
                    return
                end if
            end if
            if checks then
                integer chk = 3+length(dc)*19
                if xx>=chk and xx<=chk+13 then
                    chk = not nodes[TG_TREE_CHECKED]
                    nodes = 0 -- (kill refcount)
                    ctrl_xtra[tree][CXTREE_DATA][line][TG_TREE_CHECKED] = chk
                    gRedraw(tree)
                    return
                end if
            end if
            if line!=ctrl_xtra[tree][CXTREE_SELECTED] then
                ctrl_xtra[tree][CXTREE_SELECTED] = line
                gRedraw(tree)
                rtn selected = gGetHandler(tree,`SELECTED`)
                if selected then
                    string sig = tg_get_sig(selected)
                    if length(sig)=3 then
                        selected(tree,line)
                    else
                        selected(line)
                    end if
                end if // selected handler
            end if // selection changed
        end if // 1..vnc
    end if // LS
end procedure

local procedure tg_tree_hover(gdx tree, integer /*x*/,y, left,middle,right, onscroll)
    if gGetAttribute(tree,`ACTIVE`) then
        object tree_attr = ctrl_xtra[tree]
        atom bgclr = ctrl_bg[tree],
             bghov = tree_attr[CXTREE_BGHOV]
        if bgclr!=bghov then
            integer line_height = tree_attr[CXTREE_LINESTEP],
                       top_line = tree_attr[CXTREE_TOPITEM],
                        was_hov = tree_attr[CXTREE_HOVLINE],
                            vnc = tg_tree_vnc(tree)
            tree_attr = 0 -- (kill refcount)
            if line_height then -- (skip shd we get here super-early)
                integer line = top_line + floor(y/line_height), new_hov = 0
                if line<=vnc and not (onscroll or left or middle or right) then
                    new_hov = line
                end if
                if new_hov!=was_hov then
                    ctrl_xtra[tree][CXTREE_HOVLINE] = new_hov
                    gRedraw(tree)
                end if
            end if
        end if
    end if
end procedure

local procedure tg_tree_mouseleave(gdx tree)
    bool bRedraw = false
    if ctrl_xtra[tree][CXTREE_HOVLINE] then
        ctrl_xtra[tree][CXTREE_HOVLINE] = 0
        bRedraw = true
    end if
    object sbinfo = ctrl_sbinfo[tree]
    if sequence(sbinfo)
    and sbinfo[SB_MONLD]!=`` then
        sbinfo = NULL
        ctrl_sbinfo[tree][SB_MONLD] = ``
        bRedraw = true
    end if
    if bRedraw then
        gRedraw(tree)
    end if
end procedure

local function tg_tree_key_handler(gdx tree, integer c, bool ctrl, shift, alt) 
    integer {sw,sh} = gGetAttribute(tree,`SCROLLSIZE`),
      {ox,oy,vw,vh} = gGetAttribute(tree,`VIEWPORT`), oyo = oy,
                vnc = tg_tree_vnc(tree),
        line_height = ctrl_xtra[tree][CXTREE_LINESTEP],
           top_line = floor(oy/line_height)+1,
          view_rows = floor(vh/line_height),
               seln = ctrl_xtra[tree][CXTREE_SELECTED],
               seld = tg_tree_n2d(tree,seln), selo = seld
    object node = iff(seln?ctrl_xtra[tree][CXTREE_DATA][seln]:0)
    bool branch = seld and not find(node[TG_TREE_CHILDREN],{0,{}}),
       expanded = branch and node[TG_TREE_EXPANDED]
    integer parent = iff(seld?node[TG_TREE_PARENT]:0)
    node = 0
--  if not ctrl then ?
    switch c do
        case VK_UP:     seld = max(1,seld-1)
        case VK_DOWN:   seld = min(vnc,seld+1)
        case VK_LEFT:   if seld then
                            if expanded then
                                tg_tree_collapse_node(tree,seln); selo = 0
                            elsif parent then
                                seld = tg_tree_n2d(tree,parent)
                            end if
                        end if
        case VK_RIGHT:  if seld then
                            if branch and not expanded then
                                tg_tree_expand_node(tree,seln); selo = 0
                            else
                                seld = min(vnc,seld+1)
                            end if
                        end if
        case VK_PGUP:   if top_line=1 then
                            seld = 1
                        else
                            top_line = max(1,top_line-view_rows)
                            seld = max(1,seld-view_rows)
                        end if
        case VK_PGDN:   if top_line+view_rows<=vnc then
                            top_line += view_rows
                            seld = min(vnc,seld+view_rows)
                        else
                            seld = vnc
                        end if
        case VK_HOME:   seld = 1
                        top_line = 1
        case VK_END:    seld = vnc
                        top_line = max(vnc-view_rows+1,top_line)
        case VK_SP:     if seln and ctrl_xtra[tree][CXTREE_CHECKED] then
                            bool chk = ctrl_xtra[tree][CXTREE_DATA][seln][TG_TREE_CHECKED]
                            ctrl_xtra[tree][CXTREE_DATA][seln][TG_TREE_CHECKED] = not chk
                            gRedraw(tree)
                        end if
    end switch
    oy = (top_line-1)*line_height
    if seld!=selo or oy!=oyo then
        if oy=oyo then
            if seld<=top_line then
                oy = (seld-1)*line_height
            elsif seld>=top_line+view_rows then
                oy = (seld-view_rows)*line_height
            end if
        end if
        gSetAttribute(tree,`VIEWPORT`,{ox,oy})
        ctrl_xtra[tree][CXTREE_SELECTED] = tg_tree_d2n(tree,seld)
        gRedraw(tree)
    end if
    return TG_CONTINUE
end function

local function tg_set_tree_attribute(gdx tree, string name, object v, integer nFrames)
    integer gxdx = find(name,tree_attr_names)
    if gxdx then
        -- aside: common up by type, but feel free to do  
        -- anything that needs special treatment by name
        integer vtype = tree_attr_types[gxdx]
        if vtype='B' then
            v = tg_to_bool(v,nFrames+2)
        elsif vtype='C' then
            v = tg_get_colour_value(v)
            assert(atom(v))
        elsif vtype='I' then
            if string(v) and is_integer(v) then
                v = to_integer(v)
            else
                assert(integer(v),nFrames:=nFrames+2)
            end if
        elsif name=`DATA` then
            if string(v[1]) then
                v = tg_tree_convert_nested_to_flat({},v,0)
            end if
        elsif vtype!='O' then -- (IMAGE)
            ?9/0 -- should never happen...
        end if
        ctrl_xtra[tree][gxdx] = v
        return true
    end if
    return false
end function

function tg_get_tree_attribute(gdx tree, string name, integer nFrames)
    integer gxdx = find(name,tree_attr_names)
    if gxdx then
        if gxdx=CXTREE_DATA then -- `DATA`
            return {ctrl_xtra[tree][CXTREE_DATA],
                    {tg_tree_vnc,
                     tg_tree_n2d,
                     tg_tree_d2n,
                     tg_tree_collapse_node,
                     tg_tree_expand_node}}
        elsif gxdx=CXTREE_HOVCOL then -- `DATA+`
            sequence res = ctrl_xtra[tree][CXTREE_DATA]
            ctrl_xtra[tree][CXTREE_DATA] = NULL
            return res
        end if
        return ctrl_xtra[tree][gxdx]
    end if
    tg_bad_attr(tree,name,nFrames+1)
end function

global function gTree(sequence nodes, string attributes=``, sequence args={})
    if string(nodes) then nodes = {nodes,0} end if -- leaf -> dummy root
    gdx tree = gCanvas(tg_redraw_tree)
    ctrl_types[tree] = TREE
    ctrl_set_attr[TREE] = tg_set_tree_attribute
    ctrl_get_attr[TREE] = tg_get_tree_attribute
    object tree_attr = repeat(0,CXTREE_LEN)
    tree_attr[CXTREE_BGSEL] = #CCE8FF
    tree_attr[CXTREE_BGHOV] = #E5F3FF
    tree_attr[CXTREE_FGSEL] = TG_BLACK
    tree_attr[CXTREE_SELFULL] = true
    tree_attr[CXTREE_IMAGE] = true
    ctrl_xtra[tree] = tree_attr
    tree_attr = 0
    gSetAttribute(tree,`DATA`,nodes)
    tg_register_handler(TREE,`CHECKED`,{`POPI`,`PPI`})
    tg_register_handler(TREE,`DATA`,{`FOP`,`FP`})
    tg_register_handler(TREE,`SELECTED`,{`POPI`,`PPI`})
    gSetHandler(tree,`CLICK`,tg_tree_click)
    gSetHandler(tree,`MOUSEMOVE`,tg_tree_hover)
    gSetHandler(tree,`MOUSELEAVE`,tg_tree_mouseleave)
    gSetHandler(tree,`KEY`,tg_tree_key_handler)
    if length(attributes) then
        gSetAttributes(tree,attributes,args,2)
    end if
    return tree
end function

local function tg_placement(integer xy, os, ol, is, il)
    -- xy is the x or y of gShow(), which can be an absolute value such as 100 (returned as is)
    -- or one of the TG_XXX - which obviously need the outer and inner starts and lengths.
    integer res = is                                -- (default for xy==TG_CURRENT)
    if xy<TG_CURRENT then
        res = xy
    elsif xy>TG_CURRENT then
        switch xy && 0b0011 do
            case 0b0011: res = os+floor((ol-il)/2)      -- centre
            case 0b0010: res = os+ol-il                 -- right/btm
            case 0b0001: res = os                       -- left/top
            case 0b0000: res = is-iff(is+il<=ol?0:il)   -- mousepos [DEV untested]
        end switch
    end if
    return res
end function

global procedure gShow(gdx id, integer x=TG_CURRENT, y=TG_CURRENT)
    integer ct = ctrl_types[id],
           pid = ctrl_parent[id]
    if ct!=DIALOG then
        gSetAttribute(id,`VISIBLE`,true)
        return
    end if
    -- catch first window displayed:
    if PrimaryWindowID=UNDEFINED then
        assert(pid=0,`first window displayed must be parent-less`)
        PrimaryWindowID = id
    end if
    integer {sx,sy} = {0,0},
--          {sw,sh} = gGetGlobalIntInt(`SCREENSIZE`)
            {sw,sh} = tg_get_screensize(), -- ==""
            {dw,dh} = tg_get_dialog_decoration_size(id)
    if ctrl_handles[id]=NULL then
        tg_Dialog(id)
        tg_apply_deferred_attributes(id)
        tg_set_ctrl_flag(id,CF_INVISIBLE,false)
--for gVidCut, Alt A then F1 resizing down... (10/9/26)
end if
if true then
        tg_lm_accumulate_sizes(id)
        tg_lm_apply_normalisation()
        integer w = max(ctrl_size[id][SZ_USER_W],ctrl_size[id][SZ_NORMAL_W]),
                h = max(ctrl_size[id][SZ_USER_H],ctrl_size[id][SZ_NORMAL_H])
        tg_lm_accumulate_and_disperse_user_sizes(id,w-dw,h-dh,who:="gShow")
        if x=TG_CURRENT then x=TG_CENTER end if
        if y=TG_CURRENT then y=TG_CENTER end if
    end if
    tg_set_ctrl_flag(id,CF_INVISIBLE,false)
    atom handle = ctrl_handles[id],
         cfi = ctrl_flags[id]
    integer {wx,wy,ww,wh} = tg_get_window_rect(id)
    bool bPx = x>=TG_CURRENT and and_bits(x,TG_PARENT),
         bPy = y>=TG_CURRENT and and_bits(y,TG_PARENT)
    if pid!=0 and (bPx or bPy) then
        integer {px,py,pw,ph} = tg_get_window_rect(pid)
        if bPx then {sx,sw} = {px,pw} end if
        if bPy then {sy,sh} = {py,ph} end if
    end if  
    if x=TG_MOUSEPOS
    or y=TG_MOUSEPOS then
        assert(x==y,`gShow: TG_MOUSEPOS is both-only`)
        {wx,wy} = tg_get_mousepos()
    else
        wx = tg_placement(x,sx,sw,wx,ww)
        wy = tg_placement(y,sy,sh,wy,wh)
    end if
    g_log(`set`,`ctrl_sizeXY`,{`gShow`,source_line()},{id,wx,wy})
    ctrl_size[id][SZ_X] = wx
    ctrl_size[id][SZ_Y] = wy
    if backend=TG_GTK then
        c_proc(x_gtk_window_move,{handle,wx,wy})
        if c_func(x_gtk_window_get_transient_for,{handle})=NULL then
            tg_gtk_signal_connect(handle,`destroy`,tg_gtk_quit,id)
        end if
        c_proc(x_gtk_widget_show_all,{handle})
    elsif backend=TG_WINAPI then
        integer uFlags = SWP_NOZORDER+SWP_NOACTIVATE,
                hWndAft = NULL
        integer w = ctrl_size[id][SZ_W]+dw+12,
                h = ctrl_size[id][SZ_H]+dh+7-32
        -- without this, gButton.exw does not start in the right (centred) place:
        g_funk(xSetWindowPos,{handle,hWndAft,wx,wy,w,h,uFlags},source_line())
        c_proc(xShowWindow,{handle,SW_SHOWNORMAL})
        if pid and and_bits(ctrl_flags[id],CF_MODAL) then
            c_proc(xEnableWindow,{ctrl_handles[pid],false})
        end if
-- do we still need this?? [erm, I still get two WM_PAINT whether this is here or not anyway...]
        c_proc(xUpdateWindow,{handle})
        gSetFocus(id) -- (helps with gMsgBox open...)
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (gShow)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    if bDiagnostics and not nodump then
        tg_lm_dump_ctrls(source_line(),`gShow`)
    end if
end procedure

