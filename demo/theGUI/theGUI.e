atom pLogBuffer = NULL

procedure expand_buffer(integer len)
    if pLogBuffer=NULL or len>logBufferLength then
        if pLogBuffer!=NULL then pLogBuffer = free(pLogBuffer) end if
        while len>logBufferLength do logBufferLength*=2 end while
        pLogBuffer = allocate(logBufferLength)
    end if
end procedure

