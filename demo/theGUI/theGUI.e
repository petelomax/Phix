local function tg_get_dialog_decoration_size(gdx id)
    integer w = 0,
            h = 0
    if not ctrl_xtra[id][DX_FULLSCREEN]
    and ctrl_xtra[id][DX_NOTITLE]=false then
        w = 2
        h = 32
    end if
    return {w,h}
end function

local function tg_get_window_rect(gdx id)
    -- returns {left,top,width,height}
    atom handle = ctrl_handles[id]
    integer ct = ctrl_types[id],
            left, top, width, height
    if backend=TG_GTK then
        if ct!=DIALOG then
            handle = ctrl_handles[gGetDialog(id)]
        end if
        c_proc(x_gtk_window_get_position,{handle,pX,pY})
        c_proc(x_gtk_window_get_size,{handle,pW,pH})
          left = get_struct_field(idGdkRectangle,pRECT,`x`)
           top = get_struct_field(idGdkRectangle,pRECT,`y`)
         width = get_struct_field(idGdkRectangle,pRECT,`width`)
        height = get_struct_field(idGdkRectangle,pRECT,`height`)
        if ct=DIALOG then -- GTK yields the client size...
            integer {dw,dh} = tg_get_dialog_decoration_size(id)
            width += dw
            height += dh
        else
            left += ctrl_size[id][SZ_X]
             top += ctrl_size[id][SZ_Y]
            width = ctrl_size[id][SZ_W]
           height = ctrl_size[id][SZ_H]
        end if

    elsif backend=TG_WINAPI then
            left = ctrl_size[id][SZ_X]
             top = ctrl_size[id][SZ_Y]
           width = ctrl_size[id][SZ_W]
          height = ctrl_size[id][SZ_H]
    elsif backend=TG_JS then    
        #ilJS{
/*
--oops: handle is still null... - see tg_Dialog for starters
        let bRect = handle.getBoundingClientRect(); // (nb: recalc in DOM)
        left = bRect.left;
        top = bRect.top;
        width = bRect.width;
        height = bRect.height;
*/
            crash(`JS (tg_get_window_rect)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    return {left,top,width,height}
end function

local function tg_WinAPI_getDC0()
    -- must be paired with ReleaseDC0()
    -- SelectObject() should trigger an error... [DEV]
    atom hDC = c_func(xGetDC,{0})
    if hDC=null then
        atom err = c_func(xGetLastError,{})
        crash(`GetDC(0) returned null wih error #%08x`,{err})
    end if
    return hDC
end function

integer ccoDC = 0, ccrDC = 0

local procedure ReleaseDC0(atom hDC)
    c_funk(xReleaseDC,{0,hDC})
    ccrDC += 1
end procedure

local function tg_WinAPI_CreateCompatibleDC(atom handle)
    atom hDC = c_func(xCreateCompatibleDC,{handle})
    if hDC=null then
        --
        -- Aside: There is a hard limit in WinAPI of 10,000 GDI resources. (fair enough)
        -- Should you breach that, CreateCompatibleDC() will return null, and a call to
        -- GetLastError() will helpfully return the error code 0. Blooming marvelous!
        -- Same thing applies to GetDC(), btw. The `trick` is that all SelectObject()
        -- must be undone, and then whatever you created DeleteObject()'d, unless of
        -- course you're keeping them in a cache for later reuse.
        --
        atom err = c_func(xGetLastError,{})
        crash(`CreateCompatibleDC(%x) returned null wih error #%08x (obt:%d, rel:%d)`,
              {handle,err,ccoDC,ccrDC})
    end if
    ccoDC += 1
    return hDC
end function

-- re-using hDC for gDrawImage doubles performance... maybe these could be used elsewhere...
local atom gp_dstDC = 0, -- general purpose screen destDC
           gp_srcDC = 0  -- general purpose screen srcDC

local function tg_WinAPI_GetDestDC()
    if gp_dstDC=0 then
        gp_dstDC = tg_WinAPI_CreateCompatibleDC(0)
    end if
    integer obj_type = c_func(xGetObjectType, {gp_dstDC})
    assert(obj_type==OBJ_MEMDC)
    return gp_dstDC
end function

local function tg_WinAPI_GetSrcDC()
    if gp_srcDC=0 then
        gp_srcDC = tg_WinAPI_CreateCompatibleDC(0)
    end if
    integer obj_type = c_func(xGetObjectType, {gp_srcDC})
    assert(obj_type==OBJ_MEMDC)
    return gp_srcDC
end function

local bool ufontwarn = false

-- Never deleted:
local sequence font_cache = {},
             cached_fonts = {},
        cached_font_names = {}

procedure tg_set_font(gdx id, atom handle, string v, atom angle=0)
    -- Either the gdx or handle should be null:
    -- When gdx!=0 this is really setting up the cache for inheritance,
    -- else handle is a pango layout or a compatible DC into which the
    -- target image has already been (/perhaps soon will be) selected.

if match("EXPAND",v) then ?9/0 end if
--DEV togo: (replace with cached_font_names[inherited(ctrl_font[id])]...?
    if id then
        ctrl_fonts[id] = v
    end if

    atom fontdesc
    integer comma = find(',',v),
         fontsize = 0, k
    string face = v[1..comma-1],
       facerest = ``
    sequence styles = {}, fsf
    if comma then
        styles = split_any(v[comma+1..$],` ,`)
        string sizestr = styles[$]
        if ends("px",sizestr) then
            fontsize = -to_integer(sizestr[1..-3])
        elsif ends("pt",sizestr) then
            fontsize = +to_integer(sizestr[1..-3])
        else
            fontsize = to_integer(sizestr)
        end if
        if fontsize then styles = styles[1..$-1] end if
        for i,s in styles do
            s = proper(s)
            if s!=`Normal` then
                facerest &= ` `&s
            end if
            styles[i] = s 
        end for
    end if
    if fontsize<0 then
        facerest &= sprintf(` %dpx`,-fontsize)
    elsif fontsize then
        facerest &= sprintf(` %d`,fontsize)
    end if
--printf(1,"%s -> fontsize=%d styles=%v\n",{v,fontsize,styles})

    if backend=TG_GTK then
        if find(face,{`Helvetica`,`Arial`,`Calibri`}) then
            face = `Sans`
        elsif find(face,{`Courier`,`Courier New`}) then
--      elsif find(face,{`Courier`,`Courier New`,`Consolas`}) then -- ew, no ta!
            face = `Monospace`
        elsif find(face,{`Times`,`Times New Roman`}) then
            face = `Serif`
--      elsif face=`Consolas` then
--          face = `Cascadia Mono` -- ???
        elsif not find(face,{`Sans`,`Monospace`,`Serif`,`Consolas`,`Segoe UI`,`Yu Gothic`}) then
            if not ufontwarn then
                printf(1,"Warning(hGUI.e line %d): FONT %s may not be supported...\n",{source_line(),face})
                ufontwarn = true
            end if
        end if
        fsf = {face,styles,fontsize}
        k = find(fsf,font_cache)
        if k then
            fontdesc = cached_fonts[k]
        else
            fontdesc = c_func(x_pango_font_description_from_string,{face&facerest})
            font_cache = append(font_cache,fsf)
            cached_fonts &= fontdesc
            cached_font_names &= 0
            k = length(font_cache)
            if id then
                ctrl_font[id] = k
            end if
            cached_font_names[k] = face&`,`&facerest
        end if
        if handle then
            c_proc(x_pango_layout_set_font_description,{handle,fontdesc})
        end if
        if id then
            ctrl_font[id] = k
        end if
    elsif backend=TG_WINAPI then
        if find(face,{`Helvetica`,`Sans`}) then
            face = `Arial`
        elsif find(face,{`Courier`,`Monospace`}) then
            face = `Courier New`
        elsif find(face,{`Times`,`Serif`}) then
            face = `Times New Roman`
        end if
        atom hFont
        fsf = {face,styles,fontsize,angle}
        k = find(fsf,font_cache)
        if k then
            hFont = cached_fonts[k]
        else
            if fontsize>0 then
                fontsize = floor(-DEVCAP_LOGPIXELSY*fontsize/72)
            end if
            set_struct_field(idLOGFONT,pLOGFONT,`lfHeight`,fontsize)
            set_struct_field(idLOGFONT,pLOGFONT,`lfCharSet`,DEFAULT_CHARSET)
            set_struct_field(idLOGFONT,pLOGFONT,`lfEscapement`,-angle*10)
            set_struct_field(idLOGFONT,pLOGFONT,`lfOrientation`,-angle*10)
--          set_struct_field(idLOGFONT,pLOGFONT,`lfQuality`,DEFAULT_QUALITY (==0)) -- (best)

--          assert(length(face)<LF_FACESIZE)
            assert(length(face)*2<LF_FACESIZE)
--          set_struct_field(idLOGFONT,pLOGFONT,`lfFaceName`,face&0)
            atom pFace = get_struct_field_addr(idLOGFONT,pLOGFONT,`lfFaceName`)
            poke2(pFace,utf8_to_utf16(face)&0)
            integer fw = iff(find(`Bold`,styles)?FW_BOLD:FW_NORMAL),
                    ib = find(`Italic`,styles)!=0,
--DEV we're not doing it this way... (see docs)
                    ub = find(`Underline`,styles)!=0,
                    sb = find(`Strikeout`,styles)!=0
            set_struct_field(idLOGFONT,pLOGFONT,`lfWeight`,fw)
            set_struct_field(idLOGFONT,pLOGFONT,`lfItalic`,ib)
            set_struct_field(idLOGFONT,pLOGFONT,`lfUnderline`,ub)
            set_struct_field(idLOGFONT,pLOGFONT,`lfStrikeOut`,sb)
            hFont = c_func(xCreateFontIndirect,{pLOGFONT})
            font_cache = append(font_cache,fsf)
            cached_fonts &= hFont
            cached_font_names &= 0
            k = length(font_cache)
            cached_font_names[k] = face&`,`&facerest
        end if
        if handle then
            {} = c_func(xSelectObject,{handle,hFont})
        end if
        if id then
            ctrl_font[id] = k
        end if
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_set_font)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
end procedure

local function tg_get_inherited_flag(integer id, flag)
    do
        if and_bits(ctrl_flags[id],flag) then
            return false
        end if
        id = ctrl_parent[id]
    until id=0
    return true
end function

global function gGetParent(gdx id)
    return ctrl_parent[id]
end function

local function tg_get_margins(gdx id)
    object cmi = ctrl_size[id][SZ_MARGIN]
    sequence res
    if atom(cmi) then
        res = repeat(cmi,4,false)
    else
        sequence mpdx = {{1,1,1,1},
                         {1,2,1,2},
                         {1,2,3,2},
                         {1,2,3,4}}[length(cmi)]
        res = extract(cmi,mpdx)
    end if
    return res
end function

global function gGetAttribute(gcx id, string name, integer nFrames=1)
    if name=`CLASSNAME` then return gdx_name(id) end if
    if id<0 then
        -- deal with gImage/gPixbuf attributes first:
        integer idx, adx = 0
        if odd(id) then -- gImage
            idx = (-id+1)/2
            switch name do
                case `BGCLR`: adx = TG_IMG_BGCLR
                case `FGCLR`: adx = TG_IMG_FGCLR
                case `FONT`: object font = gimages[idx][TG_IMG_DRAW_FONT]
                             return iff(font=NULL?TG_STD_FONT:font)
                case `LINESTYLE`: adx = TG_IMG_LINESTYLE
                case `LINEWIDTH`: adx = TG_IMG_LINEWIDTH
                case `USER_DATA`: adx = TG_IMG_USER_DATA
                case `SIZE`: return {gimages[idx][TG_IMG_WIDTH],
                                     gimages[idx][TG_IMG_HEIGHT]}
                case `TRANSPARENT`: adx = TG_IMG_TRANSPARENT
            end switch
            if adx then return gimages[idx][adx] end if
        else            -- gPixbuf
            idx = -id/2
            switch name do
                case `BGCLR`: adx = TG_PB_BGCLR
                case `FGCLR`: adx = TG_PB_FGCLR
                case `LINESTYLE`: adx = TG_PB_LINESTYLE
                case `LINEWIDTH`: adx = TG_PB_LINEWIDTH
                case `USER_DATA`: adx = TG_PB_USER_DATA
                case `SIZE`: return {length(gpixbufs[idx][1]),
                                     length(gpixbufs[idx])}
            end switch
            if adx then 
                if idx<=length(pixbuf_xtra) then
                    return pixbuf_xtra[idx][adx]
                end if
                return {TG_WHITE,TG_BLACK,1,1,NULL}[adx]
            end if
        end if
        string what = iff(odd(id)?`gImage`:`gPixbuf`)
        crash(`gGetAttribute(%s,%s)`,{what,name},nFrames+1)
    end if
    assert(gdx(id))
    integer ct = ctrl_types[id]

    if name=`ACTIVE` then
-- and visible??
        return tg_get_inherited_flag(id,CF_INACTIVE)

    elsif name=`CANFOCUS` then
        return and_bits(ctrl_flags[id],CF_CANFOCUS)!=0

    elsif name=`CBXY` then
        return {ctrl_size[id][SZ_X],
                ctrl_size[id][SZ_Y]}

--/*
--DEV not documented (for gVidCut.exw)
    elsif name=`CLIENT` then
        integer left = ctrl_size[id][SZ_X],
                 top = ctrl_size[id][SZ_Y],
               width = ctrl_size[id][SZ_W],
              height = ctrl_size[id][SZ_H]
        if ct!=DIALOG then
            gdx dlg = gGetDialog(id)
            if not gGetAttribute(dlg,`MAXIMISED`) then
                left += ctrl_size[dlg][SZ_X]+8
                 top += ctrl_size[dlg][SZ_Y]
            end if
        else
            width -= 2
        end if
        top += 32
        return {left,top,width,height}
--*/
    elsif name=`BGCLR` then
        while id do
            atom res = ctrl_bg[id]
            if res!=-1 then return res end if
            id = ctrl_parent[id]
        end while

    elsif name=`FGCLR` then
        -- as documented, deliberately different inheritance:
        -- BGCLR is container-inherited, whereas
        -- FGCLR is non-inherited.
        return ctrl_fg[id]

    elsif name=`EXPAND` then
        integer hvdx = and_bits(ctrl_flags[id],CF_EXPAND) -- 0/1/2/4
        string res = {`NONE`,`BOTH`,`HORIZONTAL`,0,`VERTICAL`}[hvdx+1]
        return res

    elsif name=`FONT` then
        integer fid = id -- (since gcx id:=0 typechecks)
        do
            integer font = ctrl_font[fid]
            if font!=UNDEFINED then
                return cached_font_names[font]
            end if
            sequence did = deferred_attr[fid]
            for k=length(did) to 1 by -1 do
                if did[k][1]=name then
                    return did[k][2]
                end if
            end for
            fid = ctrl_parent[fid]
        until fid=NULL
        return TG_STD_FONT

    elsif name=`GAP` then
        assert(ct=BOX)
        return ctrl_xtra[id][CX_BOX_GAP]

    elsif name=`LINEWIDTH` then
        return ctrl_penwidth[id]

    elsif name=`LINESTYLE` then
        return ctrl_penstyle[id]

    elsif name=`MARGIN` then
        return ctrl_size[id][SZ_MARGIN] -- 0 | {trbl} | {tb,rl} | {t,rl,b} | {t,r,b,l}

    elsif name=`MARGINS` then
        return tg_get_margins(id) -- always length 4 (read only)

    elsif name=`MINSIZE`
       or name=`MAXSIZE` then
        integer mmdx = find(name,{`MINSIZE`,`MAXSIZE`}),
           {mwx,mhx} = {{SZ_MIN_W,SZ_MIN_H},
                        {SZ_MAX_W,SZ_MAX_H}}[mmdx],
                   w = ctrl_size[id][mwx],
                   h = ctrl_size[id][mhx]
        return {w,h}

    elsif name=`MOUSEPOS` then
        if not tg_get_inherited_flag(id,CF_INVISIBLE) then return {-1,-1} end if
        integer dlg = gGetDialog(id)
--      if dlg=0 then dlg=id end if
        atom handle = iff(dlg?ctrl_handles[dlg]:
                      iff(backend=TG_GTK?ctrl_hdc[id][2]:
                      iff(backend=TG_WINAPI?ctrl_hdc[id][1]:
                      iff(backend=TG_JS?true:9/0))))
        if handle then
            integer x = 0, 
                    y = 0
            if backend=TG_GTK then
                c_proc(x_gtk_widget_get_pointer,{handle,pX,pY})
                x = get_struct_field(idGdkRectangle,pRECT,`x`)
                y = get_struct_field(idGdkRectangle,pRECT,`y`)
            elsif backend=TG_WINAPI then
                c_funk(xGetCursorPos,{pPOINT})
                c_funk(xScreenToClient,{handle,pPOINT})
                x = get_struct_field(idPOINT,pPOINT,`x`)
                y = get_struct_field(idPOINT,pPOINT,`y`)
            elsif backend=TG_JS then
                #ilJS{
                    puts(1,"MOUSEPOS javascript code!\n");
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if              
--DEV untested
            if id!=dlg then
                x -= ctrl_size[id][SZ_X]
                y -= ctrl_size[id][SZ_Y]
            end if
            return {x,y}
        end if
        -- (undefined if not mapped/visible...)
--
--  JavaScript
--  In a browser environment, it's impossible to actually get the cursor position at the specific moment. 
--  You must wait for user input (movement, click, etc). One of many ways to add an event listener:
--
--  document.addEventListener('mousemove', function(e){
--    var position = { x: e.clientX, y: e.clientY }
--  }
--  In the above example, the window may not be external. It must in fact be a web browser window, which runs the script.
--

    elsif name=`SCROLLFIX` then
        assert(and_bits(ctrl_flags[id],CF_CANVAS))
        return and_bits(ctrl_flags[id],CF_SCROLLFIX3)/CF_SCROLLFIX

    elsif name=`SCROLLSIZE`
       or name=`SCROLLPORT`
       or name=`VIEWPORT` then
        assert(and_bits(ctrl_flags[id],CF_CANVAS))
        integer w = 0, h = 0, x = 0, y = 0,
                hsv = false, hsh = 0,
                vsv = false, vsw = 0,
                {sw,sh} = gGetAttribute(id,`SIZE`)
        object sbinfo = ctrl_sbinfo[id]
        if sequence(sbinfo) then
            w = sbinfo[SB_SCRLW]
            h = sbinfo[SB_SCRLH]
            x = sbinfo[SB_ORIGX]
            y = sbinfo[SB_ORIGY]
            hsv = sbinfo[SB_HVISB]
            hsh = sbinfo[SB_HHIGH]
            vsv = sbinfo[SB_VVISB]
            vsw = sbinfo[SB_VWIDE]
        end if
        if name=`SCROLLSIZE` then
            if w=0 then w = sw end if
            if h=0 then h = sh end if
            sbinfo = {w,h}
        else --if name=`SCROLLPORT` or name=`VIEWPORT` then
            sw -= vsv*vsw
            sh -= hsv*hsh
            sbinfo = {x,y,sw,sh}
        end if
        return sbinfo

    elsif name=`SIZE` then
        integer w = ctrl_size[id][SZ_W],
                h = ctrl_size[id][SZ_H]
        if ct=DIALOG and backend=TG_GTK then
            integer {dw,dh} = tg_get_dialog_decoration_size(id)
            w += dw
            h += dh
        end if
        return {w,h}

    elsif name=`TIP` then
        return tool_tips[id]

    elsif name=`TITLE` then
        return ctrl_titles[id]

    elsif name=`USERSIZE`
       or name=`USER_SIZE` then
        return {ctrl_size[id][SZ_USER_W],
                ctrl_size[id][SZ_USER_H]}

    elsif name=`USER_DATA` then
        return user_data[id]

    elsif name=`VISIBLE` then
        return tg_get_inherited_flag(id,CF_INVISIBLE)
    end if

    integer geta = ctrl_get_attr[ct]
    if geta then return geta(id,name,nFrames+2) end if
    tg_bad_attr(id,name,nFrames+1)
end function

global function gGetInt(gcx id, string name, integer nFrames=1)
    -- not suitable for: CLASSNAME,...
    if id>0 then
        integer ct = ctrl_types[id]
        if name=`EXPAND` then
            return and_bits(ctrl_flags[id],CF_EXPAND)
        elsif name=`SPACE` then
            assert(ct=BOX)
            integer h = ctrl_xtra[id][CX_BOX_SPACE_H],
                    v = ctrl_xtra[id][CX_BOX_SPACE_V]
            return iff(h==v?h:{h,v})
--DEV untested:
        elsif name=`SELMODE` 
           or name=`CELLMODE` then
            assert(ctrl_types[id]=TABLE)
            return ctrl_xtra[id][CXTBL_SELMODE]
        elsif name=`ORIENTATION` and ct=BOX then
            bool bHoriz = and_bits(ctrl_flags[id],CF_VERTICAL)==0
            return bHoriz
        end if
    end if
--  object ores = gGetAttribute(id,name,dflt,nFrames+1)
    object ores = gGetAttribute(id,name,nFrames+1)
    integer res = iff(string(ores)?to_number(ores):ores)
    return res
end function

