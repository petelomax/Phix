local function tg_WinAPI_process_key(integer id, msg, atom wParam, lParam, bool bUp)
    --
    -- Firstly: get things down to one and precisely one message per keystroke.
    -- WM_CHAR is best for graphical characters, and distinguishes eg '1' from '!'
    -- WM_KEYDOWN overlaps a bit, but gets eg Insert (nb as the vk_code '-'/#2D...)
    -- WM_SYSCHAR also handles '1' vs '!', and critically allows supressing BELLs.
    -- WM_SYSKEYDOWN is finally needed for any remaining non-graphical alt-keys.
    --
    bool ctrl = and_bits(c_func(xGetKeyState,{VK_XCTRL}),#8000)!=0,
        shift = and_bits(c_func(xGetKeyState,{VK_XSHIFT}),#8000)!=0,
          alt = and_bits(c_func(xGetKeyState,{VK_XALT}),#8000)!=0,
     bGraphic = (wParam>=#30 and wParam<=#5A)   -- 0..9 & A..Z
             or (wParam>=#60 and wParam<=#6F)   -- Numpad
             or (wParam>=#BA and wParam<=#E2)   -- OEM
    integer key = 0
    if msg=WM_CHAR then -- #102 = 258
        if not ctrl 
        and wParam>=#20 then
            key = wParam
//          if key=#A3 then key=VK_POUND end if -- fudge...
        end if
    elsif msg=WM_KEYDOWN    -- #100 = 256
       or msg=WM_KEYUP then -- #101 = 257
        if ctrl or (not bGraphic and wParam!=VK_SP) then
            if wParam>=VK_XSHIFT and wParam<=VK_XALT then
                wParam = floor(lParam/#10000)
                wParam -= and_bits(wParam,#4000)
            end if
            key = tg_map_key(wParam)
        end if
    elsif msg=WM_SYSCHAR then -- #106 = 262
        key = wParam
    elsif msg=WM_SYSKEYDOWN    -- #104 = 260
       or msg=WM_SYSKEYUP then -- #105 = 261
        if not bGraphic and (wParam>' ' or wParam=VK_XALT) then
            key = tg_map_key(wParam)
            if wParam=VK_XALT then key=VK_LALT end if
        end if
    end if
    if key then
        -- explicitly forward keys to the (non-focus-stealing) popup, if any
        gdx popup = ctrl_xtra[id][DX_ACTIVEPOP]
        if popup and msg=WM_KEYDOWN then
            integer ct = ctrl_types[popup]
            if ct=MENU then
                integer mdx = tg_menu_visible(popup,1,true)
-- erm mdx=0 ==> why DX_ACTIVEPOP?
                return tg_process_menu_keydown(popup,mdx,key)
--              if mdx then return tg_process_menu_keydown(popup,mdx,key) end if
            elsif ct=CALENDAR then -- (gDatePick)
                return tg_calendar_key(popup,key)
            elsif ct=LIST then -- (gDropDown)
                return tg_list_key(popup,key,ctrl,shift) 
            elsif ct=CANVAS then
                return true -- hText.exw[?]
            elsif ct=VIDEO then
                return true -- gVidCut.exw[?]
            else
                ?9/0 --{"key",popup,ct,ctrl_names[ct]} -- (should never trigger)
            end if
        end if
        integer res = tg_key_handler(id,key,ctrl,shift,alt,bUp)
        if res then return 0 end if
        -- GTK equivalent done in tg_gtk_focus(), ie 
        -- the `focus` event not the `key_press_event`:
        if msg=WM_KEYDOWN and key=VK_TAB then
            gdx fid = gGetFocus()
            if fid then id = fid end if
            tg_find_next_tab_stop(id,shift)
        end if
    end if
    -- (if we haven't dealt with this, nowt else will:..)
    if msg=WM_CHAR and wParam=VK_TAB then return 0 end if
    return true -- (carry on with xDefWindowProc)
end function

