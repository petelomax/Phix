local procedure g_log(string fp, name, object qual, sequence args, bool bShowRes=false, object res=0)
    -- fp is one of `c_func`, `c_proc`, `callback`, `call`, or `set`, etc.
    -- name is eg `xSetWindowPos` or `??` (both being backend-specific) or `ctrl_sizeWH`.
    if DF_ACTIVE==DF_NONE or nodump then return end if
    integer nf = getdd(name,-1,DF_FLAGS), dotypes = 0
    assert(nf!=-1,name&` not set in DF_FLAGS`)
    if and_bits(nf,DF_ACTIVE)=0 then return end if
    if c_log=NULL then
        c_log = repeat(0,CMAX)
        c_next = 1
    end if
    c_log[c_next] = {fp,name,qual,args}
    c_next = remainder(c_next,CMAX)+1
    c_log[c_next] = 0
    if backend=TG_GTK then
        if name=`gtk_window_set_default_size`
        or name=`gtk_window_resize` then
            args = deep_copy(args)
            dotypes = 1
        end if
    elsif backend=TG_WINAPI then
        if name=`GetWindowRect` then
            object p2 = args[2]
            if p2=pRECT then 
                if bShowRes then
                    sequence fields = deep_copy(get_field_details(idRECT,``))
                    for i,f in fields do
                        fields[i] = sprintf(`%s:%v`,{f,get_struct_field(idRECT,pRECT,f)})
                    end for
                    res = join(fields,`, `)
                end if
                p2 = `pRECT` 
            end if
            args = {args[1],p2}
            dotypes = 1
        elsif name=`SetWindowPos` then
            args = deep_copy(args)
            integer flags = args[7]
            dotypes = 1
            if not and_bits(flags,SWP_NOZORDER) then
                dotypes = 2
            end if
            args[7] = decode_flags(SWP_FLAGS,flags)
        end if
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (g_log)`);
        #}ilJS
    else
        ?9/0
    end if
    for i,h in args to dotypes do
        if h=0 then
            args[i] = `NULL`
        else
            h = tg_getID(h)
            args[i] = {h,gdx_name(h)}
        end if
    end for
    if qual!=0 then 
        if integer(qual) then qual = sprintf(`%d`,qual)
        elsif not string(qual) then qual = sprintf(`%s(%d)`,qual) end if
        name = sprintf(`%s[%s]`,{name,qual})
    end if
    if bShowRes then
        printf(1,"%s(%s,%v) ==> %v\n",{fp,name,args,res})
    else
        printf(1,"%s(%s,%v)\n",{fp,name,args})
    end if
end procedure

--
-- **NB** It would be quite wrong to blanket-call this, for instance tg_getID would crash,
--        and getting info back from WinAPI/GTK is generally of little interest. Instead,
--        what is of real interest are calls we make that supply wrong info to WinAPI/GTK.
--         (actually, that's more like wrong info in ctrl_sizes[], in more recent times)
--        Each entry point we decide to monitor, one at a time, probably requires the same
--        sort of tweaks as shown for xGetWindowRect above. Actually maybe there is a case
--        for logging everything, so you don't have to pester an end user, but I do rather
--        doubt that will (ever) be significant/useful/critical for theGUI, in here almost
--        everything will be solved by me anyway. Filtering options are unlimited: on each
--        call, in g_func/proc, or during a post-mortem on an as yet unwritten g_dump_all.
--
local function g_func(integer rid, sequence args, object qual=0)
    atom res = c_func(rid,args)
    g_log(`c_func`,c_name(rid),qual,args,true,res)
    return res
end function

local procedure g_proc(integer rid, sequence args, object qual=0)
    c_proc(rid, args)
    g_log(`c_proc`,c_name(rid),qual,args)
end procedure

-- these three specifically avoid the need to declare/test bOK/res:
local procedure g_funk(integer rid, sequence args, object qual=0)
    bool bOK = c_func(rid,args)
    g_log(`c_func`,c_name(rid),qual,args,true,bOK)
    assert(bOK)
end procedure

bool bIgnoreTextExtentErrors = false

local procedure c_funk(integer rid, sequence args)
    bool bOK = c_func(rid,args)
--  assert(bOK)
    if not bOK then
        atom e = c_func(xGetLastError,{})
        string name = c_name(rid)
        if name!=`GetTextExtentPoint32W`
        or not bIgnoreTextExtentErrors then
            crash("%s() failure, error code %d [#%x]",{name,e,e})
        end if
    end if
end procedure

local procedure c_funz(integer rid, sequence args)
    atom res = c_func(rid,args)
    assert(res!=0)
end procedure

local sequence gtk_version

local function tg_to_bool(object v, nFrames=1)
    -- convert `YES`/`NO`/etc to true/false (as a common requirement)
    if string(v) then
        string uv = upper(v)
        if find(uv,{`YES`,`ON`,`1`,`TRUE`}) then v = true elsif
           find(uv,{`NO`,`OFF`,`0`,`FALSE`}) then v = false
        else crash(`unrecognised("%s")`,{v},nFrames+1) end if
    else
        assert(v=true or v=false,"t/f?",{},nFrames+1)
    end if
    return v
end function

local function tg_to_int(object v)
    -- convert eg `20` to 20, but v may already be integer
    if string(v) then
        v = to_number(v)
    end if
    assert(integer(v))
    return v
end function

local function tg_intint(string val, name, integer nFrames)
    --
    -- convert eg `225x75` to {225,75}, and in fact 
    --            `50x10x20x30` to {50,10,20,30},
    --            `1`->{1}, and `1x2x3`->{1,2,3}.
    -- likewise eg `{225,75}` -> {225,75}, etc.
    --
    sequence res
    if val[1]='{' then
        assert(val[$]='}')
        res = split(val[2..-2],',')
    else
        res = split(val,'x',false) -- (eg `x50` -> {"","50})
    end if
    for i,ri in res do
        assert(ri=="" or is_integer(ri),"invalid "&name&":"&val,nFrames+1)
        res[i] = to_integer(ri)
    end for
    return res
end function

global function gGetDialog(gdx id)
    while id and ctrl_types[id]!=DIALOG do
        id = ctrl_parent[id]
    end while
    return id
end function

