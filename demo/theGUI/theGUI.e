local procedure tg_ensure_visible(gdx list, integer line)
    object list_attr = ctrl_xtra[list]
    integer lpp = list_attr[LX_LINESPP],
         n_rows = list_attr[LX_N_ROWS],
       top_line = list_attr[LX_TOPLINE],
            col = list_attr[LX_CURSORX],
          third = floor(lpp/3),
      last_line = min(line+lpp-third,n_rows)
    list_attr = 0
    top_line = max(top_line,last_line-lpp+1)
    tg_list_set_top_line(list,top_line)
    tg_list_set_line_col(list,line,col)
    gRedraw(list)
end procedure

local procedure tg_redraw_list(gdx list)
    object list_attr = ctrl_xtra[list],
           show_item = list_attr[LX_SHOWLINE],
            selected = list_attr[LX_SELECTED],
              sbinfo = ctrl_sbinfo[list],
                data = list_attr[LX_DATA]
    integer sbw = iff(sequence(sbinfo)?sbinfo[SB_VWIDE]:17),
            {width, height} = gGetAttribute(list, `SIZE`),
            {ox,oy,vw,vh} = gGetAttribute(list,`VIEWPORT`),
            {char_width,line_height} = gGetTextExtent(`X`,list),
            hover_line = list_attr[LX_HOVLINE],
            cursorx = list_attr[LX_CURSORX],
            cursory = list_attr[LX_CURSORY],
            caret = list_attr[LX_CARET],
            longest_line = list_attr[LX_LONGEST],
            n_rows = list_attr[LX_N_ROWS]
    atom caretime = list_attr[LX_CARETIME],
         caretend = list_attr[LX_CARETEND],
            bgclr = ctrl_bg[list],
            bgsel = list_attr[LX_BGSEL],
            bghov = list_attr[LX_BGHOV]
    list_attr = 0 -- (kill refcount)
    sbinfo = 0 -- (kill refcount)
    if show_item!=0 then
        tg_ensure_visible(list, show_item)
        ctrl_xtra[list][LX_SHOWLINE] = 0
    end if
    ctrl_xtra[list][LX_LINEHT] = line_height
    ctrl_xtra[list][LX_CHARWID] = char_width
    ctrl_xtra[list][LX_LINESPP] = floor(vh/line_height)
    string sig
    if integer(data) then
        sig = tg_get_sig(data)
        if sig=`FI` then
            n_rows = data(0)
            longest_line = data(-1)
        elsif sig=`FOI` then
            n_rows = data(list,0)
            longest_line = data(list,-1)
        else
            ?9/0 -- unrecognised sig
        end if
    elsif n_rows=0 then
        n_rows = length(data)
        integer ll = 0, lil
        for i,line in data do
            if string(line) then
                lil = length(line)
            else
                lil = 0
                for fragment in line do
                    if string(fragment) then
                        lil += length(fragment)
                    else
                        lil += length(fragment[1])
                    end if
                end for
            end if
            if lil>ll then
                ll = lil
                longest_line = i
            end if
        end for
        ctrl_xtra[list][LX_LONGEST] = longest_line
    end if
    ctrl_xtra[list][LX_N_ROWS] = n_rows
    if longest_line=0 then
        gSetAttribute(list,`SCROLLSIZE`,{width-sbw,line_height*(n_rows+1)})
        -- (aside: since this is never hz, ^  ^ ^   is quite right)
    end if
    sequence si
    integer l1 = max(1,floor(oy/line_height)+1),
            nr = min(n_rows-l1+1,ceil(vh/line_height)),
            vy = oy
    ctrl_xtra[list][LX_TOPLINE] = l1
    bool bActive = gGetAttribute(list,`ACTIVE`)
    integer fgclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
    gSetAttribute(list,`FGCLR`,fgclr) -- (nb *NOT* saved/restored between redraws)

    for rll=iff(longest_line?0:1) to nr do
        integer r = iff(rll=0?longest_line:rll+l1-1), vx = 2
        if integer(data) then
            if sig=`FI` then
                si = data(r)
            elsif sig=`FOI` then
                si = data(list,r)
            else
                ?9/0
            end if
        else
            si = data[r]
        end if
        if rll!=0 and r!=0 then
            atom clr = -1
            if bgsel!=bgclr and iff(atom(selected)?r=selected:selected[r]) then
                clr = bgsel
            elsif bghov!=bgclr and r=hover_line then
                clr = bghov
            end if
            if clr!=-1 then
                integer ymin = vy-oy, ymax = ymin+line_height
                gDrawRect(list,3,ymin,width-3,ymax,true,0,clr)
--              if clr=bgsel and caret then
                if clr=bgsel and caret and cursory=r then
--DEV (sip) that's not going to be true for multiple selection??
--                  assert(cursory=r) -- sanity check [it always is]
                    clr = ctrl_xtra[list][LX_CARETCLR]
                    if time()>=caretime then
                        clr = iff(clr=TG_BLACK?bgsel:TG_BLACK)
                        ctrl_xtra[list][LX_CARETIME] = time()+0.375
                        if time()>caretend and clr=TG_BLACK then
                            gdx timer = ctrl_xtra[list][LX_CARETIMER]
                            if timer then
                                gSetAttribute(timer,`RUN`,false)
                            end if
                        end if
                    end if
                    integer xmin = (cursorx-1)*char_width+2
                    gDrawRect(list,xmin,ymin,xmin+1,ymax,true,0,clr)
                    ctrl_xtra[list][LX_CARETCLR] = clr
                end if
            end if
        end if
        if string(si) then
            if rll=0 then
                vx += gGetTextExtent(si,list,bNorm:=true)[1]
            else
                gDrawText(list,vx-ox,vy-oy,si,{},TG_SE,style:={-1,true})
            end if
        else
            for sii in si do
                object sic = -1 -- colour
                atom sis = -1  -- style
                if not string(sii) then
                    if not sequence(sii) then
                        crash(`fragments must be string or {string,colour[,style}}`)
                    end if
                    if length(sii)=2 then
                        {sii, sic} = sii
                    elsif length(sii)=3 then
                        {sii, sic, sis} = sii
                    else
                        crash(`unrecognised fragment[length]:%v`,{sii})
                    end if
                    assert(string(sii))
                    if not bActive then -- greyscale
                        integer {rr,gg,bb,aa} = to_rgba(sic)
                        rr = floor(sqrt((rr+gg+bb)/(255*3))*255)
                        sic = rgba(rr,rr,rr,aa)
                    end if
                end if
                if rll!=0 then
                    gDrawText(list,vx-ox,vy-oy,sii,{},TG_SE,0,sic,{sis,true})
                end if
                vx += gGetTextExtent(sii,list,bNorm:=true)[1]
            end for
        end if
        if rll=0 then
            gSetAttribute(list,`SCROLLSIZE`,{vx,line_height*(n_rows)+2})
        else
            vy += line_height
        end if      
    end for
end procedure

