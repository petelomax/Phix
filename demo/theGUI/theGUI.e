local function tg_gtk_press(atom handle, event, gdx id, bool bUp) -- (GTK only)
    -- GTK only part (WinAPI equivalent in tg_WinAPI_WndProc)
    assert(id=tg_getID(handle))
    integer keyval = get_struct_field(idGdkEventKey,event,`keyval`),
             state = get_struct_field(idGdkEventKey,event,`state`),
               key = tg_map_key(keyval),
              ctrl = and_bits(state,GDK_CONTROL_MASK)!=0,
             shift = and_bits(state,GDK_SHIFT_MASK)!=0,
               alt = and_bits(state,GDK_ALT_MASK)!=0
    assert(ctrl_types[id]=DIALOG)
    if not bUp then
        -- explicitly forward keys to the (non-focus-stealing) menu|popup
        gdx popup = ctrl_xtra[id][DX_ACTIVEPOP]
        if popup then
            integer ct = ctrl_types[popup]
            if ct=MENU then
                integer mdx = tg_menu_visible(popup,1,true)
                return tg_process_menu_keydown(popup,mdx,key)
--              if mdx then return tg_process_menu_keydown(popup,mdx,key) end if
            elsif ct=CALENDAR then -- (gDatePick)
                return tg_calendar_key(popup,key)
            elsif ct=LIST then -- (gDropDown)
                return tg_list_key(popup,key,ctrl,shift) 
            else
                ?9/0 --{"key",popup,ct,ctrl_names[ct]} -- (should never trigger)
            end if
        end if
    end if
    return tg_key_handler(id,key,ctrl,shift,alt,bUp)
end function

local function tg_gtk_press_key(atom handle, event, gdx id) -- (GTK only)
    return tg_gtk_press(handle,event,id,false)
end function

local function tg_gtk_release_key(atom handle, event, gdx id) -- (GTK only)
    -- (clear ctrl/shiftkey when/if those keys are released)
    return tg_gtk_press(handle,event,id,true)
end function

local procedure tg_track_mouseleave(gdx id, bool bTrackMouse)
    integer flags = ctrl_flags[id],
            wasTrackMouse = and_bits(flags,CF_TRACKLEAVE)
    bool bHovlist = ctrl_types[id]=LIST and 
                    ctrl_xtra[id][LX_HOVLINE]!=0
    if bHovlist then bTrackMouse := true end if
    flags -= and_bits(flags,CF_TRACKLEAVE)
    if bTrackMouse then flags += CF_TRACKLEAVE end if
    ctrl_flags[id] = flags
    if backend=TG_GTK then
        -- gtk done via `leave-notify-event`/tg_gtk_mouseleave, for other backends:
    elsif backend=TG_WINAPI then
        if bTrackMouse
        or wasTrackMouse then
            -- ask for a WM_MOUSELEAVE msg, when/if it actually does:
            gdx dlg = gGetDialog(id)
            atom dwFlags = iff(bTrackMouse?0:TME_CANCEL)+TME_LEAVE,
                 handle = iff(dlg?ctrl_handles[dlg]:
                        iff(backend=TG_GTK?ctrl_hdc[id][2]:
                      iff(backend=TG_WINAPI?ctrl_hdc[id][1]:9/0)))
            set_struct_field(idTRACKMOUSEEVENT,pTRACKMOUSEEVENT,`hWndTrack`,handle)
            set_struct_field(idTRACKMOUSEEVENT,pTRACKMOUSEEVENT,`dwFlags`,dwFlags)
            c_funk(xTrackMouseEvent,{pTRACKMOUSEEVENT})
        end if
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_track_mouseleave)`);
        #}ilJS
    else
        ?9/0
    end if
end procedure

local procedure tg_mouseleave(gdx dlg)
    -- common to WinAPI and GTK, invoked from tg_gtk_mouseleave/WM_MOUSELEAVE
    integer lm = ctrl_xtra[dlg][DX_LAST_MOUSE]
    sequence checkset = iff(lm and lm!=dlg?{lm,dlg}:{dlg})
    for id in checkset do
        integer mouseleave = gGetHandler(id,`MOUSELEAVE`)
        if mouseleave then
            string sig = tg_get_sig(mouseleave)
            if sig=`PO` then
                mouseleave(id)
            elsif sig=`P` then
                mouseleave()
            else
                ?9/0 -- unknown sig...
            end if
        end if
    end for
    gRedraw(dlg)
end procedure

local function tg_scrollbar_mousemove(gdx canvas, integer x,y, bool left,/*middle*/,right)
    object sbinfo = ctrl_sbinfo[canvas]
    if not sequence(sbinfo) then return false end if
    string monsba = tg_get_mouse_on_scrollbar(canvas,x,y)
    string clikmon = sbinfo[SB_CKMON]
    bool dragg = sbinfo[SB_DRAGG]
    if dragg then
        if left or right then
            integer origx = sbinfo[SB_ORIGX],
                    origy = sbinfo[SB_ORIGY],
                    clikx = sbinfo[SB_CLIKX],
                    cliky = sbinfo[SB_CLIKY]
            if clikmon=`` then
                origy += cliky-y
                cliky = y
                origx += clikx-x
                clikx = x
            else
                integer {w, h} = gGetIntInt(canvas,`SIZE`)
                if clikmon=`VT` then
                    integer vtmax = h - sbinfo[SB_HVISB]*sbinfo[SB_HHIGH]-sbinfo[SB_VWIDE]*2
                    origy += round((y-cliky)*sbinfo[SB_SCRLH]/vtmax)
                    cliky = y
                elsif clikmon=`HT` then
                    integer htmax = w - sbinfo[SB_VVISB]*sbinfo[SB_VWIDE]-sbinfo[SB_HHIGH]*2
                    origx += round((x-clikx)*sbinfo[SB_SCRLW]/htmax)
                    clikx = x
                end if
            end if
            sbinfo = NULL
            ctrl_sbinfo[canvas][SB_ORIGX] = origx
            ctrl_sbinfo[canvas][SB_ORIGY] = origy
            ctrl_sbinfo[canvas][SB_CLIKX] = clikx
            ctrl_sbinfo[canvas][SB_CLIKY] = cliky
            gRedraw(canvas)
        else
            sbinfo = NULL
            ctrl_sbinfo[canvas][SB_DRAGG] = false
        end if
        g_log(`set`,`ctrl_sbinfo`,source_line(),deep_copy(ctrl_sbinfo[canvas]))
    elsif monsba!=sbinfo[SB_MONLD] then -- (only if needed)
        sbinfo = NULL
        ctrl_sbinfo[canvas][SB_MONLD] = monsba
        gRedraw(canvas)
    end if
    return monsba!=``
end function

