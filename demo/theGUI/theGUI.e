local procedure tg_plot2(gcp canvas, atom x, y, f, xgap, integer width, bool bFlip)
    integer d = floor(width/2)
    tg_plot(canvas,x,y-d,(1-f)*xgap,bFlip)
    if d=0 then
        tg_plot(canvas,x,y+1,(f)*xgap,bFlip)
    else
        for i=-d+1 to d-1 do 
            tg_plot(canvas,x,y+i,1,bFlip)
        end for
        tg_plot(canvas,x,y+d,(f)*xgap,bFlip)
    end if
end procedure

local function fpart(atom x)
    return x-floor(x)   -- fractional part of x
end function

--local procedure tg_wu_line(integer canvas, atom x1, y1, x2, y2, colour, integer width, object style)
local procedure tg_wu_line(gcp canvas, atom x1, y1, x2, y2, colour, integer width, object style)
    tg_wu_set_rgbL(colour)
    bool flip := abs(y2-y1) > abs(x2-x1) -- (aka steep)
    if flip then
        {x1,y1,x2,y2} := {y1,x1,y2,x2}
    end if
    if x1>x2 then
        {x1,x2,y1,y2} := {x2,x1,y2,y1}
    end if
    
    atom dx := x2-x1,
         dy := y2-y1,
         gradient := iff(dx=0? 1 : dy/dx),
         x1end := round(x1),
         x2end := round(x2),
         y1end := y1 + gradient*(x1end-x1),
         y2end := y2 + gradient*(x2end-x2)

    integer dots = 1
    sequence dasher = iff(sequence(style)?style:dashers[style])

    -- handle first endpoint
    tg_plot2(canvas,x1end,floor(y1end),fpart(y1end),1-fpart(x1+0.5),width,flip)
    
    -- main loop
    atom intery := y1end + gradient -- first y-intersection for the main loop
    for x = x1end+1 to x2end-1 do
        dots = iff(dots=length(dasher)?1:dots+1)
        if dasher[dots] then
            tg_plot2(canvas,x,floor(intery),fpart(intery),1,width,flip)
        end if
        intery += gradient
    end for

    -- handle second endpoint
    tg_plot2(canvas,x2end,floor(y2end),fpart(y2end),fpart(x2+0.5),width,flip)

end procedure

