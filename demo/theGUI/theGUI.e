local procedure tg_register_handler(integer ct, string name, sequence sigs, bool bLeafOnly=false)
    -- aside: bLeafOnly is [probably] only actually helpful when ct is 0.
    if bLeafOnly then setd(name,true,leaf_only) end if
    setd({ct,name},sigs,handler_sigs)
end procedure

global procedure gSetHandler(object id, sequence name, integer handler=-1)
    if sequence(id) then
        for i in id do
            assert(integer(i) and i>0 and gdx(i))
            gSetHandler(i,name,handler)
        end for
    elsif not string(name) then
        if handler==-1 then
            -- assume name is a pair-list
            assert(even(length(name)))
            for i=1 to length(name) by 2 do
                string ni = name[i]
                integer f = name[i+1]
                gSetHandler(id,ni,f)
            end for
        else
            for n in name do
                assert(string(n))
                gSetHandler(id,n,handler)
            end for
        end if
    else
        assert(rtn(handler))
        assert(gdx(id))
        integer ct = ctrl_types[id], sdx
        string cn = ctrl_names[ct]
        -- be helpful (to be extended as and when needed):
        if name=`ACTION` then
            if ct=CANVAS then
                crash(`gSetHandler(CANVAS,"ACTION",rtn) should be changed to "REDRAW"`)
            elsif ct=CHECKBOX or ct=TEXT then
                crash(`gSetHandler(%s,"ACTION",rtn) should be changed to "VALUE_CHANGED"`,{cn})
            end if
        end if
--      if ct=DATEPICK then ct = TEXT end if
        if ct=DATEPICK or ct=DROPDOWN then ct = TEXT end if
        if and_bits(ctrl_flags[id],CF_CONTAINER)
        and getdd(name,NULL,leaf_only) -- (assumes {type,name} is never needed)
        and (name!=`MOUSEMOVE` or and_bits(ctrl_flags[id],CF_SPLIT)=0)
        and ct!=DIALOG then -- (for gVidCut)
            crash("%s handler invalid on containers",{name})
        end if
        -- avoid time-bombs like that old KEY_CB thing (whereby a program would work fine,
        -- but crash when you hit a function key, at one point I ended up with 92 of 'em):
        if handler!=NULL then
            string sig = tg_get_sig(handler)                        -- (actual)
            if name=`MOUSEMOVE` then -- rather than specify/wade through 20 of them...
                string noIsig = trim_tail(sig,'I')
                sdx = iff(length(sig)<=11?find(noIsig,{`F`,`FO`,`P`,`PO`}):0)
            else
                sequence rig = getdd({ct,name},{},handler_sigs)         --  (rqd)
                sdx = find(sig,rig)
                if sdx=0 then
                    sequence rig0 = getdd({0,name},{},handler_sigs)     -- (common handlers)
                    sdx = find(sig,rig0)
                end if
            end if
            if sdx=0 then
                crash(`%s(%s) handler signature error (%s)`,{cn,name,sig})
            end if
        end if
        -- aside: using deld() for handler==NULL should make no real difference
        setd({id,name},handler,handlers)
        if ct=TABS and name=`TABITEMS` then
            ctrl_xtra[id][CXTAB_ITEMS] = handler
        end if
    end if
end procedure
global constant gSetHandlers = gSetHandler

