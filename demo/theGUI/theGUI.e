local function hit_test(gdx id, integer x,y)
    gdx cid = ctrl_xtra[id][DX_CAPTURE]
    if cid then 
        id = cid
    else
        bool none = false
        while sequence(children_ids[id]) and not none do
            none = true
            for child in children_ids[id] do
-- 16/5/26 let's see if this still ever triggers... (and if so mention why)
--if sequence(ctrl_size[child]) then
                integer cx = ctrl_size[child][SZ_X],
                        cy = ctrl_size[child][SZ_Y],
                        cw = ctrl_size[child][SZ_W],
                        ch = ctrl_size[child][SZ_H]
                if x>=cx and x<=cx+cw
                and y>=cy and y<=cy+ch then
                    id = child
                    none = false
                    exit
                end if
--end if
            end for
        end while
    end if
    return id
