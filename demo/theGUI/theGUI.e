local procedure tg_WINAPI_register_popup_class(atom classname, wndproc)
    nnatom cursor_handle = c_func(xLoadCursor,{NULL,IDC_ARROW})
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`cbSize`,get_struct_size(idWNDCLASSEX))
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`style`,NULL)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`lpfnWndProc`,wndproc) -- default message handler
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`cbClsExtra`,0)   -- no more than 40 bytes for win95
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`cbWndExtra`,0)   -- "		"      "		"        "
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`hInstance`,instance())
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`hIcon`,NULL) -- (32 x 32)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`hIconSm`,NULL) -- (16 x 16)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`hCursor`,cursor_handle)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`hbrBackground`,COLOR_BTNFACE+1)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`lpszMenuName`,NULL)
    set_struct_field(idWNDCLASSEX,pWNDCLASSEX,`lpszClassName`,classname)
    atom regdclass = c_func(xRegisterClassEx,{pWNDCLASSEX})
    if not regdclass then
        crash(`Registration of Popup window class failed.`)
    end if
end procedure

local procedure tg_gtk_signal_connect(atom handle, string signal, integer rid, integer id)
    -- note that g_signal_connect is defined in the GTK sources as a #define of
    -- g_signal_connect_data(....,NULL,0), and is not exported from the dll/so.
    -- privately we are doing the opposite of is_call_back() with rid here, as
    -- opposed to most of the raw GTK-only prototypes you may find lying around,
    -- and o/c assuming our libgtk-3-0.dll/libgdk-win32-2.0-0.dll are CDECL-built.
    atom r = c_func(x_g_signal_connect_data,{handle,signal,call_back({'+',rid}),id,NULL,0})
    assert(r>0)
end procedure

local function tg_ensure_popup(gdx menu, integer mdx)
    gdx owner = tg_get_menu_owner(menu,mdx)
    atom hWnd = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP],
         hOwn = ctrl_handles[owner]
    if hWnd=NULL then
        if backend=TG_GTK then
            nnatom hPopup = c_func(x_gtk_window_new,{GTK_WINDOW_POPUP})
            c_proc(x_gtk_window_set_type_hint,{hPopup,GDK_WINDOW_TYPE_HINT_POPUP_MENU})
            c_proc(x_gtk_window_set_decorated,{hPopup,false})

            nnatom hMenu = c_func(x_gtk_drawing_area_new,{})
            c_proc(x_gtk_container_add,{hPopup,hMenu})

            atom event_mask = GDK_POINTER_MOTION_MASK + 
                              GDK_BUTTON_PRESS_MASK + 
                              GDK_LEAVE_NOTIFY_MASK
            c_proc(x_gtk_widget_add_events,{hMenu,event_mask})

            ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP] = hPopup
            ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDGET] = hMenu

            {string signal, atom cb} = iff(bGTK2?{`expose_event`,tg_GTK_expose_event}
                                          /*GTK3*/:{      `draw`,tg_GTK_menu_draw   }) 
            tg_gtk_signal_connect(hMenu,signal,cb,mdx)
            tg_gtk_signal_connect(hMenu,`motion_notify_event`,tg_GTK_menu_mousemove,mdx)
            tg_gtk_signal_connect(hMenu,`button_press_event`,tg_GTK_menu_click,mdx)
            tg_gtk_signal_connect(hMenu,`leave-notify-event`,tg_GTK_menu_leave,mdx)

--X         tg_gtk_signal_connect(hPopup,`button_press_event`,popup_click,mdx)
            c_proc(x_gtk_window_set_transient_for,{hPopup,hOwn})
            hWnd = hPopup
        elsif backend=TG_WINAPI then
            if not bPopMenuWndProcRegistered then
--              tg_WINAPI_register_popup_class(`Popmenu`,call_back(tg_WinAPI_PopMenuWndProc))
                tg_WINAPI_register_popup_class(popmenu,call_back(tg_WinAPI_PopMenuWndProc))
                bPopMenuWndProcRegistered = true
            end if
            atom hInst = NULL,
             dwExStyle = WS_EX_TOPMOST+WS_EX_NOACTIVATE -- (for the popup only)
--          hWnd = c_func(xCreateWindowEx,{dwExStyle,`Popmenu`,"",WS_POPUP,0,0,100,100,hOwn,NULL,hInst,NULL})
            hWnd = c_func(xCreateWindowEx,{dwExStyle,popmenu,NULL,WS_POPUP,0,0,100,100,hOwn,NULL,hInst,NULL})
--          hWnd = c_func(xCreateWindowEx,{dwExStyle,popmenu,no_title,WS_POPUP,0,0,100,100,hOwn,NULL,hInst,NULL})
            assert(hWnd!=NULL)
            ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP] = hWnd
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_ensure_popup)`);
            #}ilJS
        end if
    else
        if backend=TG_GTK then
            c_proc(x_gtk_window_set_transient_for,{hWnd,hOwn})
        elsif backend=TG_WINAPI then
            if c_func(xGetParent,{hWnd})!=hOwn then
                if hOwn=NULL then ?9/0 end if
                c_proc(xSetParent,{hWnd,hOwn})
            end if
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_ensure_popup2)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
    end if
    return hWnd
end function

function tg_get_mousepos()
    integer x, y
    if backend=TG_GTK then
        nnatom display = c_func(x_gdk_display_get_default,{}),
               pX = allocate(4), pY = allocate(4)
        c_proc(x_gdk_display_get_pointer,{display,NULL,pX,pY,NULL})
        x = peek4u(pX)
        y = peek4u(pY)
        free({pX,pY})
    elsif backend=TG_WINAPI then
        c_funk(xGetCursorPos,{pPOINT})
        x = get_struct_field(idPOINT,pPOINT,`x`)
        y = get_struct_field(idPOINT,pPOINT,`y`)
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_get_mousepos)`);
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    return {x,y}
end function

global procedure gPopupMenu(gdx parent, menu, integer x=TG_MOUSEPOS, y=TG_MOUSEPOS)
    assert(ctrl_types[parent]=DIALOG,`parent must be a dialog`)
    assert(ctrl_types[menu]==MENU,`not a menu`)
    assert(ctrl_parent[menu]=0,`already in use as a barmenu`) -- as per docs
--  if x=TG_MOUSEPOS then {x,y} = gGetGlobal(`MOUSEPOS`) end if
    if x=TG_MOUSEPOS then {x,y} = tg_get_mousepos() end if --""
    ctrl_flags[menu] = or_bits(ctrl_flags[menu],CF_POPUP)
    tg_show_menu(parent,menu,1,x,y)
end procedure

local function tg_scrollbar_key_handler(gdx canvas, integer c, bool ctrl, shift, alt)
    object sbinfo = ctrl_sbinfo[canvas]
    if sequence(sbinfo) then
        object ltattr = ctrl_xtra[canvas]
        integer {w, h} = gGetIntInt(canvas,`SIZE`), 
                pg = (c=VK_PGUP or c=VK_PGDN),
                ud = (c=VK_UP or c=VK_DOWN),
                sa = (shift or alt),
                ct = ctrl_types[canvas],
                vpg = h-sbinfo[SB_HVISB]*sbinfo[SB_HHIGH], -- vertical page size
                hpg = w-sbinfo[SB_VVISB]*sbinfo[SB_VWIDE], -- horizontal page size
                origx = sbinfo[SB_ORIGX],
                origy = sbinfo[SB_ORIGY],
--DEV: note this implements up/downarrow scrolling on a gList(), but actually those
--      keys should alter the selected line, and only scroll when that hits top/btm.
--      (obvs. that key handling simply does not belong on a plain canvas/graph,
--            and a gTable has both that and a bit of left/right handling to do)
--DEV: [CXTBL_LINEHT] subscripting an atom 19/9/25, before hTable re-merged...
--              step1 = iff(ct=LIST and ud?ltattr[LX_LINEHT]:
                step1 = iff(ct=LIST and ud?ltattr[LX_LINEHT]:1),
--                      iff(ct=TABLE and ud?ltattr[CXTBL_LINEHT]:1)),
                step = iff(pg?vpg
                             :iff(ctrl?iff(ud?vpg:hpg)
                                      :iff(sa?10:step1)))
        switch c do
            case VK_LEFT:           origx -= step
            case VK_RIGHT:          origx += step
            case VK_UP,VK_PGUP:     origy -= step
            case VK_DOWN,VK_PGDN:   origy += step
            default:          return TG_CONTINUE
        end switch
        sbinfo = 0 -- (kill refcount)
        ctrl_sbinfo[canvas][SB_ORIGX] = origx
        ctrl_sbinfo[canvas][SB_ORIGY] = origy
        g_log(`set`,`ctrl_sbinfo`,source_line(),deep_copy(ctrl_sbinfo[canvas]))
        gRedraw(canvas,false)
    end if
    return TG_CONTINUE
end function

