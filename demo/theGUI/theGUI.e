local procedure tg_gtk_set_cursor(atom handle, integer what)
    atom window = c_func(x_gtk_widget_get_window,{handle}),
            csr = NULL
    if what!=NULL then
        if what=GDK_SB_H_DOUBLE_ARROW then
            csr = gtk_col_resize_cursor
        elsif what=GDK_SB_V_DOUBLE_ARROW then
            csr = gtk_row_resize_cursor
        elsif what=GDK_FLEUR then
            csr = gtk_fleur_cursor
        else
            ?9/0
        end if
        if csr=NULL then
            nnatom display = c_func(x_gdk_window_get_display,{window})
            csr = c_func(x_gdk_cursor_new_for_display,{display,what})
            if what=GDK_SB_H_DOUBLE_ARROW then
                gtk_col_resize_cursor = csr
            elsif what=GDK_SB_V_DOUBLE_ARROW then
                gtk_row_resize_cursor = csr
            elsif what=GDK_FLEUR then
                gtk_fleur_cursor = csr
            end if
        end if
    end if
    c_proc(x_gdk_window_set_cursor,{window,csr})
end procedure

local procedure tg_gtk_set_minmax(gdx id)
    assert(ctrl_types[id]==DIALOG)
    nnatom handle = ctrl_handles[id]
    integer {dw,dh} = {2,32}, -- decoration sizes [DEV headerless?]
            minw = ctrl_size[id][SZ_MIN_W],
            minh = ctrl_size[id][SZ_MIN_H],
            maxw = ctrl_size[id][SZ_MAX_W],
            maxh = ctrl_size[id][SZ_MAX_H],
            flags = 0
    if minw>dw
    or maxw>dh then
        flags += GDK_HINT_MIN_SIZE
        set_struct_field(idGdkGeometry,pGdkGeometry,`min_width`,minw-dw)
        set_struct_field(idGdkGeometry,pGdkGeometry,`min_height`,minh-dh)
    end if
    maxw = iff(maxw>dw and maxw>=minw?maxw:65535)
    maxh = iff(maxh>dh and maxh>=minh?maxh:65535)
    if maxw<65535
    or maxh<65535 then
        flags += GDK_HINT_MAX_SIZE
        -- note: these were apparently fixed in 2.24.23, but I'm using 2.24.10 (on Windows)
        set_struct_field(idGdkGeometry,pGdkGeometry,`max_width`,maxw-dw)
        set_struct_field(idGdkGeometry,pGdkGeometry,`max_height`,maxh-dh)
    end if
    if flags!=0 then
        c_proc(x_gtk_window_set_geometry_hints,{handle,handle,pGdkGeometry,flags})
    end if
end procedure

global procedure gSetAttribute(gcxs id, sequence name, object v, sequence args={}, integer nFrames=1)
    if length(args) then v = sprintf(v,args) end if
    if not string(name) then
        string ni
        for ni in name do
            gSetAttribute(id, ni, v, {}, nFrames+1)
        end for
        return
    end if
    if sequence(id) then
        for i in id do
            assert(integer(i))
            gSetAttribute(i,name,v,{},nFrames+1)
        end for
        return
    end if
    if name=`BGCLR`
    or name=`FGCLR` then
        v = tg_get_colour_value(v)
    end if
    if id<0 then
        -- deal with gImage/gPixbuf attributes first:
        integer idx, adx = 0, l
        if gdm(id) then -- gImage
            idx = (-id+1)/2
            switch name do
                case `BGCLR`: adx = TG_IMG_BGCLR
                case `FGCLR`: adx = TG_IMG_FGCLR
                case `FONT`: adx = TG_IMG_DRAW_FONT
                             if v=NULL then v = TG_STD_FONT end if
                case `LINESTYLE`: adx = TG_IMG_LINESTYLE
                case `LINEWIDTH`: adx = TG_IMG_LINEWIDTH
                case `USER_DATA`: adx = TG_IMG_USER_DATA
            end switch
            if adx then
                gimages[idx][adx] = v
                return
            end if
        else            -- gPixbuf
--          adx = find(name,{`BGCLR`,`FGCLR`,`LINESTYLE`,`LINEWIDTH`,`USER_DATA`})
            switch name do
                case `BGCLR`: adx = TG_PB_BGCLR
                case `FGCLR`: adx = TG_PB_FGCLR
                case `LINESTYLE`: adx = TG_PB_LINESTYLE
                case `LINEWIDTH`: adx = TG_PB_LINEWIDTH
                case `USER_DATA`: adx = TG_PB_USER_DATA
            end switch
            if adx then 
                assert(gdp(id))
                idx = -id/2
                l = length(pixbuf_xtra)
                if idx>l then
                    pixbuf_xtra &= repeat({TG_WHITE,TG_BLACK,1,1,NULL},idx-l)
                end if
                pixbuf_xtra[idx][adx] = v
                return
            end if
        end if
        string what = iff(gdm(id)?`gImage`:`gPixbuf`)
        crash(`gSetAttribute(%s,%s)`,{what,name},nFrames:=nFrames+1)
    end if
    assert(gdx(id))
    -- nb NULL id is *not* permitted/supported (as per docs)
    integer ct = ctrl_types[id],
         flags = ctrl_flags[id]
    atom handle = ctrl_handles[id]

    if name=`ACTIVE` then
        v = tg_to_bool(v,nFrames+1)
        tg_set_ctrl_flag(id,CF_INACTIVE,not v)

    elsif name=`BGCLR` then
        ctrl_bg[id] = v

    elsif name=`FGCLR` then
        ctrl_fg[id] = v

    elsif name=`CBXY` then
        -- (clobbered/ignored if not in a gCbox)
        if string(v) then v = tg_intint(v,name,nFrames+1) end if
        {ctrl_size[id][SZ_X],
         ctrl_size[id][SZ_Y]} = v
        -- aside: if parent chain does not yet exist, a wrong'un'll 
        --        just get quietly clobbered, no harm no foul, this
        --        may however help catch slipups when converting a
        --        concrete layout into a proper abstract one, and
        --        mucking up tg_lm_accumulate_and_disperse's work.
        integer bid = id -- (since id:=0 crashes)
        while bid and ctrl_types[bid]!=BOX do
            bid = ctrl_parent[bid]
        end while
        if bid and and_bits(ctrl_flags[bid],CF_CONCRETE)=0 then
            crash(`gSetAttribute(CBXY) for non-cbox child`,nFrames:=nFrames+1)
        end if

    elsif name=`CANFOCUS` then 
        assert(not find(ct,{DIALOG,BOX,TIMER}))
        v = tg_to_bool(v,nFrames+1)
        tg_set_ctrl_flag(id,CF_CANFOCUS,v)

    elsif name=`CURSOR` then
        handle = ctrl_handles[gGetDialog(id)]
        if handle=NULL then
            tg_defer_attr(id,name,v)
        else
            if v!=NULL then
                assert(string(v))
                v = upper(v)
            end if
            if backend=TG_GTK then
                switch v do
                    case NULL: break
                    case `RESIZE_NS`,
                         `NS_RESIZE`: v = GDK_SB_V_DOUBLE_ARROW
                    case `RESIZE_WE`,
                         `WE_RESIZE`,
                         `EW_RESIZE`,
                         `RESIZE_EW`: v = GDK_SB_H_DOUBLE_ARROW 
                    case `SIZE_ALL`:  v = GDK_FLEUR
                    default: ?9/0
                end switch
                ctrl_cursors[id] = v
                tg_gtk_set_cursor(handle,v)
            elsif backend=TG_WINAPI then
                if v!=NULL then
                    switch v do
                        case `RESIZE_NS`,
                             `NS_RESIZE`: v = IDC_SIZENS
                        case `RESIZE_WE`,
                             `WE_RESIZE`,
                             `EW_RESIZE`,
                             `RESIZE_EW`: v = IDC_SIZEWE 
                        case `SIZE_ALL`:  v = IDC_SIZEALL
                        default: ?9/0
                    end switch
                    v = c_func(xLoadCursor,{NULL,v})
                end if
                ctrl_cursors[id] = v
                if v=NULL then v = ARROW_CURSOR end if
                c_proc(xSetCursor,{v})
            elsif backend=TG_JS then    
                #ilJS{
                    crash(`JS (gSetAttribute)`);
                #}ilJS
            else
                ?9/0 -- (unknown backend)
            end if
        end if

    elsif name=`EXPAND` then
        if string(v) then
            if v=`FALSE` or v=`NO` then v=`NONE` end if
            if v=`TRUE` or v=`YES` then v=`BOTH` end if
            nnatom k = iff(length(v)=1?find(v[1],`NBHHVTY`):find(v,{`NONE`,`BOTH`,`HORIZONTAL`,0,`VERTICAL`}))
            v = iff(k>5?1:k-1)
        else
            if v='F' then v = 'N' end if
            if v='T' or v='Y' then v = 'B' end if
            if v>0b100 then v = find(v,`NBHHV`)-1 end if
        end if
        assert(v=0b000 or v=0b001 or v=0b010 or v=0b100)
        gdx parent = ctrl_parent[id]
        if ct=BOX and parent!=0 and ctrl_types[parent]=DIALOG then
            assert(v=0b001,`cannot disable expansion on a "sole child" gH/Vbox`) -- (as per docs)
        elsif ct=DIALOG then
            crash(`EXPAND is meaningless on a gDialog`,nFrames:=nFrames+1) -- (as per docs)
        end if
        flags -= and_bits(flags,CF_EXPAND)
        flags += v
        ctrl_flags[id] = flags

    elsif name=`FONT` then
        assert(string(v))
        tg_set_font(id,NULL,v)

    elsif name=`LINEWIDTH` then
        assert(atom(v),`placeholder`)
        ctrl_penwidth[id] = v

    elsif name=`LINESTYLE` then
        object style = v
        assert(not string(style),`placeholder`)
        if sequence(style) then
            for b in style do
                assert(b=0 or b=1)
            end for
            assert(style[1]=1 and style[$]=0)
        end if
        ctrl_penstyle[id] = style

    elsif name=`MARGIN` then
        if string(v) then v = tg_intint(v,name,nFrames+1) end if
        assert(ct!=DIALOG,`no MARGIN on dialogs!`)
        bool bSplit = ct==BOX and and_bits(flags,CF_SPLIT)!=0
        assert(not bSplit,`no MARGIN on gSplit!`,nFrames:=nFrames+1)
        ctrl_size[id][SZ_MARGIN] = v -- (save as 1..4 integers, pre-{t,r,b,l} mapping)

    elsif name=`MINSIZE`
       or name=`MAXSIZE` then
        if string(v) then v = tg_intint(v,name,nFrames+1) end if
        integer {w,h} = v,
            {mwx,mhx} = iff(name=`MINSIZE`?{SZ_MIN_W,SZ_MIN_H}
                                          :{SZ_MAX_W,SZ_MAX_H})
        ctrl_size[id][mwx] = w
        ctrl_size[id][mhx] = h
        if backend=TG_GTK and ct=DIALOG then
            if handle=NULL then
                tg_defer_attr(id,name,v)
            else
                tg_gtk_set_minmax(id)
            end if 
        elsif backend=TG_JS then    
            #ilJS{
                printf(1,"gSetAttribute(%s)\n",["sequence",name]);
            #}ilJS
        end if 

    elsif name=`SCROLLFIX` then
--      assert(and_bits(ctrl_flags[id],CF_CANVAS))
        assert(and_bits(flags,CF_CANVAS))
        v = tg_to_int(v)
        assert(v==v && 0b11)
        flags -= and_bits(flags,CF_SCROLLFIX3)
        flags += v*CF_SCROLLFIX
        ctrl_flags[id] = flags
        gRedraw(id)

    elsif name=`SCROLLSIZE`
       or name=`SCROLLPORT`
       or name=`VIEWPORT` then
--      assert(and_bits(ctrl_flags[id],CF_CANVAS))
        assert(and_bits(flags,CF_CANVAS))
        object sbinfo = ctrl_sbinfo[id]
        ctrl_sbinfo[id] = NULL
        if v=NULL then
            flags -= and_bits(flags,CF_SCROLLBARS)
            ctrl_flags[id] = flags
            g_log(`set`,`ctrl_sbinfo`,source_line(),{})
        else
            if atom(sbinfo) then
                sbinfo = repeat(0,SB_INFOLEN)
                sbinfo[SB_VWIDE] = 17
                sbinfo[SB_HHIGH] = 17
                sbinfo[SB_MONLD] = ``
                sbinfo[SB_CKMON] = ``
                flags = or_bits(flags,CF_SCROLLBARS)
                ctrl_flags[id] = flags
            end if
            if string(v) then v = tg_intint(v,name,nFrames+1) end if
            if name=`SCROLLSIZE` then
--?{name,v}
                integer {w,h} = v
                sbinfo[SB_SCRLW] = w
                sbinfo[SB_SCRLH] = h
            else -- name=`SCROLLPORT` or name=`VIEWPORT` then   
                integer {x,y} = v
                sbinfo[SB_ORIGX] = x
                sbinfo[SB_ORIGY] = y
            end if
            ctrl_sbinfo[id] = sbinfo
            g_log(`set `&name,`ctrl_sbinfo`,source_line(),deep_copy(sbinfo))
        end if

    elsif name=`SIZE`
       or name=`USER_SIZE`      -- (<<== real/actual target)
       or name=`USERSIZE` then
object wasv = v
        if v=NULL or v=`NULL` then v = {0,0} 
        elsif string(v) then v = tg_intint(v,name,nFrames+1) end if
        if integer(v) then v = {v,0}
        elsif length(v)=1 then v = {v[1],0} end if
        integer {width,hight} = apply(v,round)
        -- aside: eg {0,24} aka `x24` just sets h, `0x0` sets both
        --     (and the only case when zeros get set is that {0,0})
        if width!=0 or hight=0 then ctrl_size[id][SZ_USER_W] = width end if
        if hight!=0 or width=0 then ctrl_size[id][SZ_USER_H] = hight end if
        g_log(`set`,`ctrl_sizeWH`,source_line(),{id,width,hight})
        if ct=PROGRESS then
            g_log(`set`,`ctrl_sizeNORM`,source_line(),{id,width,hight})
            ctrl_size[id][SZ_NORMAL_W] = width
            ctrl_size[id][SZ_NORMAL_H] = hight
        end if
        if ct=DIALOG then
            if handle=NULL then
                tg_defer_attr(id,name,v)
            else
--          ctrl_size[id][SZ_NORMAL_W] = 0
--          ctrl_size[id][SZ_NORMAL_H] = 0

                integer nw = ctrl_size[id][SZ_NORMAL_W],
                        nh = ctrl_size[id][SZ_NORMAL_H]
                if and_bits(ctrl_flags[id],CF_CANVAS) then -- (specifically for gSplit)
                    if width and width<nw then nw = width; ctrl_size[id][SZ_NORMAL_W] = nw end if
                    if hight and hight<nh then nh = hight; ctrl_size[id][SZ_NORMAL_H] = nh end if
                    g_log(`set`,`ctrl_sizeNORM`,source_line(),{id,nw,nh})
                    -- (aside: next is still needed to deal with any w/h of 0)
                end if
                width = max(width,nw)
                hight = max(hight,nh)
                if backend=TG_GTK then
                    integer {dw,dh} = tg_get_dialog_decoration_size(id)
                    g_proc(x_gtk_window_resize,{handle,width-dw,hight-dh},source_line())
                    g_proc(x_gtk_window_set_default_size,{handle,width-dw,hight-dh},source_line())
                elsif backend=TG_WINAPI then
                    integer uFlags = SWP_NOMOVE+SWP_NOZORDER+SWP_NOACTIVATE
                    g_funk(xSetWindowPos,{handle,NULL,0,0,width+14,hight+7,uFlags},source_line())
                elsif backend=TG_JS then    
                    #ilJS{
                        crash(`JS (gSetAttribute2)`);
                    #}ilJS
                else
                    ?9/0 -- (unknown backend)
                end if
            end if
        end if

    elsif name=`TIP` then
        if v="" then v=NULL end if
        assert(v=NULL or string(v))
        --DEV as yet unused: needs dlg's mousemove to get hit and [tg_set_tip()]
        tool_tips[id] = v

    elsif name=`TITLE` then
        if ct=LABEL then
            if sequence(v) and not string(v) then
                {v,ctrl_xtra[id][CXLBL_ALIGN]} = v -- (dissect the {text,align} case)
            end if
--DEV: as per gVidCut/mbx/properties_window, only this be nowhere near enuf..
--          gSetAttribute(id,`SIZE`,gGetTextExtent(v))
--          ctrl_size[id][SZ_NORMAL_W] = 0
--          ctrl_size[id][SZ_NORMAL_W] = v[1]
--          ctrl_size[id][SZ_NORMAL_H] = 0
--          ctrl_size[id][SZ_NORMAL_H] = v[2]
        elsif ct=CHECKBOX and sequence(v) and not string(v) then
            {{v,ctrl_xtra[id][CXCHK_IALGN]},
                ctrl_xtra[id][CXCHK_PALGN]} = {v,v[$]} -- (dissect the {text,ialign[,palign]} case)
        end if
        assert(nullable_string(v),`string/null expected`,nFrames:=nFrames+1)
        assert(and_bits(flags,CF_SPLIT)=0,`title illegal`,nFrames:=nFrames+1)
        if ct=CHECKBOX and string(v) and find('\n',v)!=0 then
            crash("multi-line checkboxes not supported",nFrames:=nFrames+1)
        end if
        ctrl_titles[id] = v
        gdx dlg = gGetDialog(id)
        if dlg!=NULL then
            handle = ctrl_handles[dlg]
            if id=dlg then
                assert(ctrl_types[id]==DIALOG)
                if handle=NULL then
                    tg_defer_attr(dlg,name,v)
                else
                    if backend=TG_GTK then
                        c_proc(x_gtk_window_set_title,{handle,v})
                    elsif backend=TG_WINAPI then
--                      c_proc(xSetWindowText,{handle,v}) -- xSetWindowTextA way...
                        sequence utf16 = utf8_to_utf16(v)
                        atom pText = allocate_wstring(utf16)
                        c_proc(xSetWindowText,{handle,pText})
                        free(pText)
                    elsif backend=TG_JS then    
                        #ilJS{
                            crash(`JS (gSetAttribute3)`);
                        #}ilJS
                    else
                        ?9/0 -- (unknown backend)
                    end if
                end if
            end if
            if handle!=NULL then
                gRedraw(dlg)
            end if
        end if

    elsif name=`USER_DATA` then
        user_data[id] = v

    elsif name=`VISIBLE` then
        v = tg_to_bool(v,nFrames+1)
        tg_set_ctrl_flag(id,CF_INVISIBLE,not v)
    else
        integer setattr = ctrl_set_attr[ct]
        if setattr=NULL or not setattr(id,name,v,nFrames+1) then
            string san = get_routine_info(setattr,true)[4] -- (name/debug aid)
            if v=NULL then v=`NULL` end if
            crash(`gSetAttribute[%s](%s,%s,%v)`,{san,ctrl_names[ct],name,v},nFrames+1)
        end if
    end if
end procedure

--global function gGetSetAttribute(gcx id, string name, object v, dflt=999_999_999)
global function gGetSetAttribute(gcx id, string name, object v)
--  object prev = gGetAttribute(id,name,dflt,nFrames:=2)
    object prev = gGetAttribute(id,name,nFrames:=2)
    gSetAttribute(id,name,v,nFrames:=2)
    return prev
end function

local procedure tg_apply_deferred_attributes(integer id)
    -- Affects, on a gDialog, TITLE/FULLSCREEN/MIN|MAXIMISED/HDR/MNZ/RST/CLX
    integer ct = ctrl_types[id]
    for nv in deferred_attr[id] do
        {string name, object v} = nv
        gSetAttribute(id,name,v)
    end for
    deferred_attr[id] = {}
end procedure 

global procedure gSetInt(gdx id, string name, integer i)
    gSetAttribute(id,name,i,nFrames:=2)
end procedure

global procedure gSetDouble(gdx id, string name, atom a)
    gSetAttribute(id,name,a,nFrames:=2)
end procedure

global procedure gToggleInt(gdx id, string name)
--  bool bNot = not gGetAttribute(id,name,false,nFrames:=2)
    bool bNot = not gGetAttribute(id,name,nFrames:=2)
    gSetAttribute(id,name,bNot,nFrames:=2)
end procedure

local function tg_collect_child_handlers(gdx id, string name)
    sequence rids = {}
    object c = children_ids[id]
    if sequence(c) then
        for ch in c do
            rtn rid = getd({ch,name},handlers)
            if rid then rids = append(rids,{ch,rid}) end if
            rids &= tg_collect_child_handlers(ch,name)
        end for
    end if
    return rids
end function

local function gGetInheritedHandler(gdx id, string name)
    rtn rid = getd({id,name},handlers)
    if rid=0 then
        sequence chrid = tg_collect_child_handlers(id,name)
        integer l = length(chrid)
        if l=1 then
            {id,rid} = chrid[1]
        else
            while rid=0 and ctrl_parent[id] do
                id = ctrl_parent[id]
                rid = getd({id,name},handlers)
            end while
        end if
    end if
    return {id,rid}
end function

global procedure gHide(gdx id)
    if ctrl_types[id]!=DIALOG then
        gSetAttribute(id,`VISIBLE`,false)
    else
        nnatom handle = ctrl_handles[id]
        if backend=TG_GTK then
            c_proc(x_gtk_widget_hide,{handle})
            if not nodump then -- (not for the unit tests)
                atom parent = c_func(x_gtk_window_get_transient_for,{handle})
                if parent=NULL then
                    c_proc(x_gtk_main_quit)
                end if
            end if
        elsif backend=TG_WINAPI then
            {} = c_func(xSendMessage,{handle,WM_CLOSE,0,0}) -- this line has the better way of closing!!!
--          {} = c_func(xCloseWindow,{handle})  -- this function will minimize a child window or minimize & 
--                                              --  half close a main window. very poor name & behaviour!
--27/7/26:
--          c_proc(xShowWindow,{handle,SW_HIDE})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (gHide)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    end if
end procedure

local function tg_gtk_quit(atom handle, gdx id) -- (GTK only)
    assert(id=tg_getID(handle))
    gHide(gGetDialog(id))
    return true 
end function 

local integer key_map = NULL

local function tg_map_key(integer c)
    if key_map=NULL then
        key_map = new_dict()
        integer kdx
        if backend=TG_GTK then
            kdx = 4
        elsif backend=TG_WINAPI then
            kdx = 3
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_map_key)`);
            #}ilJS
        else
            ?9/0
        end if
        for k in key_mappings do
            setd(k[kdx],k[2],key_map)
        end for
    end if
    if backend=TG_WINAPI then
        c = and_bits(c,#0FFF)
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_map_key2)`);
        #}ilJS
    end if
    return getdd(c,c,key_map)
end function

