local function tg_WinAPI_PopMenuWndProc(atom hWnd, msg, wParam, lParam)
    integer {menu,mdx} = tg_find_menu(hWnd,MX_POPUP)
    if mdx then -- ignore eg WM_CREATE which arrives before any menus[mdx] gets the hWnd
        switch msg do

            case WM_ACTIVATE:  -- (not strictly needed, but safer)
                if LOWORD(wParam)=WA_INACTIVE then
                    tg_hide_one_menu(menu,mdx,false)
                end if
                return 0

            case WM_SETFOCUS:  -- (not strictly needed, but safer)
                return 0

            case WM_NCACTIVATE:  -- (not strictly needed, but safer)
                return true

            case WM_MOUSEACTIVATE:
                return MA_NOACTIVATE

            case WM_MOUSEMOVE:
                integer x = and_bits(lParam,#FFFF),
                        y = floor(lParam/#10000)
                tg_menu_mousemove(menu,mdx,x,y)
--              return 0 -- (no help with the menu thing)
--              return 1 -- ""

            case WM_MOUSELEAVE:
                tg_menu_leave(menu,mdx)
                return 0

            case WM_LBUTTONDOWN:
                tg_menu_leftclick(menu,mdx)
                return 0

            case WM_PAINT:
                tg_draw_menu(menu,mdx)
                sequence mxtra = ctrl_xtra[menu][CX_MEXTRA][mdx]
                gdm img = mxtra[MX_TGTIMG]
                integer imdx = (-img+1)/2,
                        w = mxtra[MX_WIDTH],
                        h = mxtra[MX_HEIGHT]
                nnatom dstDC = c_func(xBeginPaint,{hWnd,pPAINTSTRUCT}),
                       srcDC = tg_WinAPI_GetSrcDC(),
                     src_img = gimages[imdx][TG_IMG_HANDLE],
                      prevBM = c_func(xSelectObject,{srcDC,src_img})
                c_funk(xBitBlt,{dstDC,0,0,w,h,srcDC,0,0,SRCCOPY})
                prevBM = c_func(xSelectObject,{srcDC,prevBM})
                c_proc(xEndPaint,{hWnd,pPAINTSTRUCT})
                return 0

            case WM_KEYDOWN:
--              -- directly routed as if via this by WndProc:
--              return tg_process_menu_keydown(menu,mdx,wParam)
                return 0 -- (extra paranoia, let WndProc always do it)

        end switch
    end if
    return c_func(xDefWindowProc,{hWnd,msg,wParam,lParam})
end function
