        end if
    else
        -- (text,icon)
        if pair_align=TG_E then
--?"WE"
--          tx += 16 --??
--          ix = tx+tw --??
            tx = 4
            ix = tx+tw+5 --??
        else
--?"WW"
--          ix = tx --??
--          tx += 16 --??
            tx = w-tw-23
            ix = w-17 --??
        end if
    end if
    gDrawImage(image,chk,ix,ty-7)
    gDrawText(chk,tx,ty,chk_txt,{},align,colour:=txtclr)

    if gGetFocus()==chk and bActive then
--      gDrawRect(chk,2,2,tw-1,th-2,rc:=2,colour:=TG_BLACK,style:=TG_DOTTED)
        gDrawRect(chk,2,2,w-1,h-2,rc:=2,colour:=TG_BLACK,style:=TG_DOTTED)
    end if
end procedure   
