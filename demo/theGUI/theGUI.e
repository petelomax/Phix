global function gGetHandler(gdx id, string name)
    rtn rid = getd({id,name},handlers)
    if rid=NULL and name=`REDRAW` then rid = tg_canvas_edge end if
    return rid
end function

local sequence ngroups = {},
                nflags = {}

local procedure tg_lm_apply_normalisation()
    for i,ids in ngroups do
        integer iwhb = nflags[i],
                mw = 0, mh = 0
        for id in ids do
            mw = max(mw,ctrl_size[id][SZ_NORMAL_W])
            mh = max(mh,ctrl_size[id][SZ_NORMAL_H])
        end for
        for id in ids do
            if iwhb && 0b01 then ctrl_size[id][SZ_NORMAL_W] = mw
                       else mw = ctrl_size[id][SZ_NORMAL_W] end if -- (for g_log)
            if iwhb && 0b10 then ctrl_size[id][SZ_NORMAL_H] = mh
                       else mh = ctrl_size[id][SZ_NORMAL_H] end if -- (for g_log)
            g_log(`set`,`ctrl_sizeNORM`,source_line(),{id,mw,mh})
        end for
    end for
end procedure

global procedure gNormalise(gdx ids, atom_string whb=`BOTH`)
    -- iwhb is a non-0 bitfield, 0b01/0b10/0b11:
    integer iwhb = iff(string(whb)?find(whb,iff(length(whb)==1?{`W`,`H`,`B`}
                                                  :{`WIDTH`,`HEIGHT`,`BOTH`}))
                     :iff(whb>0b11?find(upper(whb),`WHB`):whb))
    assert(iwhb!=0 and iwhb==and_bits(iwhb,0b11))
    for id in ids do
        assert(ctrl_flags[id] && CF_CONTAINER == 0)
    end for
    ngroups = append(ngroups,ids)
    nflags = append(nflags,iwhb)
end procedure
global constant integer gNormalize = gNormalise;

local procedure tg_lm_just_copy_concrete_sizes(integer id)
    object children = children_ids[id]
    if sequence(children) then
        for child in children do
            tg_lm_just_copy_concrete_sizes(child)
        end for
    end if
    ctrl_size[id][SZ_W] = ctrl_size[id][SZ_USER_W]
    ctrl_size[id][SZ_H] = ctrl_size[id][SZ_USER_H]
end procedure

local procedure tg_lm_accumulate_sizes(gdx id)
    --
    -- Called from gShow() the first time a dialog is displayed...
    --
    -- sum [SZ_NORMAL_W/H] with margins etc.
    --
    integer ct = ctrl_types[id], 
           cfi = ctrl_flags[id],
            nw = 0, nh = 0
    object children = children_ids[id]
    if sequence(children) then
        if and_bits(cfi,CF_CONCRETE) then
            tg_lm_just_copy_concrete_sizes(id)
        else
            integer gap = 0, 
                    gap2 = iff(ct=BOX?ctrl_xtra[id][CX_BOX_GAP]:0)
            bool bVert = and_bits(cfi,CF_VERTICAL)!=0
            for i,child in children do
--Moved 27/7/26...
                tg_lm_accumulate_sizes(child)
                if gGetAttribute(child,`VISIBLE`) then
--                  tg_lm_accumulate_sizes(child)
                    integer {mt,mr,mb,ml} = tg_get_margins(child),
                            cw = ctrl_size[child][SZ_NORMAL_W]+ml+mr,
                            ch = ctrl_size[child][SZ_NORMAL_H]+mt+mb
                    -- aside: for a single child this is of course
                    --        equivalent to nw:=cw and nh:=ch.
                    nw = iff(bVert?max(nw,cw):nw+gap+cw)
                    nh = iff(bVert?nh+gap+ch:max(nh,ch))
                    gap = gap2
                end if
            end for
            nullable_string title = ctrl_titles[id]
            if ct=BOX and title!=NULL then
                nw += 2
                nh += 2
                if length(title) then
                    integer {tw,th} = gGetTextExtent(title,id)
                    nh += th-1 -- (height)
                end if
            elsif ct=DIALOG then
                integer {dw,dh} = tg_get_dialog_decoration_size(id),
                        mw = gGetTextExtent(title,id)[1]+170
                if backend=TG_GTK then
                    mw += 3
                elsif backend=TG_WINAPI then
                    --... do nowt
                elsif backend=TG_JS then
                    #ilJS{
                        crash(`JS (tg_lm_accumulate_sizes)`);
                    #}ilJS
                else
                    ?9/0
                end if
                nw += dw
                nh += dh
                nw = max(nw,mw) -- (avoid ellipsis on the dialog title if we can)
            end if
        end if
    else -- (leaf node)
        if ct=BUTTON
        or ct=CHECKBOX
        or ct=LABEL then
            integer tw = 0, th = 0
            nullable_string title = ctrl_titles[id]
            if title!=NULL then
                {tw,th} = gGetTextExtent(title,id)
            end if
            if ct=BUTTON then
                if backend=TG_GTK then
                    if bGTK2 then
                        -- GTK2: (eg) 49x15 -> 59x23 ? x25?
                        tw += 10
                        th += 10
                    elsif bGTK3 then
                        -- GTK3: (eg) 45x14 -> 79x34
                        tw += 34
                        th += 20
                    else
                        ?9/0
                    end if
                elsif backend=TG_WINAPI then
                    -- WinAPI: (eg) 50x15 -> 56x23
--?{tw,th} -- {80,15}
--                  tw += 14
                    tw += 13
                    th += 8
--?{tw,th} -- {94,23} (fone)

                elsif backend=TG_JS then    
                    #ilJS{
                        crash(`JS (tg_lm_accumulate_sizes2)`);
                    #}ilJS
                else
                    ?9/0
                end if
                gdn image = ctrl_xtra[id][CXBTN_IMAGE]
                if image then
                    integer {iw,ih} = gGetAttribute(image,`SIZE`)
--                  tw += iw+2
                    tw = iff(tw=14?iw+8:tw+iw+2)
--                  th = max(th,ih+8)
                    th = max(th,ih+2)
--?{tw,th} -- {116,26} (gotcha)
                end if
            elsif ct=CHECKBOX then
                if backend=TG_GTK then
                    tw += 5
                    th += 2
--                  th += 1 + bGTK3
                elsif backend=TG_WINAPI then
                    if ctrl_xtra[id][CXCHK_RADIO] then
                        tw += 7
--                      th += 6
                        th -= 1
-- for mastermind.exw:
                    else
                        tw += 8
                    end if
                elsif backend=TG_JS then    
                    #ilJS{
                        crash(`JS (tg_lm_accumulate_sizes3)`);
                    #}ilJS
                end if
                tw += 19
                th += 8
            elsif ct=LABEL then
--?{"label",id,{tw,th}}
                tw += 4
--SUG: verify a gTabs with SHOWCLOSE has either a TABCHANGED or a TABCLICK handler defined.
            end if
            g_log(`set`,`ctrl_sizeUSER`,source_line(),{id,tw,th})
            ctrl_size[id][SZ_USER_W] = tw
            ctrl_size[id][SZ_USER_H] = th
        end if
--for gVidCut, Alt A then F1 resizing down... (10/9/26)
--      nw = max(0,--ctrl_size[id][SZ_NORMAL_W],
--               ctrl_size[id][SZ_USER_W])
--      nh = max(0,--ctrl_size[id][SZ_NORMAL_H],
--               ctrl_size[id][SZ_USER_H])
        nw = ctrl_size[id][SZ_USER_W]
        nh = ctrl_size[id][SZ_USER_H]
    end if
    g_log(`set`,`ctrl_sizeNORM`,source_line(),{id,nw,nh})
    ctrl_size[id][SZ_NORMAL_W] = nw
    ctrl_size[id][SZ_NORMAL_H] = nh
end procedure

