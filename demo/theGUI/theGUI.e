--?{icon_align,TG_W,TG_E} -- {8,8,4}
--?{pair_align}           -- {4}
    atom txtclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
    if icon_align=TG_E then
        -- (icon,text)
        if pair_align=TG_E then
--?"EE" -- (default)
            ix = tx
            tx += 16
        else
--          align = TG_E
            tx = w-tw-5
            ix = tx-16
