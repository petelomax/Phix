local procedure tg_wu_set_rgbL(atom colour)
    rL = and_bits(colour,#FF0000)/#10000
    gL = and_bits(colour,#00FF00)/#100
    bL = and_bits(colour,#0000FF)
end procedure

local procedure tg_plot(gcp canvas, atom x, y, c, bool bFlip=false)
    --  plot the pixel at (x, y) with brightness c (where 0 <= c <= 1)
    --  note that bFlip is exclusively intended for tg_wu_line() only.
    --  aside: c is 0 or 1 ~0.5% of the time, so attempting to optimise
    --         for that would only succeed in slowing everything down.
    if bFlip then {x,y} = {y,x} end if
    integer ic = floor(c*256),
            iC = 256-ic

    atom bg = gGetPixel(canvas,x,y)

    integer rB = and_bits(bg,#FF0000)/#10000,
            gB = and_bits(bg,#00FF00)/#100,
            bB = and_bits(bg,#0000FF)

    integer r = and_bits((rL*ic+rB*iC)/256,#FF),
            g = and_bits((gL*ic+gB*iC)/256,#FF),
            b = and_bits((bL*ic+bB*iC)/256,#FF)

    gDrawPixel(canvas,x,y,r*#10000+g*#100+b)
end procedure

