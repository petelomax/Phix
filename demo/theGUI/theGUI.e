local function tg_get_mouse_on_scrollbar(gdx canvas, integer mx, my)
    -- return `` if not on a scrollbar, else a two char code
    sequence sbinfo = ctrl_sbinfo[canvas]
    integer {w, h} = gGetIntInt(canvas,`SIZE`),
            vsbvis = sbinfo[SB_VVISB],  sbwid = sbinfo[SB_VWIDE],
            hsbvis = sbinfo[SB_HVISB],  sbhgh = sbinfo[SB_HHIGH],
            sbvend = h-hsbvis*sbhgh, -- where vertical scrollbar ends
            sbhend = w-vsbvis*sbwid, -- where horizontal scrollbar ends
            vttop = sbinfo[SB_VTTOP],
            vtend = sbinfo[SB_VTEND],
            htlft = sbinfo[SB_HTLFT],
            htend = sbinfo[SB_HTEND]
    if vsbvis and mx>=w-sbwid and mx<w then
        if my>=0 and my<=sbhgh then     return `UA` -- uparrow
        elsif my<vttop then             return `AT` -- above thumb
        elsif my<=vtend then            return `VT` -- vertical thumb
        elsif my<sbvend-sbhgh then      return `BT` -- below thumb
        elsif my<=sbvend then           return `DA` -- downarrow
        end if
    elsif hsbvis and my>=h-sbhgh and my<h then
        if mx>=0 and mx<=sbwid then     return `LA` -- left arrow
        elsif mx<htlft then             return `LT` -- left of thumb
        elsif mx<=htend then            return `HT` -- horizontal thumb
        elsif mx<sbhend-sbwid then      return `RT` -- right of thumb
        elsif mx<=sbhend then           return `RA` -- right arrow
        end if
    end if
    return `` -- (not on any of the ten scrollbar regions)
end function

local function tg_button_clicked(gdx id) -- (WinAPI and GTK)
    -- (common to mouse and keyboard activation)
    integer ct = ctrl_types[id]
    assert(ct=BUTTON)
    gSetFocus(id)
    integer action = gGetHandler(id,`ACTION`)
    if action then
        string sig = tg_get_sig(action)
        if sig=`P` then
            action()
        elsif sig=`PO` then
            action(id)
        else
            integer res = iff(sig=`FO`?action(id):action())
            if res=TG_CLOSE then
                gHide(gGetDialog(id))
            end if
        end if
    end if
    return false
end function

local constant ONEDAY = timedelta(days:=1),
            SEVENDAYS = timedelta(days:=7),
           bGregorian = false -- (no error for < 1752)

local function tg_last_day_of_month(integer year, month, bool bPrev=false)
    --
    -- Assume month is 9: if bPrev return 31 (ie August)
    --                        else return 30 (September).
    -- There simply isn't a case where a gCalendar ever needs to
    --  know how many days are in the next month, just this&prev,
    --  and obviously cannot draw it properly w/out knowing that.
    --
    -- Calling tg_last_day_of_month(year,month), and
    --         tg_last_day_of_month(year,month,true) should both 
    -- be completely intuitive and hassle-free with regards to
    -- fretting about year rollovers, however the actual use of 
    -- bPrev (here) is perhaps slightly counter-intuitive, ie:
    -- (Sept,false) is 1st Oct-1, and (Sept,true) is 1st Sept-1
    --
    if not bPrev then
        {year,month} = iff(month=12?{year+1,1}:
                                    {year,month+1})
    end if
    return adjust_timedate({year,month,1,0,0,0},-ONEDAY,bGregorian)[DT_DAY]
end function

local function tg_clamp_calendar(gdx calendar, integer year,month,day)
    integer {{sy,sm,sd},{ey,em,ed}} = ctrl_xtra[calendar][CXCAL_RANGE]
    --
    -- note that for a range of 3/11..7/11,
    --   8/10 -> 3/11, but 8/11 -> 7/11,
    -- aka do reset day to 1 if sm used, but
    --  do not apply lastday if sm used.
    -- aka heed year/month as-was not post-clamped
    ---
    bool bWas_gtm = (sy>year or (sy=year and sm>month)),
         bWas_ltm = (year>ey or (year=ey and month>em))
    year = min(max(sy,year),ey)
    if year=sy then
        -- if range is Aug 5th..., then
        --  July 31st -> Aug 1st -> Aug 5th,
        --  but Aug 31st should stay as it is.
        month = max(sm,month)
        if bWas_gtm then day = 1 end if
        if month=sm then day = max(sd,day) end if
    end if
    if year=ey then
        -- if range is ...July 25th, then
        --  Aug 20th -> July 31st -> July 25th,
        --  but July 20th should stay as it is.
        month = min(month,em)
        if bWas_ltm then day = tg_last_day_of_month(ey,em) end if
        if month=em then day = min(day,ed) end if
    end if
    day = min(day,tg_last_day_of_month(year,month))
    return {year,month,day,0,0,0}
end function

local procedure tg_calendar_set_hoverable(gdx calendar)
    --
    -- sets [CXCAL_LHOV, RHOV], which are bools indicating
    --  wherther the left/right header buttons are enabled, 
    -- and [CXCAL_LOHOV, HIHOV] for 42 or 12 regions below
    --  to {7,48} or some subset of it when state=TG_MONTH,
    --  or {4,15} or some subset of it when state>TG_MONTH
    -- The ranges 7..48 and 4..15 were chosen:
    --  a) to not overlap header 1|2|3
    --  b) so that divmod 7|4 is useful
    --
    object cal_attr = ctrl_xtra[calendar]
    integer y = cal_attr[CXCAL_YEAR],
            m = cal_attr[CXCAL_MONTH],
        state = cal_attr[CXCAL_STATE],
          dow = day_of_week(y,m,1),
         prev = cal_attr[CXCAL_PREV],
         last = cal_attr[CXCAL_LAST],
     {{sy,sm,sd},{ey,em,ed}} = cal_attr[CXCAL_RANGE],
        lhov, rhov,
        lohov, hihov
    cal_attr = 0 -- (kill refcount)
    if state=TG_MONTH then
        lhov = (sy!=y or sm!=m)
        rhov = (ey!=y or em!=m)
        -- there are dow-1 days from the previous month...
        bool this_sm = (sy=y and sm=m),
             prev_sm = (sm=12 and m=1 and sy=y-1) or
                       (sm=m-1 and sy=y),
             this_em = (ey=y and em=m),
             prev_em = (em=1 and m=12 and ey=y+1) or
                       (em=m+1 and ey=y)
        lohov = iff(this_sm?sd+dow+5:iff(prev_sm?max(dow-prev+sd+6,7):7))
        hihov = iff(this_em?ed+dow+5:iff(prev_em?min(dow+last+ed+6,48):48))
    elsif state=TG_YEAR then
        -- this shows 12 months from the current year (only)
        lhov = (sy!=y)
        rhov = (ey!=y)
        lohov = iff(sy=y?sm+3:4)
        hihov = iff(ey=y?em+3:15)
    else
        -- this shows ten years/decades/centuries plus one either side
        integer p10 = power(10,state-2),
                r10 = power(10,state-3),
         {fy,fs,fe} = sq_floor_div({y,sy,ey},p10)
        lhov = (fs!=fy)
        rhov = (fe!=fy)
        -- aside: shouldn't actually need the >=/<= here, 
        --        a simple = should suffice, because it
        --        should not go past, but if it has...
        lohov = iff(fs>=fy?floor(rmdr(sy,p10)/r10)+5:4)
        hihov = iff(fe<=fy?floor(rmdr(ey,p10)/r10)+5:15)
    end if
    ctrl_xtra[calendar][CXCAL_LHOV] = lhov
    ctrl_xtra[calendar][CXCAL_RHOV] = rhov
    -- (title_hov is implicitly lhov or rhov [and state<TG_MILLEN])
    ctrl_xtra[calendar][CXCAL_LOHOV] = lohov
    ctrl_xtra[calendar][CXCAL_HIHOV] = hihov
end procedure

local procedure tg_save_calendar(gdx calendar, integer year, month, day)
    -- common code to store the newly selected date and call any handler
    if year<0 then year = 0 end if
    -- may as well be safe (a month=0 bug has now been fixed):
    if month<1 or month>12 then ?9/0 end if
    if day<1 or day>31 then ?9/0 end if
    ctrl_xtra[calendar][CXCAL_YEAR] = year
    ctrl_xtra[calendar][CXCAL_MONTH] = month
    ctrl_xtra[calendar][CXCAL_DAY] = day

    tg_calendar_set_hoverable(calendar)

    sequence ymd = tg_clamp_calendar(calendar,year,month,day)

    gdx datepick = ctrl_xtra[calendar][CXCAL_DT_PICK]
    if datepick then
        gSetAttribute(datepick,`VALUE`,"%02d/%02d/%04d",ymd)
    end if

    rtn value_changed = gGetHandler(calendar,`VALUE_CHANGED`)
    if value_changed then
        string sig = tg_get_sig(value_changed)
        if sig=`POO` then
            value_changed(calendar,ymd)
        elsif sig=`PO` then
            value_changed(ymd)
        else
            ?9/0 -- unknown sig (shd never trigger)
        end if
    end if
end procedure

local procedure tg_calendar_scroll(gdx calendar, integer code)
    --
    -- code is [CXCAL_HOV]-2, [see tg_calendar_mousemove()], ie:
    --    -1 for left/pgup, 
    --     0 for title, ie state += 1,
    --    +1 for right/pgdn,
    -- 5..46 a day [when state==TG_MONTH, any of the 6*7 days being shown],
    -- 2..13 month/year/decade/mllnnia [when state>=TG_YEAR, of 4*3 shown]
    --
    object cal_attr = ctrl_xtra[calendar]
    integer state = cal_attr[CXCAL_STATE],
             year = cal_attr[CXCAL_YEAR],
            month = cal_attr[CXCAL_MONTH],
              day = cal_attr[CXCAL_DAY],
              dow = day_of_week(year,month,1),
          prevday = cal_attr[CXCAL_PREV],
          lastday = cal_attr[CXCAL_LAST]
    cal_attr = 0 -- (kill refcount)
    if code=0 then
        ctrl_xtra[calendar][CXCAL_STATE] = state+1
    elsif code<=1 then
        if state=TG_MONTH then
            month += code
--          if month=0 then {year,month} = {max(year-1,0),12}
            if month=0 then {year,month} = {year-1,12}
            elsif month=13 then {year,month} = {year+1,1} end if
        else
            year += code*power(10,state-2)
--          case TG_YEAR:       year += code
--          case TG_DECADE:     year += code*10
--          case TG_CENTURY:    year += code*100
--          case TG_MILLEN:     year += code*1000
        end if
    elsif state=TG_MONTH then
        -- select the date and close
        integer d = code-dow-3
        if d<1 then
            day = prevday+d
            month -= 1
            if month=0 then {year,month} = {year-1,12} end if
        elsif d<=lastday then
            day = d
        else -- d>lastday
            day = d-lastday
            month += 1
            if month=13 then {year,month} = {year+1,1} end if
        end if
    else
        if state=TG_YEAR then
            month = code-1
        else -- TG_DECADE / TG_CENTURY / TG_MILLEN
            integer t2 = power(10,state-2),
                    t3 = power(10,state-3)
            year = year-rmdr(year,t2)+(code-3)*t3+rmdr(year,t3)
        end if
        ctrl_xtra[calendar][CXCAL_STATE] = state-1
    end if
    tg_save_calendar(calendar,year,month,day)
end procedure

local procedure tg_calendar_mousemove(gdx calendar, integer x,y)
    --
    -- Set [CXCAL_HOV]:
    --   0 nothing, 1 left arrow, 2 title, 3 right arrow, 
    --   7..48 a day [when state==TG_MONTH, any of the 6*7 days being shown],
    --   4..15 month/year/decade/mllnnia [when state>=TG_YEAR, of 4*3 shown]
    -- This routine does not care much what is in the box being hovered on.
    --
    object cal_attr = ctrl_xtra[calendar]
    integer hov = 0,
        was_hov = ctrl_xtra[calendar][CXCAL_HOV],
          state = ctrl_xtra[calendar][CXCAL_STATE],
           year = ctrl_xtra[calendar][CXCAL_YEAR],
          lohov = ctrl_xtra[calendar][CXCAL_LOHOV],
          hihov = ctrl_xtra[calendar][CXCAL_HIHOV],
           lhov = ctrl_xtra[calendar][CXCAL_LHOV],
           rhov = ctrl_xtra[calendar][CXCAL_RHOV],
           thov = (lhov or rhov) and (state<TG_MILLEN)
    cal_attr = NULL -- (kill refcount)
    if y<=32 then
        hov = iff(x<19 ?iff(lhov?1:0):
              iff(x<204?iff(thov?2:0):
                        iff(rhov?3:0)))
    else
        if state=TG_MONTH then
            if y>48 and y<=138 then
                hov = 7+floor(x/32)+floor((y-48)/15)*7
            end if
        else -- TG_YEAR / TG_DECADE / TG_CENTURY / TG_MILLEN:
            if y>32 and y<=138 then
                hov = 4+floor(x/54)+floor((y-32)/35)*4
            end if
        end if
        if hov<lohov or hov>hihov then hov = 0 end if
    end if
    if hov!=was_hov then
        ctrl_xtra[calendar][CXCAL_HOV] = hov
        gRedraw(calendar)
    end if
end procedure

local procedure tg_calendar_recalculate_hover(gdx calendar)
    --
    -- recalcuate CXCAL_HOV, rather than force the user 
    -- to "jiggle" the mouse. Aside: there is a hov==4
    -- on/around year 0 we may want to trash/reinstate,
    -- which is actually the only case mousewheel needs.
    --
    integer {x,y} = gGetAttribute(calendar,`MOUSEPOS`)
    tg_calendar_mousemove(calendar,x,y)
end procedure

local function tg_calendar_key(gdx calendar, integer c)
    object cal_attr = ctrl_xtra[calendar]
    integer state = cal_attr[CXCAL_STATE],
             year = cal_attr[CXCAL_YEAR],
            month = cal_attr[CXCAL_MONTH],
              day = cal_attr[CXCAL_DAY],
              dow = day_of_week(year,month,1),
          lastday = cal_attr[CXCAL_LAST],
             lhov = cal_attr[CXCAL_LHOV],
             rhov = cal_attr[CXCAL_RHOV],
            lohov = cal_attr[CXCAL_LOHOV],
            hihov = cal_attr[CXCAL_HIHOV],
              sel = cal_attr[CXCAL_SEL]
    cal_attr = 0 -- (kill refcount)
    sequence oymd = tg_clamp_calendar(calendar, year,month,day)

    if c=VK_PGUP
    or c=VK_PGDN then
        bool l = (c==VK_PGUP)
        if iff(l?lhov:rhov) then
            tg_calendar_scroll(calendar,iff(l?-1:+1))
            gRedraw(calendar)
        end if
        c = 0
    elsif c=VK_CR then
        if state=TG_MONTH then
--DEV deal with this properley when both gCalendar and gDatePick are properly in theGUI.e
?"VK_CR not fully implemented..." --[DEV]
-- (TG_CLOSE??)
            c = 0
        else
            ctrl_xtra[calendar][CXCAL_STATE] = state-1

            tg_calendar_recalculate_hover(calendar)
            gRedraw(calendar)
        end if
    elsif state=TG_MONTH then
        sequence dt = {year,month,min(day,lastday),0,0,0}
        integer adj = 0
        switch c do
            case VK_UP:     adj = -SEVENDAYS
            case VK_DOWN:   adj = +SEVENDAYS
            case VK_LEFT:   adj = -ONEDAY
            case VK_RIGHT:  adj = +ONEDAY
            default: c = 0
        end switch
        if adj then
            dt = adjust_timedate(dt,adj,bGregorian)
            {year,month,day} = dt
        end if
    elsif state=TG_YEAR then
        switch c do
            case VK_UP:     month -= 4
            case VK_DOWN:   month += 4
            case VK_LEFT:   month -= 1
            case VK_RIGHT:  month += 1
            default: c = 0
        end switch
        if month<=0 then year -= 1; month += 12 end if
        if month>12 then year += 1; month -= 12 end if
    else -- TG_DECADE / TG_CENTURY / TG_MILLEN
        switch c do
            case VK_UP:     sel = max(sel-4,4)
            case VK_DOWN:   sel = min(sel+4,15)
            case VK_LEFT:   sel -= 1
            case VK_RIGHT:  sel += 1
            default: c = 0
        end switch
        if sel<lohov or sel>hihov then c = 0 end if
        if c then
            integer p10 = power(10,state-3), 
                    d10 = rmdr(floor(year/p10),10)
            switch c do
                case VK_UP:     year -= p10*iff(d10<4?10:4)
                case VK_DOWN:   year += p10*iff(d10>5?10:4)
                case VK_LEFT:   year -= p10
                case VK_RIGHT:  year += p10
                default: c = 0
            end switch
            -- (purely on the basis the above maths goes badly wrong 
            --  if we don't do this, plus the '-' were rather ugly:)
            year = max(year,0)
        end if
    end if
    sequence nymd = tg_clamp_calendar(calendar, year,month,day)
    if c and oymd!=nymd then
        tg_save_calendar(calendar,nymd[1],nymd[2],day)
        gRedraw(calendar)
    end if
    return TG_CONTINUE
end function

local procedure tg_calendar_mousewheel(gdx calendar, integer direction)
    integer hdx = iff(direction=-1?CXCAL_RHOV:CXCAL_LHOV)
    if ctrl_xtra[calendar][hdx] then
        tg_calendar_scroll(calendar,-direction)
        tg_calendar_recalculate_hover(calendar)
        gRedraw(calendar)
    end if
end procedure

local procedure tg_list_set_top_line(gdx list, integer top_line)
    integer line_height = ctrl_xtra[list][LX_LINEHT],
          {ox,oy,vw,vh} = gGetAttribute(list,`VIEWPORT`)
    oy = (top_line-1)*line_height
    gSetAttribute(list,`VIEWPORT`,{ox,oy})
    -- NB next line is ineffective, while we could just as well let redraw set it, 
    --    someone somewhere sometime would no doubt moan if fetch!=the recent set,
    --   plus this way I don't need another ugly explanation in the documentation.
    ctrl_xtra[list][LX_TOPLINE] = top_line
end procedure

local procedure tg_list_set_line_col(gdx list, integer line, col)
    object data = ctrl_xtra[list][LX_DATA]
    if integer(data) then
        string sig = tg_get_sig(data)
        if sig=`FI` then
            data = data(line)
        elsif sig=`FOI` then
            data = data(list,line)
        else
            ?9/0 -- unrecognised sig
        end if
    else
        data = data[line]
    end if
    integer ll = length(data)
    if not string(data) then
        ll = 0
        for fragment in data do
            if string(fragment) then
                ll += length(fragment)
            else
                ll += length(fragment[1])
            end if
        end for
    end if
    if col<1 then col=1 elsif col>ll+1 then col=ll+1 end if
    ctrl_xtra[list][LX_CURSORX] = col
    ctrl_xtra[list][LX_CURSORY] = line
end procedure

local procedure tg_list_set_selection(gdx list, integer line, bool ctrl, shift)
    object sel = ctrl_xtra[list][LX_SELECTED]
    bool bSingle = not ctrl_xtra[list][LX_MULTIPLE]
    if bSingle or line=0 then
        sel = line
    else
        integer n_rows = ctrl_xtra[list][LX_N_ROWS]
        ctrl_xtra[list][LX_SELECTED] = 0
        if ctrl then
            if atom(sel) then
                integer psel = sel
                sel = repeat(0,n_rows)
                if psel then sel[psel] = true end if
            end if
            sel[line] = not sel[line]
            ctrl_xtra[list][LX_SSTART] = line
        elsif shift then
            integer lstart = max(ctrl_xtra[list][LX_SSTART],1)
            if lstart>line then {line,lstart} = {lstart,line} end if
            sel = repeat(0,n_rows)
            sel[lstart..line] = true
        else
            sel = line
            ctrl_xtra[list][LX_SSTART] = line
        end if
    end if
    ctrl_xtra[list][LX_SELECTED] = sel
    gRedraw(list)
    rtn selected = gGetHandler(list,`SELECTED`)
    if selected then
        string sig = tg_get_sig(selected)
        sel = gGetAttribute(list,`SELECTED`) -- (to integer when sensible)
        if length(sig)=3 then
            selected(list,sel)
        else
            selected(sel)
        end if
    end if
end procedure

local procedure tg_reactivate_caret(gdx list=0)
    if list=0 then
        for id,t in ctrl_types do
            if t=LIST then
                tg_reactivate_caret(id)
            end if
        end for
    elsif ctrl_xtra[list][LX_CARET] then
        gdx timer = ctrl_xtra[list][LX_CARETIMER]
        if timer then
            gSetAttribute(timer,`RUN`,true)
            ctrl_xtra[list][LX_CARETIME] = time()+0.375
            ctrl_xtra[list][LX_CARETEND] = time()+5
        end if
    end if
end procedure

local function tg_list_key(gdx list, integer c, bool ctrl, shift) 
-- LEFT/RIGHT should perhaps do the scrollbar thing...
    if gGetAttribute(list,`ACTIVE`) then
        tg_reactivate_caret(list)
        if c=VK_UP
        or c=VK_DOWN
        or c=VK_PGUP
        or c=VK_PGDN
        or c=VK_HOME
        or c=VK_END then
            object list_attr = ctrl_xtra[list]
            integer line = list_attr[LX_CURSORY],
                     col = list_attr[LX_CURSORX],
                top_line = list_attr[LX_TOPLINE],
                  n_rows = list_attr[LX_N_ROWS], -- aka length(data)
                     lpp = list_attr[LX_LINESPP]
            list_attr = 0 -- (kill refcount)
            if c=VK_UP then         line = max(line-1,1)            top_line = min(top_line,line)
            elsif c=VK_DOWN then    line = min(line+1,n_rows)       top_line = max(top_line,line-lpp+1)
            elsif c=VK_PGUP then    line = max(line-lpp,1)          top_line = max(top_line-lpp,1)
            elsif c=VK_PGDN then    line = min(line+lpp,n_rows)     top_line = min(top_line+lpp,n_rows)
            elsif c=VK_HOME then    line = 1                        top_line = 1
            elsif c=VK_END then     line = n_rows                   top_line = max(top_line,line-lpp+1)
            end if
            tg_list_set_top_line(list,top_line)
            tg_list_set_line_col(list,line,col)
            tg_list_set_selection(list,line,false,shift)
--      elsif c=VK_LEFT
--         or c=VK_RIGHT then
--          return tg_scrollbar_key_handler(list, c, ctrl, shift, false)
        elsif ctrl and upper(c)='A'
          and ctrl_xtra[list][LX_MULTIPLE] then
            integer n_rows = ctrl_xtra[list][LX_N_ROWS]
            ctrl_xtra[list][LX_SELECTED] = repeat(true,n_rows)
            gRedraw(list)
        -- Aside: VK_ESC cancelling select is a feature of theEditor, not a gList.
        end if
    end if
    return TG_CONTINUE
end function

local function tg_close_handler(gdx id)
    -- (shared code between GTK via tg_gtk_hide(), 
    --  WinAPI via tg_WinAPI_WndProc and WM_CLOSE.)
    -- return true if ok to close
    integer close_handler = gGetHandler(id,`CLOSE`)
    if close_handler then
        integer res = TG_DEFAULT
        string sig = tg_get_sig(close_handler)
        switch sig do
            case `F`: res = close_handler()
            case `FO`: res = close_handler(id)
            case `P`: close_handler()
            case `PO`: close_handler(id)
            default: ?9/0
        end switch
        if res=TG_IGNORE then return false end if
    end if
    return true
end function

global constant TG_MENUITEM_HEIGHT = 21,
                TG_MENU_FONT = `Segoe UI, 9`,
                TG_MENU_KEY_FONT = `Segoe UI, 7`

local function tg_get_menu_owner(gdx menu, integer mdx)
    sequence menus = ctrl_xtra[menu][CX_MENUS]
    while menus[mdx][MX_PARENT]>0 do
        mdx = menus[mdx][MX_PARENT]
    end while
    gdx res = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_OWNER]
    return res
end function

local procedure tg_menu_redraw(gdx menu, integer mdx)
    -- note this is for popups; for (only) the menubar just gRedraw(menu)
    if backend=TG_GTK then
        atom widget = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDGET]
        c_proc(x_gtk_widget_queue_draw,{widget})
    elsif backend=TG_WINAPI then
        atom hWnd = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP]
        c_funk(xInvalidateRect,{hWnd,NULL,false});
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_menu_redraw)`);
        #}ilJS
    else
        ?9/0 -- unknown backend
    end if
end procedure

procedure tg_compute_menu_size(gdx menu, integer mdx)
    integer width = 40,  -- padding baseline
            height = 8,  -- (4+4, top+btm)
            radio_group = 0,
            radio_checked = 0,
            tw
    bool bAnyImages = false
    sequence items = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS],
       text_widths = {}
    for i,item in items do
        object image = item[MX_IMAGE]
        if image!=NULL then
            bAnyImages = true
            if image=`??` then
                if radio_group=0 then
                    radio_group = i
                    radio_checked = 0
                end if
                if item[MX_CHECKED] then
                    if radio_checked then ?9/0 end if
                    radio_checked = i
                end if
            end if
        elsif radio_group then
            if radio_checked=0 then
                items = deep_copy(items)
                ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS][radio_group][MX_CHECKED] = true
            end if
            radio_group = 0
        end if
        string text = item[MX_TEXT]
        if text=`-` then
            tw = 0
            height += 6
        else
            integer tab = find('\t',text)
            if tab then text = text[1..tab-1] end if
            tw = gGetTextExtent(text,TG_MENU_FONT)[1]
            width = max(width,tw)
            tw += 14 -- matching menubars
            height += TG_MENUITEM_HEIGHT
        end if
        text_widths &= tw
    end for
    if bAnyImages then width += 28 end if
--  width += 52 -- add gutter
    width += 62 -- add gutter
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDTH] = width
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HEIGHT] = height
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDTHS] = text_widths
end procedure

integer menu_id_dict
function tg_build_menu(sequence menus, def, integer parent=0)
    -- convert the nested structure passed to gMenu(children) into a flat linked table.
    menus &= 0 -- reserve slot
    integer mdx = length(menus), rgStart=0, rgOneSet=false
    sequence items = {}
    if parent=0 then menu_id_dict = new_dict() end if
    for mi,mitem in def do
        bool rgItem = false
        if string(mitem) or integer(mitem) then
            -- Aside: in the real thing, items w/o id are illegal...
            assert(find(mitem,{`|`,`-`,'|','-'})) -- separator
                    -- txt,submenu,image,enabled,id
            items &= {{`-`,      0, NULL,  false, 0}}
        else
            integer l = length(mitem), id = 0
            object image = NULL -- or `?[?]`
            bool enabled = true,
                 checked = false
            if integer(mitem[$]) then
                id = mitem[$]
--              {`leaf`, id}                                -- (nb: id>0)
--              {`leaf`, enabled, id}                       -- (enabled>=0)
--              {`leaf`, image, id}                         -- (image<0)
--              {`leaf`, image, enabled, id}                -- (  ""   )
--              {`leaf`, image, enabled, ignored, id}       -- (chk ignored)
--              {`leaf`, `?[?]`, checked, id}
--              {`leaf`, `?[?]`, enabled, checked, id}      -- (unambiguous)
                if l=5 then
                    {?,image,enabled,checked,id} = mitem
                elsif l=4 then
                    {?,image,enabled,id} = mitem
                    if string(image) then
                        {enabled,checked} = {true,enabled}
                    else
                        assert(image<0)
                    end if
                elsif l=3 then
                    image = mitem[2]
                    if integer(image) and image>=0 then
                        {image,enabled} = {NULL,image}
                    end if
                end if
                string text = mitem[1]
                integer submenu = 0
                if string(image) and length(image)>2 then
                    image = gImage_from_XPM(image)
                end if
                if not enabled then checked = false end if
                if string(image) then
                    items &= {{text,submenu,image,enabled,id,checked}}
                    rgItem = image==`??`
                    if rgItem then
--?{"rgItem!",length(items),checked,mitem,l}
                        if rgStart=0 then rgStart=length(items) end if
                        if checked then rgOneSet = true end if
                    elsif image!=`?` then
                        crash("bad image")
                    end if
                else
                    items &= {{text,submenu,image,enabled,id}}
                end if
            else
                -- submenu
--              {`submenu`, children}
--              {`submenu`, id, children}                   -- (id>0)
--              {`submenu`, enabled, id, children}          -- (enabled>=0)
--              {`submenu`, image, children}                -- (image<0)
--              {`submenu`, image, id, children}            -- (image<0)
--              {`submenu`, image, enabled, id, children}   -- (unambiguous)
                if l=5 then
                    {?,image,enabled,id,?} = mitem
                elsif l=4 then
                    {?,image,id,?} = mitem
                    if image>=0 then
                        {image,enabled} = {NULL,image}
                    end if
                elsif l=3 then
                    {?,image,?} = mitem
                    if image>=0 then
                        {image,id} = {NULL,image}
                    end if
                end if
                integer submenu = length(menus)+1
                menus = tg_build_menu(menus,mitem[$],mdx)
                string text = mitem[1]
--NO: part of draw_menu:
--              if length(menus[submenu][MX_ITEMS])=0 then
--                  enabled = false
--              end if
                items &= {{text,submenu,image,enabled,id}}
            end if
            if id then
                if getd_index(id,menu_id_dict)!=NULL then
                    crash("duplicate menu id:%s",{gGetKeyName(id)})
                end if
                setd(id,0,menu_id_dict)
            end if
        end if
        if rgStart and ((not rgItem) or mi=length(def)) then
            if not rgOneSet then
                -- if none, first gets the honour
                items[rgStart][MX_CHECKED] = true
            end if
            rgStart = 0
            rgOneSet = false
        end if
    end for
-- no, do this check at display time instead:
--  menus[mdx] = {items, parent, NULL, length(items)>0, 0}
-- MX_ITEMS, MX_PARENT, MX_IMAGE, MX_ENABLED, MX_ID
    menus[mdx] = {items, parent, NULL, true, 0}
--  menus[mdx] = {items, parent, image, enabled, id}
    if parent=0 then
--?apply(getd_all_keys(menu_id_dict),gGetKeyName)
        destroy_dict(menu_id_dict)
        menu_id_dict = 0
    end if
    return menus
end function

local procedure tg_draw_menu(gdx menu, integer mdx)
    object cxm = ctrl_xtra[menu],
         items = cxm[CX_MENUS][mdx][MX_ITEMS],
         mxtra = cxm[CX_MEXTRA][mdx]
    cxm = NULL -- (kill refcount)
    gdn img = mxtra[MX_TGTIMG]
    integer w = mxtra[MX_WIDTH],
            h = mxtra[MX_HEIGHT]
    if img!=NULL and gGetAttribute(img,`SIZE`)!={w,h} then
        -- (re)create the image when we need to
        -- (usually single-shot, unless updated)
        img = gImageDestroy(img)
    end if
    if img=NULL then
        img = gImage(w,h,TG_POPMENU_BGCLR)
        gSetAttribute(img,`FONT`,TG_MENU_FONT)
        mxtra = 0 -- (kill refcount)
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_TGTIMG] = img
        mxtra = ctrl_xtra[menu][CX_MEXTRA][mdx]
    else
        tg_fill_image(img,w,h,TG_POPMENU_BGCLR) -- clear
    end if
    draw_menu(menu,img,items,mxtra) 
end procedure

local function tg_find_menu(atom handle, integer hdx, in_mdx=0)
    -- hdx must be MX_POPUP and handle a hWnd on WinAPI,
    --          or MX_WIDGET and handle a widget on GTK
    -- [aside: instead of all GTK calls must getwindow(widget)]
    integer menu, mdx = 0
    for menu,m in ctrl_xtra do
        if ctrl_types[menu]=MENU then
            for i,mx in m[CX_MEXTRA] do
                if mx[hdx]=handle then
                    mdx = i
                    exit
                end if
            end for
            if mdx then exit end if
        end if
    end for
--NO! mdx of 0 is expected for ignorable startup WinAPI messages
--  assert(mdx!=0 and (in_mdx=0 or mdx=in_mdx))
    assert(in_mdx=0 or mdx=in_mdx)
    return iff(in_mdx?menu:{menu,mdx})
end function

local function tg_GTK_menu_draw(atom widget, cairo, integer mdx)
    -- GTK3 version, which gets the cairo context it should draw on.
    --  (also invoked from GTK2 version, with the cairo it created)
    integer menu = tg_find_menu(widget,MX_WIDGET,mdx)
    tg_draw_menu(menu,mdx)
    gdm img = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_TGTIMG]
    integer imdx = (-img+1)/2
    atom src_img = gimages[imdx][TG_IMG_HANDLE]
    c_proc(x_gdk_cairo_set_source_pixbuf,{cairo,src_img,0,0})
    c_proc(x_cairo_paint,{cairo})
    c_proc(x_cairo_fill,{cairo})
    return false
end function

local function tg_GTK_expose_event(atom widget, /*event*/, integer mdx)
    -- GTK2 version, which needs to create a cairo context to draw on.
    --  (then invokes GTK3 version, passing said cairo just created)
    nnatom win = c_func(x_gtk_widget_get_window,{widget}),
         cairo = c_func(x_gdk_cairo_create,{win})
    integer res = tg_GTK_menu_draw(widget,cairo,mdx)
    c_proc(x_cairo_destroy,{cairo})
    return res
end function

local function tg_get_menu_root(gdx menu, integer mdx)
    integer parent = mdx
    sequence menus = ctrl_xtra[menu][CX_MENUS]
    do
        mdx = parent
        parent = menus[mdx][MX_PARENT]
    until parent<=0
    return mdx
end function

local function tg_menu_hit_test(gdx menu, integer mdx, x, y, bool bDisabled=false)
    sequence cxm = ctrl_xtra[menu][CX_MEXTRA][mdx],
           items = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS]
    integer w = cxm[MX_WIDTH],
            h = cxm[MX_HEIGHT]
    if x>=0 and x<=w and y>=4 and y<=h-4 then
        integer top = 4, btm
        for i,item in items do
            btm = top+iff(item[MX_TEXT]=`-`?6:TG_MENUITEM_HEIGHT)
            if y<top then exit end if
            if y<=btm then
                bool enabled = item[MX_ENABLED]
                integer submenu = item[MX_SUBMENU]
                if submenu and length(ctrl_xtra[menu][CX_MENUS][submenu][MX_ITEMS])=0 then
                    enabled = false
                end if
                return iff(enabled or bDisabled?i:0)
            end if
            top = btm
        end for
    end if
    return 0
end function

local function tg_menu_visible(gdx menu, integer mdx, bool bLowest)
    -- returns 0 if mdx is not visible, else the lowest(/topmost) visible submenu or mdx if none
    atom hWnd = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP]
    if hWnd!=NULL and iff(backend=TG_GTK?c_func(x_gtk_widget_get_visible,{hWnd})
                     :iff(backend=TG_WINAPI?c_func(xIsWindowVisible,{hWnd})
                     :9/0 --/* unknown backend --*/ )) then
        if bLowest then
            sequence items = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS]
            for item in items do
                integer submenu = item[MX_SUBMENU]
                if submenu then
                    submenu = tg_menu_visible(menu,submenu,true)
                    if submenu then return submenu end if
                end if
            end for
        end if
        return mdx
    end if
    if mdx=1 and ctrl_parent[menu]!=NULL then
        -- on a top-level barmenu check each child:
        for mdx in vslice(ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS],MX_SUBMENU) do
            if mdx then
                mdx = tg_menu_visible(menu,mdx,bLowest)
                if mdx then return mdx end if
            end if
        end for
        return 0
    end if
    return 0
end function

local procedure tg_hide_one_menu(gdx menu, integer mdx, bool bKeepKbd)
--  bool killOwner = true
    gdx owner = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_OWNER]
    bool killOwner = owner!=NULL
--?{"tg_hide_one_menu",menu,mdx,"kill",killOwner,"owner",owner}
    atom hWnd = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_POPUP]
    if hWnd!=NULL then -- (not a top-level menubar)
        if backend=TG_GTK then
            c_proc(x_gtk_widget_hide,{hWnd})
        elsif backend=TG_WINAPI then
            c_proc(xShowWindow,{hWnd,SW_HIDE})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_hide_one_menu)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
        integer parent = ctrl_xtra[menu][CX_MENUS][mdx][MX_PARENT]
        if parent>0 then
            if bKeepKbd and ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] then
                ctrl_xtra[menu][CX_MEXTRA][mdx][MX_KEYMODE] = true
                tg_menu_redraw(menu,parent)
            end if
            -- leave kill true for top level popup and immediate children of barmenu:
            if parent!=1 or ctrl_parent[menu]=0 then
--?{"kof",parent,ctrl_parent[menu]}
                killOwner = false
            else
                owner = gGetDialog(menu)
                -- added 22/7/26: (not 100% sure about this)
                killOwner = owner!=NULL
            end if
        end if
    end if
--?{"kill",killOwner,"owner",owner}
    if killOwner then
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_OWNER] = NULL
--printf(1,"ctrl_xtra[%d][DX_ACTIVEPOP] = NULL (%d)\n",{owner,source_line()})
        ctrl_xtra[owner][DX_ACTIVEPOP] = NULL
    end if
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = 0
--DEV see if we can get away w/o this...
--  tg_call_menu_handler(menu,0,0,true,false)
end procedure

function tg_top_position(gdx menu, integer mdx, n)
    -- compute the top y-position of the n'th item in menu[mdx]
    -- (obviously must match height calculation in tg_compute_menu_size)
    integer top = 4
    sequence items = ctrl_xtra[menu][CX_MENUS][mdx][MX_ITEMS]
    for text in vslice(items[1..n-1],MX_TEXT) do
        top += iff(text=`-`?6:TG_MENUITEM_HEIGHT)
    end for
    return top
end function

local integer screen_width = -1,
              screen_height

function tg_get_screensize()
    integer width, height
    if backend=TG_GTK then
        if not bGTK3 then
            width = c_func(x_gdk_screen_get_width)
            height = c_func(x_gdk_screen_get_height)
        else -- GTK/64 bit (and/or post-2.0)
            nnatom display = c_func(x_gdk_display_get_default,{}),
                   monitor = c_func(x_gdk_display_get_monitor,{display,0})
            c_proc(x_gdk_monitor_get_geometry,{monitor,pRECT})
            width = get_struct_field(idGdkRectangle,pRECT,`width`)
            height = get_struct_field(idGdkRectangle,pRECT,`height`)
        end if
    elsif backend=TG_WINAPI then
        width = c_func(xGetSystemMetrics,{SM_CXSCREEN})
        height = c_func(xGetSystemMetrics,{SM_CYSCREEN})
    elsif backend=TG_JS then    
        #ilJS{
            width = window.innerWidth;
            height = window.innerHeight;
        #}ilJS
    else
        ?9/0 -- (unknown backend)
    end if
    return {width,height}
end function

local function tg_adjust_menu_pos(integer x, y, w, h)
    integer nx = x, ny = y
    if screen_width=-1 then
--      {screen_width,screen_height} = gGetGlobalIntInt(`SCREENSIZE`)
        {screen_width,screen_height} = tg_get_screensize() -- ""
    end if
    if x+w>screen_width then nx = x-w end if    -- flip horizontally
    if y+h>screen_height then ny = y-h end if   -- flip vertically
    -- clamp (important for tiny screens / extreme cases)
    if nx<0 then nx = 0 end if
    if ny<0 then ny = 0 end if
    return {nx,ny}
end function

-- Needed since (eg) tg_ensure_popup() needs to set tg_GTK_menu_mousemove(), which
--  calls tg_menu_mousemove(), which calls tg_open_child_menu(), which then calls
--  tg_draw_menu(), which calls tg_show_menu(), which calls tg_ensure_popup()!!!!
forward local function tg_ensure_popup(gdx menu, integer mdx)

local procedure tg_show_menu(gdx owner, menu, integer mdx, x, y)
    integer parent = ctrl_xtra[menu][CX_MENUS][mdx][MX_PARENT]
    if parent<=0 then
        ctrl_xtra[menu][CX_MEXTRA][mdx][MX_OWNER] = owner
        ctrl_xtra[owner][DX_ACTIVEPOP] = menu
    end if
    atom hPopup = tg_ensure_popup(menu,mdx),
          hMenu = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDGET]
          -- (aside: hMenu is for GTK only and expected to be NULL on WinAPI)
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HOT] = 0
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_SEL] = 0
    integer w = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_WIDTH],
            h = ctrl_xtra[menu][CX_MEXTRA][mdx][MX_HEIGHT],
      {nx,ny} = tg_adjust_menu_pos(x,y,w,h)
    if backend=TG_GTK then
        c_proc(x_gtk_widget_set_size_request,{hMenu,w,h})
        c_proc(x_gtk_window_resize,{hPopup,w,h})
        c_proc(x_gtk_widget_show_all,{hPopup})
        c_proc(x_gtk_window_move,{hPopup,nx,ny})
    elsif backend=TG_WINAPI then
        integer uFlags = SWP_SHOWWINDOW+SWP_NOACTIVATE
        c_funk(xSetWindowPos,{hPopup,HWND_TOPMOST,nx,ny,w,h,uFlags})
    elsif backend=TG_JS then    
        #ilJS{
            crash(`JS (tg_show_menu)`);
        #}ilJS
    else
        ?9/0 -- unknown backend
    end if
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_X] = nx
    ctrl_xtra[menu][CX_MEXTRA][mdx][MX_Y] = ny
end procedure

local procedure tg_open_child_menu(gdx menu, integer submenu, mdx, sel_item)
    -- open submenu, which is the sel_item of mdx, already open,
    -- because the mouse is hovered on it or user keyed rightarrow
    gdx owner = tg_get_menu_owner(menu, mdx)
    object mxtra = ctrl_xtra[menu][CX_MEXTRA],
           mxmdx = mxtra[mdx],
           mxsub = mxtra[submenu]
    if screen_width=-1 then
--      {screen_width,screen_height} = gGetGlobalIntInt(`SCREENSIZE`)
        {screen_width,screen_height} = tg_get_screensize() -- ""
    end if
    integer mx = mxmdx[MX_X],
            my = mxmdx[MX_Y],
            pw = mxmdx[MX_WIDTH],
            cw = mxsub[MX_WIDTH],
            ch = mxsub[MX_HEIGHT],
            px = mx+pw-4, -- try right...
            nx = iff(px+cw>screen_width?mx-cw+4:px),
            ny = my+tg_top_position(menu,mdx,sel_item)
    {mxtra,mxmdx,mxsub} = {NULL,NULL,NULL} -- (kill refcounts)
    {nx,ny} = tg_adjust_menu_pos(nx,ny,cw,ch)
    tg_show_menu(owner,menu,submenu,nx,ny)
end procedure

procedure tg_hide_submenus(gdx menu, integer mdx, bool bAndItself)
--?{"tg_hide_submenus",menu,mdx,bAndItself}
    -- hide any submenus when we hover on summat else (sometimes several levels up),
    -- also used to close an entire menu from the root menu and everything downwards
    while true do
        integer submenu = tg_menu_visible(menu,mdx,true)
        if submenu=0 or submenu=mdx then exit end if
        tg_hide_one_menu(menu,submenu,false)
    end while
    if bAndItself then
        tg_hide_one_menu(menu,mdx,false)
    end if
end procedure

procedure tg_hide_up(gdx menu, integer mdx)
    -- hide the lowest level menu and all parents of it
    integer parent = mdx
    sequence menus = ctrl_xtra[menu][CX_MENUS]
    do
        mdx = parent
        tg_hide_one_menu(menu,mdx,false)
        parent = menus[mdx][MX_PARENT]
    until parent<=0
end procedure

