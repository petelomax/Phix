local procedure tg_chk_redraw(gdx chk, integer w, h)
    string chk_txt = gGetAttribute(chk,`TITLE`)
--  integer {tw,th} = gGetAttribute(chk,`SIZE`), tx=6, ty=12,
    integer {tw,th} = gGetTextExtent(chk_txt,chk), tx=6, ty=12, ix,
         icon_align = ctrl_xtra[chk][CXCHK_IALGN],
         pair_align = ctrl_xtra[chk][CXCHK_PALGN],
              align = TG_E
--?{tw,w,th,h}
    bool bActive = gGetAttribute(chk,`ACTIVE`),
         bChecked = ctrl_xtra[chk][CXCHK_VALUE],
         bRadio = ctrl_xtra[chk][CXCHK_RADIO]
    if backend=TG_GTK then
--      {tx,ty,tw,th} = {4,11,tw-1,th-4}
        {tx,ty,w,h} = {4,11,w-1,h-4}
    elsif backend=TG_WINAPI then
        -- (do nowt)
    elsif backend=TG_JS then
        #ilJS{
            crash(`JS (tg_chk_redraw)`);
