global procedure gSaveFile(gdx parent, rtn got, object arg2=NULL, folder=NULL, filters=NULL, title="Save As", object name=NULL)
    atom win = ctrl_handles[parent]
    if backend=TG_GTK then
        nnatom file_dialog = c_func(x_gtk_file_chooser_dialog_new,
                                    {title,win,
                                     GTK_FILE_CHOOSER_ACTION_SAVE,
                                     `_Cancel`, GTK_RESPONSE_CANCEL,
                                     `_Open`, GTK_RESPONSE_ACCEPT,
                                     NULL,NULL})
        if folder!=NULL then
            {} = c_func(x_gtk_file_chooser_set_current_folder,{file_dialog,folder})
        end if
        if filters!=NULL then
            for f in filters do
                string {friendly_name, pattern} = f
                nnatom fltr = c_func(x_gtk_file_filter_new,{})
                c_proc(x_gtk_file_filter_add_pattern,{fltr,pattern})
                c_proc(x_gtk_file_filter_set_name,{fltr,friendly_name})
                c_proc(x_gtk_file_chooser_add_filter,{file_dialog,fltr})
            end for
        end if
        c_proc(x_gtk_file_chooser_set_select_multiple,{file_dialog,false})
        if name!=NULL then
            c_proc(x_gtk_file_chooser_set_filename,{file_dialog,name})
        end if
        bool bOK = c_func(x_gtk_dialog_run,{file_dialog})==GTK_RESPONSE_ACCEPT
        if bOK then
            atom pRes = c_func(x_gtk_file_chooser_get_filename,{file_dialog})
--          invoke_got(got,peek_string(pRes),arg2)
            got(peek_string(pRes),arg2)
            c_proc(x_g_free,{pRes})
        end if
        c_proc(x_gtk_widget_destroy,{file_dialog})
    elsif backend=TG_WINAPI then
        -- (see builtins\fileopenN.exw [note phix.chm documents 
        --  gOpenFile() //rather than// newGetOpenFileName()!])
--      object default_folder = iff(name=NULL?NULL:{NULL,name}),
--             res = newGetSaveFileName(win,filters,default_folder,title:=title) 
        object res = newGetSaveFileName(win,filters,folder,title:=title) 
        if res!=NULL then
            if not string(res) then
                assert(length(res)=2)
--              ?{`Encoding`,res[1]}
                res = res[2]        
            end if
            assert(string(res))
            got(res,arg2)
        end if
    elsif backend=TG_JS then
        if filters!=NULL then
            ?9/0 -- placeholder
        end if
        #ilJS{
            let opts = {suggestedName: name,
                       };
--/*
            let opts = {types: [{description: "Text file",
                                 accept: { "text/plain": [".txt"] },
                                },
                               ],
                        suggestedName: name,
                       };
--          if (name) {
--              opts.suggestedName = name;
--          }
from open:
const pickerOpts = {
  types: [
    {
      description: "Images",
      accept: {
        "image/"&"*": [".png", ".gif", ".jpeg", ".jpg"],
      },
    },
  ],
  excludeAcceptAllOption: true,
  multiple: false,
};
--*/
            let newHandle = await window.showSaveFilePicker(opts);
            if (newHandle) {
                got(newHandle,arg2);
            }
        #}ilJS
    else
        ?9/0
    end if
end procedure

global procedure gSaveFileText(object file, contents, bool bBinary=false, bAddCR=true)
    if backend=TG_JS then
        #ilJS{
            let writableStream = await file.createWritable();
            if (string(contents)) {
                await writableStream.write(contents);
            } else {
                let l = length(contents);
                for (let i = 1; i <= l; i++) {
                    await writableStream.write(contents[i]);
                    if (bAddCR) {
                        await writableStream.write("\n");
                    }
                }
            }
            await writableStream.close();
        #}ilJS
    else
        assert(string(file))
        integer fn = open(file,iff(bBinary?"wb":"w"))
        if string(contents) then
            puts(fn,contents)
        else
            for c in contents do
                puts(fn,c)
                if bAddCR then
                    puts(fn,"\n")
                end if
            end for
        end if
        close(fn)
    end if
end procedure

global procedure gMainLoop(gdx dlg=NULL, integer x=TG_CURRENT, y=TG_CURRENT)
    if dlg!=NULL then gShow(dlg,x,y) end if
    if backend=TG_GTK then
        c_proc(x_gtk_main) -- (GTK2/3, nb not GTK4!)
    elsif backend=TG_WINAPI then
        do 
            while idle_rtn
              and not c_func(xPeekMessage,{pMSG,NULL,0,0,PM_NOREMOVE}) do
                -- hg_prioritise_idle()
                integer r = call_func(idle_rtn,idle_args)
                if r=TG_IGNORE then
                    idle_rtn = NULL
                    {} = hg_pop_or_prioritise_idle_stack()
                elsif r!=TG_CONTINUE then
                    crash(`TG_IGNORE or TG_CONTINUE only`)
                end if
            end while                   
            if not c_func(xGetMessage,{pMSG,NULL,0,0}) then exit end if
            c_proc(xTranslateMessage,{pMSG})
            -- (^^ generates WM_[SYS]CHAR messages from WM_[SYS]KEYDOWN messages)
            c_proc(xDispatchMessage,{pMSG})
        until false // (until WM_QUIT)
    elsif backend=TG_JS then    
        // do nothing...
    else
        ?9/0 -- (unknown backend)
    end if
    PrimaryWindowID = UNDEFINED
end procedure
last_xpgui_rid = gMainLoop -- (or whatever ends up last in this file)

local procedure tg_unit_test(gdx dlg, string what, integer w, h, gdx id1=NULL, id2=NULL)
    gShow(dlg)
    if what=`DIALOG_SIZE` then
        integer left, top, width, height
        if backend=TG_GTK then  
            atom handle = ctrl_handles[dlg]
            c_proc(x_gtk_window_get_size,{handle,pW,pH})
            integer {dw,dh} = tg_get_dialog_decoration_size(dlg)
            width = get_struct_field(idGdkRectangle,pRECT,`width`)+dw
            height = get_struct_field(idGdkRectangle,pRECT,`height`)+dh
        elsif backend=TG_WINAPI then    
            atom hWnd = ctrl_handles[dlg]
            c_funz(xGetWindowRect,{hWnd,pRECT})
            left = get_struct_field(idRECT,pRECT,`left`)
            top = get_struct_field(idRECT,pRECT,`top`)
            width = get_struct_field(idRECT,pRECT,`right`)-left-14
            height = get_struct_field(idRECT,pRECT,`bottom`)-top-7
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_unit_test)`);
            #}ilJS
        else
            ?9/0 -- unknown backend
        end if
        assert(width==w)
        assert(height==h)
    elsif what=`CANVAS_SIZE` then
        assert(ctrl_size[id1][SZ_W]==w)
        assert(ctrl_size[id2][SZ_W]==w)
        assert(ctrl_size[id1][SZ_H]==h)
        assert(ctrl_size[id2][SZ_H]==h)
    else
        ?9/0 -- unknown "what"
    end if
    gHide(dlg)
    if backend=TG_WINAPI then   
        gMainLoop()
    elsif backend=TG_JS then    
        // do nothing...
    end if
    clear_tables()
end procedure

local procedure tg_unit_tests()
    -- not invoked when run_unit_tests is false or main file not in demo\theGUI\.
    nodump = true -- (also avoid gtk_main_quit)
    -- both same, from gCanvasX.exw:
    gdx cnv, dlg
    cnv = gCanvas()
    dlg = gDialog(cnv,`edge`,`SIZE = 302x332`)
    tg_unit_test(dlg,`DIALOG_SIZE`,302,332)
    cnv = gCanvas(`SIZE = 300x300`)
    dlg = gDialog(cnv,`edge`)
    tg_unit_test(dlg,`DIALOG_SIZE`,302,332)
    gdx cv1,cv2,box
    cv1 = gCanvas()
    cv2 = gCanvas()
    box = gHbox({cv1,cv2})
    dlg = gDialog(box,`edge`,`SIZE = 212x142`)
    gSetAttribute(box,`GAP`,`10`)
    gSetAttribute(box,`MARGIN`,`10`)
    tg_unit_test(dlg,`CANVAS_SIZE`,90,90,cv1,cv2)
    cv1 = gCanvas()
    cv2 = gCanvas()
    box = gHbox({cv1,cv2})
    dlg = gDialog(box,`edge`)
    gSetAttributes({cv1,cv2},`SIZE=90x90,EXPAND=NO`)
    gSetAttribute(box,`GAP`,`10`)
    gSetAttribute(box,`MARGIN`,`10`)
    tg_unit_test(dlg,`CANVAS_SIZE`,90,90,cv1,cv2)
    cv1 = gCanvas()
    cv2 = gCanvas()
    box = gHbox({cv1,cv2})
    dlg = gDialog(box,`edge`)
    gSetAttributes({cv1,cv2},`SIZE=90x90,EXPAND=NO`)
    gSetAttribute(box,`GAP`,`10`)
    gSetAttribute(box,`MARGIN`,`10`)
    tg_unit_test(dlg,`DIALOG_SIZE`,212,142)
    
    nodump = false
end procedure

