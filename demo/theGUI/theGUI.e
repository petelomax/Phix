local function tg_set_calendar_attribute(gdx calendar, string name, object v, integer nFrames)
    if name=`RANGE` then
        if string(v) then
            assert(v[1]='{' and v[$]='}',"{}?",nFrames:=nFrames+2)
            v = v[2..-2]
            integer cr = iff(v[1]=='{'?'}':','),
                     k = find(cr,v)
            assert(k and (cr=',' or v[k+1]=','),nFrames:=nFrames+2)
            v = {v[1..k],v[k+2..$]}
            for i,vi in v do
                v[i] = iff(vi[1]=='{' ? tg_intint(vi,name,nFrames+2) : to_number(vi))
            end for
        end if
        if v=NULL then
            v = {{1800,1,1},{9999,12,31}}
        else
            assert(length(v)=2,"bad RANGE",nFrames:=nFrames+2)
            for i,vi in v do
                if integer(vi) then
                    v[i] = adjust_timedate(date(),timedelta(days:=vi))
                end if
            end for
            assert(v[1]<=v[2])
        end if
        ctrl_xtra[calendar][CXCAL_RANGE] = v
        integer year = ctrl_xtra[calendar][CXCAL_YEAR],
               month = ctrl_xtra[calendar][CXCAL_MONTH],
                 day = ctrl_xtra[calendar][CXCAL_DAY]
        {year,month,day} = tg_clamp_calendar(calendar, year,month,day)
        ctrl_xtra[calendar][CXCAL_YEAR] = year
        ctrl_xtra[calendar][CXCAL_MONTH] = month
        ctrl_xtra[calendar][CXCAL_DAY] = day
        return true
--DEV not tested here, but we may want this, and possibly on non-alt-tab-losefocus too[?]:
--  elsif name=`ACTIVE` then
--      if v=false then
--          ctrl_xtra[calendar][CXCAL_STATE] = TG_MONTH
--      end if
    end if
    return false
end function

local function tg_get_calendar_attribute(gdx calendar, string name, integer nFrames)
    if name=`RANGE` then
        return ctrl_xtra[calendar][CXCAL_RANGE]
    end if
    tg_bad_attr(calendar,name,nFrames+1)
end function

global function gCalendar(object ymd=NULL, value_changed=NULL, sequence attributes=``, args={})
    {ymd,value_changed,attributes,args} = paranormalise_draa(ymd,value_changed,attributes,args)
    if ymd=NULL then ymd = date() end if
    gdx calendar = gCanvas(tg_redraw_calendar,`SIZE=221x142`,nFrames:=2)
    ctrl_types[calendar] = CALENDAR
    ctrl_set_attr[CALENDAR] = tg_set_calendar_attribute
    ctrl_get_attr[CALENDAR] = tg_get_calendar_attribute
    object cx = repeat(0,CXCAL_LEN)
    cx[CXCAL_BGSEL] = #CCE8F8
    cx[CXCAL_BGHOV] = #0066CC
    cx[CXCAL_BGHBX] = #E5F3FF
    cx[CXCAL_YEAR] = ymd[DT_YEAR]
    cx[CXCAL_MONTH] = ymd[DT_MONTH]
    cx[CXCAL_DAY] = ymd[DT_DAY]
    cx[CXCAL_STATE] = TG_MONTH
    ctrl_xtra[calendar] = cx
    cx = null
    gSetAttribute(calendar,`EXPAND`,false)
    gSetAttribute(calendar,`CANFOCUS`,true)
    gSetAttribute(calendar,`RANGE`,NULL)
    gSetHandler(calendar,`KEY`,tg_calendar_key)
    gSetHandler(calendar,`CLICK`,tg_calendar_click)
    gSetHandler(calendar,`MOUSEMOVE`,tg_calendar_mousemove)
    gSetHandler(calendar,`MOUSELEAVE`,tg_calendar_mouseleave)
    gSetHandler(calendar,`MOUSEWHEEL`,tg_calendar_mousewheel)
    if value_changed then
        gSetHandler(calendar,`VALUE_CHANGED`,value_changed)
    end if
    if length(attributes) then
        gSetAttributes(calendar,attributes,args,2)
    end if
    return calendar
end function

local procedure tg_draw_minor_ticks(gdx graph, atom x,y,tick,level,size, integer minor, xydx)
    -- draw one mark of size ...
    atom {xe,ye} = iff(xydx=1?{x,y-size}:{x+size,y})
    gDrawLine(graph,x,y,xe,ye)
    size /= 2
    if level=1 then
        -- ... and minor-1 marks of size/2:
        for i=1 to minor-1 do
            if xydx=1 then x -= tick/minor else y += tick/minor end if
            {xe,ye} = iff(xydx=1?{x,y-size}:{x+size,y})
            gDrawLine(graph,x,y,xe,ye)
        end for
    else
        -- ... and recurse/split for smaller ones:
        atom {xs,ys} = {x,y}
        if xydx=1 then xs -= tick/2 else ys += tick/2 end if
        tick /= 2
        minor /= 2
        level -= 1
        tg_draw_minor_ticks(graph, x,y, tick,level,size,minor, xydx)
        tg_draw_minor_ticks(graph, xs,ys, tick,level,size,minor, xydx)
    end if
end procedure

local procedure tg_redraw_graph(gdx graph, integer w, h)
    rtn data = gGetHandler(graph,`DATA`)
    string sig = tg_get_sig(data)
    sequence datasets = iff(sig=`F`?data():
                        iff(sig=`FO`?data(graph):
                        iff(sig=`FII`?data(w,h):
                        iff(sig=`FOII`?data(graph,w,h):9/0))))

    // nb: `XTICK` etc may be set in the above data() call.
    object grattrbs = ctrl_xtra[graph],
           legendxy = grattrbs[GX_LEGENDXY]
    sequence xytick = {grattrbs[GX_XTICK],
                       grattrbs[GX_YTICK]},
                 wh = {w,h},
             tminor = {0,0},
             tsizes = {16,16},
            tlevels = {1,1}
    for i,t in xytick do
        if sequence(t) then
            if sequence(t[1]) then
                t = t[1][binary_index(wh[i],t[2])]
            end if
        end if
        if sequence(t) then
            switch length(t) with fallthrough do
                case 4: tlevels[i] = t[4]
                case 3: tsizes[i] = t[3]
                case 2: tminor[i] = t[2]
                        break
                default: ?9/0
            end switch          
            t = t[1]
        end if
--erm: (if/when it promises to help, I guess)
--  crash(`minor ticks (%d) must be divisible by %d to show %d levels`,{minor,power(2,levels-1),levels})
        xytick[i] = t -- (shd be integer by now)
    end for
    atom gridclr = grattrbs[GX_GRIDCLR],
         xtick = xytick[1],
         xtminor = tminor[1],
         xtlevels = tlevels[1],
         xtsize = tsizes[1],
         xmin = grattrbs[GX_XMIN],
         xmax = grattrbs[GX_XMAX],
         xmargin = grattrbs[GX_XMARGIN],
         xyshift = grattrbs[GX_XYSHIFT],
         xangle = grattrbs[GX_XANGLE],
         ytick = xytick[2],
         ytminor = tminor[2],
         ytlevels = tlevels[2],
         ytsize = tsizes[2],
         ymin = grattrbs[GX_YMIN],
         ymax = grattrbs[GX_YMAX],
         ymargin = grattrbs[GX_YMARGIN],
         yxshift = grattrbs[GX_YXSHIFT],
         yangle = grattrbs[GX_YANGLE],
         bgclr = gGetAttribute(graph,`BGCLR`)

    string title = grattrbs[GX_GTITLE],
           xname = grattrbs[GX_XNAME],
           yname = grattrbs[GX_YNAME],
           xfmt = grattrbs[GX_XTICKFMT],
           yfmt = grattrbs[GX_YTICKFMT],
           legendpos = grattrbs[GX_LEGENDPOS],
           mode = grattrbs[GX_MODE],
           barmode = grattrbs[GX_BARMODE],
           markstyle = grattrbs[GX_MARKSTYLE]

    sequence legend = grattrbs[GX_LEGEND]
    if string(legend) and length(legend) then
        legend = apply(true,trim,{split(legend,','),{"\"`"}})
    end if

    integer marksize = grattrbs[GX_MARKSIZE],
            lx, ly, -- (TG_EAST of the first legend text)
            xacross = grattrbs[GX_XACROSS],
            yacross = grattrbs[GX_YACROSS],
            xrid = gGetHandler(graph,`XRID`),
            yrid = gGetHandler(graph,`YRID`),
            ystart = 16,
            ytop = 0
    bool bGrid = grattrbs[GX_GRID],
         bLegendBox = grattrbs[GX_LEGENDBOX]
    grattrbs = 0

    -- draw title and axis names
    gSetAttribute(graph,`FGCLR`,TG_BLACK)
    if title!=`` then
        gDrawText(graph,w/2+4,5,title,{},TG_SOUTH)
        ytop = 15
    end if
    if yname!=`` then
        gDrawText(graph,20,(h+ytop)/2,yname,{},TG_SOUTH,270)
        xmargin += 10
    end if
    if xname!=`` then
        gDrawText(graph,w/2,h-0,xname,{},TG_NORTH)
        ystart += 10
    end if

    -- draw the x/y-axis labels and vertical gridlines
    xacross = iff(xacross?round((0-xmin)/xtick)+1:1)
    yacross = iff(yacross?round((0-ymin)/ytick)+1:1)

    integer vb = (barmode=`VERTICAL`),
            hb = (barmode=`HORIZONTAL`),
            nx = max(round((xmax-xmin)/xtick)+vb,1),
            ny = max(round((ymax-ymin)/ytick)+hb,1)

    if barmode!=`` then
        assert(vb or hb,`invalid BARMODE`)
        assert(mode=`` or mode=`BAR`,`invalid MODE for BARMODE`)
        mode = `BAR`
    elsif mode=`BAR` then
        vb = true
    end if
    if markstyle!=`` and mode!=`MARK` and mode!=`MARKLINE` then
        assert(mode=``,`invalid MODE for MARKSTYLE`)
        mode = `MARK`
    end if
    atom dx = (w-60-xmargin)/nx,
         dy = (h-ystart-9-ymargin-ytop)/ny,
         vx = 30+xmargin,
         vy = ystart+ymargin,
         x = xmin,
         y = ymin
    integer {lgn,rt} = iff(xangle=0?{TG_S,0}: -- (rt n/a)
                       iff(xangle=90?{TG_E,TG_W}:
                       iff(xangle=-90?{TG_W,TG_E}:9/0)))
    for i=1 to nx+1-vb do   -- the vertical lines
        if (bGrid and not vb) or i=xacross then
            gSetAttribute(graph,`FGCLR`,iff(i=xacross?TG_BLACK:gridclr))
            gDrawLine(graph,vx,9+ytop,vx,h-(ystart+ymargin))
        end if
        gSetAttribute(graph,`FGCLR`,TG_BLACK)
        string xtext = iff(xrid?xrid(x):sprintf(xfmt,x))
        atom tx = vx+dx*vb/2+1,
             ty = h-(ystart+ymargin+xyshift+(yacross-1)*dy)

        gDrawText(graph,vx,ty+5,xtext,{},lgn,{rt,xangle})
        if i>1 and xtminor>1 then
            tg_draw_minor_ticks(graph,tx-1,ty,dx,xtlevels,xtsize,xtminor,1)
        end if
        vx += dx
        x += xtick
    end for
    {lgn,rt} = iff(yangle=0?{TG_W,0}: -- (rt n/a)
               iff(yangle=90?{TG_S,TG_N}:
               iff(yangle=-90?{TG_N,TG_S}:9/0)))
    integer nhl = ny+1-hb
    for i=1 to nhl do   -- the horizontal lines
        if (bGrid and not hb) or i=yacross then
            gSetAttribute(graph,`FGCLR`,iff(i=yacross?TG_BLACK:gridclr))
            gDrawLine(graph,31+xmargin,h-vy,w-30,h-vy)
        end if
        gSetAttribute(graph,`FGCLR`,TG_BLACK)
        string ytext = iff(yrid?yrid(y):sprintf(yfmt,y))
        atom tx = 25+xmargin+yxshift+(xacross-1)*dx,
             ty = h-vy
        gDrawText(graph,tx,ty,ytext,{},lgn,{rt,yangle})
        if i>1 and ytminor>1 then
            tg_draw_minor_ticks(graph,30+xmargin,ty,dy,ytlevels,ytsize,ytminor,2)
        end if
        vy += dy
        y += ytick
    end for 

    integer lw,lh, -- (legend text height, per line)
            ll = length(legend)
    if ll then
--      {lw,lh} = gGetTextExtent(legend,graph)
        {lw} = gGetTextExtent(legend,graph)
        {{},lh} = gGetTextExtent(legend[1],graph)
        assert(length(legendpos)=2)
        if legendpos=`XY` then
            {lx,ly} = legendxy -- (untested)
        else
            switch legendpos[1] do
                case 'T': ly = 25
                case 'C': ly = floor((h-50-lh*ll)/2)
                case 'B': ly = h-50-lh*ll
                default: ?9/0
            end switch
            switch legendpos[2] do
                case 'L': lx = 30+xmargin
                case 'C': lx = floor((xmargin*2+w-lw)/2)
                case 'R': lx = w-lw-50
                default: ?9/0
            end switch
            gSetAttribute(graph,`LEGENDXY`,{lx,ly})
        end if
        if bLegendBox then
            integer lr = lx+lw+30,
                    lb = ly+lh*ll
            gDrawRect(graph,lx-2,ly,lr,lb,true,0,bgclr)
            gDrawRect(graph,lx-2,ly,lr,lb,false,0,TG_BLACK)
        end if
    end if

    -- and finally draw/plot the points!
    atom wx = dx/xtick,
         hx = dy/ytick
    vx = 30+xmargin + (xacross-1)*dx
    vy = ystart+ymargin + (yacross-1)*dy
    if markstyle=`` then markstyle=`X` end if
    for d=1 to length(datasets) do
        sequence dd = datasets[d],
                 {px,py} = dd
        integer ldd = length(dd),
                 mm = begins(`MARK`,mode),
                dsz = marksize
        string dms = markstyle,
               dmm = mode
        if ldd>=4 then
            mm = true
            dms = dd[4]
            if ldd>=5 then
                object dd5 = dd[5]
                if string(dd5) then
                    assert(dd5=`MARKLINE`)
                    dmm = `MARKLINE`
                    if ldd>=6 then
                        dsz = dd[6]
                    end if
                else
                    dsz = dd5
                end if
            end if
        end if          
        atom fgclr = iff(ldd>=3?dd[3]:TG_BLACK)
        gSetAttribute(graph,`FGCLR`,fgclr)
        if length(px) then
            atom x1 = 30+xmargin+(px[1]-xmin)*wx,
                 y1 = ystart+ymargin+(py[1]-ymin)*hx
            for i=2-(vb or hb or mm) to length(px) do
                atom x2 = 30+xmargin+(px[i]-xmin)*wx+dx*vb/2,
                     y2 = ystart+ymargin+(py[i]-ymin)*hx+dy*hb/2
                if mode=`BAR` then
                    if vb then
                        gDrawRect(graph,x2-dx/2+1,h-vy,x2+dx/2-1,h-y2,true)
                    elsif hb then
                        gDrawRect(graph,vx,h-(y2-dy/2+1),x2,h-(y2+dy/2-1),true)
                    end if
                else
                    if mm then
--                  if mm or dmm=`MARKLINE`then
-- (from IupPlot:) mark style of the current dataset. 
--        Can be: `HOLLOW_CIRCLE`, `PLUS`, `X`, [DONE]
--          `STAR`, `CIRCLE`, `BOX`, `DIAMOND`,
--          `HOLLOW_BOX`, `HOLLOW_DIAMOND`. Default `X`. 
--        (rest to be implemented as and when needed)
                        if dms=`HOLLOW_CIRCLE` then
                            gDrawCircle(graph,x2,h-y2,2*(dsz+1))
                        elsif dms=`PLUS` then
                            gDrawLine(graph,x2,h-(y2-dsz),x2,h-(y2+dsz+1))
                            gDrawLine(graph,x2-dsz+1,h-y2,x2+dsz,h-y2)
                        elsif dms=`X` then
                            gDrawLine(graph,x2-dsz,h-(y2-dsz),x2+dsz,h-(y2+dsz))
                            gDrawLine(graph,x2-dsz,h-(y2+dsz),x2+dsz,h-(y2-dsz))
                        elsif dms=`DOT` then
                            gDrawPixel(graph,x2,h-y2,fgclr)
                        else
                            crash(`unknown MARKSTYLE (%s)`,{dms})
                        end if
                    end if
                    if not mm or (dmm=`MARKLINE` and i>=2) then
                        gDrawLine(graph,x1,h-y1,x2,h-y2)
                    end if
                end if
                x1 = x2
                y1 = y2
            end for
        end if
        if ll then
            integer lX = lx+2+lw,
                    lY = ly+floor(lh/2)
            if mode=`BAR` then -- (untested)
                gDrawRect(graph,lX,lY-5,lX+25,lY+5,true)
            else
                if mm then
                    if dms=`HOLLOW_CIRCLE` then
                        gDrawCircle(graph,lX+12,lY,2*(dsz+1))
                    elsif dms=`PLUS` then
                        gDrawLine(graph,lX+12,lY-dsz,lX+12,lY+dsz+1)
                        gDrawLine(graph,lX+12-dsz,lY,lX+12+dsz+1,lY)
                    elsif dms=`X` then
                        gDrawLine(graph,lX+12-dsz,lY+dsz,lX+12+dsz,lY-dsz)
                        gDrawLine(graph,lX+12-dsz,lY-dsz,lX+12+dsz,lY+dsz)
                    elsif dms=`DOT` then
                        gDrawPixel(graph,lX+15,lY,fgclr)
                    else --default/x
                        ?9/0
                    end if
                end if
                if not mm or dmm=`MARKLINE` then
                    gDrawLine(graph,lX+3,lY,lX+23,lY)
                end if
            end if
            gSetAttribute(graph,`FGCLR`,TG_BLACK)
            string txt = legend[d]
            gDrawText(graph,lx+2+lw,lY+1,txt,align:=TG_W)
            ly += lh
        end if
    end for

    gSetAttribute(graph,`BGCLR`,bgclr)
end procedure

local function tg_set_graph_attribute(gdx id, string name, object v, integer nFrames)
    integer gxdx = find(name,grph_attr_names)
    if gxdx then
        -- aside: common up by type, but feel free to do  
        -- anything that needs special treatment by name
        integer vtype = grph_attr_types[gxdx]
        if vtype='B' then
            v = tg_to_bool(v,nFrames+2)
        elsif vtype='C' then
            v = tg_get_colour_value(v)
            assert(atom(v))
        elsif vtype='I' then
            if string(v) and is_integer(v) then
                v = to_integer(v)
            else
                assert(integer(v),nFrames:=nFrames+2)
            end if
        elsif vtype='N' then
            if string(v) then v = to_number(v) end if
            assert(atom(v),nFrames:=nFrames+2) -- (fail if `` yields {})
        elsif vtype='S' then
            assert(string(v))
        elsif name=`LEGENDXY` then
            if string(v) then v = tg_intint(v,name,nFrames+2) end if
            assert(sequence(v) and not string(v) and length(v)=2)
        elsif vtype='P' then
            assert(sequence(v))
        elsif vtype!='O' then
            ?9/0
        end if
        ctrl_xtra[id][gxdx] = v
        return true
    end if
    return false
end function

function tg_get_graph_attribute(gdx id, string name, integer nFrames)
    integer gxdx = find(name,grph_attr_names)
    if gxdx then
        return ctrl_xtra[id][gxdx]
    end if
    tg_bad_attr(id,name,nFrames+1)
end function

global function gGraph(rtn data, string attributes=``, sequence args={})
    gdx graph = gCanvas(tg_redraw_graph,nFrames:=2)
    ctrl_types[graph] = GRAPH
    ctrl_set_attr[GRAPH] = tg_set_graph_attribute
    ctrl_get_attr[GRAPH] = tg_get_graph_attribute
    tg_register_handler(GRAPH,`DATA`,{`F`,`FO`,`FII`,`FOII`})
    tg_register_handler(GRAPH,`XRID`,{`FI`})
    tg_register_handler(GRAPH,`YRID`,{`FI`})
    gSetHandler(graph,`DATA`,data)
    object grattrbs = repeat(0,GX_LEN)
    grattrbs[GX_GRID] = true        -- (show the grid by default)
    grattrbs[GX_GRIDCLR] = TG_GREY
    grattrbs[GX_GTITLE] = ``
    grattrbs[GX_XNAME] = ``
    grattrbs[GX_YNAME] = ``
    grattrbs[GX_LEGEND] = ``
    grattrbs[GX_LEGENDBOX] = true   -- (ditto box around legend)
    grattrbs[GX_LEGENDPOS] = `TR`
    grattrbs[GX_MODE] = ``
    grattrbs[GX_BARMODE] = ``
    grattrbs[GX_MARKSTYLE] = ``
    grattrbs[GX_MARKSIZE] = 3
    grattrbs[GX_XMARGIN] = 10
    grattrbs[GX_YMARGIN] = 10
    grattrbs[GX_XTICK] = 1
    grattrbs[GX_YTICK] = 1
    grattrbs[GX_XTICKFMT] = `%g`
    grattrbs[GX_YTICKFMT] = `%g`
    ctrl_xtra[graph] = grattrbs
    grattrbs = 0 -- (kill refcount)
    gSetAttribute(graph,`BGCLR`,TG_WHITE)
    if length(attributes) then
        gSetAttributes(graph,attributes,args,2)
    end if
    return graph    
end function

local procedure tg_lbl_redraw(gdx lbl, integer w, h)
    string title = gGetAttribute(lbl,`TITLE`)
    bool bActive = gGetAttribute(lbl,`ACTIVE`),
         bML = find('\n',title) -- multi-line
    atom fgclr = gGetAttribute(lbl,`FGCLR`)
    if not bActive then fgclr = gGreyscale(fgclr,true) end if
    integer {nw,nh} = gGetAttribute(lbl,`SIZE`),
            {tw,th} = gGetTextExtent(title,lbl),
            align = iff(bML?TG_SE:ctrl_xtra[lbl][CXLBL_ALIGN]),
            tx = iff(align==TG_E or align==TG_SE?0:
                 iff(align==TG_C?floor(nw/2):
                 iff(align==TG_W?nw:9/0))),
--          ty = ceil(iff(align=TG_SE?(nh-th):th)/2)
            ty = ceil(iff(align=TG_SE?(nh-th):nh)/2)
    gDrawText(lbl,tx,ty,title,{},align,colour:=fgclr)
end procedure   

global function gLabel(object title=NULL, sequence attributes="", args={})
    integer align = TG_E
    if sequence(title) and not string(title) then {title,align} = title end if
    {title,attributes,args} = paranormalise_taa(title,attributes,args)
    gdx lbl = gCanvas(tg_lbl_redraw,nFrames:=2)
    ctrl_types[lbl] = LABEL
    object lbl_attr = repeat(0,CXLBL_LEN)
    lbl_attr[CXLBL_ALIGN] = align
    ctrl_xtra[lbl] = lbl_attr
    lbl_attr = 0
    gSetAttribute(lbl,"EXPAND",false) -- (or maybe horiz?) [nah, docs say default is NONE]
    gSetAttribute(lbl,`TITLE`,title)
    if length(attributes) then
        gSetAttributes(lbl,attributes,args,2)
    end if
    return lbl
end function

