local procedure tg_scrollbar_timer_action(gdx canvas)
    -- for when a mouse button is pressed and held down on a scrollbar:
    object sbinfo = ctrl_sbinfo[canvas]
    if sequence(sbinfo) then
        string clikmon = sbinfo[SB_CKMON]
        integer k = find(clikmon,TMON), 
               ox = sbinfo[SB_ORIGX], 
               oy = sbinfo[SB_ORIGY]
        sbinfo = NULL -- (kill refcount)
        if k then
            bool bCtrl = TCTRL[k],
                 bShift = tg_get_shiftkey(), -- == gGetGlobal(`SHIFTKEY`)
                 bAlt = tg_get_altkey() -- == gGetGlobal(`ALTKEY`)
            {} = tg_scrollbar_key_handler(canvas,TKEY[k],bCtrl,bShift,bAlt)
        end if
        gdx timer = ctrl_sbinfo[canvas][SB_TIMER]
        if  ox==ctrl_sbinfo[canvas][SB_ORIGX]
        and oy==ctrl_sbinfo[canvas][SB_ORIGY] then  -- no change
            gSetAttribute(timer,`RUN`,false) -- switch off
        elsif timer then
            gSetAttribute(timer,`TIME`,100)
        end if
    end if
end procedure

local procedure tg_mousewheel(gdx id, integer direction, bool ctrl, shift, alt)
    -- GTK and WinAPI part
    integer ct = ctrl_types[id]
    if and_bits(ctrl_flags[id],CF_SCROLLBARS) then
        integer key = iff(ctrl?iff(direction=-1?VK_RIGHT:VK_LEFT)
                              :iff(direction=-1?VK_DOWN:VK_UP))
        if ct=LIST then shift = not shift end if
        {} = tg_scrollbar_key_handler(id,key,false,shift,alt)
    end if
--  do
        integer mw_handler = gGetHandler(id,`MOUSEWHEEL`)
        if mw_handler then
            string sig = tg_get_sig(mw_handler)
            integer l = length(sig)-1
            sequence args = {id,direction,ctrl,shift,alt}[1..l]
            -- sigs of `POI`,`PON`,`POII`,`POIII`,`POIIII`:
            call_proc(mw_handler,args)
        end if
-- maybe, maybe not... (MOUSEWHEEL is now leaf-only)
--      id = gGetParent(id)
--  until id=NULL
end procedure

local sequence radio_sets = {},
           radio_selected = {}

local procedure tg_chk_key(gdx chk, integer c)
    if c=' ' and gGetAttribute(chk,`ACTIVE`) then
        bool bState = true
        integer radio = ctrl_xtra[chk][CXCHK_RADIO]
        if radio then
            gdx prv = radio_selected[radio]
            ctrl_xtra[prv][CXCHK_VALUE] = false
            ctrl_xtra[chk][CXCHK_VALUE] = true
            radio_selected[radio] = chk
        else
            bState = not ctrl_xtra[chk][CXCHK_VALUE]
            ctrl_xtra[chk][CXCHK_VALUE] = bState
        end if
        gRedraw(gGetDialog(chk))
        integer value_changed = gGetHandler(chk,`VALUE_CHANGED`)
        if value_changed then
            string sig = tg_get_sig(value_changed)
            if sig=`P` then
                value_changed()
            elsif sig=`PO` then
                if radio then
                    value_changed(chk)
                else
                    value_changed(bState)
                end if
            elsif sig=`PI` then
                assert(not radio)
                value_changed(bState)
            elsif sig=`POI` then
                value_changed(chk,bState)
            else
                ?9/0
            end if
        end if
    end if
end procedure

local function tg_tabs_get_tabset(gdx tabs)
    object tabset = ctrl_xtra[tabs][CXTAB_ITEMS]
    if integer(tabset) then
        string sig = tg_get_sig(tabset)
        if sig="FO" then
            tabset = tabset(tabs)
        elsif sig="F" then
            tabset = tabset()
        else
            ?9/0
        end if
    end if
    return tabset
end function

local function tg_tab_change(gdx tabs, integer old_posn,tdx)
    rtn tabchanged = gGetHandler(tabs,`TABCHANGED`)
    if tabchanged then
        string sig = get_routine_info(tabchanged,false)[3]
        if sig=`POII` then
            tabchanged(tabs,old_posn,tdx)
        elsif sig=`PII` then
            tabchanged(old_posn,tdx)
        else
            ?9/0
        end if
        return true
    end if
    return false
end function

local function tg_has_mnemonic(string title, integer key)
    bool bAmp = false
    for ch in title do
        if bAmp then
            if upper(ch)=key then return true end if
            bAmp = false
        else
            bAmp = ch='&'
        end if
    end for
    return false
end function

local function tg_process_mnemonics(gdx id, integer key)
    -- recursive function to process alt-key mnemonics
    object children = children_ids[id]
    if sequence(children) then
        for child in children do
            if tg_process_mnemonics(child,key) then
                return true
            end if
        end for
    elsif gGetAttribute(id,`ACTIVE`)
      and gGetAttribute(id,`VISIBLE`) then
        integer ct = ctrl_types[id]
        if ct=MENU then
            for i,t in ctrl_xtra[id][CX_MENUS][1][MX_ITEMS] do
                if tg_has_mnemonic(t[MX_TEXT],key) then
                    tg_menubar_showtop(id,i)
                    tg_call_menu_handler(id,1,i,false,false)
                    return true
                end if
            end for
        elsif ct=TABS then
            for tdx,t in tg_tabs_get_tabset(id) do
                if not string(t) then t = t[1] end if
                if tg_has_mnemonic(t,key) then
                    integer firsttab = ctrl_xtra[id][CXTAB_1ST],
                            old_posn = ctrl_xtra[id][CXTAB_SEL]
                    if old_posn!=tdx then
                        ctrl_xtra[id][CXTAB_SEL] = tdx
                        ctrl_xtra[id][CXTAB_BUMP] = true
                        if tdx<firsttab then
                            ctrl_xtra[id][CXTAB_1ST] = tdx
                        end if
                        gRedraw(id)
                        {} = tg_tab_change(id,old_posn,tdx)
                    end if
                    return true
                end if
            end for
        elsif string(ctrl_titles[id])
          and tg_has_mnemonic(ctrl_titles[id],key) then
            if ct=BUTTON then
                {} = tg_button_clicked(id)
            elsif ct=CHECKBOX then
                gSetFocus(id)
                tg_chk_key(id,' ')
            else
                ?{"found!",id,ctrl_names[ct]}
            end if
            return true
        end if
    end if
    return false
end function

local function tg_key_handler(gdx dlg, integer key, bool ctrl, shift, alt, bUp)
--printf(1,"tg_key_handler(%s, ctrl:%t, shift:%t, alt:%t, bUp:%t\n",{gGetKeyName(key),ctrl,shift,alt,bUp})
    -- GTK and WinAPI part
    -- returns true if the key was handled / should not be propagated
    shiftkey = shift    -- keep for gGetGlobal
    ctrlkey = ctrl      -- ""
    altkey = alt
    assert(ctrl_types[dlg]=DIALOG)
    if key=VK_LALT and not bUp then
        bMenuNorm = not bMenuNorm
        gRedraw(dlg)
    end if
    integer id = gGetFocus()
    if id=0 then id = dlg end if
    gdx menu = ctrl_xtra[dlg][DX_ACTIVEPOP]
    if alt and not menu and key>='A'
    and tg_process_mnemonics(dlg,upper(key)) then
        return true
    end if
    integer {kid,khandler} = gGetInheritedHandler(id,`KEY`)
--?{"tg_key",kid,khandler}
--  integer res = TG_DEFAULT
    integer res = TG_CONTINUE
    if khandler and gGetAttribute(kid,`ACTIVE`) then
        do
            string sig = tg_get_sig(khandler)
--/*
            if sig=`FOIIIII` then
                res = khandler(kid,key,ctrl,shift,alt,bUp)
            elsif not bUp then
                if sig=`FOIIII` then
                    res = khandler(kid,key,ctrl,shift,alt)
                elsif (not alt) then
                    if sig=`FOIII` then
                        res = khandler(kid,key,ctrl,shift)
                    elsif (not shift)
                       or (key>=#21 and key<=#7E)
                       or key=VK_POUND then
                        if sig=`FOII` then
                            res = khandler(kid,key,ctrl)
                        elsif (not ctrl) then
                            if sig=`FOI` then
                                res = khandler(kid,key)
                            else
                                ?9/0 -- unknown sig...
                            end if
                        end if
                    end if
                end if
            end if
---*/
            integer l = length(sig)-1
            if (l>5 or not bUp) 
            and (l>4 or not alt) 
            and (l>3 or not shift or (key>=#21 and key<=#7E) or key=VK_POUND)
            and (l>2 or not ctrl) then
                sequence args = {kid,key,ctrl,shift,alt,bUp}[1..l]
                if sig[1]='F' then
                    res = call_func(khandler,args)
                else
                    call_proc(khandler,args)
                end if
            end if
--?{kid,res}
            if alt and res!=TG_CONTINUE and res!=TG_CLOSE
            and length(sig)>=6 and not bUp then
                -- stop handled alt keys belling (u/h still shd):
                return res
            end if
--          if res=TG_IGNORE
--          or (res=TG_DEFAULT and not find(key,{VK_ESC,VK_F5,VK_TAB})) then
            if res=TG_IGNORE then
                return true
            end if
            if ctrl_types[kid]=DIALOG then exit end if
            do
                kid = gGetParent(kid)
                khandler = gGetHandler(kid,`KEY`)
            until khandler!=NULL or ctrl_types[kid]=DIALOG
--  {kid,khandler} = gGetInheritedHandler(gGetParent(kid),`KEY`)
--?{"r2",kid,khandler}
--sleep(1)
        until khandler=NULL
    end if
    if and_bits(ctrl_flags[id],CF_SCROLLBARS)
    and gGetAttribute(id,`ACTIVE`) then
        {} = tg_scrollbar_key_handler(id,key,ctrl,shift,alt)
    end if
    if not (ctrl or shift or alt) then
--      if res=TG_DEFAULT then
        if res=TG_DEFAULT
        or res=TG_CONTINUE then
            integer def = NULL
            if key=VK_CR then
                def = gGetAttribute(dlg,`DEFAULTENTER`)
            elsif key=VK_ESC then
                def = gGetAttribute(dlg,`DEFAULTESC`)
            end if
            if def<0 then -- (TG_CLOSE or TG_IGNORE)
                res = def
            elsif def>0 then -- (a gdx)
                assert(ctrl_types[def]=BUTTON)
                return tg_button_clicked(def)
            end if
        end if
        if menu and key=VK_ESC then
--      if menu and key=VK_ESC and not bUp then
            integer ct = ctrl_types[id]
            if ct=MENU then
                integer mdx = tg_menu_visible(menu,1,true)
                tg_hide_one_menu(menu,mdx,true)
            else
                tg_hide(menu)
            end if
            return true
        end if
-- 23/12/25 (fixes esc closing both windows in hDialogs.exw)
--      bool bClose = key=VK_ESC and and_bits(CF_CLOSE_ON_ESC,ctrl_flags[dlg])!=0
        bool bClose = key=VK_ESC and and_bits(CF_CLOSE_ON_ESC,ctrl_flags[dlg])!=0 and not bUp
        if bClose or res=TG_CLOSE then
            gHide(dlg)
            return true
        end if
    end if
-- added 15/8/26(!!!)
    if key=VK_F4 and alt then
        gHide(dlg)
        return true
    end if
    return false
end function

