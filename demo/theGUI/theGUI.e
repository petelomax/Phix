local procedure tg_copy_image(gdm src, tgt, integer x, y)
    -- simplified version of gDrawImage for image->image using copy (w/o any transparency)
    integer sdx = (-src+1)/2,
            tdx = (-tgt+1)/2
    atom hSrc = gimages[sdx][TG_IMG_HANDLE],
         hTgt = gimages[tdx][TG_IMG_HANDLE]
    -- clip w,h to tgt boundaries
    integer w = min(gimages[sdx][TG_IMG_WIDTH],gimages[tdx][TG_IMG_WIDTH]-x),
            h = min(gimages[sdx][TG_IMG_HEIGHT],gimages[tdx][TG_IMG_HEIGHT]-y)
    if w>0 and h>0 then
        if backend=TG_GTK then
            c_proc(x_gdk_pixbuf_copy_area,{hSrc,0,0,w,h,hTgt,x,y})
        elsif backend=TG_WINAPI then
            atom dstDC = tg_WinAPI_GetDestDC(),
                 srcDC = tg_WinAPI_GetSrcDC(),
                  pdBM = c_func(xSelectObject,{dstDC,hTgt}),
                prevBM = c_func(xSelectObject,{srcDC,hSrc})
            c_funk(xBitBlt,{dstDC,x,y,w,h,srcDC,0,0,SRCCOPY})
            prevBM = c_func(xSelectObject,{srcDC,prevBM})
            pdBM = c_func(xSelectObject,{dstDC,pdBM})
        elsif backend=TG_JS then    
            #ilJS{
                crash(`JS (tg_copy_image)`);
            #}ilJS
        else
            ?9/0 -- (unknown backend)
        end if
    end if
end procedure

local procedure tg_gtk_set_image_pen(atom cairo, pencolour, integer penwidth, object penstyle)
    c_proc(x_cairo_set_line_width,{cairo,penwidth})
    if penstyle=TG_CONTINUOUS then
        c_proc(x_cairo_set_dash,{cairo,0,0,0})
    else
        sequence dashes
        if sequence(penstyle) then
            dashes = {}
            integer prev = penstyle[1], c = 1
            for dot in penstyle from 2 do
                if dot!=prev then
                    dashes &= c
                    c = 1
                    prev = dot
                else
                    c += 1
                end if
            end for
            dashes &= c
        else
            dashes = {{6,2},{1,1},{6,2,2,2},{6,2,2,2,2,2}}[penstyle-1]
        end if
        atom pDash = tg_double_array(dashes)
        c_proc(x_cairo_set_dash,{cairo,pDash,length(dashes),0})
        free(pDash)
--DEV probably better to switch this on/off as needed, as tg_gtk_rect now does
        -- (assumes we are drawing a line!)
        if not bGTK3 then
            c_proc(x_cairo_set_antialias,{cairo, CAIRO_ANTIALIAS_NONE})
        end if
    end if
    atom {r,g,b} = to_rgba(pencolour)
    c_proc(x_cairo_set_source_rgb,{cairo,r/255,g/255,b/255})
end procedure

