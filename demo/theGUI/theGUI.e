local function tg_gtk_gslist_to_strings(atom pList)
    -- Convert GSList* result from (eg) gtk_file_chooser_get_filenames() to a sequence of strings
    sequence files = {}
    atom node = pList

    while node!=NULL do
        -- GSList struct is [data, next]
        atom data = peekns(node)      -- gchar* filename
        files = append(files, peek_string(data))
        -- Free the gchar* (the API docs say caller owns them)
        c_proc(x_g_free,{data})
        node = peekns(node+machine_word())
    end while

    -- Free the GSList nodes themselves
    c_proc(x_g_slist_free,{pList})

    return files
end function

global procedure gOpenFile(gdx parent, rtn got, object arg2=NULL, folder=NULL, filters=NULL, title=NULL, bool bMulti=false)
    if bMulti=false then  -- (some micro-paranormalisation:)
        if title==true then
            {title,bMulti} = {NULL,true}
        elsif title==NULL 
          and filters==true then
            {filters,title,bMulti} = {NULL,NULL,true}
        elsif title==NULL 
          and filters==NULL
          and folder==true then
            {folder,filters,title,bMulti} = {NULL,NULL,NULL,true}
        end if
    end if
--  atom win = iff(parent?ctrl_handles[parent]:NULL)
    atom win = ctrl_handles[parent]
    if backend=TG_GTK then
        nnatom file_dialog = c_func(x_gtk_file_chooser_dialog_new,
                                    {title,win,
                                     GTK_FILE_CHOOSER_ACTION_OPEN,
                                     `_Cancel`, GTK_RESPONSE_CANCEL,
                                     `_Open`, GTK_RESPONSE_ACCEPT,
                                     NULL,NULL})
        if folder!=NULL then
            {} = c_func(x_gtk_file_chooser_set_current_folder,{file_dialog,folder})
        end if
        if filters!=NULL then
            for f in filters do
                string {friendly_name, pattern} = f
                nnatom fltr = c_func(x_gtk_file_filter_new,{})
                c_proc(x_gtk_file_filter_add_pattern,{fltr,pattern})
                c_proc(x_gtk_file_filter_set_name,{fltr,friendly_name})
                c_proc(x_gtk_file_chooser_add_filter,{file_dialog,fltr})
            end for
        end if
        c_proc(x_gtk_file_chooser_set_select_multiple,{file_dialog,bMulti})
        sequence filename
        bool bOK = c_func(x_gtk_dialog_run,{file_dialog})==GTK_RESPONSE_ACCEPT
        if bOK then
            integer fn = iff(bMulti?x_gtk_file_chooser_get_filenames
                                   :x_gtk_file_chooser_get_filename)
            atom pRes = c_func(fn,{file_dialog})
            if bMulti then
                filename = tg_gtk_gslist_to_strings(pRes)
            else
                filename = peek_string(pRes)
                c_proc(x_g_free,{pRes})
            end if
        end if
        c_proc(x_gtk_widget_destroy,{file_dialog})
        if bOK then
            got(filename,arg2)
        end if
    elsif backend=TG_WINAPI then
        -- (see builtins\fileopenN.exw [note phix.chm documents 
        --  gOpenFile() //rather than// newGetOpenFileName()!])
        if folder!=NULL then folder={folder} end if -- (do the more aggressive override)    
        object ext = iff(bMulti?{1,0,FOS_ALLOWMULTISELECT}:NULL),
               res = newGetOpenFileName(win,filters,ext,folder,title:=title) 
        if res!=NULL then
            if not (bMulti or string(res)) then
                assert(length(res)=2)
--              ?{`Encoding`,res[1]}
                res = res[2]        
                assert(string(res))
            end if
            got(res,arg2)
        end if
    elsif backend=TG_JS then
        #ilJS{
            let hidden_input = gOpenFile.hidden_input;
            if (!hidden_input) {
                hidden_input = document.createElement("input");
                hidden_input.type = "file";
                hidden_input.style.display = "none"; // Hide it
                function changeHandler(e) { // private
//                  previewFile(e.target.files[0]);
                    let got = hidden_input.got,
                        arg2 = hidden_input.arg2,
                        multi = hidden_input.bMulti,
                        filenames;
                    if (multi) {
                        // quickly convert to a 1-based sequence:
                        //  (noting elements are still opaque)
                        let l = e.target.files.length;
                        filenames = repeat(0,l);
                        for (let i = 0; i < l; i += 1) { 
                            filenames[i+1] = e.target.files[i];
                        }
                    } else {
                        filenames = e.target.files[0];
                    }
                    got(filenames,arg2);
                }
                hidden_input.addEventListener("change", changeHandler);
//DEV what does this actually achieve?? (not alot, it seems!)
//              function clickHandler() { // private
//                  hidden_input.value = null;
//              }
//              hidden_input.addEventListener('click', clickHandler);
                document.body.appendChild(hidden_input);
                gOpenFile.hidden_input = hidden_input;
            }

// Original Phix code (not stored anywhere else, now includes two post-xlate "/"&"*"):
//  with javascript_semantics
//  function convert_filters(object filters=NULL)
//      if filters!=NULL and not string(filters) then
//          sequence res = {}
//          for f in filters do
//              string {friendly,spec} = f
//              friendly = lower(friendly)
//              if spec!="*.*" then
//                  for mime_type in {"audio","video","image"} do
//                      if match(mime_type,friendly) then
//                          mime_type &= "/"&"*"
//                          if not find(mime_type,res) then
//                              res &= {mime_type}
//                          end if
//                          spec = ""
//                          exit
//                      end if
//                  end for
//                  for ext in split(spec,';') do
//                      ext = trim(ext)
//                      assert(begins("*.",ext))
//                      ext = ext[2..$]
//                      if not find(ext,res) then
//                          res &= {ext}
//                      end if
//                  end for
//              end if
//          end for
//          filters = join(res,",")
//      end if
//      return filters
//  end function
//  asserteq(convert_filters(),0)
//  asserteq(convert_filters({}),"")
//  asserteq(convert_filters({{"Text Document (*.txt)","*.txt"}, 
//                            {"All Documents (*.*)","*.*"} }),
//           ".txt")
//  asserteq(convert_filters({{"szJPG","*.jpg;*.jpeg"}}),".jpg,.jpeg")
//  asserteq(convert_filters({{"szJPG","*.jpg;*.jpeg"},
//                            {"szBMP","*.bmp"},
//                            {"szAll","*.*"}}),
//           ".jpg,.jpeg,.bmp")              
//  asserteq(convert_filters({{"IMAGES","*.jpg;*.jpeg"},
//                            {"bitmap image","*.bmp"},
//                            {"szAll","*.*" }}),
//           "image/"&"*")

            function convert_filters(/*object*/ filters=NULL) { // private
                if ((!equal(filters,NULL)) && !string(filters)) {
                    let /*sequence*/ res = ["sequence"],
                                       l = length(filters);
                    for (let i = 1; i <= l; i += 1) { 
                        let f = $subse(filters,i);
                        let /*string*/ [,friendly,spec] = f;
                        friendly = lower(friendly);
                        if (spec!=="*.*") {
                            let mime_types = ["sequence","audio","video","image"];
                            for (let mi = 1; mi <= 3; mi += 1) { 
                                let mime_type = $subse(mime_types,mi);
                                if (match(mime_type,friendly)) {
                                    mime_type = $conCat(mime_type, "/"+"*", false);
                                    if (!find(mime_type,res)) {
                                        res = $conCat(res, ["sequence",mime_type], false);
                                    }
                                    spec = "";
                                    break;
                                }
                            }
                            let se = split(spec,0X3B), -- ';'
                                sl = length(se)
                            for (let ei = 1; ei <= sl; ei += 1) { 
                                let ext = trim($subse(se,ei));
                                assert(begins("*.",ext));
                                ext = $subss(ext,2,-1);
                                if (!find(ext,res)) {
                                    res = $conCat(res, ["sequence",ext], false);
                                }
                            }
                        }
                    }
                    filters = join(res,",");
                }
                return filters;
            }

            if ((!equal(filters,NULL)) && !string(filters)) {
                filters = convert_filters(filters);
            }
            hidden_input.accept = filters;
            if (bMulti) {
                hidden_input.setAttribute("multiple", "");
            } else {
                hidden_input.removeAttribute("multiple");
            }
            hidden_input.got = got;
            hidden_input.arg2 = arg2;
            hidden_input.bMulti = bMulti;
            hidden_input.click();
        #}ilJS
    else
        ?9/0
    end if
