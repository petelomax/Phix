--
-- demo\theGUI\gBox.exw
-- ====================
-- 
-- simple version, for some size testing
--
--requires(64,true)
with javascript_semantics
include theGUI.e

gdx cv1 = gCanvas("SIZE=55x90"), 
    cv2 = gCanvas("SIZE=135x90"), 
    box = gHbox({cv1,cv2}),
    dlg = gDialog(box,`edge`,`SIZE = 212x142`)
gSetAttribute(box,"MARGIN","10")
gMainLoop(dlg)

