--
-- gClip.exw
-- =========
--
--  change focus... gGet/SetGlobal(CLIPIMG/TXT[?])... theGUI.fileio.e??
--  gCanvas/gList, only one of which is visible, with different [default] sizes/
--  gList has Strip Html/Fix qpe/Hex View/Update Clipboard buttons beneath it.
--  focus in/out of main window...
--  support drag/drop of img/text file onto the main window...
--
include theGUI.e
--gUseGTK()
gdn img = gGetGlobal(`CLIPIMG`)

procedure redraw(gdx canvas, integer w, h)
    if img then
        gDrawImage(img,canvas,10,10)
    else
        gDrawText(canvas,w/2,h/2,"no image",{},TG_C)
    end if
end procedure

procedure click(gdx canvas, sequence status)
    if img and begins("LR",status) then
        integer {w,h} = gGetAttribute(img,`SIZE`)
        sequence corners = {gGetPixel(img,0,0),
                            gGetPixel(img,w-1,0),
                            gGetPixel(img,0,h-1),
                            gGetPixel(img,w-1,h-1)}
--?corners
        bool all_white = unique(corners)={TG_WHITE}
        integer clr = iff(all_white?TG_BLACK:TG_WHITE)
        --
        --                             *****    
        --                             ***
        -- patch the four corners in a **    pattern:
        --                             *
        --                             *
        --  
        for i,n in {5,3,2,1,1} do
            for j=1 to n do
                gDrawPixel(img,j-1,i-1,clr)
                gDrawPixel(img,w-j,i-1,clr)
                gDrawPixel(img,j-1,h-i,clr)
                gDrawPixel(img,w-j,h-i,clr)
            end for
        end for
--/*
atom t1 = time()+1, n = 0
while time()<t1 do
--  gDrawPixel(img,0,0,clr) -- 3.5m/s
    {} = gGetPixel(img,0,0) -- 3.2m/s
    n += 1
end while
?{"pps:",n}
--*/
        gSetGlobal(`CLIPIMG`,img)
        gRedraw(canvas)
    end if
end procedure


gdx canvas = gCanvas(redraw,"BGCLR=LIGHT_PARCHMENT"),
    dialog = gDialog(canvas,`gClip`,`SIZE=240x80`)
    if img then
        integer {w,h} = gGetAttribute(img,`SIZE`)
        gSetAttribute(canvas,`SIZE`,{w+20,h+20})
    end if
    gSetHandler(canvas,`CLICK`,click)
--gSetAttribute(dialog,"MINSIZE",{230,70}) -- all good
--gSetAttribute(dialog,"MAXSIZE",{250,90})  --  """
--gSetAttribute(canvas,"SIZE",{200,200})      --  ... no scrolbars yet ... [DEV]
--gSetAttribute(canvas,"SCROLLSIZE",{400,400})  --  ...
--?gGetTextExtent(txt,canvas)
--?gGetTextExtent(txt,cut_xpm)
--?gVersion()
gMainLoop(dialog)

