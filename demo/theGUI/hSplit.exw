--/!*
procedure canvas_number(gdx canvas, integer w,h)
    gDrawRect(canvas,1,1,w-2,h-2)
    integer cid = gGetInt(canvas,`USER_DATA`)
    gDrawText(canvas,w/2,h/2,`%d`,{cid},TG_C)
end procedure

gdx c1 = gCanvas(canvas_number,`USER_DATA=1`),
    c2 = gCanvas(canvas_number,`USER_DATA=2`), 
    c3 = gCanvas(canvas_number,`USER_DATA=3`),
    vs = hSplit(c2,c3,`VERTICAL`),
    hs = hSplit(c1,vs,`HORIZONTAL`),
    dlg = gDialog(hs,`gSplit`,`SIZE=240x80`)
gSetAttributes({c1,c2,c3},`BGCLR=PARCHMENT,FGCLR=OLIVE`)
gMainLoop(dlg)
--*!/

