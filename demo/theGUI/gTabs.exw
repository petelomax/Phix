constant xpm_txt = `
16 16 3 1
+ c None
. c #000000
# c #FF0000
++++++++++++++++
++++++++++++++++
++++++++++++++++
++++++###.++++++
++++#####.++++++
++#######.++++++
++#######.++++++
++++#####.++++++
++++++###.++++++
+++++++...++++++
+++++++...++++++
+++++++...++++++
++++++......++++
++++.........+++
++++++++++++++++
++++++++++++++++
`
constant xpm = gImage_from_XPM(xpm_txt)

--gdx tabs = gTabs({`First`,`Second`,`Third`,`Fourth`}, `SIZE=225x23`),

--procedure tabchange(gdx id, integer old_posn, new_posn)
procedure tabchange(integer old_posn, new_posn)
--  ?{`tabchange`, id, old_posn, new_posn}
    ?{`tabchange`, old_posn, new_posn}
end procedure

--sequence tablist = {{`&First`,xpm},`Second`,`Third`,`Fourth`}
sequence tablist = {{`&First`,xpm},`&Second`,`&Third`,`Fou&rth`,`Fift&h`,`Si&xth`,`Se&venth`,`&Eighth`}
--sequence tablist = {{`First`,xpm,TG_GREEN,TG_RED,TG_ITALIC},{`Second`,`YELLOW`,#0000FF,TG_BOLD},`Third`,`Fourth`,`Fifth`,`Sixth`,`Seventh`,`Eighth`}

