constant backend = gVersion(-1),
         backver = gVersion(-2),
         bGTK2 = backend=TG_GTK and backver=2,
         bGTK3 = backend=TG_GTK and backver=3 

--/*
local constant text_attrs = {{ CXTEXT_CARETCLR:=$,'n',`[CARETCLR]`  }, -- (internal) TG_BLACK|WHITE for blinking
                             {  CXTEXT_CARETCT:=$,'i',`[CARETCT]`   }, -- (internal) blink six times then stop (if zero activity)
                             { CXTEXT_CARETIME:=$,'n',`[CARETIME]`  }, -- (internal) time()+0.5 to next blink on/off
                             {CXTEXT_CARETIMER:=$,'i',`[CARETIMER]` }, -- (internal) the gTimer() used for blinking
                             { CXTEXT_CARETPOS:=$,'i',`[CARETPOS]`  }, -- (internal) cursor position (initially 1)
                             {CXTEXT_CHARSFROM:=$,'i',`[CHARSFROM]` }, -- (internal) VALUE[i] is the first char being shown
                             {    CXTEXT_LASTW:=$,'i',`[LASTW]`     }, -- (internal) last width, for bumping cfrom
                             { CXTEXT_HADFOCUS:=$,'b',`[HADFOCUS]`  }, -- (internal) restart caret timer
                             { CXTEXT_SELSTART:=$,'i',`[SELSTART]`  }, -- (internal) selection start, or 0 if none
                             {    CXTEXT_VALUE:=$,'S',`VALUE`       }, -- text
                             {CXTEXT_CUEBANNER:=$,'S',`CUEBANNER`   }, -- text to display when length(text)==0
                             {     CXTEXT_UNDO:=$,'p',`[UNDO]`      }, -- (internal) undo stack (initially NULL)
                             {  CXTEXT_UNDOPOS:=$,'i',`[UNDOPOS]`   }, -- (internal) idx<=length(undo stack)
                             {      CXTEXT_SDD:=$,'i',`[SDD]`       }, -- (internal) spin/datepick/dropdown extras
                             {      CXSPIN_HOV:=$,'i',`[SPIN_HOV]`  }}, -- (internal) 0/1/2 for none/up/down
                    CXTEXT_LEN = length(text_attrs)

-- logically, but easier just to code {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD]:
--local enum -- ctrl_xtra[spin][CXTEXT_SDD] for SPIN:
--   CXSPIN_LO,         -- int <= hi
--   CXSPIN_HI,         -- int >= lo
--   CXSPIN_STEP,       -- int >= 1 (or same sign as hi-lo? or just suckitandsee?)
--   CXSPIN_WRAP,       -- t/f              (may work for +ve step only, "")    

--*/

local enum TEXT, SPIN, DATEPICK, DROPDOWN -- ""

-- contents of ctrl_xtra[text]:
enum CXTEXT_CARETCLR,
     CXTEXT_CARETCT,
     CXTEXT_CARETIME,
     CXTEXT_CARETIMER,
     CXTEXT_CARETPOS,
     CXTEXT_CHARSFROM,
     CXTEXT_LASTW,
     CXTEXT_HADFOCUS,
     CXTEXT_SELSTART,
     CXTEXT_VALUE,
     CXTEXT_CUEBANNER,
     CXTEXT_UNDO,
     CXTEXT_UNDOPOS,
     CXTEXT_SDD,        -- {lo,hi,step,wrap}, {calendar}, {list}
     CXSPIN_HOV,        -- 0/1/2 for none/up/down
     CXTEXT_VALUE_CHANGED, -- nb hText only, use gSetHandler in theGUI.e
     CXTEXT_LEN = $
sequence ctrl_xtra, ctrl_types

local function tg_nearest_cpos(gdx text, integer x)
    -- perform a binary chop to find the nearest cpos, taking cfrom into account
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM]
    if x<=5 then return cfrom end if
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)[cfrom..$]
    integer lo = 0,
            hi = length(utf32),
            lopos = 5,
--          hipos = 5 + gGetTextExtent32(utf32,text)[1]
            hipos = 5 + gGetTextExtent(utf32_to_utf8(utf32),text)[1]
    if x>=hipos then return cfrom+hi end if
    while hi>lo+1 do
        integer mid = floor((hi+lo)/2)
        -- may as well leave these in (never triggered for me)
        if mid<=lo then ?9/0 end if
        if mid>=hi then ?9/0 end if
--      integer midpos = 5 + gGetTextExtent32(utf32[1..mid],text)[1]
        integer midpos = 5 + gGetTextExtent(utf32_to_utf8(utf32[1..mid]),text)[1]
        if x<midpos then
            hi = mid
            hipos = midpos
        else
            lo = mid
            lopos = midpos
        end if
    end while
    -- aside: I was planning on nearest(hi,lo) here, but this seems fine:
    return cfrom+lo
end function

local function tg_gtext_prev_word_boundary(integer cpos, sequence utf32)
    cpos = max(cpos-1,1)
    while cpos>1 do
        if utf32[cpos-1]=' ' then
            exit
        end if
        cpos -= 1
    end while
    return cpos
end function

local function tg_gtext_next_word_boundary(integer cpos, len, sequence utf32)
    cpos = min(cpos+1,len+1)
    while cpos<=len do
        if utf32[cpos-1]=' '
        and utf32[cpos]!=' ' then
            exit
        end if
        cpos += 1
    end while
    return cpos
end function

local procedure tg_text_process_mouseclickmove(gdx text, integer d, x)
    --
    -- process mouse click/move:
    -- d is 'S' or 'D' for single./double click, 'M' for mousemove.
    -- 
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM],
             cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
         selstart = ctrl_xtra[text][CXTEXT_SELSTART],
        prev_cpos = cpos
    if backend=TG_GTK then
        if bGTK2 then x += 4 end if
        if bGTK3 then x -= 2 end if
    end if
    cpos = tg_nearest_cpos(text, x)
    if d='S' then
        bool shift = gGetGlobal(`SHIFTKEY`)
        if shift and selstart=0 then
            selstart = prev_cpos
        elsif selstart=0 or not shift then
            selstart = cpos
        end if
    elsif d='D' then
        selstart = tg_gtext_prev_word_boundary(cpos,utf32)
        cpos = tg_gtext_next_word_boundary(cpos,length(utf32),utf32)
    elsif d='M' then
        if x<=5 then
            if cfrom>1 then
                cfrom -= 1
                ctrl_xtra[text][CXTEXT_CHARSFROM] = cfrom
            end if
            cpos = cfrom
--      else
--          cpos = tg_nearest_cpos(text,x)
        end if
--      ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
    else
        ?9/0
    end if
    ctrl_xtra[text][CXTEXT_SELSTART] = selstart
    ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
end procedure

local atom date_pick_icon = NULL

local procedure tg_gtext_redraw(gdx text, integer w, h)
    string txt = ctrl_xtra[text][CXTEXT_VALUE], substr
    sequence utf32 = utf8_to_utf32(txt)
    bool unicode = length(txt)!=length(utf32),
           tType = ctrl_types[text]
    integer cfrom = ctrl_xtra[text][CXTEXT_CHARSFROM],
             cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
           last_w = ctrl_xtra[text][CXTEXT_LASTW],
         selstart = ctrl_xtra[text][CXTEXT_SELSTART],
              hov = ctrl_xtra[text][CXSPIN_HOV]
    ctrl_xtra[text][CXTEXT_LASTW] = w
    bool bHasFocus = (gGetFocus()==text), 
       bDrawCursor = false
    if backend==TG_GTK then
        if bGTK2 then
            gDrawLine(text,0,0,w-1,0,colour:=#9E9A91)
            gDrawLine(text,0,0,0,h-1,colour:=#9E9A91)
            gDrawLine(text,1,1,w-2,1,colour:=TG_BLACK)
            gDrawLine(text,1,1,1,h-2,colour:=TG_BLACK)
            gDrawLine(text,w-2,2,w-2,h-2,colour:=#DCDAD5)
            gDrawLine(text,2,h-2,w-2,h-2,colour:=#DCDAD5)
        elsif bGTK3 then
            gDrawRect(text,0,0,w-1,h-1,false,0,colour:=#E8E8E7,width:=1)

            if bHasFocus then
                gDrawRect(text,1,1,w-2,h-5,false,2,colour:=#4A90D9,width:=2)
            else
                gDrawRect(text,0,0,w-1,h-8,false,4,colour:=#808080,width:=1)
            end if
        end if
    elsif backend==TG_WINAPI then
        atom boxclr = iff(bHasFocus?#0078D4:#646464)
        gDrawRect(text,0,0,w-1,h-1,colour:=boxclr)
    else
        ?9/0
    end if
    integer x = floor(h/5), y = floor(h/2), tw, th
    if backend=TG_GTK then
        if bGTK2 then x -= 2 y += 1 end if
        if bGTK3 then x += 4 y += 1 end if
    end if

    -- ensure cpos on-screen, by adjusting cfrom as needed:
    integer l1 = length(iff(unicode?utf32:txt))+1
    cpos = min(cpos,l1)
    integer newfrom = min(iff(cfrom>=cpos?1:cfrom),l1)
    substr = iff(unicode?utf32_to_utf8(utf32[newfrom..cpos-1])
                                        :txt[newfrom..cpos-1])
    {tw,th} = gGetTextExtent(substr,text,bNorm:=true)
    integer maxw = w-6-(tType!=TEXT)*(h-6)
    if tw>=maxw then
        newfrom = max(1,cpos-floor((cpos-newfrom)*((w*2/3)/tw)))
        substr = iff(unicode?utf32_to_utf8(utf32[newfrom..cpos-1])
                                            :txt[newfrom..cpos-1])
        {tw,th} = gGetTextExtent(substr,text,bNorm:=true)

    elsif w>last_w and newfrom>1 then
        -- increase newfrom while txt[$] still visible
        while newfrom>1 do
            substr = iff(unicode?utf32_to_utf8(utf32[newfrom-1..$])
                                                :txt[newfrom-1..$])
            {tw,th} = gGetTextExtent(substr,text,bNorm:=true)
            if tw>=maxw then exit end if
            newfrom -= 1
        end while
    end if
    if newfrom!=cfrom then
        cfrom = newfrom
        ctrl_xtra[text][CXTEXT_CHARSFROM] = cfrom
    end if

    -- cursor:
    gdx cursorblinktimer = ctrl_xtra[text][CXTEXT_CARETIMER]
    -- Aside: GTK only shows cursor when no text selected, WinAPI always
--  if bHasFocus and ((not (bGTK2 or bGTK3)) or selstart=0 or selstart=cpos) then
    if bHasFocus then
        if not ctrl_xtra[text][CXTEXT_HADFOCUS] then
            ctrl_xtra[text][CXTEXT_CARETCT] = 6
            gSetAttribute(cursorblinktimer,`RUN`,true)
        end if
        if gGetAttribute(cursorblinktimer,`RUN`) then
            atom caretime = ctrl_xtra[text][CXTEXT_CARETIME],
                 caretclr = ctrl_xtra[text][CXTEXT_CARETCLR]
            if time()>=caretime then
--              caretclr = iff(caretclr=TG_BLACK?bgsel:TG_BLACK)
                caretclr = iff(caretclr=TG_BLACK?TG_WHITE:TG_BLACK)
                ctrl_xtra[text][CXTEXT_CARETCLR] = caretclr
                ctrl_xtra[text][CXTEXT_CARETIME] = time()+0.5
                if caretclr=TG_BLACK then
                    ctrl_xtra[text][CXTEXT_CARETCT] -= 1
                    if ctrl_xtra[text][CXTEXT_CARETCT]<=0 then
                        gSetAttribute(cursorblinktimer,`RUN`,false)
                    end if
                end if
            end if
            bDrawCursor = (caretclr=TG_BLACK)
        end if
    else
        gSetAttribute(cursorblinktimer,`RUN`,false)
    end if
    gCanvasClip(text,{1,1,maxw+5,h-1})
    if tType=SPIN then
        y += 1
    elsif tType=DATEPICK then
        y += 1
        x -= 1
    end if
    if selstart and bHasFocus then
        if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
        integer sx = x
        if selstart>cfrom then
            substr = iff(unicode?utf32_to_utf8(utf32[cfrom..selstart-1])
                                                :txt[cfrom..selstart-1])
            gDrawText(text,sx,y,substr)
            sx += gGetTextExtent(substr,text,bNorm:=true)[1]
            cfrom = selstart
        end if
        substr = iff(unicode?utf32_to_utf8(utf32[cfrom..cpos-1])
                                            :txt[cfrom..cpos-1])
        sequence selclr
        if backend==TG_GTK then
            if bGTK2 then
                selclr = {TG_WHITE,iff(bHasFocus?#4B6983:#9C9A94)}
            elsif bGTK3 then
                selclr = {#DBFFF2,#0078D7}
            else
                ?9/0
            end if
        elsif backend==TG_WINAPI then
            selclr = {#DBFFF2,#0078D7}
        else
            ?9/0 -- unknown backend
        end if
        gDrawText(text,sx,y,substr,colour:=selclr)
        if cpos<=length(txt) then
            sx += gGetTextExtent(substr,text,bNorm:=true)[1]
            substr = iff(unicode?utf32_to_utf8(utf32[cpos..$])
                                                :txt[cpos..$])
            gDrawText(text,sx,y,substr)
        end if
    else
        substr = iff(unicode?utf32_to_utf8(utf32[cfrom..$])
                                            :txt[cfrom..$])
        if length(substr)=0 then
            sequence cb = ctrl_xtra[text][CXTEXT_CUEBANNER]
            if string(cb) then
                gDrawText(text,x,y,cb,colour:=TG_GREY)
            else
                substr = cb[1]
                atom clr = cb[2]
                object style = iff(length(cb)=3?cb[3]:-1)
                gDrawText(text,x,y,substr,colour:=clr,style:=style)
            end if
        else
            gDrawText(text,x,y,substr)
        end if
    end if
    gCanvasClip(text,NULL)
    if tType=SPIN then
--DEV we should probably force a gSpin to have an odd height...
--    I also suspect a gText height should depend on FONT or an explicit SIZE, but not/refuse to expand heightwise.
        integer g = ceil(h/10),
                m = ceil(h/2),
                l = w-h+5,
                r = w-2
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        gDrawLine(text,l,r+1,m,r+1,colour:=#D2D2D2)
        if hov then 
            integer {t,b} = iff(hov=1?{1,m-1}:{m,h-2})
            gDrawRect(text,l,t,r,b,true,colour:=#D8E6F1)
            if hov=1 then t -= 1 end if
            gDrawRect(text,l,t,r+1,b+1,false,colour:=#0078D4)
        end if
        -- draw the up and down arrows themselves
        integer xl = w-m+2, la = 0, yb = h-g-1
        for yt=g+1 to m-g-1 do
            integer xr = xl+la+1, aclr = #505050
            gDrawLine(text,xl,yt,xr,yt,aclr)
            gDrawLine(text,xl,yb,xr,yb,aclr)
            xl -= 1
            la += 2
            yb -= 1
        end for
    elsif tType=DATEPICK then
        integer l = w-28
        if hov then -- DEV or drop-down visible
            gDrawRect(text,l,1,w-2,h-2,true,colour:=#D8E6F1)
        end if
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        if date_pick_icon=NULL then date_pick_icon = gGetGlobal("dp_xpm") end if
        -- "" is 22x14: (revisit this with a resizable datepick in v2..)
        gDrawImage(date_pick_icon,text,w-25,h/2-7)
    elsif tType=DROPDOWN then
        integer l = w-19
        if hov then -- DEV or drop-down visible
            gDrawRect(text,l,1,w-2,h-2,true,colour:=#D8E6F1)
        end if
        gDrawLine(text,l,1,l,h-1,#D2D2D2)
        for y=8 to 12 do
            gDrawLine(text,w+y-22,y,w-y+3,y,#505050)
        end for
    end if
    if bDrawCursor then
        if th=0 then th = gGetTextExtent("|",text)[2] end if
        integer cx = x+tw+1,
               hth = floor(th/2)
        if backend=TG_GTK then  
            if bGTK2 then cx += 1 end if
            if bGTK3 then cx -= 1 y -= 1 end if
        end if
        gDrawLine(text,cx,y-hth,cx,y+hth,TG_BLACK)
    end if
    ctrl_xtra[text][CXTEXT_HADFOCUS] = bHasFocus
end procedure   

local procedure tg_gtext_cursorblink_action(gdx cursorblinktimer)
--  gdx text = user_data[cursorblink]
    gdx text = gGetAttribute(cursorblinktimer,`USER_DATA`)
    gRedraw(text)
end procedure

--
-- undo/redo handling:
--
local constant TG_GTEXT_DEL=-1,
               TG_GTEXT_SAME=0,
               TG_GTEXT_INS=+1,
               TG_GTEXT_CPLX=9

-- this lot may need to be utf32 sequences rather than utf8 strings...
local function tg_gtext_onediff(string s1, s2)
    -- part of undo/redo: do s1,s2 differ by a single/central
    --  insert/delete, and if so how long is it, and where?
    -- nb something much cleverer than this may be desired...
    -- aside: this relies heavily on unit_tests() passing.
    integer l1 = length(s1),
            l2 = length(s2),
            s = 1
    while l1 and l2 and s1[l1] = s2[l2] do
        l1 -= 1
        l2 -= 1
    end while
    while l1 and l2 and s1[s] = s2[s] do
        s += 1
        l1 -= 1
        l2 -= 1
    end while
    if l1=0 and l2=0 then return {TG_GTEXT_SAME,0,0} end if
    if l1=0 then return {TG_GTEXT_INS,l2,s} end if
    if l2=0 then return {TG_GTEXT_DEL,-l1,s} end if
    return {TG_GTEXT_CPLX,0,0}
end function

local integer upos  -- copy of crl_xtra[txt][CXTEXT_UNDOPOS] (pbr not needed)

local function tg_gtext_update_undo(sequence undo, string c)
    -- aside: this relies heavily on unit_tests() passing,
    --         as opposed to being intuitively easy code.
    -- undo[1] is the initial state and is never changed.
    bool bAddNew = true
    if length(undo)!=1 then
        -- c is the current value, b,a are the last two
        string b = undo[-1],
               a = undo[-2]
        if c==b then
            bAddNew = false
        else
            -- {tg_gtext_type, length, position}:
            integer {act,acl,sac} = tg_gtext_onediff(a,c),
                    {abt,abl,sab} = tg_gtext_onediff(a,b)
            -- if ac is one insert/delete and one more than ab then 
            if act==abt and (abl+act)==acl
            and ((act==TG_GTEXT_DEL and sac-acl==sab-abl) or
                 (act==TG_GTEXT_INS and sac ==sab    )) then
                undo[$] = c -- replace b
                bAddNew = false
            end if
        end if  
    elsif c==undo[1] then
        bAddNew = false
    end if
    if bAddNew then
        -- add new entry
        undo = append(undo,c)
        upos += 1
        assert(upos==length(undo)) -- (quick sanity check)
    end if
    return undo
end function

-- Debug aid (temp):
--local sequence klog = {}

--with trace
local function tg_gtext_key_handler(gdx text, integer c, bool ctrl, shift) 
--if c='!' then ?9/0 end if -- (debug aid)
--  klog = append(klog,{c,gGetKeyName(c),ctrl,shift})
--  ?{`tg_gtext_key_handler`,text,c,gGetKeyName(c),ctrl,shift}
    bool redraw = true, -- (and not TG_IGNORE)
       bAltered = false,
       bGraphic = (not ctrl) and ((c>=' ' and c<=#7E) or c=VK_POUND)
        -- ^certainly avoid #A1..#A4 (udlr), #E0..E6 (VK_APPS..VK_SCROLL),
        --                  #90 (VK_NUMLOCK), or #F1..FC (VK_F1..F12)...
    string txt = ctrl_xtra[text][CXTEXT_VALUE]
    sequence utf32 = utf8_to_utf32(txt)
    integer cpos = ctrl_xtra[text][CXTEXT_CARETPOS],
        selstart = ctrl_xtra[text][CXTEXT_SELSTART], was_ss = selstart,
             len = length(utf32),
           tType = ctrl_types[text]
    bool unicode = length(txt)!=len
--if ctrl and c='C' then trace(1) end if
--if selstart and ctrl and c=VK_RIGHT then trace(1) end if
    --
    -- Aside: the next few conditions here are absolutely critical, and
    --        non-intuitive, at least until you enumerate them out loud:
    --          shift VK_RIGHT starts/extends the selection
    --          shift 'c' gets you a capital(/caplock) 'C'.
    --          ctrl VK_RIGHT starts/extends the selection
    --          ctrl ACXVZ only change selection indirectly
    --          .. (I could go on almost forever...)
    --        It is certainly more valuable and probably much easier,
    --        albeit rather tedious, to properly extend unit_tests()
    --        than it would be to make these tests crystal clear...
    --
    if selstart and (bGraphic or find(c,{VK_BS,VK_DEL})) then
        if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
        if unicode then
            utf32[selstart..cpos-1] = {}
            len = length(utf32)
            txt = utf32_to_utf8(utf32)
        else
            txt[selstart..cpos-1] = ``
            len = length(txt)
        end if
        cpos = selstart
        selstart = 0
        if not bGraphic then c=-1 end if
        bAltered = true
    else
--      if shift and (not (bGraphic or c=VK_POUND)) then
        if shift and (not bGraphic) then
            if selstart=0 then selstart = cpos end if
        elsif not ctrl then
            selstart = 0
        end if
    end if
    if c=VK_HOME then
        cpos = 1
    elsif c=VK_END then
        cpos = len+1
    elsif c=VK_BS then
        if cpos>1 then
            if unicode then
                utf32 = utf32[1..cpos-2] & utf32[cpos..len]
                txt = utf32_to_utf8(utf32)
            else
                txt = txt[1..cpos-2] & txt[cpos..len]
            end if
            cpos = max(cpos-1,1)
        end if
        selstart = 0
        bAltered = true
    elsif c=VK_DEL then
        if cpos<=len then
            if unicode then
                utf32 = utf32[1..cpos-1] & utf32[cpos+1..len]
                txt = utf32_to_utf8(utf32)
            else
                txt = txt[1..cpos-1] & txt[cpos+1..len]
            end if
        end if
        bAltered = true
    elsif ctrl then
        c = upper(c)
        if c='A' then
            selstart = 1
            cpos = len+1
        elsif c='C'
           or c='X'
           or c='V' then
            sequence clip = ``
            if selstart>cpos then {cpos,selstart} = {selstart,cpos} end if
            if c='V' then
                clip = gGetGlobal(`CLIPTXT`)
                clip = clip[1..find_any("\r\n",clip)-1]
            elsif selstart and selstart!=cpos then
                clip = iff(unicode?utf32_to_utf8(utf32[selstart..cpos-1])
                                                  :txt[selstart..cpos-1])
                gSetGlobal(`CLIPTXT`,clip)
            end if
            if c!='C' and length(clip) then
                if selstart and selstart!=cpos then
                    if unicode then
                        utf32[selstart..cpos-1] = {}
                        txt = utf32_to_utf8(utf32)
                    else
                        txt[selstart..cpos-1] = ``
                    end if
                    cpos = selstart
                end if
                bAltered = true
                selstart = 0
                if c='V' then
                    if unicode then
                        clip = utf8_to_utf32(clip)
                        utf32[cpos..cpos-1] = clip
                        txt = utf32_to_utf8(utf32)
                    else
                        txt[cpos..cpos-1] = clip
                    end if
                    cpos += length(clip)
                end if
            end if
        elsif c='Y' or c='Z' then -- redo/undo
            bAltered = true -- (see below)
        elsif c=VK_RIGHT then
            cpos = tg_gtext_next_word_boundary(cpos,len,utf32)
            if not shift then selstart = 0 end if
        elsif c=VK_LEFT then
            cpos = tg_gtext_prev_word_boundary(cpos,utf32)
            if not shift then selstart = 0 end if
        else
            redraw = false
        end if  
    elsif c=VK_RIGHT then
        if not shift and was_ss and was_ss!=cpos then
            cpos = max(was_ss,cpos)
        else
            cpos = min(cpos+1,len+1)
        end if
    elsif c=VK_LEFT then
        if not shift and was_ss and was_ss!=cpos then
            cpos = min(was_ss,cpos)
        else
            cpos = max(cpos-1,1)
        end if
    elsif c=VK_UP
       or c=VK_DOWN then
        if tType=SPIN then
            integer {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD],
                     v = to_integer(ctrl_xtra[text][CXTEXT_VALUE])
            if c=VK_UP then
                v = max(lo,v+step)
                if v>hi then v = iff(bWrap?lo:hi) end if
            else          -- down
                v = min(hi,v-step)
                if v<lo then v = iff(bWrap?hi:lo) end if
            end if
            txt = sprintf("%d",v)
            cpos = length(txt)+1
            redraw = true
--      elsif tType=DATEPICK, DROPDOWN -- maybe...
        end if
    elsif bGraphic then
        object cc = iff(c=VK_POUND?iff(unicode?#A3:x"C2A3"):c)
        if unicode then
            utf32 = utf32[1..cpos-1] & cc & utf32[cpos..len]
            txt = utf32_to_utf8(utf32)
        else
            txt = txt[1..cpos-1] & cc & txt[cpos..len]
        end if
        cpos += 1
        bAltered = true
    else
        redraw = false
    end if
    if redraw or c=-1 then
        if bAltered then
            object undo = ctrl_xtra[text][CXTEXT_UNDO]
            if not sequence(undo) then
                undo = {ctrl_xtra[text][CXTEXT_VALUE]}
                upos = 1
            else
                upos = ctrl_xtra[text][CXTEXT_UNDOPOS]
            end if
            if ctrl and (c='Z' or c='Y') then
                string was_txt = txt
                if c='Z' then -- undo
                    if upos>1 then
                        upos -=1
                        txt = undo[upos]
                    end if
                elsif c='Y' then -- redo
                    if upos<length(undo) then
                        upos += 1
                        txt = undo[upos]
                    end if
                end if
                integer {t,l,s} = tg_gtext_onediff(txt,was_txt)
                if t=TG_GTEXT_DEL then
                    selstart = s
                    cpos = s-l
                elsif t=TG_GTEXT_INS then
                    cpos = s
                    selstart = 0
                end if
            else
                ctrl_xtra[text][CXTEXT_UNDO] = 0 -- (kill refcount)
                if upos<length(undo) then undo = undo[1..upos] end if
                undo = tg_gtext_update_undo(undo,txt)
                ctrl_xtra[text][CXTEXT_UNDO] = undo
            end if
            ctrl_xtra[text][CXTEXT_UNDOPOS] = upos
        end if
        ctrl_xtra[text][CXTEXT_CARETPOS] = cpos
        ctrl_xtra[text][CXTEXT_VALUE] = txt
        ctrl_xtra[text][CXTEXT_HADFOCUS] = false -- (restart caret timer)
        ctrl_xtra[text][CXTEXT_SELSTART] = selstart
        gRedraw(text)
        if bAltered then
--          rtn value_changed = gGetHandler(text,`VALUE_CHANGED`)
            rtn value_changed = ctrl_xtra[text][CXTEXT_VALUE_CHANGED]
            if value_changed then
--              string sig = tg_get_sig(value_changed)
--              if sig=`POS` then
--                  value_changed(text,txt)
--              elsif sig=`PS` then
                    value_changed(txt)
--              else
--                  ?9/0
--              end if
            end if
        end if
        return TG_IGNORE -- dealt with; do not propagate
    end if
    return TG_DEFAULT
end function

local gdx gtext_menu = NULL

-- the following uses control key codes for menu ids:
local constant TG_GTEXT_POPUP_MENU = {{"Undo\t",M_CTRL+'Z'},
                                      {"Redo\t",M_CTRL+'Y'},
                                      `-`,
                                      {"Cut\t",M_CTRL+'X'},
                                      {"Copy\t",M_CTRL+'C'},
                                      {"Paste\t",M_CTRL+'V'},
                                      {"Delete\t",VK_DEL},
                                      `-`,
                                      {"Select all\t",M_CTRL+'A'}}
--
--- The native (WinAPI) version also has no icons and:
--      Right to left Reading order
--      Show Unicode control characters
--      Insert Unicode control character
--      Open IME
--      Reconversion
--  (none of which I have any interest in or understanding of)
--  [Clearly per field r2l is just sheer utter lunatic madness]
--  The native (GTK2) version also has five (ugly) icons and:
--      InputMethods
--      Insert Unicode Control Character
--  The native (GTK3) version also has no icons and:
--      Insert Emoji
--  (not very interested in latter but more than rest combined)

local procedure tg_gtext_menu_handler(gdx menu, integer id)
    gdx text = gGetAttribute(gtext_menu,`USER_DATA`)
    integer {ch,ctrl,shift} = gMenuCcsa(id)
    {} = tg_gtext_key_handler(text,ch,ctrl,shift) 
end procedure

constant integer tg_popup = gGetGlobal(`tg_popup`) -- (undocumented)

function tg_gtext_click(gdx text, sequence status, integer x, /*y*/)
    switch status[1..2] do
        case `RR`:  -- (right button released)
                    gSetFocus(text)
                    if gtext_menu=NULL then
                        gtext_menu = gMenu(TG_GTEXT_POPUP_MENU,tg_gtext_menu_handler)
                        gSetAttribute(gtext_menu,`USER_DATA`,text)
                    end if
                    object undo = ctrl_xtra[text][CXTEXT_UNDO]
                    integer undolen = iff(sequence(undo)?length(undo):0),
                            undopos = ctrl_xtra[text][CXTEXT_UNDOPOS],
                           selstart = ctrl_xtra[text][CXTEXT_SELSTART],
                           caretpos = ctrl_xtra[text][CXTEXT_CARETPOS]
                    string txt = ctrl_xtra[text][CXTEXT_VALUE]
                    bool selected = selstart and selstart!=caretpos,
                         cliptext = gGetGlobal(`CLIPTXT?`)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'Z',`ACTIVE`,undopos>1)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'Y',`ACTIVE`,undopos<undolen)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'X',`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'C',`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'V',`ACTIVE`,cliptext)
                    gMenuSetAttribute(gtext_menu,VK_DEL,`ACTIVE`,selected)
                    gMenuSetAttribute(gtext_menu,M_CTRL+'A',`ACTIVE`,length(txt)>0)
                    gPopupMenu(gGetDialog(text),gtext_menu)
                    return TG_IGNORE
        case `LS`:  -- (left button single click/down) [or]
        case `LD`:  -- (left button double click: select word)
                    integer hov = ctrl_xtra[text][CXSPIN_HOV],
                          tType = ctrl_types[text]
                    if hov then
                        if tType=SPIN then
                            integer {lo,hi,step,bWrap} = ctrl_xtra[text][CXTEXT_SDD],
                                     v = to_integer(ctrl_xtra[text][CXTEXT_VALUE])
                            if hov=1 then -- up
                                v = max(lo,v+step)
                                if v>hi then v = iff(bWrap?lo:hi) end if
                            else          -- down
                                v = min(hi,v-step)
                                if v<lo then v = iff(bWrap?hi:lo) end if
                            end if
                            ctrl_xtra[text][CXTEXT_VALUE] = sprintf("%d",v)
--DEV call value_changed
--                          gSetAttribute(v,"VALUE",sprint("%d",v))
--                          ?{"spin",v}
--                          rtn value_changed = gGetHandler(text,`VALUE_CHANGED`)
                            rtn value_changed = ctrl_xtra[text][CXTEXT_VALUE_CHANGED]
                            if value_changed then
--                              string sig = tg_get_sig(value_changed)
--                              if sig=`POI` then
--                                  value_changed(text,v)
--                              elsif sig=`PI` then
                                    value_changed(v)
--                              else
--                                  ?9/0
--                              end if
                            end if
                        elsif tType=DATEPICK then
                            {gdx calendar} = ctrl_xtra[text][CXTEXT_SDD]
                            tg_popup(text,calendar)
                        elsif tType=DROPDOWN then
                            {gdx list} = ctrl_xtra[text][CXTEXT_SDD]
                            tg_popup(text,list)
                        end if
                    else
                        tg_text_process_mouseclickmove(text, status[2], x)
                    end if
                    -- restart cursorblink...
                    ctrl_xtra[text][CXTEXT_HADFOCUS] = false
                    gSetFocus(text) -- ... whether this matters or not
                    gRedraw(text)
    end switch
    return TG_DEFAULT
end function

procedure tg_gtext_mousemove(gdx text, integer x,y, bool left,/*middle*/,/*right*/)
--bSpin/hover on up/down?
    integer tType = ctrl_types[text]
    bool bRedraw = false
    if tType!=TEXT then
        integer {w,h} = gGetAttribute(text,"SIZE"), hov = 0,
               washov = ctrl_xtra[text][CXSPIN_HOV]
        if tType=SPIN then
            if x>w-h+4 then hov = 1 + (y>h/2) end if
        elsif tType=DATEPICK then
            hov = x>=w-28
        elsif tType=DROPDOWN then
            hov = x>=w-19
        end if
        if hov!=washov then
            ctrl_xtra[text][CXSPIN_HOV] = hov
            bRedraw = true
        end if
    end if
    if left then
        tg_text_process_mouseclickmove(text, 'M', x)
        -- restart cursorblink:
        ctrl_xtra[text][CXTEXT_HADFOCUS] = false
        bRedraw = true
    end if
    if bRedraw then gRedraw(text) end if
end procedure

local procedure tg_gtext_mouseleave(gdx text)
--?{`tg_gtext_mouseleave`,text}
    ctrl_xtra[text][CXSPIN_HOV] = 0
    gRedraw(text)
end procedure

function hText(rtn value_changed, string attr)
--function gText(object value_changed=NULL, sequence attributes="", args={})
--  {value_changed, attributes, args} = paranormalise(value_changed, attributes, args)
    -- [DEV] theGUI.e can probably just set ctrl_size[id][SZ_[USER_|NATURAL]H].
--  string hsz = iff(bGTK2?`x22`:iff(bGTK3?`x34`:`x20`))
    string hsz = iff(backend=TG_GTK and bGTK2?`x22`
                :iff(backend=TG_GTK and bGTK3?`x34`:`x20`))
--trace(1)
    gdx id = gCanvas(tg_gtext_redraw,`SIZE=%s`,{hsz})
    if platform()=JS then
        -- fudge: astonishingly, this works fine despite the fact it does things like
        --        ctrl_xtra[table] all over the shop, as if it were an integer, when
        --        it is in fact an HtmlElement...
        ctrl_xtra = {}
        ctrl_types = {}
    else
        ctrl_xtra = repeat(0,id)
        ctrl_types = repeat(0,id)
    end if
    ctrl_types[id] = TEXT
--  ctrl_set_attr[TEXT] = tg_set_text_attribute
--  ctrl_get_attr[TEXT] = tg_get_text_attribute
    object cx = repeat(0,CXTEXT_LEN)
    cx[CXTEXT_CARETCLR] = TG_BLACK
    cx[CXTEXT_CARETCT] = 6
--  cx[CXTEXT_CARETIME] = time()
--  cx[CXTEXT_CARETIMER] = gTimer(tg_gtext_cursorblink_action,525,false,id)
    cx[CXTEXT_CARETIMER] = gTimer(tg_gtext_cursorblink_action,525,true,id)
    cx[CXTEXT_CARETPOS] = 1
    cx[CXTEXT_CHARSFROM] = 1
--  cx[CXTEXT_HADFOCUS] = 0 -- (already is)
--  cx[CXTEXT_SELSTART] = 0 -- (already is)
    cx[CXTEXT_VALUE] = attr -- DEV...:
--  cx[CXTEXT_VALUE] = ``
    cx[CXTEXT_VALUE_CHANGED] = value_changed -- hText only
    cx[CXTEXT_CUEBANNER] = ``
--  cx[CXTEXT_CUEBANNER] = {`Enter some text`,TG_RED,TG_ITALIC}
--  cx[CXTEXT_UNDOPOS] = 1 -- (NO, 0)
    ctrl_xtra[id] = cx
    cx = 0
    gSetAttribute(id,`EXPAND`,`HORIZONTAL`)
    gSetAttribute(id,`BGCLR`,TG_WHITE)
    gSetAttribute(id,`CANFOCUS`,true)
--  gSetAttribute(id,`FGCLR`,TG_RED)
    gSetHandler(id,`KEY`,tg_gtext_key_handler)
    gSetHandler(id,`CLICK`,tg_gtext_click)
    gSetHandler(id,`MOUSEMOVE`,tg_gtext_mousemove)
    gSetHandler(id,`MOUSELEAVE`,tg_gtext_mouseleave)
--  gSetHandler(id,`VALUE_CHANGED`,value_changed)
    return id
end function

--DEV make the text go red when it's not an integer...
function hSpin(rtn value_changed)
--function gSpin(rtn value_changed, string attributes="", sequence args={})
    gdx spin = hText(value_changed, "3")
    gSetAttribute(spin,`SIZE`,`32x21`)
    gSetAttribute(spin,`EXPAND`,`NONE`)
    ctrl_types[spin] = SPIN
    ctrl_xtra[spin][CXTEXT_SDD] = {3,7,1,false}
--  ctrl_xtra[spin][CXTEXT_SDD] = {0,9,1,false}
    return spin 
end function

--DEV make the text go red when it's not a date...
function hDatePick(gdx calendar, rtn value_changed, string v)
    gdx datepick = hText(value_changed, v)
    gSetAttribute(datepick,`SIZE`,`109x21`)
    gSetAttribute(datepick,`EXPAND`,`NONE`)
    ctrl_types[datepick] = DATEPICK
    -- note: we're using an X-canvas in lieu of a gCalendar for now...
    -- note it is the application's responsibility to tie together
    --      all interactions between the datepick and the calendar
    --      (theGUI is busy enough showing/hiding/forwarding keys)
--  gdx calendar = gCanvas(`SIZE=221x142`)
--  gdx calendar = gCalendar(tg_datepick_calendar_handler,ymd,atributes,args)
    ctrl_xtra[datepick][CXTEXT_SDD] = {calendar}
    return datepick
end function

--DEV allow/prohibit editing... (CANFOCUS=NO??)
function hDropdown(gdx list, rtn value_changed, string v)
    gdx dropdown = hText(value_changed, v)
    gSetAttribute(dropdown,`SIZE`,`80x21`)
    gSetAttribute(dropdown,`EXPAND`,`NONE`)
    ctrl_types[dropdown] = DROPDOWN
    -- note: we're using an X-canvas in lieu of a gList for now...
    -- note it is the application's responsibility to tie together
    --      all interactions between the dropdown and popup gList
    --      (theGUI is busy enough showing/hiding/forwarding keys)
    ctrl_xtra[dropdown][CXTEXT_SDD] = {list}
    return dropdown
end function

-- </theGUI.e>

procedure unit_tests()
    assert(tg_gtext_onediff(``,``)=={TG_GTEXT_SAME,0,0})
    assert(tg_gtext_onediff(`abc`,``)=={TG_GTEXT_DEL,-3,1})
    assert(tg_gtext_onediff(``,`abc`)=={TG_GTEXT_INS,3,1})
    assert(tg_gtext_onediff(`xyz`,`abc`)=={TG_GTEXT_CPLX,0,0})
    assert(tg_gtext_onediff(`abc`,`ac`)=={TG_GTEXT_DEL,-1,2})
    assert(tg_gtext_onediff(`ac`,`abc`)=={TG_GTEXT_INS,1,2})

    sequence undo = {`abc`}
    upos = 1
    undo = tg_gtext_update_undo(undo,``)
    assert(undo=={`abc`,``})
    undo = tg_gtext_update_undo(undo,`abc`)
    assert(undo=={`abc`,``,`abc`})
    undo = tg_gtext_update_undo(undo,`ac`)
    assert(undo=={`abc`,``,`abc`,`ac`})
    undo = tg_gtext_update_undo(undo,`abc`)
    assert(undo=={`abc`,``,`abc`,`ac`,`abc`})
    undo = tg_gtext_update_undo(undo,`abcd`)
    assert(undo=={`abc`,``,`abc`,`ac`,`abc`,`abcd`})
    undo = tg_gtext_update_undo(undo,`abcde`)
    assert(undo=={`abc`,``,`abc`,`ac`,`abc`,`abcde`})
    undo = tg_gtext_update_undo(undo,`abcdef`)
    assert(undo=={`abc`,``,`abc`,`ac`,`abc`,`abcdef`})
    upos = 3
    undo = undo[1..3]
    undo = tg_gtext_update_undo(undo,`xyz`)
    assert(undo=={`abc`,``,`abc`,`xyz`})
    assert(upos==4)
end procedure
unit_tests()

