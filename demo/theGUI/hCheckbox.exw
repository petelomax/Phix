--/!*
-- gRadio:
procedure radio_changed(gdx toggle, bool bState)
--?9/0
    string title = gGetAttribute(toggle,`TITLE`)
--  string title = ctrl_xtra[toggle][CXCHK_TITLE]
    printf(1,"toggle(%s), state:%t\n",{title,bState})
    -- (since we know they are in a hbox, not necc always true)
    gdx hbox = gGetParent(toggle),
        rchk = gGetChild(hbox,rand(gGetChildCount(hbox)))
    assert(hRadioItem(rchk)==toggle)
end procedure

--string yattr = `VALUE=ON, FONT="Arial, italic 9"`
--gdx ygitb = {gCheckbox(`&You`,radio_changed,yattr),
gdx ygitb = {hCheckbox(`&You`,radio_changed),
             hCheckbox(`&get`,radio_changed),
             hCheckbox(`&in`,radio_changed),
             hCheckbox(`&the`,radio_changed),
             hCheckbox(`&bowl`,radio_changed)},
     hbox = gHbox(ygitb,`MARGIN=9x8`),
      dlg = gDialog(hbox,`gRadio`,`SIZE=240x80`)
gSetAttribute(ygitb[1],`FONT`,`Arial, italic 9`)
