--
--  The canvas-based implementation of gCheckbox (including gRadio).
--
--requires(64,true)
--puts(1,``)
with javascript_semantics
include theGUI.e
gSetGlobal(`DIAGNOSTICS`,true)
--/*
"WM_SETFOCUS"
id ---ctyp---   x   y   w   h  nw  nh  uw  uh  p  children   flags [19230, gShow]
 1 gCanvas      8   9  41  23  41  23  41  23  6  0          CF_CANFOCUS+CANVAS
 2 gCanvas     49   9  36  23  36  23  36  23  6  0          CF_CANFOCUS+CANVAS
 3 gCanvas     85   9  29  23  29  23  29  23  6  0          CF_CANFOCUS+CANVAS
 4 gCanvas    114   9  36  23  36  23  36  23  6  0          CF_CANFOCUS+CANVAS
 5 gCanvas    150   9  45  23  45  23  45  23  6  0          CF_CANFOCUS+CANVAS
 6 gHbox        8   9 222  30 187  23   0   0  7  {1..5}     CF_EXPANDB+CTNR
 7 gDialog    840 500 240  80 210  73 240  80  0  {6}        CF_CTNR+RESIZE+MODAL+CLESC
--*/
--gUseGTK()

rtn chk_click -- (in lieu of hSetHandler(`VALUE_CHANGED`), OK since only ever the same 'action')
constant backend = gVersion(-1),
         backver = gVersion(-2)

gdn ucb = NULL, ccb, urb, crb, irb

--/*
-- ctrl_xtra[] for gCheckbox():
local constant chk_attrs = {
--                          {      CXCHK_TITLE:=$,'S',`TITLE`       }, -- title
                            {      CXCHK_RADIO:=$,'i',`[radio]`     }}, -- group-id
                            {      CXCHK_VALUE:=$,'B',`VALUE`       }}, -- checked
                   CXCHK__LEN = length(chk_attrs),
--*/

sequence ctrl_xtra = {} -- hCheckbox-specific
enum --CXCHK_TITLE,
     CXCHK_RADIO,
     CXCHK_VALUE,
     CXCHK_LEN = $

local sequence radio_sets = {},
           radio_selected = {}

--function tg_chk_key(gdx chk, integer c, bool ctrl, shift, alt)
procedure tg_chk_key(gdx chk, integer c)
--?{`tg_chk_key`,chk, c, ctrl, shift, alt}
--?9/0
--?{`tg_chk_key`,chk, c}
--  if alt then
--DEV probably should be key_handler only...
--      if tg_process_mnemonics(c)==TG_IGNORE then
--      if tg_process_mnemonics(c,btn)==TG_IGNORE then
--          return TG_IGNORE
--      end if
    if c=' ' and gGetAttribute(chk,`ACTIVE`) then
        bool bState = true
        integer radio = ctrl_xtra[chk][CXCHK_RADIO]
        if radio then
            gdx prv = radio_selected[radio]
            ctrl_xtra[prv][CXCHK_VALUE] = false
            ctrl_xtra[chk][CXCHK_VALUE] = true
            radio_selected[radio] = chk
        else
            bState = not ctrl_xtra[chk][CXCHK_VALUE]
            ctrl_xtra[chk][CXCHK_VALUE] = bState
        end if
        gRedraw(gGetDialog(chk))
--      atom handler = gGetHandler(chk,`VALUE_CHANGED`)
        if chk_click then
--          handler(chk,bState)
            chk_click(chk,bState)
        end if
    end if
end procedure

local procedure tg_chk_mouse_click(gdx chk, sequence status)
--?{`tg_chk_mouse_click`,chk,status}
    if begins(`LR`,status) and gGetAttribute(chk,`ACTIVE`) then
        gSetFocus(chk)
        tg_chk_key(chk,' ')
    end if
end procedure

procedure tg_chk_redraw(gdx chk, integer w, h)
--  string chk_txt = ctrl_xtra[chk][CXCHK_TITLE]
    string chk_txt = gGetAttribute(chk,`TITLE`)
    integer {tw,th} = gGetAttribute(chk,`SIZE`), tx=6, ty=12
--DEV unused...
    bool bActive = gGetAttribute(chk,`ACTIVE`),
         bChecked = ctrl_xtra[chk][CXCHK_VALUE],
         bRadio = ctrl_xtra[chk][CXCHK_RADIO]
    if backend=TG_GTK then
        {tx,ty,tw,th} = {4,11,tw-1,th-4}
    elsif backend!=TG_WINAPI then
        ?9/0
    end if
    if ucb=NULL then
        {ucb,ccb,urb,crb,irb} = gGetGlobal(`chk_xpm`) -- unchecked and checked gImages, all 13x13
                                         -- ^^^^^^^ -- otherwise not documented anywhere
    end if
    gdm image = iff(bRadio?iff(bChecked?crb:urb)
                          :iff(bChecked?ccb:ucb))
--  if not bActive then image = gGreyscale_XPM(image) end if
--  if not bActive and not bRadio then image = gGreyscale_XPM(image) end if
    if not bActive then
        if bRadio then
            if bChecked then image = irb end if
        else
            image = gGreyscale_XPM(image)
        end if
    end if
    gDrawImage(image,chk,tx,ty-7)
    atom txtclr = iff(bActive?TG_BLACK:TG_DARK_GREY)
    gDrawText(chk,tx+16,ty,chk_txt,colour:=txtclr)
    if gGetFocus()==chk and bActive then
        gDrawRect(chk,2,2,tw-1,th-2,rc:=2,colour:=TG_BLACK,style:=TG_DOTTED)
    end if
end procedure   

--function hCheckbox(nullable_string title=NULL, rtn value_changed=NULL, string attributes=``, dword_seq args={}) 
function hCheckbox(nullable_string title=NULL, rtn value_changed=NULL) 
--  {title,value_changed,attributes,args} = paranormalise_traa(title,value_changed,attributes,args)
--  if not bInit then tg_Init() end if
    gdx chk = gCanvas(tg_chk_redraw)
    gSetAttribute(chk,`EXPAND`,false)
    if platform()!=JS then
        ctrl_xtra &= repeat(0,chk-length(ctrl_xtra))
    end if
    object chk_attr = repeat(0,CXCHK_LEN)
--  chk_attr[CXCHK_TITLE] = title
    ctrl_xtra[chk] = chk_attr
    chk_attr = 0
--  tg_set_mnemonic(title,chk)
    gSetAttribute(chk,`TITLE`,title)
    gSetAttribute(chk,`CANFOCUS`,true)
    gSetHandler(chk,`CLICK`,tg_chk_mouse_click)
    gSetHandler(chk,`KEY`,tg_chk_key)
--  gSetHandler(chk,`VALUE_CHANGED`,value_changed)
    chk_click = value_changed
    return chk
end function

local procedure set_chk_sizes(sequence chks)
    -- (to be done by gShow, for any CXCHK_RADIO it finds)
    for chk in chks do
        string title = gGetAttribute(chk,`TITLE`)
        integer {tw,th} = gGetTextExtent(title,chk)
        if backend=TG_GTK then
            tw += 5
        elsif backend=TG_WINAPI then
            tw += 7
        else
            ?9/0
        end if
        gSetAttribute(chk,`SIZE`,{tw+19,th+8})
--          ctrl_size[id][SZ_USER_W] = tw+19
--          ctrl_size[id][SZ_USER_H] = th+8
    end for
end procedure

procedure value_changed(gdx chk, bool bState)
?{`value_changed`,chk,bState}
    gdx dlg = gGetDialog(chk)
    gSetAttribute(dlg,`TITLE`,`ticked:%t`,{bState})
--  gSetAttribute(chk,`TITLE`,`This %s c&hecked`,{iff(bState?`is`:`ain't`)})
end procedure

procedure hRadio(gdx chks)
    radio_sets = append(radio_sets,chks)
    integer rdx = length(radio_sets), sdx = 0
    for chk in chks do
--assert it is a gCheckbox...
        -- not already part of any other radio group:
        if ctrl_xtra[chk][CXCHK_RADIO] then ?9/0 end if
        ctrl_xtra[chk][CXCHK_RADIO] = rdx
        bool bState = ctrl_xtra[chk][CXCHK_VALUE]
        if bState then
            if sdx=0 then sdx = chk else ?9/0 end if
        end if
    end for
    if sdx=0 then 
        sdx = chks[1]
        ctrl_xtra[sdx][CXCHK_VALUE] = true
    end if
    radio_selected = append(radio_selected,sdx)
end procedure

function hRadioItem(gdx id)
    integer rdx = ctrl_xtra[id][CXCHK_RADIO]
    return radio_selected[rdx]
end function

