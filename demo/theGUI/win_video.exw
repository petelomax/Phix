    return {bOK,width,height,dur,fps_num,fps_den}
end function

--string format_time(atom secs)
function format_time(atom secs)
    integer total_seconds = floor(secs),
            hours = floor(total_seconds/3600),
            minutes = floor(rmdr(total_seconds,3600)/60),
            seconds = rmdr(total_seconds,60)
    string res = sprintf("%02d:%02d:%02d", {hours, minutes, seconds})
    return res
end function


-- Main Window Procedure
function WndProc(atom hWnd, msg, wParam, lParam)
    switch msg do
        case WM_CREATE:
--/*
            -- Initialize GDI+
            atom gdiplus_token = 0
            atom gdiplus_input = allocate_struct("GG")
            p_GdiplusStartupVersion{gdiplus_input} = 1
            p_GdiplusStartup{gdiplus_input} = 0
            if GdiplusStartup(&gdiplus_token, gdiplus_input, NULL) != GDIP_OK then
                MessageBox(hWnd, "GDI+ initialization failed!", "Error", MB_ICONERROR)
                return -1
            end if
--          #pragma weakref gdiplus_token  -- Prevent cleanup during window life
--*/
            
            -- Get video info and load first frame
--          atom {bOK, vid_w, vid_h, vid_dur, vid_fps_num, vid_fps_den} = get_video_info()
            bool bOK
--          atom vid_fps_num, vid_fps_den
            {bOK, frame_w, frame_h, duration, vid_fps_num, vid_fps_den} = get_video_info()
            if not bOK then
--              MessageBox(hWnd, sprintf("Failed to load video info from %s\nCheck ffmpeg/ffprobe is in PATH", {video_path}), "Error", MB_ICONERROR)
--              return -1
                ?9/0
            end if
printf(1, "Video: %dx%d @ %.2ffps (duration: %.2fs)\n", {frame_w, frame_h, vid_fps_num/vid_fps_den, duration})

--          frame_w = vid_w
--          frame_h = vid_h
--          duration = vid_dur
            current_time = 0
            hBitmap = load_frame_at_time(current_time)
            frame_ready = (hBitmap != 0)
            InvalidateRect(hWnd, NULL, true)
            return 0

        case WM_SIZE:
            InvalidateRect(hWnd, NULL, true)
            return 0

        case WM_PAINT:
            atom hdc = BeginPaint(hWnd, pPAINTSTRUCT)
--          atom hdc, hmemdc, holdbmp
--          atom ps = allocate_struct(idPAINTSTRUCT)
--          hdc = BeginPaint(hWnd, ps)
--          integer client_w, client_h
--          integer {?,?,w,h} = GetClientRect(hWnd)
            integer {?,?,client_w,client_h} = GetClientRect(hWnd)
--          GetClientRect(hWnd, ps)
--          client_w = ps.right - ps.left
--          client_h = ps.bottom - ps.top

            -- Clear background
--          FillRect(hdc, ps, GetStockObject(BLACK_BRUSH))
            FillRect(hdc, pPAINTSTRUCT, GetStockObject(BLACK_BRUSH))

            -- Draw video frame if available
            if frame_ready and hBitmap != 0 then
                atom hmemdc = CreateCompatibleDC(hdc),
                    holdbmp = SelectObject(hmemdc, hBitmap)
                
                -- Calculate scaling to maintain aspect ratio
                atom scale_w = client_w / frame_w
                atom scale_h = client_h / frame_h
                atom scale = min(scale_w, scale_h)
                integer draw_w = floor(frame_w * scale)
                integer draw_h = floor(frame_h * scale)
                integer offset_x = (client_w - draw_w) / 2
                integer offset_y = (client_h - draw_h) / 2
                
                StretchBlt(hdc, offset_x, offset_y, draw_w, draw_h, 
                          hmemdc, 0, 0, frame_w, frame_h, SRCCOPY)
                
                {} = SelectObject(hmemdc, holdbmp)
                DeleteObject(hmemdc)
            end if
            
            -- Draw overlay text (time/progress)
            string time_text = format_time(current_time) & " / " & format_time(duration)
            SetTextColor(hdc, 0xFFFFFF)  -- White text
            SetBkMode(hdc, TRANSPARENT)
            TextOut(hdc, 10, 10, time_text, length(time_text))
            
--          EndPaint(hWnd, ps)
            EndPaint(hWnd, pPAINTSTRUCT)
            return 0

        case WM_TIMER:
            if wParam = timer_id then
                if playing then
                    -- Advance time by 1 frame (using approximate fps)
                    atom fps = vid_fps_num / vid_fps_den
                    current_time += 1.0 / fps
                    if current_time >= duration then
                        current_time = duration
                        stop_playback()
                    end if
                    -- Load new frame
                    cleanup_frame()
                    hBitmap = load_frame_at_time(current_time)
                    frame_ready = (hBitmap != 0)
                    InvalidateRect(hWnd, NULL, true)
                end if
            end if
            return 0

        case WM_CHAR:
            switch wParam do
                case VK_SPACE:
                    if playing then
                        stop_playback()
                    else
                        start_playback()
                    end if
                case VK_ADD, VK_OEM_PLUS:  -- '+' key
                    playing = false
                    KillTimer(hWnd, timer_id)
                    current_time = min(duration, current_time + 5.0)
                    cleanup_frame()
                    hBitmap = load_frame_at_time(current_time)
                    frame_ready = (hBitmap != 0)
                    InvalidateRect(hWnd, NULL, true)
                case VK_SUBTRACT, VK_OEM_MINUS:  -- '-' key
                    playing = false
                    KillTimer(hWnd, timer_id)
                    current_time = max(0.0, current_time - 5.0)
                    cleanup_frame()
                    hBitmap = load_frame_at_time(current_time)
                    frame_ready = (hBitmap != 0)
                    InvalidateRect(hWnd, NULL, true)
                case VK_HOME:
                    playing = false
                    KillTimer(hWnd, timer_id)
                    current_time = 0.0
                    cleanup_frame()
                    hBitmap = load_frame_at_time(current_time)
                    frame_ready = (hBitmap != 0)
                    InvalidateRect(hWnd, NULL, true)
                case VK_END:
                    playing = false
                    KillTimer(hWnd, timer_id)
                    current_time = duration
                    cleanup_frame()
                    hBitmap = load_frame_at_time(current_time)
                    frame_ready = (hBitmap != 0)
                    InvalidateRect(hWnd, NULL, true)
                case VK_ESCAPE:
                    {} = SendMessage(hWnd, WM_CLOSE, 0, 0)
            end switch
            return 0

        case WM_DESTROY:
            stop_playback()
            cleanup_frame()
            -- GDI+ shutdown would go here in a real app (omitted for brevity in demo)
            PostQuitMessage(0)
            return 0
    end switch
    return DefWindowProc(hWnd, msg, wParam, lParam)
end function
constant WndProc_cb = call_back(WndProc)

-- Main
procedure main()
    GdiplusStartup(gdiplusToken, pGdiplusStartupInput, NULL)

    RegisterClassEx("VideoCanvas", WndProc_cb)
    
    hWnd = CreateWindowEx(
        0, "VideoCanvas", "Phix Video Player",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT, 800, 600,
        NULL, NULL, 0, NULL
    )
    
    if hWnd = 0 then
        puts(STDERR, "Failed to create window\n")
        abort(1)
    end if
    
    ShowWindow(hWnd, SW_SHOWNORMAL)
    UpdateWindow(hWnd)
    
    atom pMsg = allocate_struct(idMSG)
    while GetMessage(pMsg, NULL, 0, 0) do
        TranslateMessage(pMsg)
        DispatchMessage(pMsg)
    end while
end procedure
main()
--*/

--/*
--
-- demo\theGUI\win_clip.exw
-- ========================
--
--  Clipboard demo, auto-crops the four corners of all me doc images for me.
--  Also supports drag and drop, with full image loading support via gdiplus (png,jpg,etc).
--                                (however image save was all a bit too C++ssy for me)
--
--  See also gtk_clip.exw and ..\..\pwa\js\poc\clip.htm (clipp.html adds paste, drag and
--                                                       drop, and a Choose file button)
--
--requires(64,true)
include theGUI.WINAPI.e
include theGUI.gdiplus.e

constant BORDER = 10,
         ppBits = allocate(machine_word()),
         bmiLen = get_struct_size(idBITMAPINFOHEADER),
         pBMI = allocate(bmiLen),
         gdiplusToken = allocate_word(),
         highlight_brush = CreateSolidBrush(0x00E5E5E5)

local procedure set_BMI(atom pBMI, integer w, h)
    -- (common code) pBMI may be the constant or the pMem going to the clipboard
    mem_set(pBMI,0,bmiLen)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biSize",bmiLen)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biWidth",w)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biHeight",h)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biPlanes",1)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biBitCount",32)
    set_struct_field(idBITMAPINFOHEADER,pBMI,"biCompression",BI_RGB)
end procedure

function get_bitmap_from_clipboard()
    atom hNew=0, pBits=0, w=0, h=0
    if OpenClipboard(NULL) then
        atom hDIB = GetClipboardData(CF_DIB)
        if hDIB!=NULL then
            atom pDIB = GlobalLock(hDIB),
                  hdc = CreateCompatibleDC(NULL)
            integer biSize = get_struct_field(idBITMAPINFOHEADER,pDIB,"biSize"),
                       bpp = get_struct_field(idBITMAPINFOHEADER,pDIB,"biBitCount"),
               compression = get_struct_field(idBITMAPINFOHEADER,pDIB,"biCompression"),
                   clrUsed = get_struct_field(idBITMAPINFOHEADER,pDIB,"biClrUsed")
            if find(bpp,{32,24,8,1}) then -- (just quietly ignore anything else!)
                {w,h} = get_struct_fields(idBITMAPINFOHEADER,pDIB,{"biWidth","biHeight"})
                h = abs(h)
                set_BMI(pBMI, w, h)
                hNew = CreateDIBSection(hdc,pBMI,DIB_RGB_COLORS,ppBits,NULL,0)
                pBits = peeknu(ppBits)

                atom pSrc = pDIB + biSize, palette = pSrc
                -- CF_DIBV5 already includes masks, so don't skip them again
                if biSize!=get_struct_size(idBITMAPV5HEADER) then
                    -- skip bitfields (for 16/32-bit BI_BITFIELDS)
                    if compression = BI_BITFIELDS then
                        pSrc += 3*4 -- 3 DWORD masks
                    end if

                    -- skip color table
                    integer nColors
                    if clrUsed!=0 then
                        nColors = clrUsed
                    elsif bpp<=8 then
                        nColors = power(2,bpp)
                    else
                        nColors = 0
                    end if

                    pSrc += nColors*4
                end if

                integer stride = floor((bpp*w+31)/32)*4
                for y=0 to h-1 do
                    atom src_row = pSrc + y*stride,
                         dst_row = pBits + y*w*4
                    if bpp=32 then
                        mem_copy(dst_row,src_row,w*4)
                    else
                        atom clr
                        for x=0 to w-1 do
                            if bpp=24 then
                                integer {b,g,r} = peek({src_row+x*3,3})
                                clr = r+g*#100+b*#10000
                            else
                                integer idx
                                if bpp=8 then
                                    idx = peek(src_row+x)*4
                                elsif bpp=1 then
                                    integer byte_ = peek(src_row+floor(x/8)),
                                          mask = power(2,7-mod(x,8)),   
                                       bit = and_bits(byte_,mask)!=0
                                    idx = iff(bit?4:0)
                                else
                                    ?9/0 -- cannot trigger
                                end if
                                clr = peek4u(palette+idx)
                            end if
                            poke4(dst_row+x*4,clr)
                        end for
                    end if
                end for
            end if
            DeleteDC(hdc)
            GlobalUnlock(hDIB)
        end if
        CloseClipboard()
    end if
    return {hNew,pBits,w,h}
end function

--/* never got this anywhere near working... mime_ptr is garbage except for the first...
function get_encoder_clsid(string mime)
    -- enumerate encoders and find "image/png"
    -- (standard GDI+ boilerplate)

    atom pNum = allocate(4),
         pSize = allocate(4)

    GdipGetImageEncodersSize(pNum, pSize)

    integer num = peek4u(pNum),
            size = peek4u(pSize)
    free(pNum)
    free(pSize)

    atom pEncoders = allocate(size)

    GdipGetImageEncoders(num, size, pEncoders)

    integer esz = get_struct_size(idImageCodecInfo)
--  integer esz = size/num
?{num,size,esz,esz*num}

    for i=0 to num-1 do
        atom p = pEncoders + i*esz
        atom mime_ptr = get_struct_field(idImageCodecInfo,p,"MimeType")

--      sequence ms = peek_string(mime_ptr)
        sequence ms = peek_wstring(mime_ptr)
        ?ms
        if ms=mime then
            atom clsid = allocate(16)
            mem_copy(clsid, get_struct_field(idImageCodecInfo,p,"Clsid"), 16)
            return clsid
        end if
    end for

    return NULL
end function

