--/*
--requires(64,true)
include libvlc.e
--include std/console.e -- For get_key() non-blocking input

constant VIDEO_FILE = `test_colorbars.mp4`  -- Must exist in cwd or full path
constant STDERR = 2
constant VK_SPACE = ' '
constant VK_ESCAPE = 27
constant VK_LEFT = 331
constant VK_RIGHT = 333
constant VK_HOME = 327
constant VK_END = 325

-- Initialize VLC (with plugin path fix for Windows)
atom inst = libvlc_new()
if inst = NULL then
    puts(STDERR, "VLC initialization failed! Check libvlc.dll is in PATH\n")
    abort(1)
end if

-- Load media
atom media = libvlc_media_new_path(inst, VIDEO_FILE)
if media = NULL then
    puts(STDERR, sprintf("Failed to load media: %s\n", {VIDEO_FILE}))
    libvlc_release(inst)
    abort(1)
end if

-- Parse media to get duration (non-blocking would be better in real app)
{} = libvlc_media_parse(media)
atom duration_ms = libvlc_media_get_duration(media)
printf(1, "Duration: %s\n", {elapsed_short(duration_ms/1000)})

-- Create player
--atom player = libvlc_media_player_new_from_media(media)
atom player = libvlc_media_player_new_from_media(media,NULL)
libvlc_media_release(media)  -- Safe to release now

-- Start playing
if libvlc_media_player_play(player) != 0 then
    puts(STDERR, "Failed to start playback\n")
    {} = libvlc_media_player_release(player)
    libvlc_release(inst)
    abort(1)
end if

-- Main loop: Handle keyboard input
bool running = true
while running do
    integer ch = get_key()
    switch ch do
        case VK_SPACE:  -- Play/pause toggle
            if libvlc_media_player_is_playing(player) then
                libvlc_media_player_pause(player)
            else
                {} = libvlc_media_player_play(player)
            end if
--      else
--          if ch!=-1 then ?ch end if
        case VK_LEFT:   -- Seek -5s
            libvlc_media_player_set_time(player, 
                max(0, libvlc_media_player_get_time(player) - 5000))
        case VK_RIGHT:  -- Seek +5s
            libvlc_media_player_set_time(player, 
                min(duration_ms, libvlc_media_player_get_time(player) + 5000))
        case VK_HOME:   -- Jump to start
            libvlc_media_player_set_time(player, 0)
        case VK_END:    -- Jump to end
            libvlc_media_player_set_time(player, duration_ms)
        case VK_ESCAPE: -- Quit
            running = false
    end switch
    
    -- Optional: Display current time (every 250ms to avoid spam)
    atom last_time = 0
    atom now = time()
    if now - last_time > 0.25 then
        atom current_ms = libvlc_media_player_get_time(player)
        printf(1, "\rTime: %s / %s    ", 
            {elapsed_short(current_ms/1000), elapsed_short(duration_ms/1000)})
--      flush()
        last_time = now
    end if
    
    sleep(0.010)  -- Yield CPU
end while

-- Cleanup
libvlc_media_player_stop(player)
{} = libvlc_media_player_release(player)
libvlc_release(inst)
*/

