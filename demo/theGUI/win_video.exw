--requires(64,true)
include theGUI.WINAPI.e
include libmpv.e

constant STDERR = 2
--OK, that's all working, however I've noticed this little anomalie:
constant VIDEO_FILE = `test_colorbars.mp4` -- (good)
--constant VIDEO_FILE = `C:\Program Files (x86)\Phix\demo\theGUI\test_colorbars.mp4` -- bad
--constant VIDEO_FILE = `C:/Program Files (x86)/Phix/demo/theGUI/test_colorbars.mp4` -- good!
--constant VIDEO_FILE = `F:\misc\porn\Nadia\BestOfPixie.mp4`
--constant VIDEO_FILE = `C:\Users\petel\Downloads\Porn Film Online - Jenna Haze Part 10 - Watching Free.mp4`

-- Global State
atom hWnd = 0
--atom hBitmap = 0        -- Current frame bitmap (HBITMAP)
--integer frame_w = 0, frame_h = 0
atom duration = -1        -- Video duration in seconds
--atom vid_fps_num, vid_fps_den
--atom current_time = 0   -- Current playback position
--bool playing = false
--atom timer_id = 0       -- WinAPI timer ID
--bool frame_ready = false  -- Whether we have a valid frame to render
--string video_path = "test.mp4"    -- <-- CHANGE THIS TO YOUR TEST VIDEO
--string video_path = `F:\misc\porn\Nadia\BestOfPixie.mp4`
--string video_path = `test_colorbars.mp4`

atom hVideoWnd = 0  -- Handle for our dedicated video child window
constant VIDEO_MARGIN_PCT = 0.1  -- 10% margin on sides/top
constant VIDEO_HEIGHT_PCT = 0.7  -- Video takes 70% of window height

atom mpv_ctx

procedure create_hVideoWnd()
    if hWnd=NULL then ?9/0 end if -- (for gVidCut use)
    -- CREATE DEDICATED VIDEO CHILD WINDOW (STATIC CLASS)
    hVideoWnd = CreateWindowEx(
                    0,                            -- dwExStyle
                    "STATIC",                     -- lpClassName (predefined static control)
                    NULL,                         -- lpWindowName (no text)
                    WS_CHILD || WS_VISIBLE,       -- dwStyle (child + visible)
                    0, 0, 0, 0,                   -- x, y, width, height (we'll size in WM_SIZE)
                    hWnd,                         -- hWndParent (our main window)
                    NULL,                         -- hMenu
--                  ((LPCREATESTRUCT)lParam)->hInstance, -- hInstance
                    instance(),
                    NULL                          -- lpParam
                );
    
    if hVideoWnd = 0 then
--      puts(STDERR, "Failed to create video child window\n")
        crash("Failed to create video child window")
--      return -1  -- Fail window creation
    end if
    
    -- Initialize mpv AFTER creating video window (but BEFORE showing main window)
    mpv_ctx = mpv_create()
--  if mpv_ctx = NULL then ... end if
    
    -- CRITICAL: Pass CHILD WINDOW HANDLE to mpv (NOT main window!)
--  mpv_set_option_string(mpv_ctx, "wid", sprintf("%p", hVideoWnd))
--  mpv_set_option_string(mpv_ctx, "wid", sprintf("%x", hVideoWnd))
--  mpv_set_option_string(mpv_ctx, "wid", sprintf("%X", hVideoWnd))
    mpv_set_option_string(mpv_ctx, "wid", sprintf("%d", hVideoWnd))
    mpv_set_option_string(mpv_ctx, "vo", "gpu")
    mpv_set_option_string(mpv_ctx, "keep-open", "yes")
    mpv_set_option_string(mpv_ctx, "pause", "yes")  -- Start paused
    
    mpv_initialize(mpv_ctx)
    -- ... [loadfile and rest of init] ...
    
--  mpv_command_string(mpv_ctx, sprintf("loadfile \"%s\"", {mpv_normalize_path(VIDEO_FILE)}))
    mpv_command_string(mpv_ctx, sprintf("loadfile %Q", {VIDEO_FILE}))
end procedure

procedure handle_resize(atom lParam)
    integer client_w = LOWORD(lParam)
    integer client_h = HIWORD(lParam)
--?{"handle_resize",client_w,client_h}
    
    -- CALCULATE VIDEO AREA (top-centered with margins)
--  integer video_w = floor(client_w * (1.0 - 2.0 * VIDEO_H_MARGIN_PCT))
    integer video_w = floor(client_w * (1.0 - 2.0 * VIDEO_MARGIN_PCT))
    integer video_h = floor(client_h * VIDEO_HEIGHT_PCT)
--  integer video_x = floor(client_w * VIDEO_H_MARGIN_PCT)
    integer video_x = floor(client_w * VIDEO_MARGIN_PCT)
--  integer video_y = floor(client_h * VIDEO_TOP_PCT)
    integer video_y = floor(client_h * VIDEO_MARGIN_PCT)
    
    -- RESIZE/MOVE VIDEO CHILD WINDOW
--?{"SetWindowPos", video_x, video_y, video_w, video_h}
--{"handle_resize",784,561} -- (full window)
--{"SetWindowPos",78,56,627,392}
    SetWindowPos(hVideoWnd, NULL, video_x, video_y, video_w, video_h, 
                 SWP_NOZORDER || SWP_NOACTIVATE)
    
    -- NOTIFY MPV OF NEW SIZE (critical for proper rendering)
    mpv_set_option_string(mpv_ctx, "video-zoom", "0")
    mpv_set_option_string(mpv_ctx, "video-pan-x", "0")
    mpv_set_option_string(mpv_ctx, "video-pan-y", "0")
    mpv_set_option_string(mpv_ctx, "video-unscaled", "no")
    mpv_command_string(mpv_ctx, "set video-zoom 0")  -- Trigger resize
end procedure

function WndProc(atom hWnd, msg, wParam, lParam)
    switch msg do

        case WM_SIZE:

            handle_resize(lParam)
    
            InvalidateRect(hWnd, NULL, true)
            return 0


        case WM_PAINT:
            atom hdc = BeginPaint(hWnd, pPAINTSTRUCT)
--          atom hdc, hmemdc, holdbmp
--          atom ps = allocate_struct(idPAINTSTRUCT)
--          hdc = BeginPaint(hWnd, ps)
--          integer client_w, client_h
--          integer {?,?,w,h} = GetClientRect(hWnd)
            integer {?,?,client_w,client_h} = GetClientRect(hWnd)
--          GetClientRect(hWnd, ps)
--          client_w = ps.right - ps.left
--          client_h = ps.bottom - ps.top

            -- Clear background
--          FillRect(hdc, ps, GetStockObject(BLACK_BRUSH))
            FillRect(hdc, pPAINTSTRUCT, GetStockObject(BLACK_BRUSH))

            -- Draw overlay text (time/progress)
--          string time_text = format_time(current_time) & " / " & format_time(duration)
--          SetTextColor(hdc, 0xFFFFFF)  -- White text
--          SetBkMode(hdc, TRANSPARENT)
--          TextOut(hdc, 10, 10, time_text, length(time_text))
            
--          EndPaint(hWnd, ps)
            EndPaint(hWnd, pPAINTSTRUCT)
            return 0

--      case WM_TIMER:
--          if wParam = timer_id then
--              if playing then
--                  -- Advance time by 1 frame (using approximate fps)
--                  atom fps = vid_fps_num / vid_fps_den
--                  current_time += 1.0 / fps
--                  if current_time >= duration then
--                      current_time = duration
----                        stop_playback()
--                  end if
----                    frame_ready = (hBitmap != 0)
--                  InvalidateRect(hWnd, NULL, true)
--              end if
--          end if
--          return 0

        case WM_CHAR:
--?{"WM_CHAR",wParam}
--?{VK_ADD, VK_OEM_PLUS, VK_RIGHT}
--**NB** these keys don't all work, but I don't care... (see gVidCut.exw)

            switch wParam do
                case VK_SPACE: mpv_command_string(mpv_ctx, "cycle pause")
--mpv_set_option_string(mpv_ctx, "fullscreen", "yes")
                case VK_ADD, VK_OEM_PLUS:  -- '+' key
                case VK_RIGHT: mpv_command_string(mpv_ctx, "seek +5 relative")
                case VK_SUBTRACT, VK_OEM_MINUS:  -- '-' key
                case VK_LEFT: mpv_command_string(mpv_ctx, "seek -5 relative")
                case VK_HOME: mpv_command_string(mpv_ctx, "seek 0 absolute")
                case VK_END: mpv_command_string(mpv_ctx, sprintf("seek %f absolute", {duration}))
                case VK_ESCAPE: {} = SendMessage(hWnd, WM_CLOSE, 0, 0)
            end switch
            return 0

        case WM_DESTROY:

            mpv_ctx = mpv_terminate_destroy(mpv_ctx)
            DestroyWindow(hVideoWnd)  -- Clean up child window

            PostQuitMessage(0)
            return 0
    end switch
    return DefWindowProc(hWnd, msg, wParam, lParam)
end function
constant WndProc_cb = call_back(WndProc)

-- Main
procedure main()

    RegisterClassEx("VideoCanvas", WndProc_cb)
    
    hWnd = CreateWindowEx(
        0, "VideoCanvas", "Phix Video Player",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT, 800, 600,
        NULL, NULL, 0, NULL
    )
    
    if hWnd = 0 then
        puts(STDERR, "Failed to create window\n")
        abort(1)
    end if

    create_hVideoWnd()
    
    ShowWindow(hWnd, SW_SHOWNORMAL)
    UpdateWindow(hWnd)
    
    atom pMsg = allocate_struct(idMSG)
    while GetMessage(pMsg, NULL, 0, 0) do
        TranslateMessage(pMsg)
        DispatchMessage(pMsg)
    end while
end procedure
main()
