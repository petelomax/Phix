Well, that all got pretty ridiculous pretty quickly, so I'm knocking all that nonsense on the head right now.
Last year I wrote a simple libvlc wrapper, as you can see below at least a hundred times easier.
However, I've just heard about libmpv, and I tyhink that's worth giving a shot.

include libvlc.e
?libvlc_get_version() -- "3.0.21 Vetinari" (32bit)

constant path = `test_colorbars.mp4`

/* Load the VLC engine */
--atom inst = libvlc_new (0, NULL);
atom inst = libvlc_new(),
     m = libvlc_media_new_path(inst,path),

     p = libvlc_media_parse(m);
printf(1,"Duration: %s\n",{elapsed_short(libvlc_media_get_duration(m)/1000)})
 
--atom mp = libvlc_media_player_new_from_media(inst, m);
atom mp = libvlc_media_player_new_from_media(m, NULL);
 
/* No need to keep the media now */
libvlc_media_release(m);
 
integer res = libvlc_media_player_play(mp)
assert(res=0)
do 
    sleep(1)
    printf(1,"%s\n",{elapsed_short(libvlc_media_player_get_time(mp)/1000)})
until not libvlc_media_player_is_playing(mp)

libvlc_media_player_stop(mp);
mp = libvlc_media_player_release(mp);
libvlc_release(inst);
--*/

--*!/
--/*
// Build with: gcc -o simple simple.c `pkg-config --libs --cflags mpv`

#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>

#include <mpv/client.h>

static inline void check_error(int status)
{
    if (status < 0) {
        printf("mpv API error: %s\n", mpv_error_string(status));
        exit(1);
    }
}

int main(int argc, char *argv[])
{
    if (argc != 2) {
        printf("pass a single media file as argument\n");
        return 1;
    }

    mpv_handle *mpv_ctx = mpv_create();
    if (!mpv_ctx) {
        printf("failed creating context\n");
        return 1;
    }

    // Enable default key bindings, so the user can actually interact with
    // the player (and e.g. close the window).
    check_error(mpv_set_option_string(mpv_ctx, "input-default-bindings", "yes"));
    mpv_set_option_string(mpv_ctx, "input-vo-keyboard", "yes");
    int val = 1;
    check_error(mpv_set_option(mpv_ctx, "osc", MPV_FORMAT_FLAG, &val));

    // Done setting up options.
    check_error(mpv_initialize(mpv_ctx));

    // Play this file.
    const char *cmd[] = {"loadfile", argv[1], NULL};
    check_error(mpv_command(mpv_ctx, cmd));

    // Let it play, and wait until the user quits.
    while (1) {
        mpv_event *event = mpv_wait_event(mpv_ctx, 10000);
        printf("event: %s\n", mpv_event_name(event->event_id));
        if (event->event_id == MPV_EVENT_SHUTDOWN)
            break;
    }

    mpv_ctx = mpv_terminate_destroy(mpv_ctx);
    return 0;
}

-- demo\theGUI\win_video_ex.exw
-- ===========================
-- A minimal video player using ffmpeg/ffprobe for media ops and WinAPI/GDI+ for rendering
-- Features: Play/pause (space), step +/-5s, jump to start/end (home/end)
-- Requires: ffmpeg/ffprobe in PATH, gdiplus.dll (standard on Windows)

include theGUI.WINAPI.e
include theGUI.gdiplus.e
--include std/filesys.e
--include std/convert.e
--include std/regex.e
include builtins\pipeio.e
include builtins\json.e 


-- GDI+ Constants and Structures
constant GDIP_OK = 0
constant gdiplusToken = allocate_word()
constant PixelFormat24bppRGB = 0x00020000
constant PixelFormat32bppARGB = 0x00020006
constant PixelFormat32bppPARGB = 0x000E200B

--type GpGraphics pointer
--type GpBitmap pointer
--type GpImage pointer
--type CLSID atom(16)

-- Global State
atom hWnd = 0
atom hBitmap = 0          -- Current frame bitmap (HBITMAP)
integer frame_w = 0, frame_h = 0
atom duration = 0         -- Video duration in seconds
atom vid_fps_num, vid_fps_den
atom current_time = 0     -- Current playback position
bool playing = false
atom timer_id = 0         -- WinAPI timer ID
bool frame_ready = false  -- Whether we have a valid frame to render
--string video_path = "test.mp4"    -- <-- CHANGE THIS TO YOUR TEST VIDEO
--string video_path = `F:\misc\porn\Nadia\BestOfPixie.mp4`
string video_path = `test_colorbars.mp4`

function ReadFromPipe(atom hPipe, hProc) 
-- Read output from the child process's pipe for stdout
-- and write to (the parent process's pipe for) stdout. 
-- Stop when there is no more data. 
    string res = ""
    while true do
        object buff = read_from_pipe(hPipe,hProc)
        if buff=-1 then exit end if
--      puts(1,buff)
        res &= buff
--DEV/fudge...
        if platform()=LINUX then
            if find('!',buff) then exit end if
        end if
    end while
    return res
end function

-- Forward declarations
--atom load_frame_at_time(atom t_sec)
-- Frame Loading (using ffmpeg)
function load_frame_at_time(atom t_sec)
    -- Build ffmpeg command to extract single frame as RGB24
--  string cmd = sprintf(
--      "ffmpeg -hide_banner -loglevel error -ss %.3f -i \"%s\" -vframes 1 -f rawvideo -pix_fmt rgb24 -",
--      {t_sec, video_path}
--  )
-- Extract as BGRA32 (guaranteed 4-byte aligned, no stride issues!)
    string cmd = sprintf(
        "ffmpeg -hide_banner -loglevel error -ss %.3f -i \"%s\" -vframes 1 -f rawvideo -pix_fmt bgra -",
        {t_sec, video_path}
    )
    
    sequence pipes = repeat(0,3)
    -- You can comment out one or more of these...
--  pipes[PIPEIN] = create_pipe(INHERIT_WRITE)
    pipes[PIPOUT] = create_pipe(INHERIT_READ)
--  pipes[PIPERR] = create_pipe(INHERIT_READ)

    atom hProc = system_exec(cmd, 12, pipes)

        -- Read from pipe that is the standard output for child process. 
        printf(1,"\n->Contents of child process stdout:\n\n")
        string frame_data = ReadFromPipe(pipes[PIPOUT][READ_PIPE],hProc)
--      puts(1,res)

--/*
    -- Execute ffmpeg and capture raw frame data
    atom pipe = popen(cmd, "r")
    if pipe = NULL then return 0 end if
--*/    
    -- Expected data size: width * height * 3 (RGB24)
    integer expected_size = frame_w * frame_h * 3
--  string frame_data = allocate(expected_size)
--  integer bytes_read = fread(frame_data, 1, expected_size, pipe)
    integer bytes_read = length(frame_data)
--  integer exit_code = pclose(pipe)

    if platform()=WINDOWS then
        hProc = close_handles(hProc)
    end if

    -- The remaining open handles are cleaned up when this process terminates. 
    -- To avoid resource leaks in a larger application, close handles explicitly. 
    pipes = close_handles(pipes)
    
--  if bytes_read != expected_size or exit_code != 0 then
    if bytes_read != expected_size then
--      free(frame_data)
        return 0  -- Failed to extract frame
    end if
    
    -- Convert RGB24 to HBITMAP using GDI+
--  atom bitmap = 0
    atom pBitmap = allocate(machine_word())
--I'm getting a status of 2 which is InvalidParameter from GdipCreateBitmapFromScan0 but everything looks pukka to me.
--Can you suggest a suitable clip for me to download and try, ideally one you know a few stats about, has the right codex, etc.
-- CRITICAL FIX: Calculate 4-byte aligned stride for GDI+
--  integer stride = ((frame_w * 3 + 3) / 4) * 4;  -- Round UP to next multiple of 4
--  integer stride = floor((frame_w * 3 + 3) / 4) * 4;  -- Round UP to next multiple of 4
    integer stride = frame_w * 4
    
